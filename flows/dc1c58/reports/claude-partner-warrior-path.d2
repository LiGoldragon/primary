direction: right
title: |md
  # El camino del guerrero · The warrior's path
  Armando Torres, *Encuentros con el nagual*
| {near: top-center}

disciplina: Disciplina\nDiscipline {shape: hexagon}
atencion: Atención\nAttention
voluntad: Voluntad\nWill {style.fill: "#f4e3c1"}
intento: Intento\nIntent {style.fill: "#e8d5a3"}
silencio: Silencio interno\nInner silence
libertad: Libertad total\nTotal freedom {shape: circle; style.fill: "#d9c27a"}

disciplina -> atencion: "la clave en el manejo\nde la atención"
atencion -> voluntad: "nos lleva a la voluntad"
voluntad -> intento: "la antesala del intento"
silencio -> intento: "transformar la voluntad\nen intento"
intento -> libertad: "el verdadero propósito"

guerra: {
  label: La guerra del guerrero · The warrior's war
  style.stroke-dash: 3
  debilidades: Contra sus propias\ndebilidades
  no_otros: No contra los demás {style.stroke: "#999"}
  paz: Su paz: silencio\ny disciplina
  debilidades -> paz
}
voluntad -> guerra.debilidades: "templa su voluntad"

meta: {
  label: La meta · The goal
  consciente: Estar consciente\nTo be aware
  percibir: Percibir todo lo\nhumanamente posible
  consciente -> percibir
}
meta.percibir -> libertad

poder: Poder de la pasión\nPower of passion {style.fill: "#f7d6cc"}
poder -> voluntad: "al servicio del ser"
