        },
        {
          "identifier": "vision:herdr-nexus-v1:L205",
          "text": "## Emission"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L207",
          "text": "The herdr command line, as a type. The translator turns it into the call. Its outcome is what the translator observed, raw and its own type. Listing composes PaneList and AgentList, and WorkspaceList while a creation is pending; each is one herdr call."
        },
        {
          "identifier": "vision:herdr-nexus-v1:L209",
          "text": "```ethos"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L210",
          "text": "Emission"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L211",
          "text": "[ herdr:[ Session PaneId Pane Root   ; imports"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L212",
          "text": "          Variable Command Text"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L213",
          "text": "          Keys State Refusal"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L214",
          "text": "          CreationId ] ]"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L215",
          "text": "[ Herdr.{ Session Verb } ]           ; emissions: one call"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L216",
          "text": "[ ExternalOutcome ]                  ; outcomes: observed, raw"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L217",
          "text": "[ Verb.[ WorkspaceCreate.{ CreationId ; types"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L218",
          "text": "                           Root"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L219",
          "text": "                           Vector<Variable> }"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L220",
          "text": "         WorkspaceList               ; while a creation is pending"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L221",
          "text": "         AgentStart.{ PaneId         ; Timeout comes from"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L222",
          "text": "                      Command        ;   the configuration"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L223",
          "text": "                      Timeout.Integer }"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L224",
          "text": "         AgentPrompt.{ PaneId Text }"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L225",
          "text": "         Keys.{ PaneId Keys }"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L226",
          "text": "         PaneClose.PaneId"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L227",
          "text": "         PaneList                    ; Listing's calls"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L228",
          "text": "         AgentList ]"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L229",
          "text": "  TerminalId.String"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L230",
          "text": "  WorkspaceId.String"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L231",
          "text": "  WorkspaceLabel.String"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L232",
          "text": "  TabId.String"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L233",
          "text": "  PaneListing.{ Pane TerminalId      ; a pane herdr listed"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L234",
          "text": "                WorkspaceId TabId }"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L235",
          "text": "  AgentListing.{ Pane TerminalId     ; an agent herdr listed"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L236",
          "text": "                 WorkspaceId TabId"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L237",
          "text": "                 State }"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L238",
          "text": "  WorkspaceListing.{ WorkspaceId     ; a workspace herdr listed"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L239",
          "text": "                     WorkspaceLabel }"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L240",
          "text": "  ExternalOutcome.[ Done             ; what the translator"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L241",
          "text": "                    Started.State    ;   observed"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L242",
          "text": "                    Created.Pane"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L243",
          "text": "                    Panes.Vector<PaneListing>"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L244",
          "text": "                    Agents.Vector<AgentListing>"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L245",
          "text": "                    Workspaces.Vector<WorkspaceListing>"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L246",
          "text": "                    Refused.Refusal"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L247",
          "text": "                    Uncertain ] ]"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L248",
          "text": "```"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L250",
          "text": "```rust"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L251",
          "text": "impl Emittable for Herdr {"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L252",
          "text": "    type Outcome = ExternalOutcome;"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L253",
          "text": "    fn emit(&self, t: &Translator) -> ExternalOutcome {"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L254",
          "text": "        let mut argv = vec![\"--session\".into(),"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L255",
          "text": "                            self.session.0.clone()];"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L256",
          "text": "        argv.extend(self.verb.argv());"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L257",
          "text": "        t.call(&t.herdr_path, &argv)"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L258",
          "text": "    }"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L259",
          "text": "}"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L260",
          "text": "```"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L262",
          "text": "## Memory"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L264",
          "text": "A pane is owned by an Owner. A text caller, through the translator, owns by its login, since a CLI is a new process each call and one person drives a pane across many. A signal peer, such as the Flow Nexus's translator, owns by its Peer entry, bound by kernel credentials. The envelope carries the Caller, its ProcessId and UserId, and ownership derives from it."
        },
        {
          "identifier": "vision:herdr-nexus-v1:L266",
          "text": "For the proof of concept, Memory lasts as long as the process."
        },
        {
          "identifier": "vision:herdr-nexus-v1:L268",
          "text": "```ethos"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L269",
          "text": "Memory"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L270",
          "text": "[ herdr:[ Owner Pane Workspace Label ; imports"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L271",
          "text": "          State Attempt"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L272",
          "text": "          MemoryRefusal CreationId ]"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L273",
          "text": "  translator:[ Principal ] ]"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L274",
          "text": "[ OwnedPane.{ Owner Pane Workspace   ; records: each owned pane,"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L275",
          "text": "              Option<Label>          ;   and who owns it"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L276",
          "text": "              State Attempt }"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L277",
          "text": "  Answer.[ Succeeded                 ; every change returns it"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L278",
          "text": "           Failed.MemoryRefusal ]"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L279",
          "text": "  PendingCreation.{ CreationId       ; a creation not yet"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L280",
          "text": "                    Principal        ;   joined to its pane"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L281",
          "text": "                    Workspace } ]"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L282",
          "text": "```"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L284",
          "text": "```datom"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L285",
          "text": "; typed at the CLI"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L286",
          "text": "Prompt.{ { main wQ:pT } «Land the messaging line» }"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L287",
          "text": "; the reply"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L288",
          "text": "Prompted.Done"
        },
        {
          "identifier": "vision:herdr-nexus-v1:L289",
          "text": "```"
        }
