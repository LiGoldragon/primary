{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/run/current-system/sw/bin/zsh -lc \"nl -ba src/composition.rs | sed -n '1,280p'; nl -ba src/composition.rs | sed -n '281,540p'; nl -ba src/composition.rs | sed -n '790,914p'; nl -ba crates/datom-codec-derive/src/lib.rs; nl -ba src/projection.rs\"","aggregated_output":"     1\tuse std::str::FromStr;\n     2\t\n     3\tuse crate::*;\n     4\t\n     5\tpub trait DatomForming {\n     6\t    fn datom_form(&self, path: Path) -> Result<Datom, Error>;\n     7\t}\n     8\t\n     9\tconst MAXIMUM_FORMING_DEPTH: Integer = 4_096;\n    10\t\n    11\tenum Forming<'a> {\n    12\t    Visit(&'a protos::Protos, Path, Integer),\n    13\t    Enclosed(Path, bool, usize),\n    14\t    Headed(Path, protos::Symbol),\n    15\t}\n    16\tstruct Former<'a> {\n    17\t    work: Vec<Forming<'a>>,\n    18\t    values: Vec<Datom>,\n    19\t}\n    20\ttrait FormingDatoms<'a> {\n    21\t    fn form(root: &'a protos::Protos, path: Path) -> Result<Datom, Error>;\n    22\t}\n    23\timpl<'a> FormingDatoms<'a> for Former<'a> {\n    24\t    fn form(root: &'a protos::Protos, path: Path) -> Result<Datom, Error> {\n    25\t        let mut former = Self {\n    26\t            work: vec![Forming::Visit(root, path, 0)],\n    27\t            values: Vec::new(),\n    28\t        };\n    29\t        while let Some(work) = former.work.pop() {\n    30\t            match work {\n    31\t                Forming::Visit(protos, path, depth) => {\n    32\t                    if depth >= MAXIMUM_FORMING_DEPTH {\n    33\t                        return Err(Error {\n    34\t                            layer: ErrorLayer::Datom,\n    35\t                            path,\n    36\t                            kind: ErrorKind::Budget,\n    37\t                        });\n    38\t                    }\n    39\t                    match protos {\n    40\t                        protos::Protos::Bare { text, .. } => former.values.push(Datom {\n    41\t                            path,\n    42\t                            form: Form::Bare(text.clone()),\n    43\t                        }),\n    44\t                        protos::Protos::Opaque {\n    45\t                            boundary: protos::Boundary::Guillemets,\n    46\t                            content,\n    47\t                            ..\n    48\t                        } => former.values.push(Datom {\n    49\t                            path,\n    50\t                            form: Form::String(content.clone()),\n    51\t                        }),\n    52\t                        protos::Protos::Opaque {\n    53\t                            boundary: protos::Boundary::Parentheses,\n    54\t                            content,\n    55\t                            ..\n    56\t                        } => former.values.push(Datom {\n    57\t                            path,\n    58\t                            form: Form::Meaning(content.clone()),\n    59\t                        }),\n    60\t                        protos::Protos::Enclosed {\n    61\t                            enclosure: protos::Enclosure::Braced,\n    62\t                            children,\n    63\t                            ..\n    64\t                        }\n    65\t                        | protos::Protos::Enclosed {\n    66\t                            enclosure: protos::Enclosure::Bracketed,\n    67\t                            children,\n    68\t                            ..\n    69\t                        } => {\n    70\t                            let structure = matches!(\n    71\t                                protos,\n    72\t                                protos::Protos::Enclosed {\n    73\t                                    enclosure: protos::Enclosure::Braced,\n    74\t                                    ..\n    75\t                                }\n    76\t                            );\n    77\t                            former.work.push(Forming::Enclosed(\n    78\t                                path.clone(),\n    79\t                                structure,\n    80\t                                children.len(),\n    81\t                            ));\n    82\t                            for (index, child) in children.iter().enumerate().rev() {\n    83\t                                former.work.push(Forming::Visit(\n    84\t                                    child,\n    85\t                                    path.child(index as Integer),\n    86\t                                    depth + 1,\n    87\t                                ));\n    88\t                            }\n    89\t                        }\n    90\t                        protos::Protos::Enclosed {\n    91\t                            enclosure: protos::Enclosure::Angled,\n    92\t                            ..\n    93\t                        } => {\n    94\t                            return Err(Error {\n    95\t                                layer: ErrorLayer::Datom,\n    96\t                                path,\n    97\t                                kind: ErrorKind::Form {\n    98\t                                    expected: \"Datom enclosure\".into(),\n    99\t                                    found: \"Angled\".into(),\n   100\t                                },\n   101\t                            });\n   102\t                        }\n   103\t                        protos::Protos::Headed {\n   104\t                            constraints: Some(_),\n   105\t                            ..\n   106\t                        } => {\n   107\t                            return Err(Error {\n   108\t                                layer: ErrorLayer::Datom,\n   109\t                                path,\n   110\t                                kind: ErrorKind::Form {\n   111\t                                    expected: \"unqualified Variant\".into(),\n   112\t                                    found: \"qualified head\".into(),\n   113\t                                },\n   114\t                            });\n   115\t                        }\n   116\t                        protos::Protos::Headed {\n   117\t                            head,\n   118\t                            constraints: None,\n   119\t                            separator: protos::Separator::Period,\n   120\t                            body,\n   121\t                            ..\n   122\t                        } => {\n   123\t                            former\n   124\t                                .work\n   125\t                                .push(Forming::Headed(path.clone(), head.clone()));\n   126\t                            former\n   127\t                                .work\n   128\t                                .push(Forming::Visit(body, path.child(1), depth + 1));\n   129\t                        }\n   130\t                        protos::Protos::Headed { .. } => former.values.push(Datom {\n   131\t                            path,\n   132\t                            form: Form::Bare(protos::Textualizable::textualize(protos)),\n   133\t                        }),\n   134\t                    }\n   135\t                }\n   136\t                Forming::Enclosed(path, structure, count) => {\n   137\t                    let children = former.values.split_off(former.values.len() - count);\n   138\t                    former.values.push(Datom {\n   139\t                        path,\n   140\t                        form: if structure {\n   141\t                            Form::Struct(children)\n   142\t                        } else {\n   143\t                            Form::Vector(children)\n   144\t                        },\n   145\t                    });\n   146\t                }\n   147\t                Forming::Headed(path, head) => {\n   148\t                    let body = former.values.pop().expect(\"formed headed body\");\n   149\t                    let form = match