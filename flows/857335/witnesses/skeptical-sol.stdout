{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/run/current-system/sw/bin/zsh -lc 'nl -ba src/lib.rs; nl -ba src/core.rs; nl -ba src/dropping.rs; nl -ba tests/protos.rs; nl -ba tests/delineation.rs; nl -ba tests/textualization.rs; nl -ba tests/deep.rs; nl -ba tests/scale.rs'","aggregated_output":"     1\t//! The structural layer shared by every Protos dialect.\n     2\tmod core;\n     3\tmod dropping;\n     4\tpub use core::{\n     5\t    Boundary, BoundedProtosizable, Canonicalizable, Enclosure, Error, Extent, Problem, Protos,\n     6\t    Protosizable, ReaderBudget, Separator, Symbol, Textualizable,\n     7\t};\n     1\tuse std::fmt;\n     2\t\n     3\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n     4\tpub struct Extent {\n     5\t    pub start: usize,\n     6\t    pub end: usize,\n     7\t}\n     8\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n     9\tpub enum Separator {\n    10\t    Period,\n    11\t    Exclamation,\n    12\t    Colon,\n    13\t}\n    14\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n    15\tpub enum Enclosure {\n    16\t    Braced,\n    17\t    Bracketed,\n    18\t    Angled,\n    19\t}\n    20\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n    21\tpub enum Boundary {\n    22\t    Guillemets,\n    23\t    Parentheses,\n    24\t}\n    25\t#[derive(Clone, Debug, PartialEq, Eq, Hash)]\n    26\tpub struct Symbol(pub String);\n    27\t#[derive(Clone, Debug, PartialEq, Eq)]\n    28\tpub enum Protos {\n    29\t    Headed {\n    30\t        extent: Extent,\n    31\t        head: Symbol,\n    32\t        constraints: Option<Box<Protos>>,\n    33\t        separator: Separator,\n    34\t        body: Box<Protos>,\n    35\t    },\n    36\t    Enclosed {\n    37\t        extent: Extent,\n    38\t        enclosure: Enclosure,\n    39\t        children: Vec<Protos>,\n    40\t    },\n    41\t    Opaque {\n    42\t        extent: Extent,\n    43\t        boundary: Boundary,\n    44\t        content: String,\n    45\t    },\n    46\t    Bare {\n    47\t        extent: Extent,\n    48\t        text: String,\n    49\t    },\n    50\t}\n    51\t#[derive(Clone, Debug, PartialEq, Eq)]\n    52\tpub struct Error {\n    53\t    pub extent: Extent,\n    54\t    pub problem: Problem,\n    55\t}\n    56\t#[derive(Clone, Debug, PartialEq, Eq)]\n    57\tpub enum Problem {\n    58\t    Empty,\n    59\t    Multiple,\n    60\t    Unclosed(char),\n    61\t    Unexpected(char),\n    62\t    MissingHead,\n    63\t    MissingBody,\n    64\t    Budget,\n    65\t    Depth,\n    66\t}\n    67\t/// The number of structural nodes one reading act may visit.\n    68\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n    69\tpub struct ReaderBudget {\n    70\t    pub remaining: usize,\n    71\t}\n    72\tpub trait ReaderBudgeting {\n    73\t    fn spend(&mut self) -> bool;\n    74\t}\n    75\timpl ReaderBudgeting for ReaderBudget {\n    76\t    fn spend(&mut self) -> bool {\n    77\t        if self.remaining == 0 {\n    78\t            false\n    79\t        } else {\n    80\t            self.remaining -= 1;\n    81\t            true\n    82\t        }\n    83\t    }\n    84\t}\n    85\tpub trait BoundedProtosizable {\n    86\t    fn protosize_with(&self, budget: &mut ReaderBudget) -> Result<Protos, Error>;\n    87\t}\n    88\tpub trait Protosizable {\n    89\t    type Output;\n    90\t    fn protosize(&self) -> Self::Output;\n    91\t}\n    92\tpub trait Textualizable {\n    93\t    fn textualize(&self) -> String;\n    94\t}\n    95\t/// Assign the UTF-8 byte extents of this tree's canonical textual form.\n    96\t///\n    97\t/// Parsing retains the source extents it read. This capability is for a tree\n    98\t/// built structurally, whose context is the canonical text it will print.\n    99\tpub trait Canonicalizable {\n   100\t    fn canonicalize(&mut self);\n   101\t}\n   102\t\n   103\ttrait Glyphing {\n   104\t    fn opener(self) -> char;\n   105\t    fn closer(self) -> char;\n   106\t}\n   107\timpl Glyphing for Enclosure {\n   108\t    fn opener(self) -> char {\n   109\t        match self {\n   110\t            Self::Braced => '{',\n   111\t            Self::Bracketed => '[',\n   112\t            Self::Angled => '<',\n   113\t        }\n   114\t    }\n   115\t    fn closer(self) -> char {\n   116\t        match self {\n   117\t            Self::Braced => '}',\n   118\t            Self::Bracketed => ']',\n   119\t            Self::Angled => '>',\n   120\t        }\n   121\t    }\n   122\t}\n   123\timpl Glyphing for Boundary {\n   124\t    fn opener(self) -> char {\n   125\t        match self {\n   126\t            Self::Guillemets => '«',\n   127\t            Self::Parentheses => '(',\n   128\t        }\n   129\t    }\n   130\t    fn closer(self) -> char {\n   131\t        match self {\n   132\t            Self::Guillemets => '»',\n   133\t            Self::Parentheses => ')',\n   134\t        }\n   135\t    }\n   136\t}\n   137\ttrait Separating {\n   138\t    fn glyph(self) -> char;\n   139\t}\n   140\timpl Separating for Separator {\n   141\t    fn glyph(self) -> char {\n   142\t        match self {\n   143\t            Self::Period => '.',\n   144\t            Self::Exclamation => '!',\n   145\t            Self::Colon => ':',\n   146\t        }\n   147\t    }\n   148\t}\n   149\ttrait Extenting {\n   150\t    fn extent(&self) -> Extent;\n   151\t}\n   152\timpl Extenting for Protos {\n   153\t    fn extent(&self) -> Extent {\n   154\t        match self {\n   155\t            Self::Headed { extent, .. }\n   156\t            | Self::Enclosed { extent, .. }\n   157\t            | Self::Opaque { extent, .. }\n   158\t            | Self::Bare { extent, .. } => *extent,\n   159\t        }\n   160\t    }\n   161\t}\n   162\t\n   163\tstruct Reader<'a> {\n   164\t    text: &'a str,\n   165\t    offset: usize,\n   166\t    budget: &'a mut ReaderBudget,\n   167\t    depth: usize,\n   168\t}\n   169\tconst MAXIMUM_READER_DEPTH: usize = 256;\n   170\ttrait Reading {\n   171\t    fn whole(&mut self) -> Result<Protos, Error>;\n   172\t    fn node(&mut self) -> Result<Protos, Error>;\n   173\t    fn enclosed(&mut self, enclosure: Enclosure) -> Result<Protos, Error>;\n   174\t    fn opaque(&mut self, boundary: Boundary) -> Result<Protos, Error>;\n   175\t    fn bare_or_headed(&mut self) -> Result<Protos, Error>;\n   176\t    fn headed(\n   177\t        &mut self,\n   178\t        head: Symbol,\n   179\t        constraints: Option<Protos>,\n   180\t        start: usize,\n   181\t        separator: Separator,\n   182\t    ) -> Result<Protos, Error>;\n   183\t    fn space(&mut self);\n   184\t    fn glyph(&self) -> Option<char>;\n   185\t    fn step(&mut self);\n   186\t    fn failure(&self, problem: Problem, start: usize) -> Error;\n   187\t}\n   188\timpl Reading for Reader<'_> {\n   189\t    fn whole(&mut self) -> Result<Protos, Error> {\n   190\t        self.space();\n   191\t        if self.glyph().is_none() {\n   192\t            return Err(self.failure(Problem::Empty, self.offset));\n   193\t        }\n   194\t        let form = self.node()?;\n   195\t        self.space();\n   196\t        if self.glyph().is_some() {\n   197\t            Err(self.failure(Problem::Multiple, self.offset))\n   198\t        } else {\n   199\t            Ok(form)\n   200\t        }\n   201\t    }\n   202\t    fn node(&mut self) -> Result<Protos, Error> {\n   203\t        if !self.budget.spend() {\n   204\t            return Err(self.failure(Problem::Budget, self.offset));\n   205\t        }\n   206\t        if self.depth == MAXIMUM_READER_DEPTH {\n   207\t            return Err(self.failure(Problem::Depth, self.offset));\n   208\t        }\n   209\t        self.depth += 1;\n   210\t        self.space();\n   211\t        let result = match self.glyph() {\n   212\t            Some('{') => self.enclosed(Enclosure::Braced),\n   213\t            Some('[') => self.enclosed(Enclosure::Bracketed),\n   214\t            Some('<') => self.enclosed(Enclosure::Angled),\n   215\t            Some('«') => self.opaque(Boundary::Guillemets),\n   216\t            Some('(') => self.opaque(Boundary::Parentheses),\n   217\t            Some('}' | ']' | '>' | '»' | ')') => Err(self.failure(\n   218\t                Problem::Unexpected(self.glyph().expect(\"matched\")),\n   219\t                self.offset,\n   220\t            )),\n   221\t            Some(_) => self.bare_or_headed(),\n   222\t            None => Err(self.failure(Problem::MissingBody, self.offset)),\n   223\t        };\n   224\t        self.depth -= 1;\n   225\t        result\n   226\t    }\n   227\t    fn enclosed(&mut self, enclosure: Enclosure) -> Result<Protos, Error> {\n   228\t        let start = self.offset;\n   229\t        self.step();\n   230\t        let mut children = Vec::new();\n   231\t        loop {\n   232\t            self.space();\n   233\t            match self.glyph() {\n   234\t                Some(glyph) if glyph == enclosure.closer() => {\n   235\t                    self.step();\n   236\t                    return Ok(Protos::Enclosed {\n   237\t                        extent: Extent {\n   238\t                            start,\n   239\t                            end: self.offset,\n   240\t                        },\n   241\t                        enclosure,\n   242\t                        children,\n   243\t                    });\n   244\t                }\n   245\t                None => return Err(self.failure(Problem::Unclosed(enclosure.opener()), start)),\n   246\t                _ => children.push(self.node()?),\n   247\t            }\n   248\t        }\n   249\t    }\n   250\t    fn opaque(&mut self, boundary: Boundary) -> Result<Protos, Error> {\n   251\t        let start = self.offset;\n   252\t        self.step();\n   253\t        let mut content = String::new();\n   254\t        let mut depth = 1usize;\n   255\t        loop {\n   256\t            let Some(glyph) = self.glyph() else {\n   257\t                return Err(self.failure(Problem::Unclosed(boundary.opener()), start));\n   258\t            };\n   259\t            if boundary == Boundary::Guillemets && glyph == '\\\\' {\n   260\t                self.step();\n   261\t                if let Some(escaped) = self.glyph() {\n   262\t                    if escaped != boundary.closer() {\n   263\t                        content.push('\\\\');\n   264\t                    }\n   265\t                    content.push(escaped);\n   266\t                    self.step();\n   267\t                } else {\n   268\t                    content.push('\\\\');\n   269\t                }\n   270\t                continue;\n   271\t            }\n   272\t            if boundary == Boundary::Parentheses && glyph == '\\\\' {\n   273\t                self.step();\n   274\t                let Some(escaped) = self.glyph() else {\n   275\t                    return Err(self.failure(Problem::Unclosed(boundary.opener()), start));\n   276\t                };\n   277\t                if !matches!(escaped, '\\\\' | '(' | ')') {\n   278\t                    content.push('\\\\');\n   279\t                }\n   280\t                content.push(escaped);\n   281\t                self.step();\n   282\t                continue;\n   283\t            }\n   284\t            if boundary == Boundary::Parentheses && glyph == '(' {\n   285\t                depth += 1;\n   286\t                content.push(glyph);\n   287\t                self.step();\n   288\t                continue;\n   289\t            }\n   290\t            if glyph == boundary.closer() {\n   291\t                depth -= 1;\n   292\t                if depth == 0 {\n   293\t                    self.step();\n   294\t                    return Ok(Protos::Opaque {\n   295\t                        extent: Extent {\n   296\t                            start,\n   297\t                            end: self.offset,\n   298\t                        },\n   299\t                        boundary,\n   300\t                        content,\n   301\t                    });\n   302\t                }\n   303\t                content.push(glyph);\n   304\t                self.step();\n   305\t                continue;\n   306\t            }\n   307\t            content.push(glyph);\n   308\t            self.step();\n   309\t        }\n   310\t    }\n   311\t    fn bare_or_headed(&mut self) -> Result<Protos, Error> {\n   312\t        let start = self.offset;\n   313\t        let run_end = self.text[start..]\n   314\t            .char_indices()\n   315\t            .find_map(|(relative, glyph)| {\n   316\t                (glyph.is_whitespace()\n   317\t                    || matches!(\n   318\t                        glyph,\n   319\t                        '{' | '}' | '[' | ']' | '<' | '>' | '«' | '»' | '(' | ')' | ';'\n   320\t                    ))\n   321\t                .then_some(start + relative)\n   322\t            })\n   323\t            .unwrap_or(self.text.len());\n   324\t        let whole_run = &self.text[start..run_end];\n   325\t        let trailing_separators = whole_run\n   326\t            .chars()\n   327\t            .rev()\n   328\t            .take_while(|glyph| matches!(glyph, '.' | '!' | ':'))\n   329\t            .count();\n   330\t        let segments_are_symbols = whole_run\n   331\t            .split(['.', '!', ':'])\n   332\t            .all(|segment| !segment.is_empty());\n   333\t        let opens_body = trailing_separators == 1\n   334\t            && whole_run[..whole_run.len() - 1]\n   335\t                .split(['.', '!', ':'])\n   336\t                .all(|segment| !segment.is_empty())\n   337\t            && self.text[run_end..]\n   338\t                .chars()\n   339\t                .next()\n   340\t                .is_some_and(|glyph| matches!(glyph, '{' | '[' | '<' | '«' | '('));\n   341\t        if !segments_are_symbols && !opens_body {\n   342\t            self.offset = run_end;\n   343\t            return Ok(Protos::Bare {\n   344\t                extent: Extent {\n   345\t                    start,\n   346\t                    end: self.offset,\n   347\t                },\n   348\t                text: whole_run.to_owned(),\n   349\t            });\n   350\t        }\n   351\t        let mut run = String::new();\n   352\t        while let Some(glyph) = self.glyph() {\n   353\t            if glyph.is_whitespace()\n   354\t                || matches!(\n   355\t                    glyph,\n   356\t                    '{' | '}' | '[' | ']' | '>' | '«' | '»' | '(' | ')' | ';'\n   357\t                )\n   358\t            {\n   359\t                break;\n   360\t            }\n   361\t            if matches!(glyph, '.' | '!' | ':') {\n   362\t                let separator = match glyph {\n   363\t                    '.' => Separator::Period,\n   364\t                    '!' => Separator::Exclamation,\n   365\t                    _ => Separator::Colon,\n   366\t                };\n   367\t                if run.is_empty() {\n   368\t                    return Err(self.failure(Problem::MissingHead, start));\n   369\t                }\n   370\t                self.step();\n   371\t                if self.glyph().is_none()\n   372\t                    || self.glyph().is_some_and(|next| {\n   373\t                        next.is_whitespace() || matches!(next, '}' | ']' | '>' | '»' | ')')\n   374\t                    })\n   375\t                {\n   376\t                    return Err(self.failure(Problem::MissingBody, self.offset));\n   377\t                }\n   378\t                return self.headed(Symbol(run), None, start, separator);\n   379\t            }\n   380\t            if glyph == '<' {\n   381\t                if run.is_empty() {\n   382\t                    return Err(self.failure(Problem::MissingHead, start));\n   383\t                }\n   384\t                let angle_start = self.offset;\n   385\t                let remaining = self.budget.remaining;\n   386\t                let constraints = self.enclosed(Enclosure::Angled)?;\n   387\t                let separator = match self.glyph() {\n   388\t                    Some('.') => Separator::Period,\n   389\t                    Some('!') => Separator::Exclamation,\n   390\t                    Some(':') => Separator::Colon,\n   391\t                    _ => {\n   392\t                        self.offset = angle_start;\n   393\t                        self.budget.remaining = remaining;\n   394\t                        return Ok(Protos::Bare {\n   395\t                            extent: Extent {\n   396\t                                start,\n   397\t                                end: angle_start,\n   398\t                            },\n   399\t                            text: run,\n   400\t                        });\n   401\t                    }\n   402\t                };\n   403\t                self.step();\n   404\t                if self.glyph().is_none()\n   405\t                    || self.glyph().is_some_and(|next| {\n   406\t                        next.is_whitespace() || matches!(next, '}' | ']' | '>' | '»' | ')')\n   407\t                    })\n   408\t                {\n   409\t                    return Err(self.failure(Problem::MissingBody, self.offset));\n   410\t                }\n   411\t                return self.headed(Symbol(run), Some(constraints), start, separator);\n   412\t            }\n   413\t            run.push(glyph);\n   414\t            self.step();\n   415\t        }\n   416\t        if run.is_empty() {\n   417\t            Err(self.failure(Problem::MissingBody, start))\n   418\t        } else {\n   419\t            Ok(Protos::Bare {\n   420\t                extent: Extent {\n   421\t                    start,\n   422\t                    end: self.offset,\n   423\t                },\n   424\t                text: run,\n   425\t            })\n   426\t        }\n   427\t    }\n   428\t    fn headed(\n   429\t        &mut self,\n   430\t        head: Symbol,\n   431\t        constraints: Option<Protos>,\n   432\t        start: usize,\n   433\t        separator: Separator,\n   434\t    ) -> Result<Protos, Error> {\n   435\t        let body = self.node()?;\n   436\t        Ok(Protos::Headed {\n   437\t            extent: Extent {\n   438\t                start,\n   439\t                end: body.extent().end,\n   440\t            },\n   441\t            head,\n   442\t            constraints: constraints.map(Box::new),\n   443\t            separator,\n   444\t            body: Box::new(body),\n   445\t        })\n   446\t    }\n   447\t    fn space(&mut self) {\n   448\t        loop {\n   449\t            while self.glyph().is_some_and(char::is_whitespace) {\n   450\t                self.step();\n   451\t            }\n   452\t            if self.glyph() != Some(';') {\n   453\t                return;\n   454\t            }\n   455\t            while self.glyph().is_some_and(|glyph| glyph != '\\n') {\n   456\t                self.step();\n   457\t            }\n   458\t        }\n   459\t    }\n   460\t    fn glyph(&self) -> Option<char> {\n   461\t        self.text.get(self.offset..)?.chars().next()\n   462\t    }\n   463\t    fn step(&mut self) {\n   464\t        if let Some(glyph) = self.glyph() {\n   465\t            self.offset += glyph.len_utf8();\n   466\t        }\n   467\t    }\n   468\t    fn failure(&self, problem: Problem, start: usize) -> Error {\n   469\t        Error {\n   470\t            extent: Extent {\n   471\t                start,\n   472\t                end: self.offset,\n   473\t            },\n   474\t            problem,\n   475\t        }\n   476\t    }\n   477\t}\n   478\timpl Protosizable for String {\n   479\t    type Output = Result<Protos, Error>;\n   480\t    fn protosize(&self) -> Self::Output {\n   481\t        let mut budget = ReaderBudget { remaining: 4_096 };\n   482\t        self.protosize_with(&mut budget)\n   483\t    }\n   484\t}\n   485\timpl BoundedProtosizable for String {\n   486\t    fn protosize_with(&self, budget: &mut ReaderBudget) -> Result<Protos, Error> {\n   487\t        Reader {\n   488\t            text: self,\n   489\t            offset: 0,\n   490\t            budget,\n   491\t            depth: 0,\n   492\t        }\n   493\t        .whole()\n   494\t    }\n   495\t}\n   496\timpl Protosizable for str {\n   497\t    type Output = Result<Protos, Error>;\n   498\t    fn protosize(&self) -> Self::Output {\n   499\t        let mut budget = ReaderBudget { remaining: 4_096 };\n   500\t        self.protosize_with(&mut budget)\n   501\t    }\n   502\t}\n   503\timpl BoundedProtosizable for str {\n   504\t    fn protosize_with(&self, budget: &mut ReaderBudget) -> Result<Protos, Error> {\n   505\t        Reader {\n   506\t            text: self,\n   507\t            offset: 0,\n   508\t            budget,\n   509\t            depth: 0,\n   510\t        }\n   511\t        .whole()\n   512\t    }\n   513\t}\n   514\tenum PrintStep<'a> {\n   515\t    Form(&'a Protos),\n   516\t    Text(&'a str),\n   517\t    Glyph(char),\n   518\t    Space,\n   519\t}\n   520\ttrait Printing {\n   521\t    fn print(&self, out: &mut String);\n   522\t}\n   523\timpl Printing for Protos {\n   524\t    fn print(&self, out: &mut String) {\n   525\t        let mut steps = vec![PrintStep::Form(self)];\n   526\t        while let Some(step) = steps.pop() {\n   527\t            match step {\n   528\t                PrintStep::Text(text) => out.push_str(text),\n   529\t                PrintStep::Glyph(glyph) => out.push(glyph),\n   530\t                PrintStep::Space => out.push(' '),\n   531\t                PrintStep::Form(form) => match form {\n   532\t                    Self::Bare { text, .. } => out.push_str(text),\n   533\t                    Self::Opaque {\n   534\t                        boundary, content, ..\n   535\t                    } => {\n   536\t                        out.push(boundary.opener());\n   537\t                        if *boundary == Boundary::Guillemets {\n   538\t                            for glyph in content.chars() {\n   539\t                                if glyph == '»' {\n   540\t                                    out.push('\\\\');\n   541\t                                }\n   542\t                                out.push(glyph);\n   543\t                            }\n   544\t                        } else {\n   545\t                            let mut opens = Vec::new();\n   546\t                            let mut escaped = Vec::new();\n   547\t                            for (index, glyph) in content.char_indices() {\n   548\t                                if glyph == '(' {\n   549\t                                    opens.push(index);\n   550\t                                } else if glyph == ')' && opens.pop().is_none() {\n   551\t                                    escaped.push(index);\n   552\t                                }\n   553\t                            }\n   554\t                            escaped.extend(opens);\n   555\t                            let glyphs: Vec<_> = content.char_indices().collect();\n   556\t                            for (position, (index, glyph)) in glyphs.iter().enumerate() {\n   557\t                                let next = glyphs.get(position + 1).map(|(_, glyph)| *glyph);\n   558\t                                if (*glyph == '\\\\' && matches!(next, None | Some('\\\\' | '(' | ')')))\n   559\t                                    || escaped.contains(index)\n   560\t                                {\n   561\t                                    out.push('\\\\');\n   562\t                                }\n   563\t                                out.push(*glyph);\n   564\t                            }\n   565\t                        }\n   566\t                        out.push(boundary.closer());\n   567\t                    }\n   568\t                    Self::Enclosed {\n   569\t                        enclosure,\n   570\t                        children,\n   571\t                        ..\n   572\t                    } => {\n   573\t                        out.push(enclosure.opener());\n   574\t                        steps.push(PrintStep::Glyph(enclosure.closer()));\n   575\t                        if !children.is_empty() {\n   576\t                            if *enclosure != Enclosure::Angled {\n   577\t                                steps.push(PrintStep::Space);\n   578\t                            }\n   579\t                            for (index, child) in children.iter().enumerate().rev() {\n   580\t                                steps.push(PrintStep::Form(child));\n   581\t                                if index > 0 {\n   582\t                                    steps.push(PrintStep::Space);\n   583\t                                }\n   584\t                            }\n   585\t                            if *enclosure != Enclosure::Angled {\n   586\t                                steps.push(PrintStep::Space);\n   587\t                            }\n   588\t                        }\n   589\t                    }\n   590\t                    Self::Headed {\n   591\t                        head,\n   592\t                        constraints,\n   593\t                        separator,\n   594\t                        body,\n   595\t                        ..\n   596\t                    } => {\n   597\t                        steps.push(PrintStep::Form(body));\n   598\t                        steps.push(PrintStep::Glyph(separator.glyph()));\n   599\t                        if let Some(constraints) = constraints {\n   600\t                            steps.push(PrintStep::Form(constraints));\n   601\t                        }\n   602\t                        steps.push(PrintStep::Text(&head.0));\n   603\t                    }\n   604\t                },\n   605\t            }\n   606\t        }\n   607\t    }\n   608\t}\n   609\timpl Textualizable for Protos {\n   610\t    fn textualize(&self) -> String {\n   611\t        let mut out = String::new();\n   612\t        self.print(&mut out);\n   613\t        out\n   614\t    }\n   615\t}\n   616\tenum CanonicalStep<'a> {\n   617\t    Form(&'a mut Protos),\n   618\t    Text(&'a str),\n   619\t    Glyph(char),\n   620\t    Space,\n   621\t    End(&'a mut Extent),\n   622\t}\n   623\ttrait CanonicalizingTree {\n   624\t    fn canonicalize_tree(&mut self);\n   625\t}\n   626\timpl CanonicalizingTree for Protos {\n   627\t    fn canonicalize_tree(&mut self) {\n   628\t        let mut offset = 0;\n   629\t        let mut steps = vec![CanonicalStep::Form(self)];\n   630\t        while let Some(step) = steps.pop() {\n   631\t            match step {\n   632\t                CanonicalStep::Text(text) => offset += text.len(),\n   633\t                CanonicalStep::Glyph(glyph) => offset += glyph.len_utf8(),\n   634\t                CanonicalStep::Space => offset += ' '.len_utf8(),\n   635\t                CanonicalStep::End(extent) => extent.end = offset,\n   636\t                CanonicalStep::Form(form) => match form {\n   637\t                    Self::Bare { extent, text } => {\n   638\t                        extent.start = offset;\n   639\t                        offset += text.len();\n   640\t                        extent.end = offset;\n   641\t                    }\n   642\t                    Self::Opaque {\n   643\t                        extent,\n   644\t                        boundary,\n   645\t                        content,\n   646\t                    } => {\n   647\t                        extent.start = offset;\n   648\t                        // Opaque nodes are leaves, so the shared writer is\n   649\t                        // bounded by their content and cannot traverse a tree.\n   650\t                        let opaque = Self::Opaque {\n   651\t                            extent: *extent,\n   652\t                            boundary: *boundary,\n   653\t                            content: content.clone(),\n   654\t                        };\n   655\t                        offset += opaque.textualize().len();\n   656\t                        extent.end = offset;\n   657\t                    }\n   658\t                    Self::Enclosed {\n   659\t                        extent,\n   660\t                        enclosure,\n   661\t                        children,\n   662\t                    } => {\n   663\t                        extent.start = offset;\n   664\t                        offset += enclosure.opener().len_utf8();\n   665\t                        steps.push(CanonicalStep::End(extent));\n   666\t                        steps.push(CanonicalStep::Glyph(enclosure.closer()));\n   667\t                        if !children.is_empty() {\n   668\t                            if *enclosure != Enclosure::Angled {\n   669\t                                steps.push(CanonicalStep::Space);\n   670\t                            }\n   671\t                            for (index, child) in children.iter_mut().enumerate().rev() {\n   672\t                                steps.push(CanonicalStep::Form(child));\n   673\t                                if index > 0 {\n   674\t                                    steps.push(CanonicalStep::Space);\n   675\t                                }\n   676\t                            }\n   677\t                            if *enclosure != Enclosure::Angled {\n   678\t                                steps.push(CanonicalStep::Space);\n   679\t                            }\n   680\t                        }\n   681\t                    }\n   682\t                    Self::Headed {\n   683\t                        extent,\n   684\t                        head,\n   685\t                        constraints,\n   686\t                        separator,\n   687\t                        body,\n   688\t                    } => {\n   689\t                        extent.start = offset;\n   690\t                        steps.push(CanonicalStep::End(extent));\n   691\t                        steps.push(CanonicalStep::Form(body));\n   692\t                        steps.push(CanonicalStep::Glyph(separator.glyph()));\n   693\t                        if let Some(constraints) = constraints {\n   694\t                            steps.push(CanonicalStep::Form(constraints));\n   695\t                        }\n   696\t                        steps.push(CanonicalStep::Text(&head.0));\n   697\t                    }\n   698\t                },\n   699\t            }\n   700\t        }\n   701\t    }\n   702\t}\n   703\timpl Canonicalizable for Protos {\n   704\t    fn canonicalize(&mut self) {\n   705\t        self.canonicalize_tree();\n   706\t    }\n   707\t}\n   708\timpl fmt::Display for Error {\n   709\t    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n   710\t        write!(\n   711\t            formatter,\n   712\t            \"structural error at {}..{}: {:?}\",\n   713\t            self.extent.start, self.extent.end, self.problem\n   714\t        )\n   715\t    }\n   716\t}\n   717\timpl std::error::Error for Error {}\n     1\t//! Iterative destruction for structural trees.\n     2\t\n     3\tuse crate::{Extent, Protos};\n     4\t\n     5\ttrait Emptying {\n     6\t    fn empty() -> Self;\n     7\t}\n     8\t\n     9\timpl Emptying for Protos {\n    10\t    fn empty() -> Self {\n    11\t        Self::Bare {\n    12\t            extent: Extent { start: 0, end: 0 },\n    13\t            text: String::new(),\n    14\t        }\n    15\t    }\n    16\t}\n    17\t\n    18\ttrait Shedding {\n    19\t    fn shed(&mut self, work: &mut Vec<Protos>);\n    20\t}\n    21\t\n    22\timpl Shedding for Protos {\n    23\t    fn shed(&mut self, work: &mut Vec<Protos>) {\n    24\t        match self {\n    25\t            Self::Headed {\n    26\t                constraints, body, ..\n    27\t            } => {\n    28\t                if let Some(constraints) = constraints.take() {\n    29\t                    work.push(*constraints);\n    30\t                }\n    31\t                work.push(*std::mem::replace(body, Box::new(Self::empty())));\n    32\t            }\n    33\t            Self::Enclosed { children, .. } => work.append(children),\n    34\t            Self::Opaque { .. } | Self::Bare { .. } => {}\n    35\t        }\n    36\t    }\n    37\t}\n    38\t\n    39\timpl Drop for Protos {\n    40\t    fn drop(&mut self) {\n    41\t        let mut work = Vec::new();\n    42\t        self.shed(&mut work);\n    43\t        while let Some(mut form) = work.pop() {\n    44\t            form.shed(&mut work);\n    45\t        }\n    46\t    }\n    47\t}\n     1\tuse protos::{\n     2\t    Boundary, BoundedProtosizable, Canonicalizable, Enclosure, Extent, Protos, Protosizable,\n     3\t    ReaderBudget, Separator, Symbol, Textualizable,\n     4\t};\n     5\tuse std::process::Command;\n     6\t\n     7\tfn form_extent(form: &Protos) -> Extent {\n     8\t    match form {\n     9\t        Protos::Headed { extent, .. }\n    10\t        | Protos::Enclosed { extent, .. }\n    11\t        | Protos::Opaque { extent, .. }\n    12\t        | Protos::Bare { extent, .. } => *extent,\n    13\t    }\n    14\t}\n    15\t#[test]\n    16\tfn structural_forms_keep_their_own_extents() {\n    17\t    let form = \"Reviewer.{ 2024 17 }\".protosize().expect(\"structure\");\n    18\t    assert_eq!(form.textualize(), \"Reviewer.{ 2024 17 }\");\n    19\t    let Protos::Headed { body, .. } = &form else {\n    20\t        panic!(\"headed\")\n    21\t    };\n    22\t    let Protos::Enclosed {\n    23\t        enclosure,\n    24\t        children,\n    25\t        ..\n    26\t    } = body.as_ref()\n    27\t    else {\n    28\t        panic!(\"enclosed\")\n    29\t    };\n    30\t    assert_eq!(*enclosure, Enclosure::Braced);\n    31\t    assert_eq!(children.len(), 2);\n    32\t}\n    33\t\n    34\t#[test]\n    35\tfn invalid_separator_chains_remain_one_bare_run() {\n    36\t    for text in [\n    37\t        \"a.\",\n    38\t        \".a\",\n    39\t        \"a..b\",\n    40\t        \"a.b.\",\n    41\t        \"..\",\n    42\t        \".codex/agents/worker.toml\",\n    43\t        \".猫/龍.\",\n    44\t    ] {\n    45\t        let form = text.protosize().expect(\"bare run\");\n    46\t        assert!(\n    47\t            matches!(&form, Protos::Bare { text: value, .. } if value == text),\n    48\t            \"{text}: {form:?}\"\n    49\t        );\n    50\t        assert_eq!(form.textualize(), text);\n    51\t    }\n    52\t}\n    53\t\n    54\t#[test]\n    55\tfn complete_separator_chains_remain_headed_with_exact_extents() {\n    56\t    for text in [\n    57\t        \"lower.case\",\n    58\t        \"Upper.Case\",\n    59\t        \"a:b:c\",\n    60\t        \"a!b!c\",\n    61\t        \"https://example.org/a\",\n    62\t        \"猫.龍\",\n    63\t        \"Observed.Locks.[]\",\n    64\t        \"Reviewer.{ 2024 17 }\",\n    65\t        \"Some.(x)\",\n    66\t    ] {\n    67\t        let form = text.protosize().expect(\"headed structure\");\n    68\t        assert!(matches!(&form, Protos::Headed { .. }), \"{text}: {form:?}\");\n    69\t        assert_eq!(\n    70\t            form_extent(&form),\n    71\t            Extent {\n    72\t                start: 0,\n    73\t                end: text.len()\n    74\t            }\n    75\t        );\n    76\t        assert_eq!(form.textualize(), text);\n    77\t    }\n    78\t}\n    79\t\n    80\t#[test]\n    81\tfn opaque_guillemets_escape_their_closer() {\n    82\t    let form = \"«she said \\\\»no\\\\» and left»\".protosize().expect(\"string\");\n    83\t    assert_eq!(form.textualize(), \"«she said \\\\»no\\\\» and left»\");\n    84\t    assert!(matches!(\n    85\t        form,\n    86\t        Protos::Opaque {\n    87\t            boundary: Boundary::Guillemets,\n    88\t            ..\n    89\t        }\n    90\t    ));\n    91\t}\n    92\t\n    93\t#[test]\n    94\tfn a_guillemet_escape_does_not_consume_an_ordinary_backslash() {\n    95\t    let form = \"«path\\\\segment»\".protosize().expect(\"string\");\n    96\t    assert_eq!(form.textualize(), \"«path\\\\segment»\");\n    97\t}\n    98\t\n    99\t#[test]\n   100\tfn parentheses_are_one_balanced_opaque_structure() {\n   101\t    let form = \"(a (b))\".protosize().expect(\"meaning structure\");\n   102\t    assert_eq!(form.textualize(), \"(a (b))\");\n   103\t    assert!(matches!(\n   104\t        form,\n   105\t        Protos::Opaque {\n   106\t            boundary: Boundary::Parentheses,\n   107\t            ..\n   108\t        }\n   109\t    ));\n   110\t}\n   111\t\n   112\t#[test]\n   113\tfn parentheses_escape_their_structural_glyphs() {\n   114\t    for text in [\"(x\\\\))\", \"(\\\\()\"] {\n   115\t        let form = text.protosize().expect(\"escaped meaning\");\n   116\t        assert_eq!(form.textualize(), text);\n   117\t    }\n   118\t}\n   119\t\n   120\t#[test]\n   121\tfn a_meaning_keeps_an_ordinary_backslash() {\n   122\t    let form = \"(path\\\\segment)\".protosize().expect(\"meaning\");\n   123\t    assert_eq!(form.textualize(), \"(path\\\\segment)\");\n   124\t    assert!(matches!(\n   125\t        &form,\n   126\t        Protos::Opaque { content, .. } if content == \"path\\\\segment\"\n   127\t    ));\n   128\t}\n   129\t\n   130\t#[test]\n   131\tfn reader_budget_bounds_recursive_descent() {\n   132\t    let mut budget = ReaderBudget { remaining: 2 };\n   133\t    assert!(\"{ { Ada } }\".protosize_with(&mut budget).is_err());\n   134\t}\n   135\t\n   136\t#[test]\n   137\tfn bounded_depth_probe_child() {\n   138\t    if std::env::var_os(\"PROTOS_DEPTH_PROBE\").is_none() {\n   139\t        return;\n   140\t    }\n   141\t    let text = format!(\"{}Ada{}\", \"{\".repeat(100_001), \"}\".repeat(100_001));\n   142\t    let mut budget = ReaderBudget { remaining: 100_002 };\n   143\t    assert!(text.protosize_with(&mut budget).is_err());\n   144\t}\n   145\t\n   146\t#[test]\n   147\tfn depth_is_bounded_independently_of_node_budget() {\n   148\t    let text = format!(\"[ {}]\", \"Ada \".repeat(10_000));\n   149\t    let mut budget = ReaderBudget { remaining: 10_001 };\n   150\t    let form = text.protosize_with(&mut budget).expect(\"wide structure\");\n   151\t    assert!(matches!(&form, Protos::Enclosed { children, .. } if children.len() == 10_000));\n   152\t}\n   153\t\n   154\t#[test]\n   155\tfn deeply_constructed_forms_print_without_recursion() {\n   156\t    let mut form = Protos::Bare {\n   157\t        extent: protos::Extent { start: 0, end: 1 },\n   158\t        text: String::from(\"Ada\"),\n   159\t    };\n   160\t    for _ in 0..100_001 {\n   161\t        form = Protos::Headed {\n   162\t            extent: protos::Extent { start: 0, end: 1 },\n   163\t            head: protos::Symbol(String::from(\"A\")),\n   164\t            constraints: None,\n   165\t            separator: protos::Separator::Period,\n   166\t            body: Box::new(form),\n   167\t        };\n   168\t    }\n   169\t    let text = form.textualize();\n   170\t    assert_eq!(text.len(), 200_005);\n   171\t    assert!(text.ends_with(\"Ada\"));\n   172\t    drop(form);\n   173\t}\n   174\t\n   175\t#[test]\n   176\tfn deeply_constructed_forms_drop_without_recursion() {\n   177\t    let mut form = Protos::Bare {\n   178\t        extent: protos::Extent { start: 0, end: 1 },\n   179\t        text: String::from(\"Ada\"),\n   180\t    };\n   181\t    for _ in 0..100_000 {\n   182\t        form = Protos::Headed {\n   183\t            extent: protos::Extent { start: 0, end: 1 },\n   184\t            head: protos::Symbol(String::from(\"A\")),\n   185\t            constraints: None,\n   186\t            separator: protos::Separator::Period,\n   187\t            body: Box::new(form),\n   188\t        };\n   189\t    }\n   190\t    drop(form);\n   191\t}\n   192\t\n   193\t#[test]\n   194\tfn canonicalization_assigns_utf8_extents_without_reading() {\n   195\t    let mut form = Protos::Headed {\n   196\t        extent: Extent { start: 99, end: 99 },\n   197\t        head: Symbol(\"H\".into()),\n   198\t        constraints: Some(Box::new(Protos::Enclosed {\n   199\t            extent: Extent { start: 99, end: 99 },\n   200\t            enclosure: Enclosure::Angled,\n   201\t            children: vec![\n   202\t                Protos::Bare {\n   203\t                    extent: Extent { start: 99, end: 99 },\n   204\t                    text: \"A\".into(),\n   205\t                },\n   206\t                Protos::Bare {\n   207\t                    extent: Extent { start: 99, end: 99 },\n   208\t                    text: \"B\".into(),\n   209\t                },\n   210\t            ],\n   211\t        })),\n   212\t        separator: Separator::Period,\n   213\t        body: Box::new(Protos::Enclosed {\n   214\t            extent: Extent { start: 99, end: 99 },\n   215\t            enclosure: Enclosure::Braced,\n   216\t            children: vec![\n   217\t                Protos::Opaque {\n   218\t                    extent: Extent { start: 99, end: 99 },\n   219\t                    boundary: Boundary::Guillemets,\n   220\t                    content: \"é»\".into(),\n   221\t                },\n   222\t                Protos::Opaque {\n   223\t                    extent: Extent { start: 99, end: 99 },\n   224\t                    boundary: Boundary::Parentheses,\n   225\t                    content: \"x)\".into(),\n   226\t                },\n   227\t                Protos::Enclosed {\n   228\t                    extent: Extent { start: 99, end: 99 },\n   229\t                    enclosure: Enclosure::Bracketed,\n   230\t                    children: vec![],\n   231\t                },\n   232\t            ],\n   233\t        }),\n   234\t    };\n   235\t    form.canonicalize();\n   236\t    let text = form.textualize();\n   237\t    assert_eq!(text, \"H<A B>.{ «é\\\\»» (x\\\\)) [] }\");\n   238\t    let Protos::Headed {\n   239\t        extent,\n   240\t        constraints: Some(constraints),\n   241\t        body,\n   242\t        ..\n   243\t    } = &form\n   244\t    else {\n   245\t        panic!(\"headed form\")\n   246\t    };\n   247\t    assert_eq!(&text[extent.start..extent.end], text);\n   248\t    let constraints_extent = form_extent(constraints);\n   249\t    assert_eq!(\n   250\t        &text[constraints_extent.start..constraints_extent.end],\n   251\t        \"<A B>\"\n   252\t    );\n   253\t    let Protos::Enclosed {\n   254\t        extent, children, ..\n   255\t    } = body.as_ref()\n   256\t    else {\n   257\t        panic!(\"braced body\")\n   258\t    };\n   259\t    assert_eq!(&text[extent.start..extent.end], \"{ «é\\\\»» (x\\\\)) [] }\");\n   260\t    for (child, expected) in children.iter().zip([\"«é\\\\»»\", \"(x\\\\))\", \"[]\"]) {\n   261\t        let child_extent = form_extent(child);\n   262\t        assert_eq!(&text[child_extent.start..child_extent.end], expected);\n   263\t    }\n   264\t}\n   265\t\n   266\t#[test]\n   267\tfn canonicalization_is_iterative_for_wide_and_deep_structures() {\n   268\t    let mut wide = Protos::Enclosed {\n   269\t        extent: Extent { start: 0, end: 0 },\n   270\t        enclosure: Enclosure::Bracketed,\n   271\t        children: (0..5_000)\n   272\t            .map(|_| Protos::Bare {\n   273\t                extent: Extent { start: 0, end: 0 },\n   274\t                text: \"é\".into(),\n   275\t            })\n   276\t            .collect(),\n   277\t    };\n   278\t    wide.canonicalize();\n   279\t    let wide_text = wide.textualize();\n   280\t    assert_eq!(form_extent(&wide).end, wide_text.len());\n   281\t\n   282\t    let mut deep = Protos::Bare {\n   283\t        extent: Extent { start: 0, end: 0 },\n   284\t        text: \"x\".into(),\n   285\t    };\n   286\t    for _ in 0..100_000 {\n   287\t        deep = Protos::Headed {\n   288\t            extent: Extent { start: 0, end: 0 },\n   289\t            head: Symbol(\"V\".into()),\n   290\t            constraints: None,\n   291\t            separator: Separator::Period,\n   292\t            body: Box::new(deep),\n   293\t        };\n   294\t    }\n   295\t    deep.canonicalize();\n   296\t    assert_eq!(\n   297\t        form_extent(&deep),\n   298\t        Extent {\n   299\t            start: 0,\n   300\t            end: 200_001\n   301\t        }\n   302\t    );\n   303\t    drop(deep);\n   304\t}\n   305\t\n   306\t#[test]\n   307\tfn depth_probe_is_bounded_by_memory_and_time() {\n   308\t    let executable = std::env::current_exe().expect(\"test executable\");\n   309\t    let output = Command::new(\"sh\")\n   310\t        .arg(\"-c\")\n   311\t        .arg(\"ulimit -v 262144; exec timeout 30 \\\"$0\\\" \\\"$@\\\"\")\n   312\t        .arg(executable)\n   313\t        .arg(\"--exact\")\n   314\t        .arg(\"bounded_depth_probe_child\")\n   315\t        .arg(\"--nocapture\")\n   316\t        .env(\"PROTOS_DEPTH_PROBE\", \"1\")\n   317\t        .output()\n   318\t        .expect(\"bounded child process\");\n   319\t    assert!(\n   320\t        output.status.success(),\n   321\t        \"deep reader probe failed: {}\\n{}\",\n   322\t        output.status,\n   323\t        String::from_utf8_lossy(&output.stderr)\n   324\t    );\n   325\t}\n   326\t\n   327\t#[test]\n   328\tfn angle_brackets_remain_structural() {\n   329\t    let form = \"<Thing Other>\".protosize().expect(\"structural angle\");\n   330\t    assert_eq!(form.textualize(), \"<Thing Other>\");\n   331\t    assert!(matches!(\n   332\t        form,\n   333\t        Protos::Enclosed {\n   334\t            enclosure: Enclosure::Angled,\n   335\t            ..\n   336\t        }\n   337\t    ));\n   338\t}\n   339\t\n   340\t#[test]\n   341\tfn qualified_names_are_one_structural_form() {\n   342\t    let text = \"Processable<[Clonable Sendable] Serializable>.[ Vector<String> ]\";\n   343\t    let form = text.protosize().expect(\"qualified headed form\");\n   344\t    assert_eq!(\n   345\t        form.textualize(),\n   346\t        \"Processable<[ Clonable Sendable ] Serializable>.[ Vector <String> ]\"\n   347\t    );\n   348\t    let Protos::Headed {\n   349\t        head,\n   350\t        constraints: Some(constraints),\n   351\t        body,\n   352\t        ..\n   353\t    } = &form\n   354\t    else {\n   355\t        panic!(\"qualified heading\")\n   356\t    };\n   357\t    assert_eq!(head.0, \"Processable\");\n   358\t    assert!(matches!(\n   359\t        constraints.as_ref(),\n   360\t        Protos::Enclosed { enclosure: Enclosure::Angled, children, .. }\n   361\t        if children.len() == 2\n   362\t    ));\n   363\t    assert!(matches!(\n   364\t        body.as_ref(),\n   365\t        Protos::Enclosed { children, .. }\n   366\t        if matches!(children.as_slice(), [Protos::Bare { text, .. }, Protos::Enclosed { enclosure: Enclosure::Angled, .. }] if text == \"Vector\")\n   367\t    ));\n   368\t}\n     1\t//! Reading: every rule of the reader, every fault, every extent.\n     2\t\n     3\tuse protos::{\n     4\t    Bare, Boundary, Delineation, Enclosure, Extent, Fault, Head, Locating, Opaque, Problem,\n     5\t    Protoform, Protosizable, Separator, Situated, Situation, Symbol,\n     6\t};\n     7\t\n     8\tfn sym(s: &str) -> Head {\n     9\t    Head::Symbol(Symbol::try_from(s).unwrap())\n    10\t}\n    11\tfn bare(s: &str) -> Protoform {\n    12\t    Protoform::Bare(Bare::try_from(s).unwrap())\n    13\t}\n    14\tfn headed(h: &str, sep: Separator, body: Protoform) -> Protoform {\n    15\t    Protoform::Headed(sym(h), sep, Box::new(body))\n    16\t}\n    17\tfn dot(h: &str, body: Protoform) -> Protoform {\n    18\t    headed(h, Separator::Period, body)\n    19\t}\n    20\tfn braced(children: Vec<Protoform>) -> Protoform {\n    21\t    Protoform::Enclosed(Enclosure::Braced, children)\n    22\t}\n    23\tfn bracketed(children: Vec<Protoform>) -> Protoform {\n    24\t    Protoform::Enclosed(Enclosure::Bracketed, children)\n    25\t}\n    26\tfn quoted(s: &str) -> Protoform {\n    27\t    Protoform::Quoted(protos::Text::try_from(s).unwrap())\n    28\t}\n    29\tfn parens(s: &str) -> Protoform {\n    30\t    Protoform::Parenthesized(Opaque::from(s))\n    31\t}\n    32\tfn qualified(s: &str, constraints: Vec<Protoform>) -> Head {\n    33\t    Head::Qualified(Symbol::try_from(s).unwrap(), constraints)\n    34\t}\n    35\t\n    36\tfn read(text: &str) -> Delineation {\n    37\t    text.protosize().unwrap()\n    38\t}\n    39\tfn forms(text: &str) -> Vec<Protoform> {\n    40\t    read(text)\n    41\t        .0\n    42\t        .into_iter()\n    43\t        .map(|Situated(_, form)| form)\n    44\t        .collect()\n    45\t}\n    46\tfn one(text: &str) -> Situated<Protoform> {\n    47\t    let mut all = read(text).0;\n    48\t    assert_eq!(all.len(), 1, \"{text:?} is one structure\");\n    49\t    all.pop().unwrap()\n    50\t}\n    51\tfn situation(text: &str) -> Situation {\n    52\t    one(text).0\n    53\t}\n    54\tfn fault(text: &str) -> Fault {\n    55\t    text.protosize().unwrap_err()\n    56\t}\n    57\t\n    58\t#[test]\n    59\tfn head_separator_body() {\n    60\t    assert_eq!(forms(\"Some.42\"), vec![dot(\"Some\", bare(\"42\"))]);\n    61\t    let s = situation(\"Some.42\");\n    62\t    assert_eq!(s.locate(&[]), Some(Extent(0, 7)));\n    63\t    assert_eq!(s.locate(&[0]), Some(Extent(0, 4)));\n    64\t    assert_eq!(s.locate(&[1]), Some(Extent(5, 7)));\n    65\t}\n    66\t\n    67\t#[test]\n    68\tfn chain_is_right_associative() {\n    69\t    assert_eq!(\n    70\t        forms(\"a:b:c\"),\n    71\t        vec![headed(\n    72\t            \"a\",\n    73\t            Separator::Colon,\n    74\t            headed(\"b\", Separator::Colon, bare(\"c\"))\n    75\t        )]\n    76\t    );\n    77\t    let s = situation(\"a:b:c\");\n    78\t    assert_eq!(s.locate(&[]), Some(Extent(0, 5)));\n    79\t    assert_eq!(s.locate(&[0]), Some(Extent(0, 1)));\n    80\t    assert_eq!(s.locate(&[1]), Some(Extent(2, 5)));\n    81\t    assert_eq!(s.locate(&[1, 0]), Some(Extent(2, 3)));\n    82\t    assert_eq!(s.locate(&[1, 1]), Some(Extent(4, 5)));\n    83\t    assert_eq!(s.locate(&[2]), None);\n    84\t    assert_eq!(\n    85\t        forms(\"a!b.c\"),\n    86\t        vec![headed(\"a\", Separator::Exclamation, dot(\"b\", bare(\"c\")))]\n    87\t    );\n    88\t}\n    89\t\n    90\t#[test]\n    91\tfn head_with_enclosed_body() {\n    92\t    let text = \"Reviewer.{ 2024 17 }\";\n    93\t    assert_eq!(\n    94\t        forms(text),\n    95\t        vec![dot(\"Reviewer\", braced(vec![bare(\"2024\"), bare(\"17\")]))]\n    96\t    );\n    97\t    let s = situation(text);\n    98\t    assert_eq!(s.locate(&[]), Some(Extent(0, 20)));\n    99\t    assert_eq!(s.locate(&[0]), Some(Extent(0, 8)));\n   100\t    assert_eq!(s.locate(&[1]), Some(Extent(9, 20)));\n   101\t    assert_eq!(s.locate(&[1, 0]), Some(Extent(11, 15)));\n   102\t    assert_eq!(s.locate(&[1, 1]), Some(Extent(16, 18)));\n   103\t}\n   104\t\n   105\t#[test]\n   106\tfn chain_with_enclosed_body() {\n   107\t    let text = \"Observed.Locks.[]\";\n   108\t    assert_eq!(\n   109\t        forms(text),\n   110\t        vec![dot(\"Observed\", dot(\"Locks\", bracketed(vec![])))]\n   111\t    );\n   112\t    let s = situation(text);\n   113\t    assert_eq!(s.locate(&[]), Some(Extent(0, 17)));\n   114\t    assert_eq!(s.locate(&[0]), Some(Extent(0, 8)));\n   115\t    assert_eq!(s.locate(&[1]), Some(Extent(9, 17)));\n   116\t    assert_eq!(s.locate(&[1, 0]), Some(Extent(9, 14)));\n   117\t    assert_eq!(s.locate(&[1, 1]), Some(Extent(15, 17)));\n   118\t}\n   119\t\n   120\t#[test]\n   121\tfn head_with_opaque_body() {\n   122\t    assert_eq!(forms(\"Some.(x)\"), vec![dot(\"Some\", parens(\"x\"))]);\n   123\t    assert_eq!(situation(\"Some.(x)\").locate(&[1]), Some(Extent(5, 8)));\n   124\t    assert_eq!(forms(\"Some.“x y”\"), vec![dot(\"Some\", quoted(\"x y\"))]);\n   125\t}\n   126\t\n   127\t#[test]\n   128\tfn runs_that_are_not_chains_stay_whole() {\n   129\t    for word in [\"a.\", \".a\", \"a..b\", \"-\", \"-42\", \"a.b.\", \"..\", \"2026-09-03\"] {\n   130\t        assert_eq!(forms(word), vec![bare(word)], \"{word:?}\");\n   131\t    }\n   132\t}\n   133\t\n   134\t#[test]\n   135\tfn a_timestamp_with_colons_is_a_colon_chain() {\n   136\t    assert_eq!(\n   137\t        forms(\"2026-09-03T17:46:20\"),\n   138\t        vec![headed(\n   139\t            \"2026-09-03T17\",\n   140\t            Separator::Colon,\n   141\t            headed(\"46\", Separator::Colon, bare(\"20\"))\n   142\t        )]\n   143\t    );\n   144\t}\n   145\t\n   146\t#[test]\n   147\tfn adjacency_without_one_trailing_separator_yields_siblings() {\n   148\t    assert_eq!(\n   149\t        forms(\"a..{ 1 }\"),\n   150\t        vec![bare(\"a..\"), braced(vec![bare(\"1\")])]\n   151\t    );\n   152\t    let d = read(\"a..{ 1 }\");\n   153\t    assert_eq!(d.0[0].0.locate(&[]), Some(Extent(0, 3)));\n   154\t    assert_eq!(d.0[1].0.locate(&[]), Some(Extent(3, 8)));\n   155\t    assert_eq!(\n   156\t        forms(\"a.{ 1 }.b\"),\n   157\t        vec![dot(\"a\", braced(vec![bare(\"1\")])), bare(\".b\")]\n   158\t    );\n   159\t    assert_eq!(forms(\"a{ 1 }\"), vec![bare(\"a\"), braced(vec![bare(\"1\")])]);\n   160\t    assert_eq!(\n   161\t        forms(\"a<b>c\"),\n   162\t        vec![\n   163\t            Protoform::Qualified(Symbol::try_from(\"a\").unwrap(), vec![bare(\"b\")]),\n   164\t            bare(\"c\")\n   165\t        ]\n   166\t    );\n   167\t}\n   168\t\n   169\t#[test]\n   170\tfn qualified_head_alone() {\n   171\t    let text = \"Vector<Text>\";\n   172\t    assert_eq!(\n   173\t        forms(text),\n   174\t        vec![Protoform::Qualified(\n   175\t            Symbol::try_from(\"Vector\").unwrap(),\n   176\t            vec![bare(\"Text\")]\n   177\t        )]\n   178\t    );\n   179\t    let s = situation(text);\n   180\t    assert_eq!(s.locate(&[]), Some(Extent(0, 12)));\n   181\t    assert_eq!(s.locate(&[0]), Some(Extent(7, 11)));\n   182\t    assert_eq!(\n   183\t        forms(\"Processable<[Clonable Sendable] Serializable>\"),\n   184\t        vec![Protoform::Qualified(\n   185\t            Symbol::try_from(\"Processable\").unwrap(),\n   186\t            vec![\n   187\t                bracketed(vec![bare(\"Clonable\"), bare(\"Sendable\")]),\n   188\t                bare(\"Serializable\")\n   189\t            ]\n   190\t        )]\n   191\t    );\n   192\t}\n   193\t\n   194\t#[test]\n   195\tfn qualified_head_with_body() {\n   196\t    let text = \"A<B>.{ 1 }\";\n   197\t    assert_eq!(\n   198\t        forms(text),\n   199\t        vec![Protoform::Headed(\n   200\t            qualified(\"A\", vec![bare(\"B\")]),\n   201\t            Separator::Period,\n   202\t            Box::new(braced(vec![bare(\"1\")]))\n   203\t        )]\n   204\t    );\n   205\t    let s = situation(text);\n   206\t    assert_eq!(s.locate(&[]), Some(Extent(0, 10)));\n   207\t    assert_eq!(s.locate(&[0]), Some(Extent(0, 4)));\n   208\t    assert_eq!(s.locate(&[0, 0]), Some(Extent(2, 3)));\n   209\t    assert_eq!(s.locate(&[1]), Some(Extent(5, 10)));\n   210\t    assert_eq!(s.locate(&[1, 0]), Some(Extent(7, 8)));\n   211\t    assert_eq!(\n   212\t        forms(\"A<B>.C\"),\n   213\t        vec![Protoform::Headed(\n   214\t            qualified(\"A\", vec![bare(\"B\")]),\n   215\t            Separator::Period,\n   216\t            Box::new(bare(\"C\"))\n   217\t        )]\n   218\t    );\n   219\t    assert_eq!(\n   220\t        forms(\"A.B<C>\"),\n   221\t        vec![dot(\n   222\t            \"A\",\n   223\t            Protoform::Qualified(Symbol::try_from(\"B\").unwrap(), vec![bare(\"C\")])\n   224\t        )]\n   225\t    );\n   226\t    assert_eq!(\n   227\t        forms(\"A<B>. C\"),\n   228\t        vec![\n   229\t            Protoform::Qualified(Symbol::try_from(\"A\").unwrap(), vec![bare(\"B\")]),\n   230\t            bare(\".\"),\n   231\t            bare(\"C\")\n   232\t        ]\n   233\t    );\n   234\t}\n   235\t\n   236\t#[test]\n   237\tfn curly_quotes_are_opaque() {\n   238\t    let text = \"“a { b” c\";\n   239\t    assert_eq!(forms(text), vec![quoted(\"a { b\"), bare(\"c\")]);\n   240\t    let d = read(text);\n   241\t    assert_eq!(d.0[0].0.locate(&[]), Some(Extent(0, 11)));\n   242\t    assert_eq!(d.0[1].0.locate(&[]), Some(Extent(12, 13)));\n   243\t    assert_eq!(forms(\"“”\"), vec![quoted(\"\")]);\n   244\t    assert_eq!(\n   245\t        forms(\"“ ; not a comment ”\"),\n   246\t        vec![quoted(\" ; not a comment \")]\n   247\t    );\n   248\t}\n   249\t\n   250\t#[test]\n   251\tfn parentheses_are_read_by_balance() {\n   252\t    assert_eq!(forms(\"(a (b) c)\"), vec![parens(\"a (b) c\")]);\n   253\t    assert_eq!(forms(\"(a \\\\) b)\"), vec![parens(\"a ) b\")]);\n   254\t    assert_eq!(forms(\"(a \\\\( b)\"), vec![parens(\"a ( b\")]);\n   255\t    assert_eq!(forms(\"(\\\\\\\\)\"), vec![parens(\"\\\\\")]);\n   256\t    assert_eq!(forms(\"(a\\\\x)\"), vec![parens(\"a\\\\x\")]);\n   257\t    assert_eq!(forms(\"()\"), vec![parens(\"\")]);\n   258\t    assert_eq!(forms(\"(a ; b)\"), vec![parens(\"a ; b\")]);\n   259\t    assert_eq!(forms(\"(a “ b)\"), vec![parens(\"a “ b\")]);\n   260\t    assert_eq!(forms(\"(a ” b)\"), vec![parens(\"a ” b\")]);\n   261\t}\n   262\t\n   263\t#[test]\n   264\tfn comments_run_to_end_of_line() {\n   265\t    assert_eq!(forms(\"a ; comment\\n b\"), vec![bare(\"a\"), bare(\"b\")]);\n   266\t    assert_eq!(\n   267\t        forms(\"{ 1 ; c }\\n 2 }\"),\n   268\t        vec![braced(vec![bare(\"1\"), bare(\"2\")])]\n   269\t    );\n   270\t    assert_eq!(forms(\"a;b\"), vec![bare(\"a\")]);\n   271\t}\n   272\t\n   273\t#[test]\n   274\tfn whitespace_and_emptiness() {\n   275\t    assert_eq!(forms(\"\"), vec![]);\n   276\t    assert_eq!(forms(\"  \\n\\t \"), vec![]);\n   277\t    assert_eq!(forms(\"{\\n\\t1\\r\\n}\"), vec![braced(vec![bare(\"1\")])]);\n   278\t    assert_eq!(forms(\"{}\"), vec![braced(vec![])]);\n   279\t    assert_eq!(forms(\"[  ]\"), vec![bracketed(vec![])]);\n   280\t}\n   281\t\n   282\t#[test]\n   283\tfn nested_enclosures_situated() {\n   284\t    let text = \"{ Ada 1990 { “12 Rue de la Paix” Paris 75002 } [ Author Reviewer.{ 2024 17 } ] }\";\n   285\t    let Situated(s, form) = one(text);\n   286\t    assert_eq!(\n   287\t        form,\n   288\t        braced(vec![\n   289\t            bare(\"Ada\"),\n   290\t            bare(\"1990\"),\n   291\t            braced(vec![\n   292\t                quoted(\"12 Rue de la Paix\"),\n   293\t                bare(\"Paris\"),\n   294\t                bare(\"75002\")\n   295\t            ]),\n   296\t            bracketed(vec![\n   297\t                bare(\"Author\"),\n   298\t                dot(\"Reviewer\", braced(vec![bare(\"2024\"), bare(\"17\")]))\n   299\t            ]),\n   300\t        ])\n   301\t    );\n   302\t    assert_eq!(s.locate(&[]), Some(Extent(0, text.len() as i64)));\n   303\t    let at = text.find(\"17\").unwrap() as i64;\n   304\t    assert_eq!(s.locate(&[3, 1, 1, 1]), Some(Extent(at, at + 2)));\n   305\t    assert_eq!(s.locate(&[3, 1, 0]), Some(Extent(60, 68)));\n   306\t    assert_eq!(s.locate(&[2, 0]), Some(Extent(13, 36)));\n   307\t}\n   308\t\n   309\t#[test]\n   310\tfn faults_are_situated() {\n   311\t    let f = fault(\"{ 1 \");\n   312\t    assert_eq!(\n   313\t        f,\n   314\t        Fault {\n   315\t            extent: Extent(0, 4),\n   316\t            problem: Problem::Unclosed(Enclosure::Braced)\n   317\t        }\n   318\t    );\n   319\t    assert_eq!(\n   320\t        fault(\"[ { 1 ] }\"),\n   321\t        Fault {\n   322\t            extent: Extent(6, 7),\n   323\t            problem: Problem::Unopened(Enclosure::Bracketed)\n   324\t        }\n   325\t    );\n   326\t    assert_eq!(\n   327\t        fault(\"}\"),\n   328\t        Fault {\n   329\t            extent: Extent(0, 1),\n   330\t            problem: Problem::Unopened(Enclosure::Braced)\n   331\t        }\n   332\t    );\n   333\t    assert_eq!(\n   334\t        fault(\"{ [ 1 }\"),\n   335\t        Fault {\n   336\t            extent: Extent(6, 7),\n   337\t            problem: Problem::Unopened(Enclosure::Braced)\n   338\t        }\n   339\t    );\n   340\t    assert_eq!(\n   341\t        fault(\"“abc\"),\n   342\t        Fault {\n   343\t            extent: Extent(0, 6),\n   344\t            problem: Problem::Unterminated(Boundary::CurlyQuotes)\n   345\t        }\n   346\t    );\n   347\t    assert_eq!(\n   348\t        fault(\"(a\"),\n   349\t        Fault {\n   350\t            extent: Extent(0, 2),\n   351\t            problem: Problem::Unterminated(Boundary::Parentheses)\n   352\t        }\n   353\t    );\n   354\t    assert_eq!(\n   355\t        fault(\"(a\\\\\"),\n   356\t        Fault {\n   357\t            extent: Extent(0, 3),\n   358\t            problem: Problem::Unterminated(Boundary::Parentheses)\n   359\t        }\n   360\t    );\n   361\t    assert_eq!(\n   362\t        fault(\"((a)\"),\n   363\t        Fault {\n   364\t            extent: Extent(0, 4),\n   365\t            problem: Problem::Unterminated(Boundary::Parentheses)\n   366\t        }\n   367\t    );\n   368\t    assert_eq!(\n   369\t        fault(\"a ” b\"),\n   370\t        Fault {\n   371\t            extent: Extent(2, 5),\n   372\t            problem: Problem::Stray(Boundary::CurlyQuotes)\n   373\t        }\n   374\t    );\n   375\t    assert_eq!(\n   376\t        fault(\")\"),\n   377\t        Fault {\n   378\t            extent: Extent(0, 1),\n   379\t            problem: Problem::Stray(Boundary::Parentheses)\n   380\t        }\n   381\t    );\n   382\t    assert_eq!(\n   383\t        fault(\"Some.{ 1 \"),\n   384\t        Fault {\n   385\t            extent: Extent(5, 9),\n   386\t            problem: Problem::Unclosed(Enclosure::Braced)\n   387\t        }\n   388\t    );\n   389\t    assert_eq!(\n   390\t        fault(\"A<B\"),\n   391\t        Fault {\n   392\t            extent: Extent(1, 3),\n   393\t            problem: Problem::Unclosed(Enclosure::Angled)\n   394\t        }\n   395\t    );\n   396\t}\n   397\t\n   398\t#[test]\n   399\tfn several_top_level_structures() {\n   400\t    let d = read(\"a { b } “c”\");\n   401\t    assert_eq!(d.0.len(), 3);\n   402\t    assert_eq!(d.0[1].0.locate(&[0]), Some(Extent(4, 5)));\n   403\t    assert_eq!(d.0[2].0.locate(&[]), Some(Extent(8, 15)));\n   404\t}\n   405\t\n   406\t#[test]\n   407\tfn a_string_protosizes_like_a_str() {\n   408\t    let owned = String::from(\"{ 1 }\");\n   409\t    assert_eq!(owned.protosize().unwrap(), \"{ 1 }\".protosize().unwrap());\n   410\t}\n     1\t//! Writing: canonical spacing, escapes, and extents computed as the writer writes.\n     2\t\n     3\tuse proptest::prelude::*;\n     4\tuse protos::{\n     5\t    Bare, Boundary, Delineation, Enclosure, Extent, Head, Locating, Opaque, Protoform,\n     6\t    Protosizable, Refusal, Separator, Situated, Situating, Symbol, Text, Textualizable, Word,\n     7\t};\n     8\t\n     9\tfn sym(s: &str) -> Head {\n    10\t    Head::Symbol(Symbol::try_from(s).unwrap())\n    11\t}\n    12\tfn bare(s: &str) -> Protoform {\n    13\t    Protoform::Bare(Bare::try_from(s).unwrap())\n    14\t}\n    15\tfn dot(h: &str, body: Protoform) -> Protoform {\n    16\t    Protoform::Headed(sym(h), Separator::Period, Box::new(body))\n    17\t}\n    18\tfn enclosed(e: Enclosure, children: Vec<Protoform>) -> Protoform {\n    19\t    Protoform::Enclosed(e, children)\n    20\t}\n    21\tfn opaque(b: Boundary, s: &str) -> Protoform {\n    22\t    match b {\n    23\t        Boundary::CurlyQuotes => Protoform::Quoted(Text::try_from(s).unwrap()),\n    24\t        Boundary::Parentheses => Protoform::Parenthesized(Opaque::from(s)),\n    25\t    }\n    26\t}\n    27\t\n    28\t/// The writer's situation must be the reader's situation of the written text.\n    29\tfn agrees(form: Protoform) -> String {\n    30\t    let Situated(written, text) = form.situate();\n    31\t    assert_eq!(form.textualize(), text);\n    32\t    let mut read = text.protosize().unwrap().0;\n    33\t    assert_eq!(read.len(), 1);\n    34\t    let Situated(found, form_again) = read.pop().unwrap();\n    35\t    assert_eq!(form_again, form);\n    36\t    assert_eq!(found, written, \"situation of {text:?}\");\n    37\t    text\n    38\t}\n    39\t\n    40\t#[test]\n    41\tfn canonical_spacing() {\n    42\t    assert_eq!(\n    43\t        agrees(enclosed(Enclosure::Braced, vec![bare(\"a\"), bare(\"b\")])),\n    44\t        \"{ a b }\"\n    45\t    );\n    46\t    assert_eq!(agrees(enclosed(Enclosure::Braced, vec![])), \"{}\");\n    47\t    assert_eq!(\n    48\t        agrees(enclosed(\n    49\t            Enclosure::Bracketed,\n    50\t            vec![bare(\"0\"), bare(\"42\"), bare(\"-42\")]\n    51\t        )),\n    52\t        \"[ 0 42 -42 ]\"\n    53\t    );\n    54\t    assert_eq!(agrees(enclosed(Enclosure::Bracketed, vec![])), \"[]\");\n    55\t    assert_eq!(\n    56\t        agrees(enclosed(Enclosure::Angled, vec![bare(\"a\"), bare(\"b\")])),\n    57\t        \"<a b>\"\n    58\t    );\n    59\t    assert_eq!(agrees(enclosed(Enclosure::Angled, vec![])), \"<>\");\n    60\t    assert_eq!(agrees(opaque(Boundary::CurlyQuotes, \"a b\")), \"“a b”\");\n    61\t    assert_eq!(agrees(opaque(Boundary::CurlyQuotes, \"\")), \"“”\");\n    62\t    assert_eq!(agrees(opaque(Boundary::Parentheses, \"x\")), \"(x)\");\n    63\t}\n    64\t\n    65\t#[test]\n    66\tfn heads_and_chains() {\n    67\t    assert_eq!(agrees(dot(\"Some\", bare(\"42\"))), \"Some.42\");\n    68\t    assert_eq!(\n    69\t        agrees(dot(\n    70\t            \"Reviewer\",\n    71\t            enclosed(Enclosure::Braced, vec![bare(\"2024\"), bare(\"17\")])\n    72\t        )),\n    73\t        \"Reviewer.{ 2024 17 }\"\n    74\t    );\n    75\t    assert_eq!(\n    76\t        agrees(dot(\n    77\t            \"Observed\",\n    78\t            dot(\"Locks\", enclosed(Enclosure::Bracketed, vec![]))\n    79\t        )),\n    80\t        \"Observed.Locks.[]\"\n    81\t    );\n    82\t    assert_eq!(\n    83\t        agrees(Protoform::Headed(\n    84\t            sym(\"a\"),\n    85\t            Separator::Colon,\n    86\t            Box::new(Protoform::Headed(\n    87\t                sym(\"b\"),\n    88\t                Separator::Exclamation,\n    89\t                Box::new(bare(\"c\"))\n    90\t            ))\n    91\t        )),\n    92\t        \"a:b!c\"\n    93\t    );\n    94\t    assert_eq!(\n    95\t        agrees(dot(\"Some\", opaque(Boundary::Parentheses, \"x y\"))),\n    96\t        \"Some.(x y)\"\n    97\t    );\n    98\t}\n    99\t\n   100\t#[test]\n   101\tfn qualified_heads() {\n   102\t    assert_eq!(\n   103\t        agrees(Protoform::Qualified(\n   104\t            Symbol::try_from(\"Vector\").unwrap(),\n   105\t            vec![bare(\"Text\")]\n   106\t        )),\n   107\t        \"Vector<Text>\"\n   108\t    );\n   109\t    assert_eq!(\n   110\t        agrees(Protoform::Headed(\n   111\t            Head::Qualified(\n   112\t                Symbol::try_from(\"A\").unwrap(),\n   113\t                vec![bare(\"B\"), enclosed(Enclosure::Bracketed, vec![bare(\"C\")])]\n   114\t            ),\n   115\t            Separator::Period,\n   116\t            Box::new(enclosed(Enclosure::Braced, vec![bare(\"1\")]))\n   117\t        )),\n   118\t        \"A<B [ C ]>.{ 1 }\"\n   119\t    );\n   120\t}\n   121\t\n   122\t#[test]\n   123\tfn siblings_one_space_apart() {\n   124\t    let d = \"a  { b }\\n“c”\".protosize().unwrap();\n   125\t    assert_eq!(d.textualize(), \"a { b } “c”\");\n   126\t    let Situated(_, text) = d.0[1].situate();\n   127\t    assert_eq!(text, \"{ b }\");\n   128\t    assert_eq!(Delineation(vec![]).textualize(), \"\");\n   129\t}\n   130\t\n   131\t#[test]\n   132\tfn only_unbalanced_parentheses_and_backslashes_are_escaped() {\n   133\t    assert_eq!(\n   134\t        agrees(opaque(Boundary::Parentheses, \"a (b) c\")),\n   135\t        \"(a (b) c)\"\n   136\t    );\n   137\t    assert_eq!(agrees(opaque(Boundary::Parentheses, \"a ) b\")), \"(a \\\\) b)\");\n   138\t    assert_eq!(agrees(opaque(Boundary::Parentheses, \"a ( b\")), \"(a \\\\( b)\");\n   139\t    assert_eq!(agrees(opaque(Boundary::Parentheses, \"\\\\\")), \"(\\\\\\\\)\");\n   140\t    assert_eq!(agrees(opaque(Boundary::Parentheses, \"((a)\")), \"(\\\\((a))\");\n   141\t    assert_eq!(agrees(opaque(Boundary::Parentheses, \"(a))\")), \"((a)\\\\))\");\n   142\t    assert_eq!(agrees(opaque(Boundary::Parentheses, \")(\")), \"(\\\\)\\\\()\");\n   143\t    assert_eq!(\n   144\t        agrees(opaque(\n   145\t            Boundary::Parentheses,\n   146\t            \"The build passed on the third try (after two timeouts)\"\n   147\t        )),\n   148\t        \"(The build passed on the third try (after two timeouts))\"\n   149\t    );\n   150\t}\n   151\t\n   152\t#[test]\n   153\tfn deep_situation_matches_the_reader() {\n   154\t    let text = \"{ Ada 1990 { “12 Rue de la Paix” Paris 75002 } [ Author Reviewer.{ 2024 17 } ] }\";\n   155\t    let Situated(_, form) =\n   156\t        \"{ Ada 1990 { “12 Rue de la Paix” Paris 75002 } [ Author Reviewer.{ 2024 17 } ] }\"\n   157\t            .protosize()\n   158\t            .unwrap()\n   159\t            .0\n   160\t            .pop()\n   161\t            .unwrap();\n   162\t    assert_eq!(agrees(form), text);\n   163\t}\n   164\t\n   165\t#[test]\n   166\tfn writer_extents_index_the_written_text() {\n   167\t    let form = dot(\n   168\t        \"Reviewer\",\n   169\t        enclosed(Enclosure::Braced, vec![bare(\"2024\"), bare(\"17\")]),\n   170\t    );\n   171\t    let Situated(situation, text) = form.situate();\n   172\t    let Extent(start, end) = situation.locate(&[1, 1]).unwrap();\n   173\t    assert_eq!(&text[start as usize..end as usize], \"17\");\n   174\t    let Extent(start, end) = situation.locate(&[0]).unwrap();\n   175\t    assert_eq!(&text[start as usize..end as usize], \"Reviewer\");\n   176\t}\n   177\t\n   178\t#[test]\n   179\tfn text_refuses_the_closing_curly_quote() {\n   180\t    assert_eq!(\n   181\t        Text::try_from(\"a”b\"),\n   182\t        Err(Refusal {\n   183\t            glyph: '”',\n   184\t            offset: 1\n   185\t        })\n   186\t    );\n   187\t    assert_eq!(\n   188\t        Text::try_from(String::from(\"xy”\")),\n   189\t        Err(Refusal {\n   190\t            glyph: '”',\n   191\t            offset: 2\n   192\t        })\n   193\t    );\n   194\t    let text = Text::try_from(\"a “ b ( ) { } ; \\\\\").unwrap();\n   195\t    assert_eq!(text.as_ref(), \"a “ b ( ) { } ; \\\\\");\n   196\t    assert_eq!(String::from(text), \"a “ b ( ) { } ; \\\\\");\n   197\t}\n   198\t\n   199\t#[test]\n   200\tfn bare_admits_only_the_reader_bare_anatomy() {\n   201\t    assert!(Bare::try_from(\"a:b\").is_err());\n   202\t    assert!(Bare::try_from(\"a..b\").is_ok());\n   203\t    assert!(Word::try_from(\"a:b\").is_ok());\n   204\t}\n   205\t\n   206\tproptest! {\n   207\t    #[test]\n   208\t    fn any_meaning_text_round_trips(content in \".*\") {\n   209\t        let form = opaque(Boundary::Parentheses, &content);\n   210\t        let text = form.textualize();\n   211\t        let mut read = text.protosize().unwrap().0;\n   212\t        prop_assert_eq!(read.len(), 1);\n   213\t        let Situated(_, back) = read.pop().unwrap();\n   214\t        prop_assert_eq!(back, form);\n   215\t    }\n   216\t\n   217\t    #[test]\n   218\t    fn any_quoted_text_round_trips(content in \"[^”]*\") {\n   219\t        let form = opaque(Boundary::CurlyQuotes, &content);\n   220\t        let text = form.textualize();\n   221\t        let mut read = text.protosize().unwrap().0;\n   222\t        prop_assert_eq!(read.len(), 1);\n   223\t        let Situated(_, back) = read.pop().unwrap();\n   224\t        prop_assert_eq!(back, form);\n   225\t    }\n   226\t}\n     1\tuse protos::{Bare, Delineation, Extent, Head, Protoform, Separator, Situated, Situation, Symbol};\n     2\t\n     3\tconst DEPTH: usize = 20_000;\n     4\t\n     5\tfn symbol() -> Symbol {\n     6\t    Symbol::try_from(\"Node\").expect(\"Node is a symbol\")\n     7\t}\n     8\t\n     9\tfn deep() -> (Situation, Protoform) {\n    10\t    let mut situation = Situation {\n    11\t        extent: Extent(0, 1),\n    12\t        children: Vec::new(),\n    13\t    };\n    14\t    let mut form = Protoform::Bare(Bare::try_from(\"leaf\").expect(\"leaf is bare\"));\n    15\t    for _ in 0..DEPTH {\n    16\t        situation = Situation {\n    17\t            extent: Extent(0, 1),\n    18\t            children: vec![situation],\n    19\t        };\n    20\t        form = Protoform::Headed(Head::Symbol(symbol()), Separator::Period, Box::new(form));\n    21\t    }\n    22\t    (situation, form)\n    23\t}\n    24\t\n    25\t#[test]\n    26\tfn recursive_structural_traits_are_iterative() {\n    27\t    let (situation, form) = deep();\n    28\t    let delineation = Delineation(vec![Situated(situation, form)]);\n    29\t    let copied = delineation.clone();\n    30\t    assert_eq!(delineation, copied);\n    31\t    assert!(format!(\"{delineation:?}\").starts_with(\"Delineation([Situated(\"));\n    32\t}\n     1\t//! Size probes: reading, writing and dropping deep and wide structures in bounded,\n     2\t//! linear memory. Each probe runs in its own process under an address-space cap\n     3\t//! and a timeout; the parent reads the child's peak resident size.\n     4\t\n     5\tuse std::process::Command;\n     6\t\n     7\tuse protos::{Bare, Enclosure, Protoform, Protosizable, Situating, Textualizable};\n     8\t\n     9\tconst SIZES: [usize; 3] = [1_000, 10_000, 100_000];\n    10\tconst MODES: [&str; 6] = [\n    11\t    \"read-brackets\",\n    12\t    \"read-chain\",\n    13\t    \"read-chain-enclosed\",\n    14\t    \"read-vector\",\n    15\t    \"write-brackets\",\n    16\t    \"write-vector\",\n    17\t];\n    18\t\n    19\tfn peak_kb() -> u64 {\n    20\t    let status = std::fs::read_to_string(\"/proc/self/status\").unwrap();\n    21\t    let line = status.lines().find(|l| l.starts_with(\"VmHWM:\")).unwrap();\n    22\t    line.split_whitespace().nth(1).unwrap().parse().unwrap()\n    23\t}\n    24\t\n    25\tfn nested(n: usize) -> Protoform {\n    26\t    let mut form = Protoform::Enclosed(Enclosure::Bracketed, vec![]);\n    27\t    for _ in 0..n {\n    28\t        form = Protoform::Enclosed(Enclosure::Bracketed, vec![form]);\n    29\t    }\n    30\t    form\n    31\t}\n    32\t\n    33\tfn probe(mode: &str, n: usize) {\n    34\t    match mode {\n    35\t        \"read-brackets\" => {\n    36\t            let text = format!(\"{}{}\", \"[\".repeat(n), \"]\".repeat(n));\n    37\t            let d = text.protosize().unwrap();\n    38\t            assert_eq!(d.0.len(), 1);\n    39\t            drop(d);\n    40\t        }\n    41\t        \"read-chain\" => {\n    42\t            let text = format!(\"{}A\", \"A.\".repeat(n));\n    43\t            let d = text.protosize().unwrap();\n    44\t            assert_eq!(d.0.len(), 1);\n    45\t            drop(d);\n    46\t        }\n    47\t        \"read-chain-enclosed\" => {\n    48\t            let text = format!(\"{}{{}}\", \"A.\".repeat(n));\n    49\t            let d = text.protosize().unwrap();\n    50\t            assert_eq!(d.0.len(), 1);\n    51\t            drop(d);\n    52\t        }\n    53\t        \"read-vector\" => {\n    54\t            let text = format!(\"[ {}]\", \"1 \".repeat(n));\n    55\t            let d = text.protosize().unwrap();\n    56\t            assert!(matches!(&d.0[0].1, Protoform::Enclosed(_, c) if c.len() == n));\n    57\t            drop(d);\n    58\t        }\n    59\t        \"write-brackets\" => {\n    60\t            let form = nested(n);\n    61\t            let text = form.textualize();\n    62\t            assert_eq!(text.len(), 4 * n + 2);\n    63\t            let situated = form.situate();\n    64\t            assert_eq!(situated.1, text);\n    65\t            drop(situated);\n    66\t            drop(form);\n    67\t        }\n    68\t        \"write-vector\" => {\n    69\t            let mut children = Vec::with_capacity(n);\n    70\t            for _ in 0..n {\n    71\t                children.push(Protoform::Bare(Bare::try_from(\"1\").unwrap()));\n    72\t            }\n    73\t            let form = Protoform::Enclosed(Enclosure::Bracketed, children);\n    74\t            let text = form.textualize();\n    75\t            assert_eq!(text.len(), 2 * n + 3);\n    76\t            drop(form.situate());\n    77\t            drop(form);\n    78\t        }\n    79\t        other => panic!(\"unknown probe {other}\"),\n    80\t    }\n    81\t    println!(\"peak-kb {}\", peak_kb());\n    82\t}\n    83\t\n    84\tfn run_child(mode: &str, n: usize) -> u64 {\n    85\t    let exe = std::env::current_exe().unwrap();\n    86\t    let output = Command::new(\"sh\")\n    87\t        .arg(\"-c\")\n    88\t        .arg(\"ulimit -v 2000000; exec timeout 120 \\\"$0\\\" \\\"$@\\\"\")\n    89\t        .arg(exe)\n    90\t        .arg(mode)\n    91\t        .arg(n.to_string())\n    92\t        .output()\n    93\t        .unwrap();\n    94\t    assert!(\n    95\t        output.status.success(),\n    96\t        \"{mode} {n} failed: {}\\n{}\",\n    97\t        output.status,\n    98\t        String::from_utf8_lossy(&output.stderr)\n    99\t    );\n   100\t    let stdout = String::from_utf8(output.stdout).unwrap();\n   101\t    let line = stdout.lines().find(|l| l.starts_with(\"peak-kb \")).unwrap();\n   102\t    line[8..].trim().parse().unwrap()\n   103\t}\n   104\t\n   105\tfn main() {\n   106\t    let args: Vec<String> = std::env::args().collect();\n   107\t    if args.len() == 3 {\n   108\t        probe(&args[1], args[2].parse().unwrap());\n   109\t        return;\n   110\t    }\n   111\t    let mut failures = 0;\n   112\t    for mode in MODES {\n   113\t        let peaks: Vec<u64> = SIZES.iter().map(|&n| run_child(mode, n)).collect();\n   114\t        let (small, medium, large) = (peaks[0], peaks[1], peaks[2]);\n   115\t        let step = medium.saturating_sub(small);\n   116\t        let linear_bound = small + 15 * step + 16 * 1024;\n   117\t        let ok = large <= linear_bound && large < 1024 * 1024;\n   118\t        println!(\n   119\t            \"{} {mode}: 1000 -> {small} kB, 10000 -> {medium} kB, 100000 -> {large} kB (bound {linear_bound} kB)\",\n   120\t            if ok { \"ok  \" } else { \"FAIL\" }\n   121\t        );\n   122\t        if !ok {\n   123\t            failures += 1;\n   124\t        }\n   125\t    }\n   126\t    assert_eq!(failures, 0, \"{failures} probes exceeded linear memory\");\n   127\t}\n","exit_code":0,"status":"completed"}}
