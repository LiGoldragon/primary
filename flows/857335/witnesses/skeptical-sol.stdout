tions.rs\ntests/generated/streamable-kind.rs\ntests/generated/tree-types.rs\ntests/signal_without_datom.rs\nMANIFEST\n[package]\nname         = \"ethos-zero\"\nversion      = \"6.1.6\"\nedition      = \"2024\"\nrust-version = \"1.89\"\nlicense      = \"MIT OR Apache-2.0\"\nrepository   = \"https://github.com/LiGoldragon/ethos-zero\"\ndescription  = \"Ethos schema language version zero: reads ethos, generates Rust.\"\npublish      = false\nautobins     = false\nautoexamples = false\nautotests    = false\n\n[lib]\nname = \"ethos_zero\"\npath = \"src/lib.rs\"\n\n[[bin]]\nname = \"ethos-zero\"\npath = \"src/main.rs\"\n\n[features]\ndefault = [\"datom\"]\ndatom = []\n\n[dependencies]\nprotos      = { git = \"https://github.com/LiGoldragon/protos\",  rev = \"b543678cfc8609529cea7174eb4af8a64daa54ad\" }\ndatom-codec = { git = \"https://github.com/LiGoldragon/datom-codec\", rev = \"f2cc06858d38a4028c928d33323a6d682e7c222f\" }\nquote       = \"1\"\nproc-macro2 = \"1\"\nsyn         = { version = \"3\", features = [\"full\"] }\nprettyplease = \"0.3\"\nrkyv = { version = \"0.8\", default-features = false, features = [\"std\", \"bytecheck\", \"little_endian\", \"pointer_width_32\", \"unaligned\"] }\n\n[dev-dependencies]\nserde = \"1\"\n\n[[test]]\nname = \"ethos\"\npath = \"tests/ethos.rs\"\n\n[[test]]\nname = \"generated\"\npath = \"tests/generated.rs\"\n\n[[test]]\nname = \"freshness\"\npath = \"tests/freshness.rs\"\n\n[[test]]\nname = \"signal-without-datom\"\npath = \"tests/signal_without_datom.rs\"\n\n[[test]]\nname = \"cli\"\npath = \"tests/cli.rs\"\n\n[lints.rust]\nunsafe_code = \"forbid\"\nunused      = { level = \"warn\", priority = -1 }\ndead_code   = \"warn\"\n","exit_code":0,"status":"completed"}}
