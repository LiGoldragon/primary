nsrc/lib.rs:285:    /// `Name.{ [ superkinds ] [ associated types ] [ associated constants ] [ capabilities ] }`.\nsrc/lib.rs:287:        /// The kinds it extends.\nsrc/lib.rs:288:        superkinds: Vec<Reference>,\nsrc/lib.rs:293:        /// Its capabilities.\nsrc/lib.rs:294:        capabilities: Vec<Capability>,\nsrc/lib.rs:298:/// An associated type of a kind, with the kinds bounding it.\nsrc/lib.rs:299:#[derive(Clone, Debug, PartialEq, Eq)]\nsrc/lib.rs:300:pub struct AssociatedType {\nsrc/lib.rs:307:/// An associated constant of a kind: its name and its type.\nsrc/lib.rs:308:#[derive(Clone, Debug, PartialEq, Eq)]\nsrc/lib.rs:309:pub struct AssociatedConstant {\nsrc/lib.rs:316:/// A capability: a function a kind has.\nsrc/lib.rs:317:#[derive(Clone, Debug, PartialEq, Eq)]\nsrc/lib.rs:318:pub struct Capability {\nsrc/lib.rs:327:/// A capability's signature: a yield bracket alone, or a brace of inputs and yield.\nsrc/lib.rs:328:#[derive(Clone, Debug, PartialEq, Eq)]\nsrc/lib.rs:329:pub enum Signature {\nsrc/lib.rs:336:/// Who a capability is called on, said by its separator.\nsrc/lib.rs:337:#[derive(Clone, Copy, Debug, PartialEq, Eq)]\nsrc/lib.rs:338:pub enum Receiver {\nsrc/lib.rs:347:/// An association: a type, by its identity, bears kinds.\nsrc/lib.rs:348:#[derive(Clone, Debug, PartialEq, Eq)]\nsrc/lib.rs:349:pub struct Association {\nsrc/lib.rs:352:    /// The kinds it bears.\nsrc/lib.rs:353:    pub kinds: Vec<Reference>,\nsrc/lib.rs:357:// The text layer: the canonical form\nsrc/lib.rs:360:/// The canonical text of a file, and the seam where the sweet form was opened into braces.\nsrc/lib.rs:361:#[derive(Clone, Debug, PartialEq, Eq)]\nsrc/lib.rs:362:pub struct Canonical {\nsrc/lib.rs:365:    /// The bytes inserted after the head, empty when the text was already canonical.\nsrc/lib.rs:369:/// Text awaiting the one conversion to an Ethos value.\nsrc/lib.rs:370:pub struct Potential<T>(pub String, PhantomData<fn() -> T>);\nsrc/lib.rs:389:#[derive(Clone, Copy, Debug, PartialEq, Eq)]\nsrc/lib.rs:390:pub enum Intrinsic {\nsrc/lib.rs:399:    /// `datom_codec::Meaning`.\nsrc/lib.rs:414:#[derive(Clone, Debug, PartialEq, Eq)]\nsrc/lib.rs:415:pub enum Resolution {\nsrc/lib.rs:422:    /// A kind declared in this file, written bare.\nsrc/lib.rs:431:    /// An associated type of the enclosing kind, written `Self::Name`.\nsrc/lib.rs:437:/// What a reference is asked to be: a type in a type position, a kind in a bound.\nsrc/lib.rs:438:#[derive(Clone, Copy, Debug, PartialEq, Eq)]\nsrc/lib.rs:439:pub enum Role {\nsrc/lib.rs:442:    /// A kind: a constraint, a superkind, a bound, an association.\nsrc/lib.rs:447:#[derive(Clone, Copy, Debug)]\nsrc/lib.rs:448:pub struct Scope<'a> {\nsrc/lib.rs:449:    /// The file whose imports and declarations are in scope.\nsrc/lib.rs:451:    /// The enclosing identity, whose single-kind constraints name parameters.\nsrc/lib.rs:453:    /// The enclosing kind's associated types.\nsrc/lib.rs:461:/// The kind whose capability yields the canonical form of an ethos text.\nsrc/lib.rs:462:pub trait Canonicalizable {\nsrc/lib.rs:463:    /// Open the sweet form into the braced form; the text is delineated to find its head.\nsrc/lib.rs:464:    fn canonicalize(&self) -> Result<Canonical, protos::Error>;\nsrc/lib.rs:467:/// The kind whose capability maps an extent of the canonical text back onto the source text.\nsrc/lib.rs:468:pub trait Resituating {\nsrc/lib.rs:473:/// The kind whose capability yields the ethos name of a value.\nsrc/lib.rs:474:pub trait Named {\nsrc/lib.rs:479:/// The kind whose static capability identifies a variant from its ethos name, walking the variants.\nsrc/lib.rs:480:pub trait Identifiable: Sized {\nsrc/lib.rs:485:/// The kind whose capability yields which variant of [`File`] a value is.\nsrc/lib.rs:486:pub trait Rooted {\nsrc/lib.rs:491:/// The kind whose capability resolves a name to what it names.\nsrc/lib.rs:492:pub trait Resolving {\nsrc/lib.rs:497:/// The kind whose capability checks a whole file and generates its Rust module.\nsrc/lib.rs:498:pub trait Generating {\nsrc/lib.rs:503:/// The kind whose capability actualizes Ethos text into its conceptual value.\nsrc/lib.rs:504:pub trait Actualizing<T> {\nsrc/lib.rs:509:/// The conversion from Protos structure to an Ethos concept.\nsrc/lib.rs:510:pub trait Ethosizable<T> {\nsrc/lib.rs:515:/// The kind whose capability yields a conceptual fault's path and places it below a child.\nsrc/lib.rs:516:pub trait Pathed {\nsrc/lib.rs:523:/// The kind whose capability places a result's fault under a child index.\nsrc/lib.rs:524:pub trait Placing {\nsrc/lib.rs:529:/// The kind whose capability constructs a situated conceptual fault.\nsrc/lib.rs:530:pub trait ConceptualFaulting {\nsrc/lib.rs:535:/// The kind whose capability constructs an arity problem.\nsrc/lib.rs:536:pub trait ArityProblem {\nsrc/lib.rs:545:impl crate::Pathed for Error {\nsrc/lib.rs:564:impl ConceptualFaulting for Error {\nsrc/lib.rs:573:impl ArityProblem for Problem {\nsrc/lib.rs:582:impl From<protos::Error> for Error {\nsrc/lib.rs:604:impl Named for Root {\nsrc/lib.rs:607:            Root::Library => \"Library\",\nsrc/lib.rs:608:            Root::Signal => \"Signal\",\nsrc/lib.rs:609:            Root::Sema => \"Sema\",\nsrc/lib.rs:614:impl Identifiable for Root {\nsrc/lib.rs:616:        for root in [Root::Library, Root::Signal, Root::Sema] {\nsrc/lib.rs:625:impl Rooted for File {\nsrc/lib.rs:628:            File::Library(_) => Root::Library,\nsrc/lib.rs:629:            File::Signal(_) => Root::Signal,\nsrc/lib.rs:630:            File::Sema(_) => Root::Sema,\nsrc/lib.rs:635:impl Named for Intrinsic {\nsrc/lib.rs:652:impl Identifiable for Intrinsic {\nsrc/lib.rs:679:mod canonicalization;\nsrc/lib.rs:687:    use super::{\nsrc/lib.rs:688:        Actualizing, Canonicalizable, Error, File, Generating, Identity, Library, Name, Potential,\nsrc/lib.rs:691:    use protos::{Extent, Protosizable, Textualizable};\nsrc/lib.rs:694:    fn library_record_generates_named_datom_fields() {\nsrc/lib.rs:695:        let file = match Potential::<File>::from(\"Library [] [ Record.{ String Integer } ] [] []\")\nsrc/lib.rs:699:            Err(_) => panic!(\"approved Library record reads\"),\nsrc/lib.rs:703:            Err(_) => panic!(\"approved Library record generates\"),\nsrc/lib.rs:706:            \"#[derive(datom_codec::Datomizable, datom_codec::Compositional, Clone, Debug, PartialEq)]\"\nsrc/lib.rs:714:        let source = \"Library [] [ Generation.{ String String } FilePath.String SyntaxError.Vector<FilePath> GenerationFailure.[ SyntaxError Unwritable ] Lock.{ String } LockRejection.[ DuplicateName.Lock PathOverlap.{ Lock Lock } ] ] [] []\";\nsrc/lib.rs:718:                let canonical = source.to_owned().canonicalize().unwrap();\nsrc/lib.rs:721:                    canonical.text.protosize()\nsrc/lib.rs:738:    fn library_kinds_generate_trait_surfaces() {\nsrc/lib.rs:739:        let source = \"Library [ std:[ Clonable Sendable Serializable ] ] [ SinkError.[ Closed ] Sink.{ String } ] [ Fillable.[ push!{ [ String ] [ Result<Integer SinkError> ] } drain![ Vector<String> ] create:[ Self ] ] Streamable.{ [ Fillable ] [ Item<Serializable> ] [ CAPACITY.Integer ] [ next![ Option<Item> ] ] } Processable<[Clonable Sendable] Serializable>.[ process.[ String ] ] ] [ Sink.[ Fillable ] ]\";\nsrc/lib.rs:743:                let canonical = source.to_owned().canonicalize().unwrap();\nsrc/lib.rs:744:                panic!(\"approved kinds read: {:?}\", canonical.text.protosize())\nsrc/lib.rs:749:            Err(_) => panic!(\"approved kinds generate\"),\nsrc/lib.rs:772:        std::fs::write(\nsrc/lib.rs:788:        std::fs::write(concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/src/error.rs\"), rust)\nsrc/lib.rs:795:        for entry in std::fs::read_dir(format!(\"{root}/fixtures\")).expect(\"fixture directory\") {\nsrc/lib.rs:801:            let source = std::fs::read_to_string(&path).expect(\"fixture source\");\nsrc/lib.rs:814:            std::fs::write(format!(\"{root}/tests/generated/{stem}.rs\"), rust)\nsrc/lib.rs:820:    fn canonical_ascent_round_trips_nonempty_library_and_signal() {\nsrc/lib.rs:821:        let library = \"Library [ crate:[ Capability ] external:[ Vector ] ] [ FilePath.String SyntaxError.Vector<FilePath> External.external:Vector<FilePath> Record.{ Vector<Option<String>> Result<String Integer> } State.[ Idle Busy ] ] [ Fillable.[ fill!{ [ Vector<Option<String>> ] [ Result<String Integer> ] } ] Processable<[Clonable Sendable] Serializable>.[ process.[ String ] ] ] [ Record.[ Fillable ] ]\";\nsrc/lib.rs:822:        let signal = \"Signal [ datom_codec:[ Error Path ] ] [ Generate.Generation ] [ Generated.String Malformed.Error ] [ Generation.{ String String } ]\";\nsrc/lib.rs:828:            let canonical = file.protosize().textualize();\nsrc/lib.rs:829:            let repeated = match Potential::<File>::from(canonical).actualize() {\nsrc/lib.rs:838:    fn sema_has_imports_and_record_type_declarations_only() {\nsrc/lib.rs:839:        let source = \"Sema [ crate:[ Handle ] ] [ Record.{ Handle String } ]\";\nsrc/lib.rs:842:            Err(_) => panic!(\"approved Sema reads\"),\nsrc/lib.rs:844:        assert!(matches!(file, File::Sema(_)));\nsrc/lib.rs:847:            Err(_) => panic!(\"Sema ascent reads\"),\nsrc/lib.rs:853:    fn retired_type_and_kind_roots_are_rejected() {\nsrc/lib.rs:861:        let source = \"Library [] [ Box<Sized>.{ String } ] [] []\";\nsrc/lib.rs:870:        use crate::{Constraint, Reference, Scope, checking::Checkable};\nsrc/lib.rs:872:        let file = File::Library(Library {\nsrc/lib.rs:873:            imports: vec![],\nsrc/lib.rs:885:            kinds: vec![],\nsrc/lib.rs:886:            associations: vec![],\nsrc/lib.rs:898:        let source = \"Library [] [ Outer.[ A.[ X.{ String } ] B.[ X.{ Integer } ] ] Rejection.[ PathOverlap.{ String String } ] ] [] []\";\nsrc/lib.rs:915:        let source = \"Library.{ [] [ Bad ] [] [] }\";\nsrc/lib.rs:923:    fn sweet_structural_errors_resituate_to_the_authored_source() {\nsrc/lib.rs:924:        let source = \"Library\\n[]\\n[ Record.{ String ]\\n[]\\n[]\";\nsrc/lib.rs:935:    fn public_file_protosization_has_the_shared_exact_canonical_extents() {\nsrc/lib.rs:936:        let source = \"Library [] [ Alias.Vector<Option<String>> Record.{ Vector<Option<String>> Result<String Integer> } ] [ Processable<[Clonable Sendable] Serializable>.[ process.[ String ] ] ] []\";\nsrc/lib.rs:942:        let canonical = projected.textualize();\nsrc/lib.rs:943:        let reparsed = canonical.protosize().expect(\"canonical ascent reads\");\nsrc/lib.rs:952:                end: canonical.len()\nsrc/lib.rs:969:        let file = File::Library(Library {\nsrc/lib.rs:970:            imports: vec![],\nsrc/lib.rs:972:            kinds: vec![],\nsrc/lib.rs:973:            associations: vec![],\nsrc/lib.rs:986:            (\"Signal [ 1 ] [] [] []\", vec![0, 0]),\nsrc/lib.rs:987:            (\"Sema [] [ 1 ]\", vec![1, 0]),\nsrc/lib.rs:988:            (\"Library [] [ Alias.Vector<1> ] [] []\", vec![1, 1, 0]),\nsrc/lib.rs:999:    fn kind_capability_and_association_errors_keep_all_structural_parents() {\nsrc/lib.rs:1001:            (\"Library [] [] [ K.[ 1 ] ] []\", vec![2, 0, 1, 0]),\nsrc/lib.rs:1003:                \"Library [] [] [ K.{ [ 1 ] [] [] [] } ] []\",\nsrc/lib.rs:1007:                \"Library [] [ T.String ] [ K.[] ] [ T.[ 1 ] ]\",\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/run/current-system/sw/bin/zsh -lc \"nl -ba src/lib.rs | sed -n '1,540p'; nl -ba src/generation.rs | sed -n '1,220p'; nl -ba src/generation.rs | sed -n '220,470p'; nl -ba src/generation.rs | sed -n '470,680p'; nl -ba src/generation.rs | sed -n '680,950p'; nl -ba src/canonicalization.rs; nl -ba src/actualization.rs; nl -ba tests/signal_without_datom.rs; nl -ba tests/generated.rs; nl -ba tests/ethos.rs; nl -ba tests/cli.rs; nl -ba Cargo.toml; nl -ba flake.nix\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/run/current-system/sw/bin/zsh -lc \"nl -ba src/lib.rs | sed -n '1,540p'; nl -ba src/generation.rs | sed -n '1,220p'; nl -ba src/generation.rs | sed -n '220,470p'; nl -ba src/generation.rs | sed -n '470,680p'; nl -ba src/generation.rs | sed -n '680,950p'; nl -ba src/canonicalization.rs; nl -ba src/actualization.rs; nl -ba tests/signal_without_datom.rs; nl -ba tests/generated.rs; nl -ba tests/ethos.rs; nl -ba tests/cli.rs; nl -ba Cargo.toml; nl -ba flake.nix\"","aggregated_output":"     1\t//! Ethos-zero: the ethos schema language, version zero.\n     2\t//!\n     3\t//! Ethos specifies the types, datom fills them with data, and ethos\n     4\t//! generates the Rust. This crate reads an ethos file and generates\n     5\t//! its Rust module. The layers, top to bottom, and the kind that\n     6\t//! carries a value from one to the next:\n     7\t//!\n     8\t//! | layer | type | kind borne | yields |\n     9\t//! |---|---|---|---|\n    10\t//! | Text, as written (the sweet form) | `protos::Text` | [`Canonicalizable`] | [`Canonical`] |\n    11\t//! | Text, canonical (the braced form) | [`Canonical`] | `protos::Protosizable` | `protos::Delineation` |\n    12\t//! | Protoform | `protos::Delineation`, `protos::Protoform` | `Conceiving<File>` | [`File`], checked whole |\n    13\t//! | Concept | [`File`] | [`Generating`] | Rust text, or a whole-file fault |\n    14\t//!\n    15\t//! `protos::Potential<File>` bears `protos::Actualizable<File>`: the\n    16\t//! whole descent in one call, its fault situated by path and extent in\n    17\t//! the source text. The concept goes back up too: [`File`] bears\n    18\t//! `protos::Protosizable` and `protos::Textualizable`, which cannot\n    19\t//! fault.\n    20\t//!\n    21\t//! Every fault the reader raises is a [`Error`] carrying the path of\n    22\t//! the structure at fault, in Protos's path convention: a headed structure's\n    23\t//! head is child 0 and its body is child 1; a qualified head's arguments are\n    24\t//! children of that head; an enclosure's children are\n    25\t//! numbered from 0, and each container prepends its child's index on\n    26\t//! the way up (`protos::Pathed::within`).\n    27\t//!\n    28\t//! Declared structs and enums bear datom-codec's structural kinds through its\n    29\t//! derives. Signal declarations gate those derives behind their `datom`\n    30\t//! feature, so a Nexus can use its contract without a text codec.\n    31\t\n    32\t// A walk over the variants of an enum is written as the loop it is, not\n    33\t// as an iterator adaptor with an inlined closure: no closure beyond what\n    34\t// std forces, and no free function, is the crate's own rule.\n    35\t#![allow(clippy::manual_find, clippy::manual_map)]\n    36\t\n    37\tuse datom_codec::Integer;\n    38\tuse protos::Extent;\n    39\tuse std::marker::PhantomData;\n    40\t\n    41\t// ---------------------------------------------------------------------------\n    42\t// The reader errors: declared in error.ethos, generated into error.rs\n    43\t// ---------------------------------------------------------------------------\n    44\t\n    45\t#[rustfmt::skip]\n    46\tmod error;\n    47\t\n    48\tpub use error::{Arity_Data, Conceptual_Data, Error, Form, Problem, Structural_Error};\n    49\t\n    50\t// ---------------------------------------------------------------------------\n    51\t// The concept: the File and its declarations\n    52\t// ---------------------------------------------------------------------------\n    53\t\n    54\t/// A validated identifier: the name of a type, kind, variant, capability or constant.\n    55\t///\n    56\t/// Construct it with [`TryFrom<&str>`]; `AsRef<str>` reads its validated text.\n    57\t#[derive(Clone, Debug, PartialEq, Eq)]\n    58\tpub struct Name(String);\n    59\t\n    60\t/// The source of an import: a Rust path prefix such as `protos`, `crate` or `std::clone`.\n    61\t///\n    62\t/// Construct it with [`TryFrom<&str>`]; `AsRef<str>` reads its validated text.\n    63\t#[derive(Clone, Debug, PartialEq, Eq)]\n    64\tpub struct Source {\n    65\t    text: String,\n    66\t    segments: Vec<protos::Symbol>,\n    67\t}\n    68\t\n    69\timpl TryFrom<&str> for Name {\n    70\t    type Error = String;\n    71\t\n    72\t    fn try_from(text: &str) -> Result<Self, Self::Error> {\n    73\t        if !text.starts_with(\"r#\")\n    74\t            && (text == \"Self\" || syn::parse_str::<syn::Ident>(text).is_ok())\n    75\t            && !text.is_empty()\n    76\t        {\n    77\t            Ok(Self(text.to_owned()))\n    78\t        } else {\n    79\t            Err(text.to_owned())\n    80\t        }\n    81\t    }\n    82\t}\n    83\t\n    84\timpl TryFrom<String> for Name {\n    85\t    type Error = String;\n    86\t\n    87\t    fn try_from(text: String) -> Result<Self, Self::Error> {\n    88\t        Self::try_from(text.as_str()).map(|_| Self(text))\n    89\t    }\n    90\t}\n    91\t\n    92\timpl AsRef<str> for Name {\n    93\t    fn as_ref(&self) -> &str {\n    94\t        &self.0\n    95\t    }\n    96\t}\n    97\t\n    98\timpl TryFrom<&str> for Source {\n    99\t    type Error = String;\n   100\t\n   101\t    fn try_from(text: &str) -> Result<Self, Self::Error> {\n   102\t        let Ok(path) = syn::parse_str::<syn::Path>(text) else {\n   103\t            return Err(text.to_owned());\n   104\t        };\n   105\t        if path.leading_colon.is_some() {\n   106\t            return Err(text.to_owned());\n   107\t        }\n   108\t        for segment in &path.segments {\n   109\t            if segment.ident == \"Self\" || !segment.arguments.is_none() {\n   110\t                return Err(text.to_owned());\n   111\t            }\n   112\t        }\n   113\t        let mut segments = Vec::with_capacity(path.segments.len());\n   114\t        for segment in text.split(\"::\") {\n   115\t            if segment.is_empty() {\n   116\t                return Err(text.to_owned());\n   117\t            }\n   118\t            segments.push(protos::Symbol(segment.to_owned()));\n   119\t        }\n   120\t        Ok(Self {\n   121\t            text: text.to_owned(),\n   122\t            segments,\n   123\t        })\n   124\t    }\n   125\t}\n   126\t\n   127\timpl TryFrom<String> for Source {\n   128\t    type Error = String;\n   129\t\n   130\t    fn try_from(text: String) -> Result<Self, Self::Error> {\n   131\t        Self::try_from(text.as_str())\n   132\t    }\n   133\t}\n   134\t\n   135\timpl AsRef<str> for Source {\n   136\t    fn as_ref(&self) -> &str {\n   137\t        &self.text\n   138\t    }\n   139\t}\n   140\t\n   141\t/// The unit of declaration: one file, one Rust module; an enum of its four variants.\n   142\t#[derive(Clone, Debug, PartialEq, Eq)]\n   143\tpub enum File {\n   144\t    /// Library: imports, types, kinds and associations in that order.\n   145\t    Library(Library),\n   146\t    /// Signal: imports, the query variants, the response variants, the types carried.\n   147\t    Signal(Signal),\n   148\t    /// Sema: imports, the record's positions, the types stored.\n   149\t    Sema(Sema),\n   150\t}\n   151\t\n   152\t/// The head of a file: which variant of [`File`] it is.\n   153\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n   154\tpub enum Root {\n   155\t    /// The library root.\n   156\t    Library,\n   157\t    /// The types variant.\n   158\t    /// The signal variant.\n   159\t    Signal,\n   160\t    /// The sema variant.\n   161\t    Sema,\n   162\t}\n   163\t\n   164\t/// A library's complete declaration surface.  Types and kinds share one\n   165\t/// namespace and associations bind those declared types to declared kinds.\n   166\t#[derive(Clone, Debug, PartialEq, Eq)]\n   167\tpub struct Library {\n   168\t    /// Where imported names come from.\n   169\t    pub imports: Vec<Import>,\n   170\t    /// The declared data types.\n   171\t    pub types: Vec<TypeDeclaration>,\n   172\t    /// The declared capability kinds.\n   173\t    pub kinds: Vec<KindDeclaration>,\n   174\t    /// The type-to-kind assertions.\n   175\t    pub associations: Vec<Association>,\n   176\t}\n   177\t\n   178\t/// The signal variant of a file: a wire contract whose query type is `Query` and whose response type is `Response`.\n   179\t#[derive(Clone, Debug, PartialEq, Eq)]\n   180\tpub struct Signal {\n   181\t    /// Where imported names come from.\n   182\t    pub imports: Vec<Import>,\n   183\t    /// The variants of the query type `Query`.\n   184\t    pub requests: Vec<Variant>,\n   185\t    /// The variants of the response type `Response`.\n   186\t    pub responses: Vec<Variant>,\n   187\t    /// The types the requests and responses carry.\n   188\t    pub types: Vec<TypeDeclaration>,\n   189\t}\n   190\t\n   191\t/// The sema variant of a file: imports and record-type declarations.\n   192\t#[derive(Clone, Debug, PartialEq, Eq)]\n   193\tpub struct Sema {\n   194\t    /// Where imported names come from.\n   195\t    pub imports: Vec<Import>,\n   196\t    /// The record type declarations.\n   197\t    pub types: Vec<TypeDeclaration>,\n   198\t}\n   199\t\n   200\t/// An import: a source and the names taken from it.\n   201\t#[derive(Clone, Debug, PartialEq, Eq)]\n   202\tpub enum Import {\n   203\t    /// One name from a source: `protos:Text`.\n   204\t    One(Source, Imported),\n   205\t    /// Several names from a source: `protos:[ Text Integer ]`.\n   206\t    Many(Source, Vec<Imported>),\n   207\t}\n   208\t\n   209\t/// An imported name: the ethos name and the source's own name for it, the same unless written `Ethos.Source`.\n   210\t#[derive(Clone, Debug, PartialEq, Eq)]\n   211\tpub struct Imported {\n   212\t    /// The name as ethos writes it.\n   213\t    pub name: Name,\n   214\t    /// The name the source gives it, which the generated Rust writes.\n   215\t    pub emitted: Name,\n   216\t}\n   217\t\n   218\t/// A reference to a type or a kind by name: an optional inline source, the name, and its arguments.\n   219\t#[derive(Clone, Debug, PartialEq, Eq)]\n   220\tpub struct Reference {\n   221\t    /// An inline source qualifying the name: `protos:Error`.\n   222\t    pub source: Option<Source>,\n   223\t    /// The name referred to.\n   224\t    pub name: Name,\n   225\t    /// The arguments in angle brackets: `Vector<Text>`, `Result<Integer SinkError>`.\n   226\t    pub arguments: Vec<Reference>,\n   227\t}\n   228\t\n   229\t/// The identity of a type or a kind: its name and its constraints, written as one head.\n   230\t#[derive(Clone, Debug, PartialEq, Eq)]\n   231\tpub struct Identity {\n   232\t    /// The name.\n   233\t    pub name: Name,\n   234\t    /// The constraints, one per parameter the Rust needs.\n   235\t    pub constraints: Vec<Constraint>,\n   236\t}\n   237\t\n   238\t/// A constraint: a kind, or a bracket of kinds, bounding one parameter.\n   239\t#[derive(Clone, Debug, PartialEq, Eq)]\n   240\tpub enum Constraint {\n   241\t    /// One kind: `Serializable`.\n   242\t    One(Reference),\n   243\t    /// A bracket of kinds: `[Clonable Sendable]`.\n   244\t    Many(Vec<Reference>),\n   245\t}\n   246\t\n   247\t/// A type declaration: a struct of positions, an enum of variants, or an alias.\n   248\t#[derive(Clone, Debug, PartialEq, Eq)]\n   249\tpub enum TypeDeclaration {\n   250\t    /// A headed brace: the positions in order.\n   251\t    Struct(Identity, Vec<Reference>),\n   252\t    /// A headed bracket: the variants.\n   253\t    Enum(Identity, Vec<Variant>),\n   254\t    /// A headed bare: the aliased type.\n   255\t    Alias(Identity, Reference),\n   256\t}\n   257\t\n   258\t/// A variant of an enum.\n   259\t#[derive(Clone, Debug, PartialEq, Eq)]\n   260\tpub enum Variant {\n   261\t    /// Carrying nothing: `Closed`.\n   262\t    Bare(Name),\n   263\t    /// Carrying one type: `Lock.LockRequest`.\n   264\t    Typed(Name, Reference),\n   265\t    /// Carrying an inline struct, a tuple variant: `Node.{ Tree Tree }`.\n   266\t    Struct(Name, Vec<Reference>),\n   267\t    /// Carrying an inline enum, a nested enum type: `Kind.[ A B ]`.\n   268\t    Enum(Name, Vec<Variant>),\n   269\t}\n   270\t\n   271\t/// A kind declaration: the bearer of capabilities, a trait in the Rust.\n   272\t#[derive(Clone, Debug, PartialEq, Eq)]\n   273\tpub struct KindDeclaration {\n   274\t    /// Its identity: the name and the constraints.\n   275\t    pub identity: Identity,\n   276\t    /// Its definition.\n   277\t    pub body: KindBody,\n   278\t}\n   279\t\n   280\t/// The definition of a kind: simple, a bracket of capabilities; or complex, a brace of four brackets.\n   281\t#[derive(Clone, Debug, PartialEq, Eq)]\n   282\tpub enum KindBody {\n   283\t    /// `Name.[ capabilities ]`.\n   284\t    Simple(Vec<Capability>),\n   285\t    /// `Name.{ [ superkinds ] [ associated types ] [ associated constants ] [ capabilities ] }`.\n   286\t    Complex {\n   287\t        /// The kinds it extends.\n   288\t        superkinds: Vec<Reference>,\n   289\t        /// Its associated types.\n   290\t        types: Vec<AssociatedType>,\n   291\t        /// Its associated constants.\n   292\t        constants: Vec<AssociatedConstant>,\n   293\t        /// Its capabilities.\n   294\t        capabilities: Vec<Capability>,\n   295\t    },\n   296\t}\n   297\t\n   298\t/// An associated type of a kind, with the kinds bounding it.\n   299\t#[derive(Clone, Debug, PartialEq, Eq)]\n   300\tpub struct AssociatedType {\n   301\t    /// The name.\n   302\t    pub name: Name,\n   303\t    /// The bounds: `Item<Serializable>`.\n   304\t    pub bounds: Vec<Reference>,\n   305\t}\n   306\t\n   307\t/// An associated constant of a kind: its name and its type.\n   308\t#[derive(Clone, Debug, PartialEq, Eq)]\n   309\tpub struct AssociatedConstant {\n   310\t    /// The upper-case name.\n   311\t    pub name: Name,\n   312\t    /// The type.\n   313\t    pub ty: Reference,\n   314\t}\n   315\t\n   316\t/// A capability: a function a kind has.\n   317\t#[derive(Clone, Debug, PartialEq, Eq)]\n   318\tpub struct Capability {\n   319\t    /// The name.\n   320\t    pub name: Name,\n   321\t    /// Who is called.\n   322\t    pub receiver: Receiver,\n   323\t    /// What it takes and what it yields.\n   324\t    pub signature: Signature,\n   325\t}\n   326\t\n   327\t/// A capability's signature: a yield bracket alone, or a brace of inputs and yield.\n   328\t#[derive(Clone, Debug, PartialEq, Eq)]\n   329\tpub enum Signature {\n   330\t    /// `name.[ Yield ]`.\n   331\t    Yielding(Reference),\n   332\t    /// `name.{ [ inputs ] [ Yield ] }`.\n   333\t    Taking(Vec<Reference>, Reference),\n   334\t}\n   335\t\n   336\t/// Who a capability is called on, said by its separator.\n   337\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n   338\tpub enum Receiver {\n   339\t    /// `.` takes self.\n   340\t    Shared,\n   341\t    /// `!` takes mutable self.\n   342\t    Mutable,\n   343\t    /// `:` takes no self.\n   344\t    Static,\n   345\t}\n   346\t\n   347\t/// An association: a type, by its identity, bears kinds.\n   348\t#[derive(Clone, Debug, PartialEq, Eq)]\n   349\tpub struct Association {\n   350\t    /// The type's identity.\n   351\t    pub identity: Identity,\n   352\t    /// The kinds it bears.\n   353\t    pub kinds: Vec<Reference>,\n   354\t}\n   355\t\n   356\t// ---------------------------------------------------------------------------\n   357\t// The text layer: the canonical form\n   358\t// ---------------------------------------------------------------------------\n   359\t\n   360\t/// The canonical text of a file, and the seam where the sweet form was opened into braces.\n   361\t#[derive(Clone, Debug, PartialEq, Eq)]\n   362\tpub struct Canonical {\n   363\t    /// The braced form the reader sees.\n   364\t    pub text: String,\n   365\t    /// The bytes inserted after the head, empty when the text was already canonical.\n   366\t    pub seam: Extent,\n   367\t}\n   368\t\n   369\t/// Text awaiting the one conversion to an Ethos value.\n   370\tpub struct Potential<T>(pub String, PhantomData<fn() -> T>);\n   371\t\n   372\timpl<T> From<&str> for Potential<T> {\n   373\t    fn from(text: &str) -> Self {\n   374\t        Self(text.to_owned(), PhantomData)\n   375\t    }\n   376\t}\n   377\t\n   378\timpl<T> From<String> for Potential<T> {\n   379\t    fn from(text: String) -> Self {\n   380\t        Self(text, PhantomData)\n   381\t    }\n   382\t}\n   383\t\n   384\t// ---------------------------------------------------------------------------\n   385\t// Resolution: what a name names\n   386\t// ---------------------------------------------------------------------------\n   387\t\n   388\t/// The names known without import.\n   389\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n   390\tpub enum Intrinsic {\n   391\t    /// Rust's owned string.\n   392\t    String,\n   393\t    /// `protos::Integer`.\n   394\t    Integer,\n   395\t    /// `protos::Decimal`.\n   396\t    Decimal,\n   397\t    /// `protos::Boolean`.\n   398\t    Boolean,\n   399\t    /// `datom_codec::Meaning`.\n   400\t    Meaning,\n   401\t    /// `Vec`.\n   402\t    Vector,\n   403\t    /// `Option`.\n   404\t    Option,\n   405\t    /// `Result`.\n   406\t    Result,\n   407\t    /// `Self`.\n   408\t    Itself,\n   409\t    /// `Sized`, the bound every corporate type bears.\n   410\t    Sized,\n   411\t}\n   412\t\n   413\t/// What a name resolves to in a scope.\n   414\t#[derive(Clone, Debug, PartialEq, Eq)]\n   415\tpub enum Resolution {\n   416\t    /// An intrinsic, written fully qualified.\n   417\t    Intrinsic(Intrinsic),\n   418\t    /// An imported name, written as the source's path and the source's name.\n   419\t    Imported(Source, Name),\n   420\t    /// A type declared in this file, written bare.\n   421\t    Type(Name),\n   422\t    /// A kind declared in this file, written bare.\n   423\t    Kind(Name),\n   424\t    /// The parameter bounded by the enclosing identity's constraint at this index.\n   425\t    Parameter(Integer),\n   426\t    /// More than one enclosing parameter has this name among its bounds.\n   427\t    ///\n   428\t    /// A body reference cannot say which parameter it means, even when the\n   429\t    /// constraints differ as whole groups.\n   430\t    Ambiguous(Name),\n   431\t    /// An associated type of the enclosing kind, written `Self::Name`.\n   432\t    Associated(Name),\n   433\t    /// A name nothing declares.\n   434\t    Undeclared,\n   435\t}\n   436\t\n   437\t/// What a reference is asked to be: a type in a type position, a kind in a bound.\n   438\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n   439\tpub enum Role {\n   440\t    /// A type: a position, an alias, an input, a yield, an argument.\n   441\t    Type,\n   442\t    /// A kind: a constraint, a superkind, a bound, an association.\n   443\t    Kind,\n   444\t}\n   445\t\n   446\t/// The scope a reference resolves in: the file, and the identity and associated types of the enclosing declaration.\n   447\t#[derive(Clone, Copy, Debug)]\n   448\tpub struct Scope<'a> {\n   449\t    /// The file whose imports and declarations are in scope.\n   450\t    pub file: &'a File,\n   451\t    /// The enclosing identity, whose single-kind constraints name parameters.\n   452\t    pub identity: Option<&'a Identity>,\n   453\t    /// The enclosing kind's associated types.\n   454\t    pub associated: &'a [AssociatedType],\n   455\t}\n   456\t\n   457\t// ---------------------------------------------------------------------------\n   458\t// Kinds\n   459\t// ---------------------------------------------------------------------------\n   460\t\n   461\t/// The kind whose capability yields the canonical form of an ethos text.\n   462\tpub trait Canonicalizable {\n   463\t    /// Open the sweet form into the braced form; the text is delineated to find its head.\n   464\t    fn canonicalize(&self) -> Result<Canonical, protos::Error>;\n   465\t}\n   466\t\n   467\t/// The kind whose capability maps an extent of the canonical text back onto the source text.\n   468\tpub trait Resituating {\n   469\t    /// Map an extent across the seam.\n   470\t    fn resituate(&self, extent: Extent) -> Extent;\n   471\t}\n   472\t\n   473\t/// The kind whose capability yields the ethos name of a value.\n   474\tpub trait Named {\n   475\t    /// The name as ethos writes it.\n   476\t    fn name(&self) -> &'static str;\n   477\t}\n   478\t\n   479\t/// The kind whose static capability identifies a variant from its ethos name, walking the variants.\n   480\tpub trait Identifiable: Sized {\n   481\t    /// Identify the variant named.\n   482\t    fn identify(name: &str) -> Option<Self>;\n   483\t}\n   484\t\n   485\t/// The kind whose capability yields which variant of [`File`] a value is.\n   486\tpub trait Rooted {\n   487\t    /// The head the file is written under.\n   488\t    fn root(&self) -> Root;\n   489\t}\n   490\t\n   491\t/// The kind whose capability resolves a name to what it names.\n   492\tpub trait Resolving {\n   493\t    /// Resolve a name.\n   494\t    fn resolve(&self, name: &Name) -> Resolution;\n   495\t}\n   496\t\n   497\t/// The kind whose capability checks a whole file and generates its Rust module.\n   498\tpub trait Generating {\n   499\t    /// The formatted Rust text, or the whole-file fault that prevents generation.\n   500\t    fn generate(&self) -> Result<String, Error>;\n   501\t}\n   502\t\n   503\t/// The kind whose capability actualizes Ethos text into its conceptual value.\n   504\tpub trait Actualizing<T> {\n   505\t    type Error;\n   506\t    fn actualize(&self) -> Result<T, Self::Error>;\n   507\t}\n   508\t\n   509\t/// The conversion from Protos structure to an Ethos concept.\n   510\tpub trait Ethosizable<T> {\n   511\t    type Error;\n   512\t    fn ethosize(&self) -> Result<T, Self::Error>;\n   513\t}\n   514\t\n   515\t/// The kind whose capability yields a conceptual fault's path and places it below a child.\n   516\tpub trait Pathed {\n   517\t    /// The path from the root form to this fault.\n   518\t    fn path(&self) -> &[Integer];\n   519\t    /// Prepend a child position to the path.\n   520\t    fn within(self, index: Integer) -> Self;\n   521\t}\n   522\t\n   523\t/// The kind whose capability places a result's fault under a child index.\n   524\tpub trait Placing {\n   525\t    /// Prepend the index to the fault's path.\n   526\t    fn place(self, index: Integer) -> Self;\n   527\t}\n   528\t\n   529\t/// The kind whose capability constructs a situated conceptual fault.\n   530\tpub trait ConceptualFaulting {\n   531\t    /// Construct the fault from its path and problem.\n   532\t    fn conceptual(integer_vector: Vec<Integer>, problem: Problem) -> Self;\n   533\t}\n   534\t\n   535\t/// The kind whose capability constructs an arity problem.\n   536\tpub trait ArityProblem {\n   537\t    /// Construct the problem from expected and actual arity.\n   538\t    fn arity(first_integer: Integer, second_integer: Integer) -> Self;\n   539\t}\n   540\t\n     1\t//! Generation: File to Rust text (cannot fault, the file having been checked).\n     2\t//!\n     3\t//! Each declaration emits itself: a struct declaration its struct and\n     4\t//! its datomic machinery, an enum declaration its enum and its\n     5\t//! machinery, a kind declaration its trait, an association its\n     6\t//! assertion; the file emits by walking its variant's sections. Names\n     7\t//! are resolved through the scope, never a table; the generated Rust\n     8\t//! carries no `use` and writes every foreign name fully qualified.\n     9\t//!\n    10\t//! One rule decides boxing: a position whose type reaches the type\n    11\t//! that declares it, walking through declared types, aliases, `Option`\n    12\t//! and `Result` but not through `Vector`, is boxed as a whole\n    13\t//! (`std::boxed::Box<std::option::Option<Tree>>`), and the datom machinery\n    14\t//! never sees the box.\n    15\t\n    16\tuse proc_macro2::{Ident, Span, TokenStream};\n    17\tuse quote::quote;\n    18\t\n    19\tuse crate::checking::{Checkable, Declaring};\n    20\tuse crate::{\n    21\t    AssociatedConstant, AssociatedType, Association, Capability, Constraint, File, Generating,\n    22\t    Identity, Intrinsic, KindBody, KindDeclaration, Name, Receiver, Reference, Resolution,\n    23\t    Resolving, Scope, Signature, Source, TypeDeclaration, Variant,\n    24\t};\n    25\t\n    26\t// ---------------------------------------------------------------------------\n    27\t// Tokens of names and sources\n    28\t// ---------------------------------------------------------------------------\n    29\t\n    30\t/// The kind whose capability yields a value's Rust tokens without any scope.\n    31\tpub(crate) trait Tokening {\n    32\t    fn tokens(&self) -> TokenStream;\n    33\t}\n    34\t\n    35\timpl Tokening for Name {\n    36\t    fn tokens(&self) -> TokenStream {\n    37\t        let ident = Ident::new(&self.0, Span::call_site());\n    38\t        quote! { #ident }\n    39\t    }\n    40\t}\n    41\t\n    42\timpl Tokening for Source {\n    43\t    fn tokens(&self) -> TokenStream {\n    44\t        let path: syn::Path =\n    45\t            syn::parse_str(self.as_ref()).expect(\"a source was validated as a path\");\n    46\t        quote! { #path }\n    47\t    }\n    48\t}\n    49\t\n    50\timpl Tokening for Intrinsic {\n    51\t    fn tokens(&self) -> TokenStream {\n    52\t        match self {\n    53\t            Intrinsic::String => quote! { String },\n    54\t            // Signal contracts must compile without their optional `datom`\n    55\t            // feature.  The wire-level integer is therefore the ordinary\n    56\t            // Rust scalar; Datom derives know how to compose it when enabled.\n    57\t            Intrinsic::Integer => quote! { i64 },\n    58\t            Intrinsic::Decimal => quote! { f64 },\n    59\t            Intrinsic::Boolean => quote! { bool },\n    60\t            Intrinsic::Meaning => quote! { datom_codec::Meaning },\n    61\t            Intrinsic::Vector => quote! { std::vec::Vec },\n    62\t            Intrinsic::Option => quote! { std::option::Option },\n    63\t            Intrinsic::Result => quote! { std::result::Result },\n    64\t            Intrinsic::Itself => quote! { Self },\n    65\t            Intrinsic::Sized => quote! { Sized },\n    66\t        }\n    67\t    }\n    68\t}\n    69\t\n    70\t/// The kind whose capability yields the name of the parameter at an index: A, B, C.\n    71\ttrait Lettering {\n    72\t    fn letter(&self, scope: &Scope) -> Ident;\n    73\t}\n    74\t\n    75\timpl Lettering for usize {\n    76\t    fn letter(&self, scope: &Scope) -> Ident {\n    77\t        let letter = char::from(b'A' + *self as u8);\n    78\t        let simple = Name::try_from(letter.to_string()).expect(\"static identifier\");\n    79\t        let allocated = if scope.file.declaration(&simple).is_none() {\n    80\t            simple\n    81\t        } else {\n    82\t            let mut allocated = Name::try_from(format!(\"{}EthosParameter\", simple.0))\n    83\t                .expect(\"parameter identifiers are identifiers\");\n    84\t            while scope.file.declaration(&allocated).is_some() {\n    85\t                allocated = Name::try_from(format!(\"{}X\", allocated.0))\n    86\t                    .expect(\"parameter identifiers are identifiers\");\n    87\t            }\n    88\t            allocated\n    89\t        };\n    90\t        Ident::new(&allocated.0, Span::call_site())\n    91\t    }\n    92\t}\n    93\t\n    94\t/// The kind whose capability lowercases a name for an assertion function.\n    95\ttrait Lowering {\n    96\t    fn lowered(&self) -> String;\n    97\t}\n    98\t\n    99\timpl Lowering for Reference {\n   100\t    fn lowered(&self) -> String {\n   101\t        let mut lowered = self.name.0.to_lowercase();\n   102\t        for argument in &self.arguments {\n   103\t            lowered.push('_');\n   104\t            lowered.push_str(&argument.lowered());\n   105\t        }\n   106\t        lowered\n   107\t    }\n   108\t}\n   109\t\n   110\t// ---------------------------------------------------------------------------\n   111\t// Emitting: Rust tokens in a scope\n   112\t// ---------------------------------------------------------------------------\n   113\t\n   114\t/// The kind whose capability yields a value's Rust tokens in a scope.\n   115\tpub(crate) trait Emitting {\n   116\t    fn emit(&self, scope: &Scope) -> TokenStream;\n   117\t}\n   118\t\n   119\timpl Emitting for Reference {\n   120\t    fn emit(&self, scope: &Scope) -> TokenStream {\n   121\t        let mut arguments = Vec::with_capacity(self.arguments.len());\n   122\t        for argument in &self.arguments {\n   123\t            arguments.push(argument.emit(scope));\n   124\t        }\n   125\t        let applied = if arguments.is_empty() {\n   126\t            TokenStream::new()\n   127\t        } else {\n   128\t            quote! { < #( #arguments ),* > }\n   129\t        };\n   130\t        let name = self.name.tokens();\n   131\t        if let Some(source) = &self.source {\n   132\t            let source = source.tokens();\n   133\t            return quote! { #source :: #name #applied };\n   134\t        }\n   135\t        match scope.resolve(&self.name) {\n   136\t            Resolution::Intrinsic(intrinsic) => {\n   137\t                let intrinsic = intrinsic.tokens();\n   138\t                quote! { #intrinsic #applied }\n   139\t            }\n   140\t            Resolution::Imported(source, emitted) => {\n   141\t                if source.as_ref() == \"std\" {\n   142\t                    if emitted.0 == \"Clone\" {\n   143\t                        return quote! { std::clone::Clone #applied };\n   144\t                    }\n   145\t                    if emitted.0 == \"Send\" {\n   146\t                        return quote! { std::marker::Send #applied };\n   147\t                    }\n   148\t                }\n   149\t                let source = source.tokens();\n   150\t                let emitted = emitted.tokens();\n   151\t                quote! { #source :: #emitted #applied }\n   152\t            }\n   153\t            Resolution::Type(_)\n   154\t            | Resolution::Kind(_)\n   155\t            | Resolution::Ambiguous(_)\n   156\t            | Resolution::Undeclared => {\n   157\t                quote! { #name #applied }\n   158\t            }\n   159\t            Resolution::Parameter(index) => {\n   160\t                let letter = (index as usize).letter(scope);\n   161\t                quote! { #letter }\n   162\t            }\n   163\t            Resolution::Associated(name) => {\n   164\t                let name = name.tokens();\n   165\t                quote! { Self::#name }\n   166\t            }\n   167\t        }\n   168\t    }\n   169\t}\n   170\t\n   171\t/// The kind whose capability yields the bounds of a constraint: `A + B`.\n   172\ttrait Bounding {\n   173\t    fn bounds(&self, scope: &Scope) -> TokenStream;\n   174\t}\n   175\t\n   176\timpl Bounding for Constraint {\n   177\t    fn bounds(&self, scope: &Scope) -> TokenStream {\n   178\t        let references = match self {\n   179\t            Constraint::One(reference) => std::slice::from_ref(reference),\n   180\t            Constraint::Many(references) => references,\n   181\t        };\n   182\t        references.bounds(scope)\n   183\t    }\n   184\t}\n   185\t\n   186\timpl Bounding for [Reference] {\n   187\t    fn bounds(&self, scope: &Scope) -> TokenStream {\n   188\t        let mut bounds = Vec::with_capacity(self.len());\n   189\t        for reference in self {\n   190\t            bounds.push(reference.emit(scope));\n   191\t        }\n   192\t        quote! { #( #bounds )+* }\n   193\t    }\n   194\t}\n   195\t\n   196\t/// The kind whose capabilities yield an identity's generics: the parameters with their bounds, and the arguments.\n   197\tpub(crate) trait Parametrizing {\n   198\t    fn parameters(&self, scope: &Scope) -> TokenStream;\n   199\t    fn arguments(&self, scope: &Scope) -> TokenStream;\n   200\t}\n   201\t\n   202\timpl Parametrizing for Identity {\n   203\t    fn parameters(&self, scope: &Scope) -> TokenStream {\n   204\t        if self.constraints.is_empty() {\n   205\t            return TokenStream::new();\n   206\t        }\n   207\t        // The bounds name kinds outside the identity they bound.\n   208\t        let outer = Scope {\n   209\t            file: scope.file,\n   210\t            identity: None,\n   211\t            associated: scope.associated,\n   212\t        };\n   213\t        let mut parameters = Vec::with_capacity(self.constraints.len());\n   214\t        for (index, constraint) in self.constraints.iter().enumerate() {\n   215\t            let letter = index.letter(scope);\n   216\t            let bounds = constraint.bounds(&outer);\n   217\t            parameters.push(quote! { #letter: #bounds });\n   218\t        }\n   219\t        quote! { < #( #parameters ),* > }\n   220\t    }\n   220\t    }\n   221\t\n   222\t    fn arguments(&self, scope: &Scope) -> TokenStream {\n   223\t        if self.constraints.is_empty() {\n   224\t            return TokenStream::new();\n   225\t        }\n   226\t        let mut letters = Vec::with_capacity(self.constraints.len());\n   227\t        for index in 0..self.constraints.len() {\n   228\t            letters.push(index.letter(scope));\n   229\t        }\n   230\t        quote! { < #( #letters ),* > }\n   231\t    }\n   232\t}\n   233\t\n   234\t// ---------------------------------------------------------------------------\n   235\t// Reaching: the boxing rule\n   236\t// ---------------------------------------------------------------------------\n   237\t\n   238\t/// The kind whose capability tells whether a value holds the target type by value, through declared types, aliases, Option and Result.\n   239\ttrait Reaching {\n   240\t    fn reaches(&self, target: &Name, file: &File, visited: &mut Vec<Name>) -> bool;\n   241\t}\n   242\t\n   243\timpl Reaching for Reference {\n   244\t    fn reaches(&self, target: &Name, file: &File, visited: &mut Vec<Name>) -> bool {\n   245\t        if self.source.is_none() {\n   246\t            if &self.name == target || self.name.0 == \"Self\" {\n   247\t                return true;\n   248\t            }\n   249\t            match file.resolve(&self.name) {\n   250\t                Resolution::Intrinsic(Intrinsic::Vector) => return false,\n   251\t                Resolution::Type(name) if !visited.contains(&name) => {\n   252\t                    visited.push(name.clone());\n   253\t                    if let Some(declaration) = file.declaration(&name)\n   254\t                        && declaration.reaches(target, file, visited)\n   255\t                    {\n   256\t                        return true;\n   257\t                    }\n   258\t                }\n   259\t                _ => {}\n   260\t            }\n   261\t        }\n   262\t        for argument in &self.arguments {\n   263\t            if argument.reaches(target, file, visited) {\n   264\t                return true;\n   265\t            }\n   266\t        }\n   267\t        false\n   268\t    }\n   269\t}\n   270\t\n   271\timpl Reaching for [Reference] {\n   272\t    fn reaches(&self, target: &Name, file: &File, visited: &mut Vec<Name>) -> bool {\n   273\t        for reference in self {\n   274\t            if reference.reaches(target, file, visited) {\n   275\t                return true;\n   276\t            }\n   277\t        }\n   278\t        false\n   279\t    }\n   280\t}\n   281\t\n   282\timpl Reaching for TypeDeclaration {\n   283\t    fn reaches(&self, target: &Name, file: &File, visited: &mut Vec<Name>) -> bool {\n   284\t        match self {\n   285\t            TypeDeclaration::Struct(_, positions) => positions.reaches(target, file, visited),\n   286\t            TypeDeclaration::Enum(_, variants) => variants.reaches(target, file, visited),\n   287\t            TypeDeclaration::Alias(_, aliased) => aliased.reaches(target, file, visited),\n   288\t        }\n   289\t    }\n   290\t}\n   291\t\n   292\timpl Reaching for Variant {\n   293\t    fn reaches(&self, target: &Name, file: &File, visited: &mut Vec<Name>) -> bool {\n   294\t        match self {\n   295\t            Variant::Bare(_) => false,\n   296\t            Variant::Typed(_, reference) => reference.reaches(target, file, visited),\n   297\t            Variant::Struct(_, positions) => positions.reaches(target, file, visited),\n   298\t            Variant::Enum(_, variants) => variants.reaches(target, file, visited),\n   299\t        }\n   300\t    }\n   301\t}\n   302\t\n   303\timpl Reaching for [Variant] {\n   304\t    fn reaches(&self, target: &Name, file: &File, visited: &mut Vec<Name>) -> bool {\n   305\t        for variant in self {\n   306\t            if variant.reaches(target, file, visited) {\n   307\t                return true;\n   308\t            }\n   309\t        }\n   310\t        false\n   311\t    }\n   312\t}\n   313\t\n   314\t/// The kind whose capabilities yield a position's Rust type, boxed when it reaches its owner.\n   315\tpub(crate) trait Positioning {\n   316\t    fn boxed(&self, scope: &Scope, owner: &Name) -> bool;\n   317\t    fn position(&self, scope: &Scope, owner: &Name) -> TokenStream;\n   318\t}\n   319\t\n   320\timpl Positioning for Reference {\n   321\t    fn boxed(&self, scope: &Scope, owner: &Name) -> bool {\n   322\t        self.reaches(owner, scope.file, &mut vec![])\n   323\t    }\n   324\t\n   325\t    fn position(&self, scope: &Scope, owner: &Name) -> TokenStream {\n   326\t        // Put the indirection immediately around the recursive argument.\n   327\t        // `Option<Box<Tree>>` lets the Datom derive see the recursive edge,\n   328\t        // while `Box<Option<Tree>>` hides it behind the container and causes\n   329\t        // an infinitely recursive derive bound.\n   330\t        if self.source.is_none()\n   331\t            && matches!(\n   332\t                scope.file.resolve(&self.name),\n   333\t                Resolution::Intrinsic(Intrinsic::Option | Intrinsic::Result)\n   334\t            )\n   335\t        {\n   336\t            let name = self.name.tokens();\n   337\t            let mut arguments = Vec::with_capacity(self.arguments.len());\n   338\t            for argument in &self.arguments {\n   339\t                let ty = if argument.boxed(scope, owner) {\n   340\t                    let inner = argument.emit(scope);\n   341\t                    quote! { std::boxed::Box<#inner> }\n   342\t                } else {\n   343\t                    argument.emit(scope)\n   344\t                };\n   345\t                arguments.push(ty);\n   346\t            }\n   347\t            return quote! { #name < #( #arguments ),* > };\n   348\t        }\n   349\t\n   350\t        let ty = self.emit(scope);\n   351\t        if self.boxed(scope, owner) {\n   352\t            quote! { std::boxed::Box<#ty> }\n   353\t        } else {\n   354\t            ty\n   355\t        }\n   356\t    }\n   357\t}\n   358\t\n   359\ttrait Fielding {\n   360\t    fn field_base(&self) -> String;\n   361\t}\n   362\t\n   363\ttrait SnakeCasing {\n   364\t    fn snake_case(&self) -> String;\n   365\t}\n   366\t\n   367\timpl SnakeCasing for str {\n   368\t    fn snake_case(&self) -> String {\n   369\t        let characters: Vec<char> = self.chars().collect();\n   370\t        let mut result = String::new();\n   371\t        for (index, character) in characters.iter().enumerate() {\n   372\t            let previous = index.checked_sub(1).and_then(|i| characters.get(i));\n   373\t            let next = characters.get(index + 1);\n   374\t            if character.is_uppercase()\n   375\t                && index != 0\n   376\t                && (previous.is_some_and(|previous| previous.is_lowercase())\n   377\t                    || next.is_some_and(|next| next.is_lowercase()))\n   378\t            {\n   379\t                result.push('_');\n   380\t            }\n   381\t            result.extend(character.to_lowercase());\n   382\t        }\n   383\t        result\n   384\t    }\n   385\t}\n   386\t\n   387\timpl Fielding for Reference {\n   388\t    fn field_base(&self) -> String {\n   389\t        let mut parts: Vec<String> = self.arguments.iter().map(Self::field_base).collect();\n   390\t        parts.push(self.name.0.as_str().snake_case());\n   391\t        parts.join(\"_\")\n   392\t    }\n   393\t}\n   394\t\n   395\ttrait Ordinaling {\n   396\t    fn ordinal(&self) -> &'static str;\n   397\t}\n   398\t\n   399\timpl Ordinaling for usize {\n   400\t    fn ordinal(&self) -> &'static str {\n   401\t        match self {\n   402\t            0 => \"first\",\n   403\t            1 => \"second\",\n   404\t            2 => \"third\",\n   405\t            3 => \"fourth\",\n   406\t            4 => \"fifth\",\n   407\t            5 => \"sixth\",\n   408\t            6 => \"seventh\",\n   409\t            7 => \"eighth\",\n   410\t            8 => \"ninth\",\n   411\t            9 => \"tenth\",\n   412\t            _ => \"position\",\n   413\t        }\n   414\t    }\n   415\t}\n   416\t\n   417\ttrait FieldNaming {\n   418\t    fn field_names(&self) -> Vec<Ident>;\n   419\t}\n   420\t\n   421\timpl FieldNaming for [Reference] {\n   422\t    fn field_names(&self) -> Vec<Ident> {\n   423\t        let bases: Vec<String> = self.iter().map(Reference::field_base).collect();\n   424\t        let mut fields = Vec::with_capacity(bases.len());\n   425\t        for (index, base) in bases.iter().enumerate() {\n   426\t            let repetitions = bases.iter().filter(|other| *other == base).count();\n   427\t            let prior = bases[..index].iter().filter(|other| *other == base).count();\n   428\t            let name = if repetitions == 1 {\n   429\t                base.clone()\n   430\t            } else if prior < 10 {\n   431\t                format!(\"{}_{}\", prior.ordinal(), base)\n   432\t            } else {\n   433\t                format!(\"position_{}_{}\", prior + 1, base)\n   434\t            };\n   435\t            let field = if syn::parse_str::<Ident>(&name).is_ok() {\n   436\t                Ident::new(&name, Span::call_site())\n   437\t            } else {\n   438\t                Ident::new_raw(&name, Span::call_site())\n   439\t            };\n   440\t            fields.push(field);\n   441\t        }\n   442\t        fields\n   443\t    }\n   444\t}\n   445\t\n   446\t/// The kind whose capabilities yield a variant's definition and the items its inline enum needs.\n   447\ttrait Varianted {\n   448\t    fn definition(&self, scope: &Scope, owner: &Name, enclosing: &Identity) -> TokenStream;\n   449\t    fn nested(\n   450\t        &self,\n   451\t        scope: &Scope,\n   452\t        owner: &Name,\n   453\t        enclosing: &Identity,\n   454\t        conditional: bool,\n   455\t    ) -> TokenStream;\n   456\t}\n   457\t\n   458\t/// The kind whose capability names the enum type an inline enum variant declares.\n   459\ttrait Nesting {\n   460\t    fn nested_identity(&self, name: &Name) -> Identity;\n   461\t}\n   462\t\n   463\timpl Nesting for Identity {\n   464\t    fn nested_identity(&self, name: &Name) -> Identity {\n   465\t        let stem = if self.name.0.ends_with(\"_Data\") {\n   466\t            format!(\"{}_{}\", self.name.0, name.0)\n   467\t        } else {\n   468\t            name.0.clone()\n   469\t        };\n   470\t        let name = Name::try_from(format!(\"{stem}_Data\"))\n   470\t        let name = Name::try_from(format!(\"{stem}_Data\"))\n   471\t            .expect(\"derived inline identifiers are identifiers\");\n   472\t        Identity {\n   473\t            name,\n   474\t            constraints: self.constraints.clone(),\n   475\t        }\n   476\t    }\n   477\t}\n   478\t\n   479\timpl Varianted for Variant {\n   480\t    fn definition(&self, scope: &Scope, owner: &Name, enclosing: &Identity) -> TokenStream {\n   481\t        match self {\n   482\t            Variant::Bare(name) => {\n   483\t                let variant = name.tokens();\n   484\t                if scope.file.declaration(name).is_some() {\n   485\t                    let ty = name.tokens();\n   486\t                    quote! { #variant(#ty) }\n   487\t                } else {\n   488\t                    quote! { #variant }\n   489\t                }\n   490\t            }\n   491\t            Variant::Typed(name, reference) => {\n   492\t                let name = name.tokens();\n   493\t                let ty = reference.position(scope, owner);\n   494\t                quote! { #name(#ty) }\n   495\t            }\n   496\t            Variant::Struct(name, _) | Variant::Enum(name, _) => {\n   497\t                let nested = enclosing.nested_identity(name);\n   498\t                let ty = nested.name.tokens();\n   499\t                let arguments = nested.arguments(scope);\n   500\t                let name = name.tokens();\n   501\t                quote! { #name(#ty #arguments) }\n   502\t            }\n   503\t        }\n   504\t    }\n   505\t\n   506\t    fn nested(\n   507\t        &self,\n   508\t        scope: &Scope,\n   509\t        owner: &Name,\n   510\t        enclosing: &Identity,\n   511\t        conditional: bool,\n   512\t    ) -> TokenStream {\n   513\t        match self {\n   514\t            Variant::Struct(name, positions) => {\n   515\t                let nested = enclosing.nested_identity(name);\n   516\t                positions.structure(scope, owner, &nested, conditional)\n   517\t            }\n   518\t            Variant::Enum(name, variants) => {\n   519\t                let nested = enclosing.nested_identity(name);\n   520\t                variants.enumeration(scope, owner, &nested, conditional)\n   521\t            }\n   522\t            Variant::Bare(_) | Variant::Typed(_, _) => TokenStream::new(),\n   523\t        }\n   524\t    }\n   525\t}\n   526\t\n   527\t// ---------------------------------------------------------------------------\n   528\t// Declaring: the items a type declaration emits\n   529\t// ---------------------------------------------------------------------------\n   530\t\n   531\t/// The kind whose capability emits a struct of these positions with its datomic machinery.\n   532\ttrait Structuring {\n   533\t    fn structure(\n   534\t        &self,\n   535\t        scope: &Scope,\n   536\t        owner: &Name,\n   537\t        identity: &Identity,\n   538\t        conditional: bool,\n   539\t    ) -> TokenStream;\n   540\t}\n   541\t\n   542\t/// The kind whose capability emits an enum of these variants with its datomic machinery.\n   543\ttrait Enumerating {\n   544\t    fn enumeration(\n   545\t        &self,\n   546\t        scope: &Scope,\n   547\t        owner: &Name,\n   548\t        identity: &Identity,\n   549\t        conditional: bool,\n   550\t    ) -> TokenStream;\n   551\t}\n   552\t\n   553\ttrait DatomDeriving {\n   554\t    fn datom_derives(&self) -> TokenStream;\n   555\t}\n   556\t\n   557\timpl DatomDeriving for bool {\n   558\t    fn datom_derives(&self) -> TokenStream {\n   559\t        if *self {\n   560\t            quote! {\n   561\t                #[derive(rkyv::Archive, rkyv::Serialize, rkyv::Deserialize, Clone, Debug, PartialEq)]\n   562\t                #[cfg_attr(feature = \"datom\", derive(datom_codec::Datomizable, datom_codec::Compositional))]\n   563\t            }\n   564\t        } else {\n   565\t            quote! {\n   566\t                #[derive(datom_codec::Datomizable, datom_codec::Compositional, Clone, Debug, PartialEq)]\n   567\t            }\n   568\t        }\n   569\t    }\n   570\t}\n   571\t\n   572\timpl Structuring for [Reference] {\n   573\t    fn structure(\n   574\t        &self,\n   575\t        scope: &Scope,\n   576\t        owner: &Name,\n   577\t        identity: &Identity,\n   578\t        conditional: bool,\n   579\t    ) -> TokenStream {\n   580\t        let name = identity.name.tokens();\n   581\t        let parameters = identity.parameters(scope);\n   582\t        let mut types = Vec::with_capacity(self.len());\n   583\t        for position in self {\n   584\t            types.push(position.position(scope, owner));\n   585\t        }\n   586\t        let fields = self.field_names();\n   587\t        let derive = conditional.datom_derives();\n   588\t        quote! {\n   589\t            #derive\n   590\t            pub struct #name #parameters { #( pub #fields: #types ),* }\n   591\t        }\n   592\t    }\n   593\t}\n   594\t\n   595\timpl Enumerating for [Variant] {\n   596\t    fn enumeration(\n   597\t        &self,\n   598\t        scope: &Scope,\n   599\t        owner: &Name,\n   600\t        identity: &Identity,\n   601\t        conditional: bool,\n   602\t    ) -> TokenStream {\n   603\t        let name = identity.name.tokens();\n   604\t        let parameters = identity.parameters(scope);\n   605\t        let derive = conditional.datom_derives();\n   606\t        let mut definitions = Vec::with_capacity(self.len());\n   607\t        let mut nested = Vec::new();\n   608\t        for variant in self {\n   609\t            definitions.push(variant.definition(scope, owner, identity));\n   610\t            nested.push(variant.nested(scope, owner, identity, conditional));\n   611\t        }\n   612\t        quote! {\n   613\t            #( #nested )*\n   614\t            #derive\n   615\t            pub enum #name #parameters { #( #definitions ),* }\n   616\t        }\n   617\t    }\n   618\t}\n   619\t\n   620\timpl Emitting for TypeDeclaration {\n   621\t    fn emit(&self, scope: &Scope) -> TokenStream {\n   622\t        match self {\n   623\t            TypeDeclaration::Struct(identity, positions) => {\n   624\t                let inner = Scope {\n   625\t                    file: scope.file,\n   626\t                    identity: Some(identity),\n   627\t                    associated: scope.associated,\n   628\t                };\n   629\t                positions.structure(\n   630\t                    &inner,\n   631\t                    &identity.name,\n   632\t                    identity,\n   633\t                    matches!(scope.file, File::Signal(_)),\n   634\t                )\n   635\t            }\n   636\t            TypeDeclaration::Enum(identity, variants) => {\n   637\t                let inner = Scope {\n   638\t                    file: scope.file,\n   639\t                    identity: Some(identity),\n   640\t                    associated: scope.associated,\n   641\t                };\n   642\t                variants.enumeration(\n   643\t                    &inner,\n   644\t                    &identity.name,\n   645\t                    identity,\n   646\t                    matches!(scope.file, File::Signal(_)),\n   647\t                )\n   648\t            }\n   649\t            TypeDeclaration::Alias(identity, aliased) => {\n   650\t                let inner = Scope {\n   651\t                    file: scope.file,\n   652\t                    identity: Some(identity),\n   653\t                    associated: scope.associated,\n   654\t                };\n   655\t                let name = identity.name.tokens();\n   656\t                let parameters = identity.parameters(&inner);\n   657\t                let aliased = aliased.emit(&inner);\n   658\t                quote! { pub type #name #parameters = #aliased; }\n   659\t            }\n   660\t        }\n   661\t    }\n   662\t}\n   663\t\n   664\t// ---------------------------------------------------------------------------\n   665\t// Kinds: traits\n   666\t// ---------------------------------------------------------------------------\n   667\t\n   668\t/// The named sections that compose a kind declaration.\n   669\tstruct KindContents<'a> {\n   670\t    superkinds: &'a [Reference],\n   671\t    types: &'a [AssociatedType],\n   672\t    constants: &'a [AssociatedConstant],\n   673\t    capabilities: &'a [Capability],\n   674\t}\n   675\t\n   676\t/// The kind whose capability exposes a declaration's named kind sections.\n   677\ttrait Containing {\n   678\t    fn contents(&self) -> KindContents<'_>;\n   679\t}\n   680\t\n   680\t\n   681\timpl Containing for KindDeclaration {\n   682\t    fn contents(&self) -> KindContents<'_> {\n   683\t        match &self.body {\n   684\t            KindBody::Simple(capabilities) => KindContents {\n   685\t                superkinds: &[],\n   686\t                types: &[],\n   687\t                constants: &[],\n   688\t                capabilities,\n   689\t            },\n   690\t            KindBody::Complex {\n   691\t                superkinds,\n   692\t                types,\n   693\t                constants,\n   694\t                capabilities,\n   695\t            } => KindContents {\n   696\t                superkinds,\n   697\t                types,\n   698\t                constants,\n   699\t                capabilities,\n   700\t            },\n   701\t        }\n   702\t    }\n   703\t}\n   704\t\n   705\timpl Emitting for AssociatedType {\n   706\t    fn emit(&self, scope: &Scope) -> TokenStream {\n   707\t        let name = self.name.tokens();\n   708\t        if self.bounds.is_empty() {\n   709\t            quote! { type #name; }\n   710\t        } else {\n   711\t            let bounds = self.bounds.bounds(scope);\n   712\t            quote! { type #name: #bounds; }\n   713\t        }\n   714\t    }\n   715\t}\n   716\t\n   717\timpl Emitting for AssociatedConstant {\n   718\t    fn emit(&self, scope: &Scope) -> TokenStream {\n   719\t        let name = self.name.tokens();\n   720\t        let ty = self.ty.emit(scope);\n   721\t        quote! { const #name: #ty; }\n   722\t    }\n   723\t}\n   724\t\n   725\timpl Emitting for Capability {\n   726\t    fn emit(&self, scope: &Scope) -> TokenStream {\n   727\t        let name = self.name.tokens();\n   728\t        let mut parameters = Vec::new();\n   729\t        match self.receiver {\n   730\t            Receiver::Shared => parameters.push(quote! { &self }),\n   731\t            Receiver::Mutable => parameters.push(quote! { &mut self }),\n   732\t            Receiver::Static => {}\n   733\t        }\n   734\t        let yields = match &self.signature {\n   735\t            Signature::Yielding(yields) => yields,\n   736\t            Signature::Taking(inputs, yields) => {\n   737\t                if let [input] = inputs.as_slice() {\n   738\t                    let ty = input.emit(scope);\n   739\t                    parameters.push(quote! { input: #ty });\n   740\t                } else {\n   741\t                    for (index, input) in inputs.iter().enumerate() {\n   742\t                        let input_name = Ident::new(&format!(\"input_{index}\"), Span::call_site());\n   743\t                        let ty = input.emit(scope);\n   744\t                        parameters.push(quote! { #input_name: #ty });\n   745\t                    }\n   746\t                }\n   747\t                yields\n   748\t            }\n   749\t        };\n   750\t        let yields = yields.emit(scope);\n   751\t        let sized = if self.contains_self() {\n   752\t            quote! { where Self: Sized }\n   753\t        } else {\n   754\t            TokenStream::new()\n   755\t        };\n   756\t        quote! { fn #name( #( #parameters ),* ) -> #yields #sized; }\n   757\t    }\n   758\t}\n   759\t\n   760\t/// Whether a capability signature mentions `Self`, which requires a sized\n   761\t/// trait receiver when lowered into Rust's sized generic constructors.\n   762\ttrait SelfContaining {\n   763\t    fn contains_self(&self) -> bool;\n   764\t}\n   765\t\n   766\timpl SelfContaining for Reference {\n   767\t    fn contains_self(&self) -> bool {\n   768\t        (self.source.is_none() && self.name.0 == \"Self\")\n   769\t            || self.arguments.iter().any(SelfContaining::contains_self)\n   770\t    }\n   771\t}\n   772\t\n   773\timpl SelfContaining for Capability {\n   774\t    fn contains_self(&self) -> bool {\n   775\t        match &self.signature {\n   776\t            Signature::Yielding(yielded) => yielded.contains_self(),\n   777\t            Signature::Taking(inputs, yielded) => {\n   778\t                inputs.iter().any(SelfContaining::contains_self) || yielded.contains_self()\n   779\t            }\n   780\t        }\n   781\t    }\n   782\t}\n   783\t\n   784\timpl Emitting for KindDeclaration {\n   785\t    fn emit(&self, scope: &Scope) -> TokenStream {\n   786\t        let KindContents {\n   787\t            superkinds,\n   788\t            types,\n   789\t            constants,\n   790\t            capabilities,\n   791\t        } = self.contents();\n   792\t        let inner = Scope {\n   793\t            file: scope.file,\n   794\t            identity: Some(&self.identity),\n   795\t            associated: types,\n   796\t        };\n   797\t        let name = self.identity.name.tokens();\n   798\t        let parameters = self.identity.parameters(&inner);\n   799\t        let extends = if superkinds.is_empty() {\n   800\t            TokenStream::new()\n   801\t        } else {\n   802\t            let bounds = superkinds.bounds(&inner);\n   803\t            quote! { : #bounds }\n   804\t        };\n   805\t        let mut items = Vec::new();\n   806\t        for associated in types {\n   807\t            items.push(associated.emit(&inner));\n   808\t        }\n   809\t        for constant in constants {\n   810\t            items.push(constant.emit(&inner));\n   811\t        }\n   812\t        for capability in capabilities {\n   813\t            items.push(capability.emit(&inner));\n   814\t        }\n   815\t        quote! {\n   816\t            pub trait #name #parameters #extends { #( #items )* }\n   817\t        }\n   818\t    }\n   819\t}\n   820\t\n   821\t// ---------------------------------------------------------------------------\n   822\t// Associations: compile-time assertions\n   823\t// ---------------------------------------------------------------------------\n   824\t\n   825\timpl Emitting for Association {\n   826\t    fn emit(&self, scope: &Scope) -> TokenStream {\n   827\t        let inner = Scope {\n   828\t            file: scope.file,\n   829\t            identity: Some(&self.identity),\n   830\t            associated: scope.associated,\n   831\t        };\n   832\t        let subject = Reference {\n   833\t            source: None,\n   834\t            name: self.identity.name.clone(),\n   835\t            arguments: vec![],\n   836\t        };\n   837\t        let ty = subject.emit(scope);\n   838\t        let arguments = self.identity.arguments(&inner);\n   839\t        let parameters = self.identity.parameters(&inner);\n   840\t        let mut assertions = Vec::with_capacity(self.kinds.len());\n   841\t        for kind in &self.kinds {\n   842\t            let assertion = Ident::new(\n   843\t                &format!(\n   844\t                    \"assert_{}_{}\",\n   845\t                    self.identity.name.0.to_lowercase(),\n   846\t                    kind.lowered()\n   847\t                ),\n   848\t                Span::call_site(),\n   849\t            );\n   850\t            let bound = kind.emit(scope);\n   851\t            if self.identity.constraints.is_empty() {\n   852\t                assertions.push(quote! {\n   853\t                    fn #assertion<T: #bound>() {}\n   854\t                    let _ = #assertion::<#ty>;\n   855\t                });\n   856\t            } else {\n   857\t                assertions.push(quote! {\n   858\t                    fn #assertion #parameters () {\n   859\t                        fn assertion<T: #bound>() {}\n   860\t                        let _ = assertion::<#ty #arguments>;\n   861\t                    }\n   862\t                });\n   863\t            }\n   864\t        }\n   865\t        quote! { const _: () = { #( #assertions )* }; }\n   866\t    }\n   867\t}\n   868\t\n   869\t// ---------------------------------------------------------------------------\n   870\t// The file: its sections walked\n   871\t// ---------------------------------------------------------------------------\n   872\t\n   873\timpl Emitting for File {\n   874\t    fn emit(&self, scope: &Scope) -> TokenStream {\n   875\t        // prettyplease owns each generated item's canonical text. rustfmt makes\n   876\t        // different width decisions for aliases and ordinary items, so each\n   877\t        // generated item is excluded individually while every authored Rust\n   878\t        // item remains checked by the repository formatter.\n   879\t        let mut items = Vec::new();\n   880\t        match self {\n   881\t            File::Library(library) => {\n   882\t                for declaration in &library.types {\n   883\t                    items.push(declaration.emit(scope));\n   884\t                }\n   885\t                for declaration in &library.kinds {\n   886\t                    items.push(declaration.emit(scope));\n   887\t                }\n   888\t                for association in &library.associations {\n   889\t                    items.push(association.emit(scope));\n   890\t                }\n   891\t            }\n   892\t            File::Signal(signal) => {\n   893\t                for declaration in &signal.types {\n   894\t                    items.push(declaration.emit(scope));\n   895\t                }\n   896\t                let request = TypeDeclaration::Enum(\n   897\t                    Identity {\n   898\t                        name: Name::try_from(\"Query\").expect(\"static identifier\"),\n   899\t                        constraints: vec![],\n   900\t                    },\n   901\t                    signal.requests.clone(),\n   902\t                );\n   903\t                let response = TypeDeclaration::Enum(\n   904\t                    Identity {\n   905\t                        name: Name::try_from(\"Response\").expect(\"static identifier\"),\n   906\t                        constraints: vec![],\n   907\t                    },\n   908\t                    signal.responses.clone(),\n   909\t                );\n   910\t                if !signal.requests.is_empty() {\n   911\t                    items.push(request.emit(scope));\n   912\t                }\n   913\t                if !signal.responses.is_empty() {\n   914\t                    items.push(response.emit(scope));\n   915\t                }\n   916\t            }\n   917\t            File::Sema(sema) => {\n   918\t                for declaration in &sema.types {\n   919\t                    items.push(declaration.emit(scope));\n   920\t                }\n   921\t            }\n   922\t        }\n   923\t        quote! {\n   924\t            #![allow(dead_code, non_camel_case_types, non_snake_case)]\n   925\t            #( #[rustfmt::skip] #items )*\n   926\t        }\n   927\t    }\n   928\t}\n   929\t\n   930\timpl Generating for File {\n   931\t    fn generate(&self) -> Result<String, crate::Error> {\n   932\t        let scope = Scope {\n   933\t            file: self,\n   934\t            identity: None,\n   935\t            associated: &[],\n   936\t        };\n   937\t        self.check(&scope)?;\n   938\t        let tokens = self.emit(&scope);\n   939\t        let file: syn::File = syn::parse2(tokens).expect(\"generated tokens are a Rust file\");\n   940\t        Ok(prettyplease::unparse(&file))\n   941\t    }\n   942\t}\n     1\t//! Canonicalization: sweet Text to canonical Text (the mechanical conversion).\n     2\t//!\n     3\t//! An ethos file is written in the sweet form: the root's head, then the\n     4\t//! sections as siblings. The reader sees only the braced form. The\n     5\t//! conversion is mechanical and structural: the sweet text is\n     6\t//! delineated, and when its first structure is a bare head, `.{` is\n     7\t//! inserted right after it and a closing brace appended on its own\n     8\t//! line. A text already in the braced form is left as it is.\n     9\t\n    10\tuse protos::{Extent, Protos, Protosizable};\n    11\t\n    12\tuse crate::{Canonical, Canonicalizable, Resituating};\n    13\t\n    14\timpl Canonicalizable for String {\n    15\t    fn canonicalize(&self) -> Result<Canonical, protos::Error> {\n    16\t        let mut head_start = 0;\n    17\t        let mut offset = 0;\n    18\t        for line in self.split_inclusive('\\n') {\n    19\t            let trimmed = line.trim_start();\n    20\t            if !trimmed.is_empty() && !trimmed.starts_with(';') {\n    21\t                head_start = offset + (line.len() - trimmed.len());\n    22\t                break;\n    23\t            }\n    24\t            offset += line.len();\n    25\t        }\n    26\t        let head_end = head_start\n    27\t            + self[head_start..]\n    28\t                .find(char::is_whitespace)\n    29\t                .unwrap_or(self.len() - head_start);\n    30\t        if self[head_start..head_end]\n    31\t            .chars()\n    32\t            .all(|glyph| glyph.is_ascii_alphabetic())\n    33\t            && !self[head_end..].trim_start().starts_with(\".{\")\n    34\t        {\n    35\t            let mut text = String::with_capacity(self.len() + 4);\n    36\t            text.push_str(&self[..head_end]);\n    37\t            text.push_str(\".{\");\n    38\t            text.push_str(&self[head_end..]);\n    39\t            text.push_str(\"\\n}\");\n    40\t            return Ok(Canonical {\n    41\t                text,\n    42\t                seam: Extent {\n    43\t                    start: head_end,\n    44\t                    end: head_end + 2,\n    45\t                },\n    46\t            });\n    47\t        }\n    48\t        let protos = <str as Protosizable>::protosize(self)?;\n    49\t        if let Protos::Bare { extent, .. } = protos {\n    50\t            let end = extent.end;\n    51\t            let mut text = String::with_capacity(self.len() + 4);\n    52\t            text.push_str(&self[..end]);\n    53\t            text.push_str(\".{\");\n    54\t            text.push_str(&self[end..]);\n    55\t            text.push_str(\"\\n}\");\n    56\t            return Ok(Canonical {\n    57\t                text,\n    58\t                seam: Extent {\n    59\t                    start: end,\n    60\t                    end: end + 2,\n    61\t                },\n    62\t            });\n    63\t        }\n    64\t        Ok(Canonical {\n    65\t            text: self.clone(),\n    66\t            seam: Extent { start: 0, end: 0 },\n    67\t        })\n    68\t    }\n    69\t}\n    70\t\n    71\t/// The kind whose capability maps one position across the seam.\n    72\ttrait Shifting {\n    73\t    fn shift(&self, position: usize) -> usize;\n    74\t}\n    75\t\n    76\timpl Shifting for Canonical {\n    77\t    fn shift(&self, position: usize) -> usize {\n    78\t        let Extent { start, end } = self.seam;\n    79\t        let inserted = end - start;\n    80\t        let source_end = self.text.len() - 2 * inserted;\n    81\t        if position <= start {\n    82\t            position\n    83\t        } else if position < end {\n    84\t            start\n    85\t        } else {\n    86\t            (position - inserted).min(source_end)\n    87\t        }\n    88\t    }\n    89\t}\n    90\t\n    91\timpl Resituating for Canonical {\n    92\t    fn resituate(&self, extent: Extent) -> Extent {\n    93\t        Extent {\n    94\t            start: self.shift(extent.start),\n    95\t            end: self.shift(extent.end),\n    96\t        }\n    97\t    }\n    98\t}\n     1\t//! Actualization: textual Ethos to its one conceptual File.\n     2\t\n     3\tuse protos::Protosizable;\n     4\t\n     5\tuse crate::{\n     6\t    Actualizing, Canonicalizable, Error, Ethosizable, File, Potential, Resituating,\n     7\t    Structural_Error,\n     8\t};\n     9\t\n    10\timpl Actualizing<File> for Potential<File> {\n    11\t    type Error = Error;\n    12\t\n    13\t    fn actualize(&self) -> Result<File, Self::Error> {\n    14\t        let canonical = self.0.canonicalize().map_err(|error| {\n    15\t            Error::Structural(Structural_Error {\n    16\t                extent: error.extent,\n    17\t                problem: error.problem,\n    18\t            })\n    19\t        })?;\n    20\t        let protos = canonical.text.protosize().map_err(|error| {\n    21\t            Error::Structural(Structural_Error {\n    22\t                extent: canonical.resituate(error.extent),\n    23\t                problem: error.problem,\n    24\t            })\n    25\t        })?;\n    26\t        protos.ethosize()\n    27\t    }\n    28\t}\n     1\t//! A generated Signal contract is a Rust-only surface when its optional\n     2\t//! `datom` feature is absent.  This deliberately compiles it in a separate\n     3\t//! Cargo package with no `datom-codec` dependency.\n     4\t\n     5\tuse std::process::Command;\n     6\t\n     7\t#[test]\n     8\tfn generated_signal_compiles_without_datom_codec() {\n     9\t    let directory = format!(\n    10\t        \"{}/signal-without-datom-{}\",\n    11\t        env!(\"CARGO_TARGET_TMPDIR\"),\n    12\t        std::process::id()\n    13\t    );\n    14\t    let _ = std::fs::remove_dir_all(&directory);\n    15\t    std::fs::create_dir_all(format!(\"{directory}/src\")).expect(\"temporary source directory\");\n    16\t    std::fs::write(\n    17\t        format!(\"{directory}/Cargo.toml\"),\n    18\t        \"[package]\\nname = \\\"signal-without-datom\\\"\\nversion = \\\"0.1.0\\\"\\nedition = \\\"2024\\\"\\n[features]\\ndatom = []\\n[dependencies]\\nrkyv = { version = \\\"0.8\\\", default-features = false, features = [\\\"std\\\", \\\"bytecheck\\\", \\\"little_endian\\\", \\\"pointer_width_32\\\", \\\"unaligned\\\"] }\\n\",\n    19\t    )\n    20\t    .expect(\"temporary manifest\");\n    21\t    std::fs::write(\n    22\t        format!(\"{directory}/src/lib.rs\"),\n    23\t        include_str!(\"generated/orchestrate.rs\"),\n    24\t    )\n    25\t    .expect(\"generated Signal source\");\n    26\t\n    27\t    let status = Command::new(\"cargo\")\n    28\t        .args([\n    29\t            \"check\",\n    30\t            \"--manifest-path\",\n    31\t            &format!(\"{directory}/Cargo.toml\"),\n    32\t            \"--no-default-features\",\n    33\t        ])\n    34\t        .status()\n    35\t        .expect(\"cargo is available\");\n    36\t    assert!(\n    37\t        status.success(),\n    38\t        \"generated Signal must not require datom-codec\"\n    39\t    );\n    40\t}\n    41\t\n    42\t#[test]\n    43\tfn generated_operation_free_signal_compiles_without_datom_codec() {\n    44\t    let directory = format!(\n    45\t        \"{}/empty-signal-without-datom-{}\",\n    46\t        env!(\"CARGO_TARGET_TMPDIR\"),\n    47\t        std::process::id()\n    48\t    );\n    49\t    let _ = std::fs::remove_dir_all(&directory);\n    50\t    std::fs::create_dir_all(format!(\"{directory}/src\")).expect(\"temporary source directory\");\n    51\t    std::fs::write(\n    52\t        format!(\"{directory}/Cargo.toml\"),\n    53\t        \"[package]\\nname = \\\"empty-signal-without-datom\\\"\\nversion = \\\"0.1.0\\\"\\nedition = \\\"2024\\\"\\n[features]\\ndatom = []\\n[dependencies]\\nrkyv = { version = \\\"0.8\\\", default-features = false, features = [\\\"std\\\", \\\"bytecheck\\\", \\\"little_endian\\\", \\\"pointer_width_32\\\", \\\"unaligned\\\"] }\\n\",\n    54\t    ).expect(\"temporary manifest\");\n    55\t    std::fs::write(\n    56\t        format!(\"{directory}/src/lib.rs\"),\n    57\t        include_str!(\"generated/empty-signal.rs\"),\n    58\t    )\n    59\t    .expect(\"generated Signal source\");\n    60\t    assert!(\n    61\t        Command::new(\"cargo\")\n    62\t            .args([\n    63\t                \"check\",\n    64\t                \"--manifest-path\",\n    65\t                &format!(\"{directory}/Cargo.toml\"),\n    66\t                \"--no-default-features\"\n    67\t            ])\n    68\t            .status()\n    69\t            .expect(\"cargo is available\")\n    70\t            .success()\n    71\t    );\n    72\t}\n     1\t//! Current generated contracts compile with Datom enabled.\n     2\t\n     3\tpub struct Wrapper<T>(pub T);\n     4\t\n     5\t#[path = \"generated/empty-signal.rs\"]\n     6\tmod empty_signal;\n     7\t#[path = \"generated/nested-collision.rs\"]\n     8\tmod nested_collision;\n     9\t#[path = \"generated/orchestrate.rs\"]\n    10\tmod orchestrate;\n    11\t#[path = \"generated/processable-kinds.rs\"]\n    12\tmod processable_kinds;\n    13\t#[path = \"generated/record-types.rs\"]\n    14\tmod record_types;\n    15\t#[path = \"generated/self-kinds.rs\"]\n    16\tmod self_kinds;\n    17\t#[path = \"generated/signal-decimal.rs\"]\n    18\tmod signal_decimal;\n    19\t#[path = \"generated/tree-types.rs\"]\n    20\tmod tree_types;\n    21\t\n    22\t#[test]\n    23\tfn nested_inline_payloads_have_distinct_rust_types() {\n    24\t    let left = nested_collision::Outer::A(nested_collision::A_Data::X(\n    25\t        nested_collision::A_Data_X_Data {\n    26\t            string: String::new(),\n    27\t        },\n    28\t    ));\n    29\t    let right = nested_collision::Outer::B(nested_collision::B_Data::X(\n    30\t        nested_collision::B_Data_X_Data { integer: 1 },\n    31\t    ));\n    32\t    assert!(matches!(left, nested_collision::Outer::A(_)));\n    33\t    assert!(matches!(right, nested_collision::Outer::B(_)));\n    34\t}\n    35\t\n    36\t#[test]\n    37\tfn named_fields_and_signal_query_response_compile() {\n    38\t    let record = record_types::Record {\n    39\t        string: \"Ada\".to_owned(),\n    40\t        integer: 1990,\n    41\t    };\n    42\t    assert_eq!(record.integer, 1990);\n    43\t    let query = orchestrate::Query::Observe(orchestrate::ObserveSelection::Locks(vec![]));\n    44\t    let response = orchestrate::Response::Observed(orchestrate::Observation::Locks(vec![]));\n    45\t    assert!(matches!(query, orchestrate::Query::Observe(_)));\n    46\t    assert!(matches!(response, orchestrate::Response::Observed(_)));\n    47\t}\n    48\t\n    49\t#[test]\n    50\tfn generated_signal_query_round_trips_as_a_portable_archive() {\n    51\t    let query = orchestrate::Query::Observe(orchestrate::ObserveSelection::Locks(vec![]));\n    52\t    let bytes = rkyv::to_bytes::<rkyv::rancor::Error>(&query).expect(\"archive query\");\n    53\t    let restored =\n    54\t        rkyv::from_bytes::<orchestrate::Query, rkyv::rancor::Error>(&bytes).expect(\"restore query\");\n    55\t    assert!(matches!(restored, orchestrate::Query::Observe(_)));\n    56\t}\n    57\t\n    58\t#[test]\n    59\tfn generated_decimal_signal_archives_and_bears_datom_derives() {\n    60\t    let query = signal_decimal::Query::Measure(signal_decimal::Measurement { decimal: 1.25 });\n    61\t    let bytes = rkyv::to_bytes::<rkyv::rancor::Error>(&query).expect(\"archive decimal query\");\n    62\t    let restored = rkyv::from_bytes::<signal_decimal::Query, rkyv::rancor::Error>(&bytes)\n    63\t        .expect(\"restore decimal query\");\n    64\t    assert_eq!(restored, query);\n    65\t}\n    66\t\n    67\t#[test]\n    68\tfn recursive_generated_types_compile() {\n    69\t    let tree = tree_types::Tree::Leaf(1);\n    70\t    assert!(matches!(tree, tree_types::Tree::Leaf(1)));\n    71\t}\n    72\t\n    73\t#[test]\n    74\tfn self_bearing_methods_are_sized_without_sizing_the_trait() {\n    75\t    fn object_safe(value: &dyn self_kinds::Mixed) -> String {\n    76\t        value.inspect()\n    77\t    }\n    78\t    let _ = object_safe;\n    79\t    let generated = include_str!(\"generated/self-kinds.rs\");\n    80\t    assert!(generated.contains(\"fn factory(&self) -> Self\"));\n    81\t    assert!(generated.contains(\"Self: Sized;\"));\n    82\t    assert!(generated.contains(\"crate::Wrapper<Self>\"));\n    83\t    assert!(!generated.contains(\"pub trait Mixed: Sized\"));\n    84\t}\n    85\t\n    86\t#[test]\n    87\tfn constrained_kind_identity_compiles() {\n    88\t    assert!(include_str!(\"generated/processable-kinds.rs\").contains(\"pub trait Processable\"));\n    89\t}\n    90\t\n    91\t#[test]\n    92\tfn operation_free_signal_shared_record_archives_and_round_trips_as_datom_text() {\n    93\t    use datom_codec::{Actualizing, Budget, Datomizable, Potential};\n    94\t    use protos::{Protosizable, ReaderBudget, Textualizable};\n    95\t\n    96\t    let shared = empty_signal::Shared {\n    97\t        name: \"domain\".to_owned(),\n    98\t    };\n    99\t    let bytes = rkyv::to_bytes::<rkyv::rancor::Error>(&shared).expect(\"archive shared record\");\n   100\t    assert_eq!(\n   101\t        rkyv::from_bytes::<empty_signal::Shared, rkyv::rancor::Error>(&bytes)\n   102\t            .expect(\"restore shared record\"),\n   103\t        shared\n   104\t    );\n   105\t    let text = shared.clone().datomize(vec![]).protosize().textualize();\n   106\t    let mut pending = Potential::<empty_signal::Shared>::from(text);\n   107\t    assert_eq!(\n   108\t        pending\n   109\t            .actualize(&mut Budget {\n   110\t                remaining: 1024,\n   111\t                reader: ReaderBudget { remaining: 1024 },\n   112\t                depth: 0,\n   113\t                maximum_depth: 1024,\n   114\t            })\n   115\t            .expect(\"restore shared datom\"),\n   116\t        shared\n   117\t    );\n   118\t}\n     1\t//! Public reader and generator contracts.  These cover the current roots and\n     2\t//! the constructs that consumers write; detailed parser failures live beside\n     3\t//! the reader in `src/lib.rs`.\n     4\t\n     5\tuse ethos_zero::{Actualizing, File, Generating, Potential};\n     6\tuse protos::{Protosizable, Textualizable};\n     7\t\n     8\tfn read(source: &str) -> File {\n     9\t    match Potential::<File>::from(source).actualize() {\n    10\t        Ok(file) => file,\n    11\t        Err(_) => panic!(\"source did not read: {source}\"),\n    12\t    }\n    13\t}\n    14\t\n    15\t#[test]\n    16\tfn full_library_round_trips_and_generates_named_types_and_kinds() {\n    17\t    let source = \"Library [ std:[ Clonable Sendable Serializable ] ] [ SinkError.[ Closed ] Sink.{ String } ] [ Fillable.[ push!{ [ String ] [ Result<Integer SinkError> ] } drain![ Vector<String> ] create:[ Self ] ] Streamable.{ [ Fillable ] [ Item<Serializable> ] [ CAPACITY.Integer ] [ next![ Option<Item> ] ] } Processable<[Clonable Sendable] Serializable>.[ process.[ String ] ] ] [ Sink.[ Fillable ] ]\";\n    18\t    let file = read(source);\n    19\t    let repeated = read(&file.protosize().textualize());\n    20\t    assert_eq!(file, repeated);\n    21\t\n    22\t    let rust = match file.generate() {\n    23\t        Ok(rust) => rust,\n    24\t        Err(_) => panic!(\"checked Library generates\"),\n    25\t    };\n    26\t    assert!(rust.contains(\"pub struct Sink\"));\n    27\t    assert!(rust.contains(\"pub string: String\"));\n    28\t    assert!(rust.contains(\"std::result::Result<i64, SinkError>\"));\n    29\t    assert!(rust.contains(\"pub trait Streamable\"));\n    30\t    assert!(rust.contains(\"pub trait Processable\"));\n    31\t}\n    32\t\n    33\t#[test]\n    34\tfn signal_generates_query_response_and_optional_datom_derives() {\n    35\t    let file = read(include_str!(\"../fixtures/orchestrate.ethos\"));\n    36\t    let rust = match file.generate() {\n    37\t        Ok(rust) => rust,\n    38\t        Err(_) => panic!(\"checked Signal generates\"),\n    39\t    };\n    40\t    assert!(rust.contains(\"pub enum Query\"));\n    41\t    assert!(rust.contains(\"pub enum Response\"));\n    42\t    assert!(rust.contains(\"cfg_attr(\\n    feature = \\\"datom\\\"\"));\n    43\t    assert!(rust.contains(\"pub type LockId = i64\"));\n    44\t}\n    45\t\n    46\t#[test]\n    47\tfn sema_has_only_imports_and_record_type_sections() {\n    48\t    let file = read(\"Sema [ crate:[ Handle ] ] [ Record.{ Handle String } ]\");\n    49\t    assert!(matches!(file, File::Sema(_)));\n    50\t    assert_eq!(file, read(&file.protosize().textualize()));\n    51\t}\n    52\t\n    53\t#[test]\n    54\tfn retired_roots_are_not_accepted() {\n    55\t    assert!(\n    56\t        Potential::<File>::from(\"Types [] [] []\")\n    57\t            .actualize()\n    58\t            .is_err()\n    59\t    );\n    60\t    assert!(Potential::<File>::from(\"Kinds [] []\").actualize().is_err());\n    61\t}\n    62\t\n    63\t#[test]\n    64\tfn operation_free_signal_generates_only_its_declared_shared_data() {\n    65\t    let generated = match read(\"Signal [] [] [] [ Shared.{ Name } Name.String ]\").generate() {\n    66\t        Ok(generated) => generated,\n    67\t        Err(_) => panic!(\"operation-free Signal generates\"),\n    68\t    };\n    69\t    assert!(generated.contains(\"pub struct Shared\"));\n    70\t    assert!(!generated.contains(\"pub enum Query\"));\n    71\t    assert!(!generated.contains(\"pub enum Response\"));\n    72\t}\n     1\t//! The command accepts one generated `Query` and writes its generated module.\n     2\t\n     3\tuse std::process::Command;\n     4\t\n     5\ttrait Invoking {\n     6\t    fn invoke(&self) -> (bool, String);\n     7\t}\n     8\t\n     9\timpl Invoking for [&str] {\n    10\t    fn invoke(&self) -> (bool, String) {\n    11\t        let output = Command::new(env!(\"CARGO_BIN_EXE_ethos-zero\"))\n    12\t            .args(self)\n    13\t            .output()\n    14\t            .expect(\"the binary runs\");\n    15\t        (\n    16\t            output.status.success(),\n    17\t            String::from_utf8(output.stdout).expect(\"utf-8 output\"),\n    18\t        )\n    19\t    }\n    20\t}\n    21\t\n    22\ttrait Scratching {\n    23\t    fn scratch(&self) -> String;\n    24\t}\n    25\t\n    26\timpl Scratching for str {\n    27\t    fn scratch(&self) -> String {\n    28\t        let directory = format!(\n    29\t            \"{}/cli-{}-{}\",\n    30\t            env!(\"CARGO_TARGET_TMPDIR\"),\n    31\t            self,\n    32\t            std::process::id()\n    33\t        );\n    34\t        let _ = std::fs::remove_dir_all(&directory);\n    35\t        directory\n    36\t    }\n    37\t}\n    38\t\n    39\tfn opaque(text: &str) -> String {\n    40\t    format!(\"«{text}»\")\n    41\t}\n    42\t\n    43\tfn generate(source: &str, directory: &str) -> String {\n    44\t    format!(\"Generate.{{ {} {} }}\", opaque(source), opaque(directory))\n    45\t}\n    46\t\n    47\t#[test]\n    48\tfn no_argument_prints_the_crates_own_ethos_ending_with_a_newline() {\n    49\t    let (success, output) = [].invoke();\n    50\t    assert!(success);\n    51\t    assert_eq!(output, include_str!(\"../ethos-zero.ethos\"));\n    52\t    assert!(output.ends_with('\\n'));\n    53\t    assert!(output.contains(\"[ Generate.Generation ]\"));\n    54\t}\n    55\t\n    56\t#[test]\n    57\tfn generate_writes_a_named_field_module_and_replies_generated() {\n    58\t    let directory = \"generate\".scratch();\n    59\t    let source = concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/fixtures/record-types.ethos\");\n    60\t    let argument = generate(source, &directory);\n    61\t    let (success, output) = [argument.as_str()].invoke();\n    62\t    assert!(success, \"{output}\");\n    63\t    assert_eq!(\n    64\t        output,\n    65\t        format!(\"Generated.[ {directory}/record-types.rs ]\\n\")\n    66\t    );\n    67\t    let written = std::fs::read_to_string(format!(\"{directory}/record-types.rs\")).unwrap();\n    68\t    assert!(written.contains(\"pub struct Record\"));\n    69\t    assert!(written.contains(\"pub string: String\"));\n    70\t    assert!(written.contains(\"pub integer: i64\"));\n    71\t}\n    72\t\n    73\t#[test]\n    74\tfn quoted_inputs_canonicalize_paths_as_bare_strings() {\n    75\t    let directory = \"quoted\".scratch();\n    76\t    let source = concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/fixtures/multi-types.ethos\");\n    77\t    let argument = generate(source, &directory);\n    78\t    let (success, output) = [argument.as_str()].invoke();\n    79\t    assert!(success, \"{output}\");\n    80\t    assert_eq!(\n    81\t        output,\n    82\t        format!(\"Generated.[ {directory}/multi-types.rs ]\\n\")\n    83\t    );\n    84\t}\n    85\t\n    86\t#[test]\n    87\tfn malformed_query_and_wrong_shape_are_reported_as_typed_errors() {\n    88\t    let (success, output) = [\"--help\"].invoke();\n    89\t    assert!(!success);\n    90\t    assert!(\n    91\t        output.starts_with(\"Malformed.Error.{ Composition\"),\n    92\t        \"{output}\"\n    93\t    );\n    94\t    assert!(output.contains(\"Query --help\"), \"{output}\");\n    95\t\n    96\t    let (success, output) = [\"Generate.{ /only }\"].invoke();\n    97\t    assert!(!success);\n    98\t    assert!(\n    99\t        output.starts_with(\"Malformed.Error.{ Composition\"),\n   100\t        \"{output}\"\n   101\t    );\n   102\t    assert!(output.contains(\"Arity.{ 2 1 }\"), \"{output}\");\n   103\t}\n   104\t\n   105\t#[test]\n   106\tfn more_than_one_argument_is_refused_with_the_count() {\n   107\t    let (success, output) = [\"Generate.{\", \"/a\", \"/b\", \"}\"].invoke();\n   108\t    assert!(!success);\n   109\t    assert_eq!(output, \"Arguments.4\\n\");\n   110\t}\n   111\t\n   112\t#[test]\n   113\tfn a_missing_file_is_unreadable() {\n   114\t    let argument = generate(\"/nowhere/missing.ethos\", \"/nowhere\");\n   115\t    let (success, output) = [argument.as_str()].invoke();\n   116\t    assert!(!success);\n   117\t    assert!(\n   118\t        output.starts_with(\"Unreadable.{ /nowhere/missing.ethos \"),\n   119\t        \"{output}\"\n   120\t    );\n   121\t}\n   122\t\n   123\t#[test]\n   124\tfn a_bad_ethos_file_returns_a_typed_generation_error() {\n   125\t    let directory = \"faulty\".scratch();\n   126\t    std::fs::create_dir_all(&directory).unwrap();\n   127\t    let source = format!(\"{directory}/faulty.ethos\");\n   128\t    std::fs::write(&source, \"Library [] [ Record.{ String Bogus } ] [] []\").unwrap();\n   129\t    let argument = generate(&source, &directory);\n   130\t    let (success, output) = [argument.as_str()].invoke();\n   131\t    assert!(!success);\n   132\t    assert!(output.starts_with(\"GenerationRejected.{\"), \"{output}\");\n   133\t    assert!(output.contains(\"Conceptual.{\"), \"{output}\");\n   134\t    assert!(output.contains(\"Undeclared.Bogus\"), \"{output}\");\n   135\t}\n     1\t[package]\n     2\tname         = \"ethos-zero\"\n     3\tversion      = \"6.1.6\"\n     4\tedition      = \"2024\"\n     5\trust-version = \"1.89\"\n     6\tlicense      = \"MIT OR Apache-2.0\"\n     7\trepository   = \"https://github.com/LiGoldragon/ethos-zero\"\n     8\tdescription  = \"Ethos schema language version zero: reads ethos, generates Rust.\"\n     9\tpublish      = false\n    10\tautobins     = false\n    11\tautoexamples = false\n    12\tautotests    = false\n    13\t\n    14\t[lib]\n    15\tname = \"ethos_zero\"\n    16\tpath = \"src/lib.rs\"\n    17\t\n    18\t[[bin]]\n    19\tname = \"ethos-zero\"\n    20\tpath = \"src/main.rs\"\n    21\t\n    22\t[features]\n    23\tdefault = [\"datom\"]\n    24\tdatom = []\n    25\t\n    26\t[dependencies]\n    27\tprotos      = { git = \"https://github.com/LiGoldragon/protos\",  rev = \"b543678cfc8609529cea7174eb4af8a64daa54ad\" }\n    28\tdatom-codec = { git = \"https://github.com/LiGoldragon/datom-codec\", rev = \"f2cc06858d38a4028c928d33323a6d682e7c222f\" }\n    29\tquote       = \"1\"\n    30\tproc-macro2 = \"1\"\n    31\tsyn         = { version = \"3\", features = [\"full\"] }\n    32\tprettyplease = \"0.3\"\n    33\trkyv = { version = \"0.8\", default-features = false, features = [\"std\", \"bytecheck\", \"little_endian\", \"pointer_width_32\", \"unaligned\"] }\n    34\t\n    35\t[dev-dependencies]\n    36\tserde = \"1\"\n    37\t\n    38\t[[test]]\n    39\tname = \"ethos\"\n    40\tpath = \"tests/ethos.rs\"\n    41\t\n    42\t[[test]]\n    43\tname = \"generated\"\n    44\tpath = \"tests/generated.rs\"\n    45\t\n    46\t[[test]]\n    47\tname = \"freshness\"\n    48\tpath = \"tests/freshness.rs\"\n    49\t\n    50\t[[test]]\n    51\tname = \"signal-without-datom\"\n    52\tpath = \"tests/signal_without_datom.rs\"\n    53\t\n    54\t[[test]]\n    55\tname = \"cli\"\n    56\tpath = \"tests/cli.rs\"\n    57\t\n    58\t[lints.rust]\n    59\tunsafe_code = \"forbid\"\n    60\tunused      = { level = \"warn\", priority = -1 }\n    61\tdead_code   = \"warn\"\n     1\t{\n     2\t  description = \"ethos-zero — the ethos schema language, version zero\";\n     3\t\n     4\t  inputs = {\n     5\t    nixpkgs.url = \"github:NixOS/nixpkgs/nixpkgs-unstable\";\n     6\t    flake-utils.url = \"github:numtide/flake-utils\";\n     7\t    rust-build = {\n     8\t      url = \"github:LiGoldragon/rust-build\";\n     9\t      inputs.nixpkgs.follows = \"nixpkgs\";\n    10\t    };\n    11\t    # The dependencies' own ethos declarations, read by the built tool as a check.\n    12\t    protos = {\n    13\t      url = \"github:LiGoldragon/protos/b543678cfc8609529cea7174eb4af8a64daa54ad\";\n    14\t      inputs.nixpkgs.follows = \"nixpkgs\";\n    15\t      inputs.flake-utils.follows = \"flake-utils\";\n    16\t      inputs.rust-build.follows = \"rust-build\";\n    17\t    };\n    18\t    datom-codec = {\n    19\t      url = \"github:LiGoldragon/datom-codec/f2cc06858d38a4028c928d33323a6d682e7c222f\";\n    20\t      inputs.nixpkgs.follows = \"nixpkgs\";\n    21\t      inputs.flake-utils.follows = \"flake-utils\";\n    22\t      inputs.rust-build.follows = \"rust-build\";\n    23\t    };\n    24\t  };\n    25\t\n    26\t  outputs = { self, nixpkgs, flake-utils, rust-build, protos, datom-codec }:\n    27\t    flake-utils.lib.eachSystem [ \"x86_64-linux\" ] (system:\n    28\t      let\n    29\t        pkgs = import nixpkgs { inherit system; };\n    30\t        rust = rust-build.lib.${system}.fromPkgs pkgs;\n    31\t        inherit (rust) craneLib toolchain;\n    32\t        ethosFilter = path: type:\n    33\t          type == \"regular\" && pkgs.lib.hasSuffix \".ethos\" path;\n    34\t        src = rust.cleanSource {\n    35\t          root = ./.;\n    36\t          extraFilters = [ ethosFilter ];\n    37\t        };\n    38\t        # These limits run inside each remote derivation, so cargo, rustc,\n    39\t        # rustdoc and test children inherit them.  The Nix client limit alone\n    40\t        # would not constrain the configured remote builder.\n    41\t        resourcePolicy = ''\n    42\t          ulimit -v 8388608\n    43\t        '';\n    44\t        common = {\n    45\t          inherit src;\n    46\t          strictDeps = true;\n    47\t          preBuild = resourcePolicy;\n    48\t          preCheck = resourcePolicy;\n    49\t        };\n    50\t        cargoArtifacts = craneLib.buildDepsOnly common;\n    51\t        package = craneLib.buildPackage (common // { inherit cargoArtifacts; });\n    52\t      in {\n    53\t        packages.default = package;\n    54\t        checks = {\n    55\t          build = craneLib.cargoBuild (common // { inherit cargoArtifacts; });\n    56\t          test = craneLib.cargoTest (common // { inherit cargoArtifacts; });\n    57\t          fmt = craneLib.cargoFmt common;\n    58\t          clippy = craneLib.cargoClippy (common // {\n    59\t            inherit cargoArtifacts;\n    60\t            cargoClippyExtraArgs = \"--all-targets -- -D warnings\";\n    61\t          });\n    62\t          doc = craneLib.cargoDoc (common // {\n    63\t            inherit cargoArtifacts;\n    64\t            RUSTDOCFLAGS = \"-D warnings\";\n    65\t          });\n    66\t          dependency-ethos = pkgs.runCommand \"ethos-zero-dependency-ethos\" {\n    67\t            inherit package;\n    68\t            declarations = [\n    69\t              \"${protos}/protos.ethos\" \"${protos}/protos-kinds.ethos\"\n    70\t              \"${datom-codec}/datom-codec.ethos\" \"${datom-codec}/datom-codec-kinds.ethos\"\n    71\t            ];\n    72\t          } ''\n    73\t            ${resourcePolicy}\n    74\t            ${builtins.readFile ./checks/dependency-ethos.sh}\n    75\t          '';\n    76\t          no-free-functions = pkgs.runCommand \"ethos-zero-no-free-functions\" { inherit src; } ''\n    77\t            ${resourcePolicy}\n    78\t            ${builtins.readFile ./checks/no-free-functions.sh}\n    79\t          '';\n    80\t          no-inherent-methods = pkgs.runCommand \"ethos-zero-no-inherent-methods\" { inherit src; } ''\n    81\t            ${resourcePolicy}\n    82\t            ${builtins.readFile ./checks/no-inherent-methods.sh}\n    83\t          '';\n    84\t        };\n    85\t        devShells.default = pkgs.mkShell {\n    86\t          name = \"ethos-zero\";\n    87\t          packages = [ pkgs.jujutsu toolchain ];\n    88\t        };\n    89\t      });\n    90\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/run/current-system/sw/bin/zsh -lc \"nl -ba src/generation.rs | sed -n '1,220p'; nl -ba src/generation.rs | sed -n '220,470p'; nl -ba src/generation.rs | sed -n '470,680p'; nl -ba src/generation.rs | sed -n '870,945p'; nl -ba tests/generated/orchestrate.rs; nl -ba tests/generated/composition-types.rs; nl -ba tests/generated/placed-types.rs; nl -ba tests/generated/record-types.rs; nl -ba tests/signal_without_datom.rs; nl -ba fixtures/composition-types.ethos; nl -ba fixtures/placed-types.ethos; nl -ba fixtures/orchestrate.ethos\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/run/current-system/sw/bin/zsh -lc \"nl -ba src/generation.rs | sed -n '1,220p'; nl -ba src/generation.rs | sed -n '220,470p'; nl -ba src/generation.rs | sed -n '470,680p'; nl -ba src/generation.rs | sed -n '870,945p'; nl -ba tests/generated/orchestrate.rs; nl -ba tests/generated/composition-types.rs; nl -ba tests/generated/placed-types.rs; nl -ba tests/generated/record-types.rs; nl -ba tests/signal_without_datom.rs; nl -ba fixtures/composition-types.ethos; nl -ba fixtures/placed-types.ethos; nl -ba fixtures/orchestrate.ethos\"","aggregated_output":"     1\t//! Generation: File to Rust text (cannot fault, the file having been checked).\n     2\t//!\n     3\t//! Each declaration emits itself: a struct declaration its struct and\n     4\t//! its datomic machinery, an enum declaration its enum and its\n     5\t//! machinery, a kind declaration its trait, an association its\n     6\t//! assertion; the file emits by walking its variant's sections. Names\n     7\t//! are resolved through the scope, never a table; the generated Rust\n     8\t//! carries no `use` and writes every foreign name fully qualified.\n     9\t//!\n    10\t//! One rule decides boxing: a position whose type reaches the type\n    11\t//! that declares it, walking through declared types, aliases, `Option`\n    12\t//! and `Result` but not through `Vector`, is boxed as a whole\n    13\t//! (`std::boxed::Box<std::option::Option<Tree>>`), and the datom machinery\n    14\t//! never sees the box.\n    15\t\n    16\tuse proc_macro2::{Ident, Span, TokenStream};\n    17\tuse quote::quote;\n    18\t\n    19\tuse crate::checking::{Checkable, Declaring};\n    20\tuse crate::{\n    21\t    AssociatedConstant, AssociatedType, Association, Capability, Constraint, File, Generating,\n    22\t    Identity, Intrinsic, KindBody, KindDeclaration, Name, Receiver, Reference, Resolution,\n    23\t    Resolving, Scope, Signature, Source, TypeDeclaration, Variant,\n    24\t};\n    25\t\n    26\t// ---------------------------------------------------------------------------\n    27\t// Tokens of names and sources\n    28\t// ---------------------------------------------------------------------------\n    29\t\n    30\t/// The kind whose capability yields a value's Rust tokens without any scope.\n    31\tpub(crate) trait Tokening {\n    32\t    fn tokens(&self) -> TokenStream;\n    33\t}\n    34\t\n    35\timpl Tokening for Name {\n    36\t    fn tokens(&self) -> TokenStream {\n    37\t        let ident = Ident::new(&self.0, Span::call_site());\n    38\t        quote! { #ident }\n    39\t    }\n    40\t}\n    41\t\n    42\timpl Tokening for Source {\n    43\t    fn tokens(&self) -> TokenStream {\n    44\t        let path: syn::Path =\n    45\t            syn::parse_str(self.as_ref()).expect(\"a source was validated as a path\");\n    46\t        quote! { #path }\n    47\t    }\n    48\t}\n    49\t\n    50\timpl Tokening for Intrinsic {\n    51\t    fn tokens(&self) -> TokenStream {\n    52\t        match self {\n    53\t            Intrinsic::String => quote! { String },\n    54\t            // Signal contracts must compile without their optional `datom`\n    55\t            // feature.  The wire-level integer is therefore the ordinary\n    56\t            // Rust scalar; Datom derives know how to compose it when enabled.\n    57\t            Intrinsic::Integer => quote! { i64 },\n    58\t            Intrinsic::Decimal => quote! { f64 },\n    59\t            Intrinsic::Boolean => quote! { bool },\n    60\t            Intrinsic::Meaning => quote! { datom_codec::Meaning },\n    61\t            Intrinsic::Vector => quote! { std::vec::Vec },\n    62\t            Intrinsic::Option => quote! { std::option::Option },\n    63\t            Intrinsic::Result => quote! { std::result::Result },\n    64\t            Intrinsic::Itself => quote! { Self },\n    65\t            Intrinsic::Sized => quote! { Sized },\n    66\t        }\n    67\t    }\n    68\t}\n    69\t\n    70\t/// The kind whose capability yields the name of the parameter at an index: A, B, C.\n    71\ttrait Lettering {\n    72\t    fn letter(&self, scope: &Scope) -> Ident;\n    73\t}\n    74\t\n    75\timpl Lettering for usize {\n    76\t    fn letter(&self, scope: &Scope) -> Ident {\n    77\t        let letter = char::from(b'A' + *self as u8);\n    78\t        let simple = Name::try_from(letter.to_string()).expect(\"static identifier\");\n    79\t        let allocated = if scope.file.declaration(&simple).is_none() {\n    80\t            simple\n    81\t        } else {\n    82\t            let mut allocated = Name::try_from(format!(\"{}EthosParameter\", simple.0))\n    83\t                .expect(\"parameter identifiers are identifiers\");\n    84\t            while scope.file.declaration(&allocated).is_some() {\n    85\t                allocated = Name::try_from(format!(\"{}X\", allocated.0))\n    86\t                    .expect(\"parameter identifiers are identifiers\");\n    87\t            }\n    88\t            allocated\n    89\t        };\n    90\t        Ident::new(&allocated.0, Span::call_site())\n    91\t    }\n    92\t}\n    93\t\n    94\t/// The kind whose capability lowercases a name for an assertion function.\n    95\ttrait Lowering {\n    96\t    fn lowered(&self) -> String;\n    97\t}\n    98\t\n    99\timpl Lowering for Reference {\n   100\t    fn lowered(&self) -> String {\n   101\t        let mut lowered = self.name.0.to_lowercase();\n   102\t        for argument in &self.arguments {\n   103\t            lowered.push('_');\n   104\t            lowered.push_str(&argument.lowered());\n   105\t        }\n   106\t        lowered\n   107\t    }\n   108\t}\n   109\t\n   110\t// ---------------------------------------------------------------------------\n   111\t// Emitting: Rust tokens in a scope\n   112\t// ---------------------------------------------------------------------------\n   113\t\n   114\t/// The kind whose capability yields a value's Rust tokens in a scope.\n   115\tpub(crate) trait Emitting {\n   116\t    fn emit(&self, scope: &Scope) -> TokenStream;\n   117\t}\n   118\t\n   119\timpl Emitting for Reference {\n   120\t    fn emit(&self, scope: &Scope) -> TokenStream {\n   121\t        let mut arguments = Vec::with_capacity(self.arguments.len());\n   122\t        for argument in &self.arguments {\n   123\t            arguments.push(argument.emit(scope));\n   124\t        }\n   125\t        let applied = if arguments.is_empty() {\n   126\t            TokenStream::new()\n   127\t        } else {\n   128\t            quote! { < #( #arguments ),* > }\n   129\t        };\n   130\t        let name = self.name.tokens();\n   131\t        if let Some(source) = &self.source {\n   132\t            let source = source.tokens();\n   133\t            return quote! { #source :: #name #applied };\n   134\t        }\n   135\t        match scope.resolve(&self.name) {\n   136\t            Resolution::Intrinsic(intrinsic) => {\n   137\t                let intrinsic = intrinsic.tokens();\n   138\t                quote! { #intrinsic #applied }\n   139\t            }\n   140\t            Resolution::Imported(source, emitted) => {\n   141\t                if source.as_ref() == \"std\" {\n   142\t                    if emitted.0 == \"Clone\" {\n   143\t                        return quote! { std::clone::Clone #applied };\n   144\t                    }\n   145\t                    if emitted.0 == \"Send\" {\n   146\t                        return quote! { std::marker::Send #applied };\n   147\t                    }\n   148\t                }\n   149\t                let source = source.tokens();\n   150\t                let emitted = emitted.tokens();\n   151\t                quote! { #source :: #emitted #applied }\n   152\t            }\n   153\t            Resolution::Type(_)\n   154\t            | Resolution::Kind(_)\n   155\t            | Resolution::Ambiguous(_)\n   156\t            | Resolution::Undeclared => {\n   157\t                quote! { #name #applied }\n   158\t            }\n   159\t            Resolution::Parameter(index) => {\n   160\t                let letter = (index as usize).letter(scope);\n   161\t                quote! { #letter }\n   162\t            }\n   163\t            Resolution::Associated(name) => {\n   164\t                let name = name.tokens();\n   165\t                quote! { Self::#name }\n   166\t            }\n   167\t        }\n   168\t    }\n   169\t}\n   170\t\n   171\t/// The kind whose capability yields the bounds of a constraint: `A + B`.\n   172\ttrait Bounding {\n   173\t    fn bounds(&self, scope: &Scope) -> TokenStream;\n   174\t}\n   175\t\n   176\timpl Bounding for Constraint {\n   177\t    fn bounds(&self, scope: &Scope) -> TokenStream {\n   178\t        let references = match self {\n   179\t            Constraint::One(reference) => std::slice::from_ref(reference),\n   180\t            Constraint::Many(references) => references,\n   181\t        };\n   182\t        references.bounds(scope)\n   183\t    }\n   184\t}\n   185\t\n   186\timpl Bounding for [Reference] {\n   187\t    fn bounds(&self, scope: &Scope) -> TokenStream {\n   188\t        let mut bounds = Vec::with_capacity(self.len());\n   189\t        for reference in self {\n   190\t            bounds.push(reference.emit(scope));\n   191\t        }\n   192\t        quote! { #( #bounds )+* }\n   193\t    }\n   194\t}\n   195\t\n   196\t/// The kind whose capabilities yield an identity's generics: the parameters with their bounds, and the arguments.\n   197\tpub(crate) trait Parametrizing {\n   198\t    fn parameters(&self, scope: &Scope) -> TokenStream;\n   199\t    fn arguments(&self, scope: &Scope) -> TokenStream;\n   200\t}\n   201\t\n   202\timpl Parametrizing for Identity {\n   203\t    fn parameters(&self, scope: &Scope) -> TokenStream {\n   204\t        if self.constraints.is_empty() {\n   205\t            return TokenStream::new();\n   206\t        }\n   207\t        // The bounds name kinds outside the identity they bound.\n   208\t        let outer = Scope {\n   209\t            file: scope.file,\n   210\t            identity: None,\n   211\t            associated: scope.associated,\n   212\t        };\n   213\t        let mut parameters = Vec::with_capacity(self.constraints.len());\n   214\t        for (index, constraint) in self.constraints.iter().enumerate() {\n   215\t            let letter = index.letter(scope);\n   216\t            let bounds = constraint.bounds(&outer);\n   217\t            parameters.push(quote! { #letter: #bounds });\n   218\t        }\n   219\t        quote! { < #( #parameters ),* > }\n   220\t    }\n   220\t    }\n   221\t\n   222\t    fn arguments(&self, scope: &Scope) -> TokenStream {\n   223\t        if self.constraints.is_empty() {\n   224\t            return TokenStream::new();\n   225\t        }\n   226\t        let mut letters = Vec::with_capacity(self.constraints.len());\n   227\t        for index in 0..self.constraints.len() {\n   228\t            letters.push(index.letter(scope));\n   229\t        }\n   230\t        quote! { < #( #letters ),* > }\n   231\t    }\n   232\t}\n   233\t\n   234\t// ---------------------------------------------------------------------------\n   235\t// Reaching: the boxing rule\n   236\t// ---------------------------------------------------------------------------\n   237\t\n   238\t/// The kind whose capability tells whether a value holds the target type by value, through declared types, aliases, Option and Result.\n   239\ttrait Reaching {\n   240\t    fn reaches(&self, target: &Name, file: &File, visited: &mut Vec<Name>) -> bool;\n   241\t}\n   242\t\n   243\timpl Reaching for Reference {\n   244\t    fn reaches(&self, target: &Name, file: &File, visited: &mut Vec<Name>) -> bool {\n   245\t        if self.source.is_none() {\n   246\t            if &self.name == target || self.name.0 == \"Self\" {\n   247\t                return true;\n   248\t            }\n   249\t            match file.resolve(&self.name) {\n   250\t                Resolution::Intrinsic(Intrinsic::Vector) => return false,\n   251\t                Resolution::Type(name) if !visited.contains(&name) => {\n   252\t                    visited.push(name.clone());\n   253\t                    if let Some(declaration) = file.declaration(&name)\n   254\t                        && declaration.reaches(target, file, visited)\n   255\t                    {\n   256\t                        return true;\n   257\t                    }\n   258\t                }\n   259\t                _ => {}\n   260\t            }\n   261\t        }\n   262\t        for argument in &self.arguments {\n   263\t            if argument.reaches(target, file, visited) {\n   264\t                return true;\n   265\t            }\n   266\t        }\n   267\t        false\n   268\t    }\n   269\t}\n   270\t\n   271\timpl Reaching for [Reference] {\n   272\t    fn reaches(&self, target: &Name, file: &File, visited: &mut Vec<Name>) -> bool {\n   273\t        for reference in self {\n   274\t            if reference.reaches(target, file, visited) {\n   275\t                return true;\n   276\t            }\n   277\t        }\n   278\t        false\n   279\t    }\n   280\t}\n   281\t\n   282\timpl Reaching for TypeDeclaration {\n   283\t    fn reaches(&self, target: &Name, file: &File, visited: &mut Vec<Name>) -> bool {\n   284\t        match self {\n   285\t            TypeDeclaration::Struct(_, positions) => positions.reaches(target, file, visited),\n   286\t            TypeDeclaration::Enum(_, variants) => variants.reaches(target, file, visited),\n   287\t            TypeDeclaration::Alias(_, aliased) => aliased.reaches(target, file, visited),\n   288\t        }\n   289\t    }\n   290\t}\n   291\t\n   292\timpl Reaching for Variant {\n   293\t    fn reaches(&self, target: &Name, file: &File, visited: &mut Vec<Name>) -> bool {\n   294\t        match self {\n   295\t            Variant::Bare(_) => false,\n   296\t            Variant::Typed(_, reference) => reference.reaches(target, file, visited),\n   297\t            Variant::Struct(_, positions) => positions.reaches(target, file, visited),\n   298\t            Variant::Enum(_, variants) => variants.reaches(target, file, visited),\n   299\t        }\n   300\t    }\n   301\t}\n   302\t\n   303\timpl Reaching for [Variant] {\n   304\t    fn reaches(&self, target: &Name, file: &File, visited: &mut Vec<Name>) -> bool {\n   305\t        for variant in self {\n   306\t            if variant.reaches(target, file, visited) {\n   307\t                return true;\n   308\t            }\n   309\t        }\n   310\t        false\n   311\t    }\n   312\t}\n   313\t\n   314\t/// The kind whose capabilities yield a position's Rust type, boxed when it reaches its owner.\n   315\tpub(crate) trait Positioning {\n   316\t    fn boxed(&self, scope: &Scope, owner: &Name) -> bool;\n   317\t    fn position(&self, scope: &Scope, owner: &Name) -> TokenStream;\n   318\t}\n   319\t\n   320\timpl Positioning for Reference {\n   321\t    fn boxed(&self, scope: &Scope, owner: &Name) -> bool {\n   322\t        self.reaches(owner, scope.file, &mut vec![])\n   323\t    }\n   324\t\n   325\t    fn position(&self, scope: &Scope, owner: &Name) -> TokenStream {\n   326\t        // Put the indirection immediately around the recursive argument.\n   327\t        // `Option<Box<Tree>>` lets the Datom derive see the recursive edge,\n   328\t        // while `Box<Option<Tree>>` hides it behind the container and causes\n   329\t        // an infinitely recursive derive bound.\n   330\t        if self.source.is_none()\n   331\t            && matches!(\n   332\t                scope.file.resolve(&self.name),\n   333\t                Resolution::Intrinsic(Intrinsic::Option | Intrinsic::Result)\n   334\t            )\n   335\t        {\n   336\t            let name = self.name.tokens();\n   337\t            let mut arguments = Vec::with_capacity(self.arguments.len());\n   338\t            for argument in &self.arguments {\n   339\t                let ty = if argument.boxed(scope, owner) {\n   340\t                    let inner = argument.emit(scope);\n   341\t                    quote! { std::boxed::Box<#inner> }\n   342\t                } else {\n   343\t                    argument.emit(scope)\n   344\t                };\n   345\t                arguments.push(ty);\n   346\t            }\n   347\t            return quote! { #name < #( #arguments ),* > };\n   348\t        }\n   349\t\n   350\t        let ty = self.emit(scope);\n   351\t        if self.boxed(scope, owner) {\n   352\t            quote! { std::boxed::Box<#ty> }\n   353\t        } else {\n   354\t            ty\n   355\t        }\n   356\t    }\n   357\t}\n   358\t\n   359\ttrait Fielding {\n   360\t    fn field_base(&self) -> String;\n   361\t}\n   362\t\n   363\ttrait SnakeCasing {\n   364\t    fn snake_case(&self) -> String;\n   365\t}\n   366\t\n   367\timpl SnakeCasing for str {\n   368\t    fn snake_case(&self) -> String {\n   369\t        let characters: Vec<char> = self.chars().collect();\n   370\t        let mut result = String::new();\n   371\t        for (index, character) in characters.iter().enumerate() {\n   372\t            let previous = index.checked_sub(1).and_then(|i| characters.get(i));\n   373\t            let next = characters.get(index + 1);\n   374\t            if character.is_uppercase()\n   375\t                && index != 0\n   376\t                && (previous.is_some_and(|previous| previous.is_lowercase())\n   377\t                    || next.is_some_and(|next| next.is_lowercase()))\n   378\t            {\n   379\t                result.push('_');\n   380\t            }\n   381\t            result.extend(character.to_lowercase());\n   382\t        }\n   383\t        result\n   384\t    }\n   385\t}\n   386\t\n   387\timpl Fielding for Reference {\n   388\t    fn field_base(&self) -> String {\n   389\t        let mut parts: Vec<String> = self.arguments.iter().map(Self::field_base).collect();\n   390\t        parts.push(self.name.0.as_str().snake_case());\n   391\t        parts.join(\"_\")\n   392\t    }\n   393\t}\n   394\t\n   395\ttrait Ordinaling {\n   396\t    fn ordinal(&self) -> &'static str;\n   397\t}\n   398\t\n   399\timpl Ordinaling for usize {\n   400\t    fn ordinal(&self) -> &'static str {\n   401\t        match self {\n   402\t            0 => \"first\",\n   403\t            1 => \"second\",\n   404\t            2 => \"third\",\n   405\t            3 => \"fourth\",\n   406\t            4 => \"fifth\",\n   407\t            5 => \"sixth\",\n   408\t            6 => \"seventh\",\n   409\t            7 => \"eighth\",\n   410\t            8 => \"ninth\",\n   411\t            9 => \"tenth\",\n   412\t            _ => \"position\",\n   413\t        }\n   414\t    }\n   415\t}\n   416\t\n   417\ttrait FieldNaming {\n   418\t    fn field_names(&self) -> Vec<Ident>;\n   419\t}\n   420\t\n   421\timpl FieldNaming for [Reference] {\n   422\t    fn field_names(&self) -> Vec<Ident> {\n   423\t        let bases: Vec<String> = self.iter().map(Reference::field_base).collect();\n   424\t        let mut fields = Vec::with_capacity(bases.len());\n   425\t        for (index, base) in bases.iter().enumerate() {\n   426\t            let repetitions = bases.iter().filter(|other| *other == base).count();\n   427\t            let prior = bases[..index].iter().filter(|other| *other == base).count();\n   428\t            let name = if repetitions == 1 {\n   429\t                base.clone()\n   430\t            } else if prior < 10 {\n   431\t                format!(\"{}_{}\", prior.ordinal(), base)\n   432\t            } else {\n   433\t                format!(\"position_{}_{}\", prior + 1, base)\n   434\t            };\n   435\t            let field = if syn::parse_str::<Ident>(&name).is_ok() {\n   436\t                Ident::new(&name, Span::call_site())\n   437\t            } else {\n   438\t                Ident::new_raw(&name, Span::call_site())\n   439\t            };\n   440\t            fields.push(field);\n   441\t        }\n   442\t        fields\n   443\t    }\n   444\t}\n   445\t\n   446\t/// The kind whose capabilities yield a variant's definition and the items its inline enum needs.\n   447\ttrait Varianted {\n   448\t    fn definition(&self, scope: &Scope, owner: &Name, enclosing: &Identity) -> TokenStream;\n   449\t    fn nested(\n   450\t        &self,\n   451\t        scope: &Scope,\n   452\t        owner: &Name,\n   453\t        enclosing: &Identity,\n   454\t        conditional: bool,\n   455\t    ) -> TokenStream;\n   456\t}\n   457\t\n   458\t/// The kind whose capability names the enum type an inline enum variant declares.\n   459\ttrait Nesting {\n   460\t    fn nested_identity(&self, name: &Name) -> Identity;\n   461\t}\n   462\t\n   463\timpl Nesting for Identity {\n   464\t    fn nested_identity(&self, name: &Name) -> Identity {\n   465\t        let stem = if self.name.0.ends_with(\"_Data\") {\n   466\t            format!(\"{}_{}\", self.name.0, name.0)\n   467\t        } else {\n   468\t            name.0.clone()\n   469\t        };\n   470\t        let name = Name::try_from(format!(\"{stem}_Data\"))\n   470\t        let name = Name::try_from(format!(\"{stem}_Data\"))\n   471\t            .expect(\"derived inline identifiers are identifiers\");\n   472\t        Identity {\n   473\t            name,\n   474\t            constraints: self.constraints.clone(),\n   475\t        }\n   476\t    }\n   477\t}\n   478\t\n   479\timpl Varianted for Variant {\n   480\t    fn definition(&self, scope: &Scope, owner: &Name, enclosing: &Identity) -> TokenStream {\n   481\t        match self {\n   482\t            Variant::Bare(name) => {\n   483\t                let variant = name.tokens();\n   484\t                if scope.file.declaration(name).is_some() {\n   485\t                    let ty = name.tokens();\n   486\t                    quote! { #variant(#ty) }\n   487\t                } else {\n   488\t                    quote! { #variant }\n   489\t                }\n   490\t            }\n   491\t            Variant::Typed(name, reference) => {\n   492\t                let name = name.tokens();\n   493\t                let ty = reference.position(scope, owner);\n   494\t                quote! { #name(#ty) }\n   495\t            }\n   496\t            Variant::Struct(name, _) | Variant::Enum(name, _) => {\n   497\t                let nested = enclosing.nested_identity(name);\n   498\t                let ty = nested.name.tokens();\n   499\t                let arguments = nested.arguments(scope);\n   500\t                let name = name.tokens();\n   501\t                quote! { #name(#ty #arguments) }\n   502\t            }\n   503\t        }\n   504\t    }\n   505\t\n   506\t    fn nested(\n   507\t        &self,\n   508\t        scope: &Scope,\n   509\t        owner: &Name,\n   510\t        enclosing: &Identity,\n   511\t        conditional: bool,\n   512\t    ) -> TokenStream {\n   513\t        match self {\n   514\t            Variant::Struct(name, positions) => {\n   515\t                let nested = enclosing.nested_identity(name);\n   516\t                positions.structure(scope, owner, &nested, conditional)\n   517\t            }\n   518\t            Variant::Enum(name, variants) => {\n   519\t                let nested = enclosing.nested_identity(name);\n   520\t                variants.enumeration(scope, owner, &nested, conditional)\n   521\t            }\n   522\t            Variant::Bare(_) | Variant::Typed(_, _) => TokenStream::new(),\n   523\t        }\n   524\t    }\n   525\t}\n   526\t\n   527\t// ---------------------------------------------------------------------------\n   528\t// Declaring: the items a type declaration emits\n   529\t// ---------------------------------------------------------------------------\n   530\t\n   531\t/// The kind whose capability emits a struct of these positions with its datomic machinery.\n   532\ttrait Structuring {\n   533\t    fn structure(\n   534\t        &self,\n   535\t        scope: &Scope,\n   536\t        owner: &Name,\n   537\t        identity: &Identity,\n   538\t        conditional: bool,\n   539\t    ) -> TokenStream;\n   540\t}\n   541\t\n   542\t/// The kind whose capability emits an enum of these variants with its datomic machinery.\n   543\ttrait Enumerating {\n   544\t    fn enumeration(\n   545\t        &self,\n   546\t        scope: &Scope,\n   547\t        owner: &Name,\n   548\t        identity: &Identity,\n   549\t        conditional: bool,\n   550\t    ) -> TokenStream;\n   551\t}\n   552\t\n   553\ttrait DatomDeriving {\n   554\t    fn datom_derives(&self) -> TokenStream;\n   555\t}\n   556\t\n   557\timpl DatomDeriving for bool {\n   558\t    fn datom_derives(&self) -> TokenStream {\n   559\t        if *self {\n   560\t            quote! {\n   561\t                #[derive(rkyv::Archive, rkyv::Serialize, rkyv::Deserialize, Clone, Debug, PartialEq)]\n   562\t                #[cfg_attr(feature = \"datom\", derive(datom_codec::Datomizable, datom_codec::Compositional))]\n   563\t            }\n   564\t        } else {\n   565\t            quote! {\n   566\t                #[derive(datom_codec::Datomizable, datom_codec::Compositional, Clone, Debug, PartialEq)]\n   567\t            }\n   568\t        }\n   569\t    }\n   570\t}\n   571\t\n   572\timpl Structuring for [Reference] {\n   573\t    fn structure(\n   574\t        &self,\n   575\t        scope: &Scope,\n   576\t        owner: &Name,\n   577\t        identity: &Identity,\n   578\t        conditional: bool,\n   579\t    ) -> TokenStream {\n   580\t        let name = identity.name.tokens();\n   581\t        let parameters = identity.parameters(scope);\n   582\t        let mut types = Vec::with_capacity(self.len());\n   583\t        for position in self {\n   584\t            types.push(position.position(scope, owner));\n   585\t        }\n   586\t        let fields = self.field_names();\n   587\t        let derive = conditional.datom_derives();\n   588\t        quote! {\n   589\t            #derive\n   590\t            pub struct #name #parameters { #( pub #fields: #types ),* }\n   591\t        }\n   592\t    }\n   593\t}\n   594\t\n   595\timpl Enumerating for [Variant] {\n   596\t    fn enumeration(\n   597\t        &self,\n   598\t        scope: &Scope,\n   599\t        owner: &Name,\n   600\t        identity: &Identity,\n   601\t        conditional: bool,\n   602\t    ) -> TokenStream {\n   603\t        let name = identity.name.tokens();\n   604\t        let parameters = identity.parameters(scope);\n   605\t        let derive = conditional.datom_derives();\n   606\t        let mut definitions = Vec::with_capacity(self.len());\n   607\t        let mut nested = Vec::new();\n   608\t        for variant in self {\n   609\t            definitions.push(variant.definition(scope, owner, identity));\n   610\t            nested.push(variant.nested(scope, owner, identity, conditional));\n   611\t        }\n   612\t        quote! {\n   613\t            #( #nested )*\n   614\t            #derive\n   615\t            pub enum #name #parameters { #( #definitions ),* }\n   616\t        }\n   617\t    }\n   618\t}\n   619\t\n   620\timpl Emitting for TypeDeclaration {\n   621\t    fn emit(&self, scope: &Scope) -> TokenStream {\n   622\t        match self {\n   623\t            TypeDeclaration::Struct(identity, positions) => {\n   624\t                let inner = Scope {\n   625\t                    file: scope.file,\n   626\t                    identity: Some(identity),\n   627\t                    associated: scope.associated,\n   628\t                };\n   629\t                positions.structure(\n   630\t                    &inner,\n   631\t                    &identity.name,\n   632\t                    identity,\n   633\t                    matches!(scope.file, File::Signal(_)),\n   634\t                )\n   635\t            }\n   636\t            TypeDeclaration::Enum(identity, variants) => {\n   637\t                let inner = Scope {\n   638\t                    file: scope.file,\n   639\t                    identity: Some(identity),\n   640\t                    associated: scope.associated,\n   641\t                };\n   642\t                variants.enumeration(\n   643\t                    &inner,\n   644\t                    &identity.name,\n   645\t                    identity,\n   646\t                    matches!(scope.file, File::Signal(_)),\n   647\t                )\n   648\t            }\n   649\t            TypeDeclaration::Alias(identity, aliased) => {\n   650\t                let inner = Scope {\n   651\t                    file: scope.file,\n   652\t                    identity: Some(identity),\n   653\t                    associated: scope.associated,\n   654\t                };\n   655\t                let name = identity.name.tokens();\n   656\t                let parameters = identity.parameters(&inner);\n   657\t                let aliased = aliased.emit(&inner);\n   658\t                quote! { pub type #name #parameters = #aliased; }\n   659\t            }\n   660\t        }\n   661\t    }\n   662\t}\n   663\t\n   664\t// ---------------------------------------------------------------------------\n   665\t// Kinds: traits\n   666\t// ---------------------------------------------------------------------------\n   667\t\n   668\t/// The named sections that compose a kind declaration.\n   669\tstruct KindContents<'a> {\n   670\t    superkinds: &'a [Reference],\n   671\t    types: &'a [AssociatedType],\n   672\t    constants: &'a [AssociatedConstant],\n   673\t    capabilities: &'a [Capability],\n   674\t}\n   675\t\n   676\t/// The kind whose capability exposes a declaration's named kind sections.\n   677\ttrait Containing {\n   678\t    fn contents(&self) -> KindContents<'_>;\n   679\t}\n   680\t\n   870\t// The file: its sections walked\n   871\t// ---------------------------------------------------------------------------\n   872\t\n   873\timpl Emitting for File {\n   874\t    fn emit(&self, scope: &Scope) -> TokenStream {\n   875\t        // prettyplease owns each generated item's canonical text. rustfmt makes\n   876\t        // different width decisions for aliases and ordinary items, so each\n   877\t        // generated item is excluded individually while every authored Rust\n   878\t        // item remains checked by the repository formatter.\n   879\t        let mut items = Vec::new();\n   880\t        match self {\n   881\t            File::Library(library) => {\n   882\t                for declaration in &library.types {\n   883\t                    items.push(declaration.emit(scope));\n   884\t                }\n   885\t                for declaration in &library.kinds {\n   886\t                    items.push(declaration.emit(scope));\n   887\t                }\n   888\t                for association in &library.associations {\n   889\t                    items.push(association.emit(scope));\n   890\t                }\n   891\t            }\n   892\t            File::Signal(signal) => {\n   893\t                for declaration in &signal.types {\n   894\t                    items.push(declaration.emit(scope));\n   895\t                }\n   896\t                let request = TypeDeclaration::Enum(\n   897\t                    Identity {\n   898\t                        name: Name::try_from(\"Query\").expect(\"static identifier\"),\n   899\t                        constraints: vec![],\n   900\t                    },\n   901\t                    signal.requests.clone(),\n   902\t                );\n   903\t                let response = TypeDeclaration::Enum(\n   904\t                    Identity {\n   905\t                        name: Name::try_from(\"Response\").expect(\"static identifier\"),\n   906\t                        constraints: vec![],\n   907\t                    },\n   908\t                    signal.responses.clone(),\n   909\t                );\n   910\t                if !signal.requests.is_empty() {\n   911\t                    items.push(request.emit(scope));\n   912\t                }\n   913\t                if !signal.responses.is_empty() {\n   914\t                    items.push(response.emit(scope));\n   915\t                }\n   916\t            }\n   917\t            File::Sema(sema) => {\n   918\t                for declaration in &sema.types {\n   919\t                    items.push(declaration.emit(scope));\n   920\t                }\n   921\t            }\n   922\t        }\n   923\t        quote! {\n   924\t            #![allow(dead_code, non_camel_case_types, non_snake_case)]\n   925\t            #( #[rustfmt::skip] #items )*\n   926\t        }\n   927\t    }\n   928\t}\n   929\t\n   930\timpl Generating for File {\n   931\t    fn generate(&self) -> Result<String, crate::Error> {\n   932\t        let scope = Scope {\n   933\t            file: self,\n   934\t            identity: None,\n   935\t            associated: &[],\n   936\t        };\n   937\t        self.check(&scope)?;\n   938\t        let tokens = self.emit(&scope);\n   939\t        let file: syn::File = syn::parse2(tokens).expect(\"generated tokens are a Rust file\");\n   940\t        Ok(prettyplease::unparse(&file))\n   941\t    }\n   942\t}\n     1\t#![allow(dead_code, non_camel_case_types, non_snake_case)]\n     2\t#[rustfmt::skip]\n     3\tpub type LockId = i64;\n     4\t#[rustfmt::skip]\n     5\tpub type LockName = String;\n     6\t#[rustfmt::skip]\n     7\tpub type FlowId = String;\n     8\t#[rustfmt::skip]\n     9\tpub type LockPath = String;\n    10\t#[rustfmt::skip]\n    11\tpub type LockPaths = std::vec::Vec<LockPath>;\n    12\t#[rustfmt::skip]\n    13\tpub type LockReason = String;\n    14\t#[rustfmt::skip]\n    15\t#[derive(rkyv::Archive, rkyv::Serialize, rkyv::Deserialize, Clone, Debug, PartialEq)]\n    16\t#[cfg_attr(\n    17\t    feature = \"datom\",\n    18\t    derive(datom_codec::Datomizable, datom_codec::Compositional)\n    19\t)]\n    20\tpub struct LockRequest {\n    21\t    pub lock_name: LockName,\n    22\t    pub flow_id: FlowId,\n    23\t    pub lock_paths: LockPaths,\n    24\t    pub lock_reason: LockReason,\n    25\t}\n    26\t#[rustfmt::skip]\n    27\t#[derive(rkyv::Archive, rkyv::Serialize, rkyv::Deserialize, Clone, Debug, PartialEq)]\n    28\t#[cfg_attr(\n    29\t    feature = \"datom\",\n    30\t    derive(datom_codec::Datomizable, datom_codec::Compositional)\n    31\t)]\n    32\tpub struct Lock {\n    33\t    pub lock_id: LockId,\n    34\t    pub lock_name: LockName,\n    35\t    pub flow_id: FlowId,\n    36\t    pub lock_paths: LockPaths,\n    37\t    pub lock_reason: LockReason,\n    38\t}\n    39\t#[rustfmt::skip]\n    40\tpub type DuplicateName = Lock;\n    41\t#[rustfmt::skip]\n    42\t#[derive(rkyv::Archive, rkyv::Serialize, rkyv::Deserialize, Clone, Debug, PartialEq)]\n    43\t#[cfg_attr(\n    44\t    feature = \"datom\",\n    45\t    derive(datom_codec::Datomizable, datom_codec::Compositional)\n    46\t)]\n    47\tpub struct LockOverlap {\n    48\t    pub lock_path: LockPath,\n    49\t    pub lock: Lock,\n    50\t}\n    51\t#[rustfmt::skip]\n    52\t#[derive(rkyv::Archive, rkyv::Serialize, rkyv::Deserialize, Clone, Debug, PartialEq)]\n    53\t#[cfg_attr(\n    54\t    feature = \"datom\",\n    55\t    derive(datom_codec::Datomizable, datom_codec::Compositional)\n    56\t)]\n    57\tpub enum LockRejection {\n    58\t    DuplicateName(Lock),\n    59\t    PathOverlap(LockOverlap),\n    60\t}\n    61\t#[rustfmt::skip]\n    62\t#[derive(rkyv::Archive, rkyv::Serialize, rkyv::Deserialize, Clone, Debug, PartialEq)]\n    63\t#[cfg_attr(\n    64\t    feature = \"datom\",\n    65\t    derive(datom_codec::Datomizable, datom_codec::Compositional)\n    66\t)]\n    67\tpub enum ReleaseRejection {\n    68\t    UnknownLockId,\n    69\t}\n    70\t#[rustfmt::skip]\n    71\t#[derive(rkyv::Archive, rkyv::Serialize, rkyv::Deserialize, Clone, Debug, PartialEq)]\n    72\t#[cfg_attr(\n    73\t    feature = \"datom\",\n    74\t    derive(datom_codec::Datomizable, datom_codec::Compositional)\n    75\t)]\n    76\tpub enum ObserveSelection {\n    77\t    Locks(Locks),\n    78\t}\n    79\t#[rustfmt::skip]\n    80\tpub type Locks = std::vec::Vec<Lock>;\n    81\t#[rustfmt::skip]\n    82\t#[derive(rkyv::Archive, rkyv::Serialize, rkyv::Deserialize, Clone, Debug, PartialEq)]\n    83\t#[cfg_attr(\n    84\t    feature = \"datom\",\n    85\t    derive(datom_codec::Datomizable, datom_codec::Compositional)\n    86\t)]\n    87\tpub enum Observation {\n    88\t    Locks(Locks),\n    89\t}\n    90\t#[rustfmt::skip]\n    91\t#[derive(rkyv::Archive, rkyv::Serialize, rkyv::Deserialize, Clone, Debug, PartialEq)]\n    92\t#[cfg_attr(\n    93\t    feature = \"datom\",\n    94\t    derive(datom_codec::Datomizable, datom_codec::Compositional)\n    95\t)]\n    96\tpub enum Query {\n    97\t    Lock(LockRequest),\n    98\t    Release(LockId),\n    99\t    Observe(ObserveSelection),\n   100\t}\n   101\t#[rustfmt::skip]\n   102\t#[derive(rkyv::Archive, rkyv::Serialize, rkyv::Deserialize, Clone, Debug, PartialEq)]\n   103\t#[cfg_attr(\n   104\t    feature = \"datom\",\n   105\t    derive(datom_codec::Datomizable, datom_codec::Compositional)\n   106\t)]\n   107\tpub enum Response {\n   108\t    Locked(Lock),\n   109\t    LockRejected(LockRejection),\n   110\t    Released(Lock),\n   111\t    ReleaseRejected(ReleaseRejection),\n   112\t    Observed(Observation),\n   113\t}\n     1\t#![allow(dead_code, non_camel_case_types, non_snake_case)]\n     2\t#[rustfmt::skip]\n     3\t#[derive(datom_codec::Datomizable, datom_codec::Compositional, Clone, Debug, PartialEq)]\n     4\tpub struct Result {\n     5\t    pub string: String,\n     6\t}\n     7\t#[rustfmt::skip]\n     8\t#[derive(datom_codec::Datomizable, datom_codec::Compositional, Clone, Debug, PartialEq)]\n     9\tpub struct Box {\n    10\t    pub string: String,\n    11\t}\n    12\t#[rustfmt::skip]\n    13\t#[derive(datom_codec::Datomizable, datom_codec::Compositional, Clone, Debug, PartialEq)]\n    14\tpub struct Tree {\n    15\t    pub self_option: Option<std::boxed::Box<Self>>,\n    16\t}\n    17\t#[rustfmt::skip]\n    18\t#[derive(datom_codec::Datomizable, datom_codec::Compositional, Clone, Debug, PartialEq)]\n    19\tpub struct Choice_Data_Item_Data {\n    20\t    pub result: Result,\n    21\t    pub r#box: Box,\n    22\t}\n    23\t#[derive(datom_codec::Datomizable, datom_codec::Compositional, Clone, Debug, PartialEq)]\n    24\tpub enum Choice_Data {\n    25\t    Item(Choice_Data_Item_Data),\n    26\t}\n    27\t#[derive(datom_codec::Datomizable, datom_codec::Compositional, Clone, Debug, PartialEq)]\n    28\tpub enum Nested {\n    29\t    Choice(Choice_Data),\n    30\t}\n     1\t#![allow(dead_code, non_camel_case_types, non_snake_case)]\n     2\t#[rustfmt::skip]\n     3\t#[derive(datom_codec::Datomizable, datom_codec::Compositional, Clone, Debug, PartialEq)]\n     4\tpub struct Placed {\n     5\t    pub integer_option: Option<i64>,\n     6\t    pub integer: i64,\n     7\t}\n     8\t#[rustfmt::skip]\n     9\t#[derive(datom_codec::Datomizable, datom_codec::Compositional, Clone, Debug, PartialEq)]\n    10\tpub struct Score {\n    11\t    pub decimal: f64,\n    12\t    pub boolean: bool,\n    13\t    pub meaning: datom_codec::Meaning,\n    14\t}\n     1\t#![allow(dead_code, non_camel_case_types, non_snake_case)]\n     2\t#[rustfmt::skip]\n     3\t#[derive(datom_codec::Datomizable, datom_codec::Compositional, Clone, Debug, PartialEq)]\n     4\tpub struct Record {\n     5\t    pub string: String,\n     6\t    pub integer: i64,\n     7\t}\n     1\t//! A generated Signal contract is a Rust-only surface when its optional\n     2\t//! `datom` feature is absent.  This deliberately compiles it in a separate\n     3\t//! Cargo package with no `datom-codec` dependency.\n     4\t\n     5\tuse std::process::Command;\n     6\t\n     7\t#[test]\n     8\tfn generated_signal_compiles_without_datom_codec() {\n     9\t    let directory = format!(\n    10\t        \"{}/signal-without-datom-{}\",\n    11\t        env!(\"CARGO_TARGET_TMPDIR\"),\n    12\t        std::process::id()\n    13\t    );\n    14\t    let _ = std::fs::remove_dir_all(&directory);\n    15\t    std::fs::create_dir_all(format!(\"{directory}/src\")).expect(\"temporary source directory\");\n    16\t    std::fs::write(\n    17\t        format!(\"{directory}/Cargo.toml\"),\n    18\t        \"[package]\\nname = \\\"signal-without-datom\\\"\\nversion = \\\"0.1.0\\\"\\nedition = \\\"2024\\\"\\n[features]\\ndatom = []\\n[dependencies]\\nrkyv = { version = \\\"0.8\\\", default-features = false, features = [\\\"std\\\", \\\"bytecheck\\\", \\\"little_endian\\\", \\\"pointer_width_32\\\", \\\"unaligned\\\"] }\\n\",\n    19\t    )\n    20\t    .expect(\"temporary manifest\");\n    21\t    std::fs::write(\n    22\t        format!(\"{directory}/src/lib.rs\"),\n    23\t        include_str!(\"generated/orchestrate.rs\"),\n    24\t    )\n    25\t    .expect(\"generated Signal source\");\n    26\t\n    27\t    let status = Command::new(\"cargo\")\n    28\t        .args([\n    29\t            \"check\",\n    30\t            \"--manifest-path\",\n    31\t            &format!(\"{directory}/Cargo.toml\"),\n    32\t            \"--no-default-features\",\n    33\t        ])\n    34\t        .status()\n    35\t        .expect(\"cargo is available\");\n    36\t    assert!(\n    37\t        status.success(),\n    38\t        \"generated Signal must not require datom-codec\"\n    39\t    );\n    40\t}\n    41\t\n    42\t#[test]\n    43\tfn generated_operation_free_signal_compiles_without_datom_codec() {\n    44\t    let directory = format!(\n    45\t        \"{}/empty-signal-without-datom-{}\",\n    46\t        env!(\"CARGO_TARGET_TMPDIR\"),\n    47\t        std::process::id()\n    48\t    );\n    49\t    let _ = std::fs::remove_dir_all(&directory);\n    50\t    std::fs::create_dir_all(format!(\"{directory}/src\")).expect(\"temporary source directory\");\n    51\t    std::fs::write(\n    52\t        format!(\"{directory}/Cargo.toml\"),\n    53\t        \"[package]\\nname = \\\"empty-signal-without-datom\\\"\\nversion = \\\"0.1.0\\\"\\nedition = \\\"2024\\\"\\n[features]\\ndatom = []\\n[dependencies]\\nrkyv = { version = \\\"0.8\\\", default-features = false, features = [\\\"std\\\", \\\"bytecheck\\\", \\\"little_endian\\\", \\\"pointer_width_32\\\", \\\"unaligned\\\"] }\\n\",\n    54\t    ).expect(\"temporary manifest\");\n    55\t    std::fs::write(\n    56\t        format!(\"{directory}/src/lib.rs\"),\n    57\t        include_str!(\"generated/empty-signal.rs\"),\n    58\t    )\n    59\t    .expect(\"generated Signal source\");\n    60\t    assert!(\n    61\t        Command::new(\"cargo\")\n    62\t            .args([\n    63\t                \"check\",\n    64\t                \"--manifest-path\",\n    65\t                &format!(\"{directory}/Cargo.toml\"),\n    66\t                \"--no-default-features\"\n    67\t            ])\n    68\t            .status()\n    69\t            .expect(\"cargo is available\")\n    70\t            .success()\n    71\t    );\n    72\t}\n     1\tLibrary\n     2\t[]\n     3\t[ Result.{ String } Box.{ String } Tree.{ Option<Self> } Nested.[ Choice.[ Item.{ Result Box } ] ] ]\n     4\t[]\n     5\t[]\n     1\t; Named fields use type-first names for intrinsic and container positions.\n     2\tLibrary\n     3\t[]\n     4\t[ Placed.{ Option<Integer> Integer }\n     5\t  Score.{ Decimal Boolean Meaning } ]\n     6\t[]\n     7\t[]\n     1\t; Orchestrate lock signal\n     2\tSignal\n     3\t[]\n     4\t[ Lock.LockRequest  Release.LockId  Observe.ObserveSelection ]\n     5\t[ Locked.Lock  LockRejected.LockRejection  Released.Lock  ReleaseRejected.ReleaseRejection  Observed.Observation ]\n     6\t[ LockId.Integer\n     7\t  LockName.String\n     8\t  FlowId.String\n     9\t  LockPath.String\n    10\t  LockPaths.Vector<LockPath>\n    11\t  LockReason.String\n    12\t  LockRequest.{ LockName FlowId LockPaths LockReason }\n    13\t  Lock.{ LockId LockName FlowId LockPaths LockReason }\n    14\t  DuplicateName.Lock\n    15\t  LockOverlap.{ LockPath Lock }\n    16\t  LockRejection.[ DuplicateName.Lock  PathOverlap.LockOverlap ]\n    17\t  ReleaseRejection.[ UnknownLockId ]\n    18\t  ObserveSelection.[ Locks ]\n    19\t  Locks.Vector<Lock>\n    20\t  Observation.[ Locks.Locks ] ]\n","exit_code":0,"status":"completed"}}
