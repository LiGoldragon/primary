(glyph),\n   530\t                PrintStep::Space => out.push(' '),\n   531\t                PrintStep::Form(form) => match form {\n   532\t                    Self::Bare { text, .. } => out.push_str(text),\n   533\t                    Self::Opaque {\n   534\t                        boundary, content, ..\n   535\t                    } => {\n   536\t                        out.push(boundary.opener());\n   537\t                        if *boundary == Boundary::Guillemets {\n   538\t                            for glyph in content.chars() {\n   539\t                                if glyph == '»' {\n   540\t                                    out.push('\\\\');\n   541\t                                }\n   542\t                                out.push(glyph);\n   543\t                            }\n   544\t                        } else {\n   545\t                            let mut opens = Vec::new();\n   546\t                            let mut escaped = Vec::new();\n   547\t                            for (index, glyph) in content.char_indices() {\n   548\t                                if glyph == '(' {\n   549\t                                    opens.push(index);\n   550\t                                } else if glyph == ')' && opens.pop().is_none() {\n   551\t                                    escaped.push(index);\n   552\t                                }\n   553\t                            }\n   554\t                            escaped.extend(opens);\n   555\t                            let glyphs: Vec<_> = content.char_indices().collect();\n   556\t                            for (position, (index, glyph)) in glyphs.iter().enumerate() {\n   557\t                                let next = glyphs.get(position + 1).map(|(_, glyph)| *glyph);\n   558\t                                if (*glyph == '\\\\' && matches!(next, None | Some('\\\\' | '(' | ')')))\n   559\t                                    || escaped.contains(index)\n   560\t                                {\n   561\t                                    out.push('\\\\');\n   562\t                                }\n   563\t                                out.push(*glyph);\n   564\t                            }\n   565\t                        }\n   566\t                        out.push(boundary.closer());\n   567\t                    }\n   568\t                    Self::Enclosed {\n   569\t                        enclosure,\n   570\t                        children,\n   571\t                        ..\n   572\t                    } => {\n   573\t                        out.push(enclosure.opener());\n   574\t                        steps.push(PrintStep::Glyph(enclosure.closer()));\n   575\t                        if !children.is_empty() {\n   576\t                            if *enclosure != Enclosure::Angled {\n   577\t                                steps.push(PrintStep::Space);\n   578\t                            }\n   579\t                            for (index, child) in children.iter().enumerate().rev() {\n   580\t                                steps.push(PrintStep::Form(child));\n   581\t                                if index > 0 {\n   582\t                                    steps.push(PrintStep::Space);\n   583\t                                }\n   584\t                            }\n   585\t                            if *enclosure != Enclosure::Angled {\n   586\t                                steps.push(PrintStep::Space);\n   587\t                            }\n   588\t                        }\n   589\t                    }\n   590\t                    Self::Headed {\n   591\t                        head,\n   592\t                        constraints,\n   593\t                        separator,\n   594\t                        body,\n   595\t                        ..\n   596\t                    } => {\n   597\t                        steps.push(PrintStep::Form(body));\n   598\t                        steps.push(PrintStep::Glyph(separator.glyph()));\n   599\t                        if let Some(constraints) = constraints {\n   600\t                            steps.push(PrintStep::Form(constraints));\n   601\t                        }\n   602\t                        steps.push(PrintStep::Text(&head.0));\n   603\t                    }\n   604\t                },\n   605\t            }\n   606\t        }\n   607\t    }\n   608\t}\n   609\timpl Textualizable for Protos {\n   610\t    fn textualize(&self) -> String {\n   611\t        let mut out = String::new();\n   612\t        self.print(&mut out);\n   613\t        out\n   614\t    }\n   615\t}\n   616\tenum CanonicalStep<'a> {\n   617\t    Form(&'a mut Protos),\n   618\t    Text(&'a str),\n   619\t    Glyph(char),\n   620\t    Space,\n   621\t    End(&'a mut Extent),\n   622\t}\n   623\ttrait CanonicalizingTree {\n   624\t    fn canonicalize_tree(&mut self);\n   625\t}\n   626\timpl CanonicalizingTree for Protos {\n   627\t    fn canonicalize_tree(&mut self) {\n   628\t        let mut offset = 0;\n   629\t        let mut steps = vec![CanonicalStep::Form(self)];\n   630\t        while let Some(step) = steps.pop() {\n   631\t            match step {\n   632\t                CanonicalStep::Text(text) => offset += text.len(),\n   633\t                CanonicalStep::Glyph(glyph) => offset += glyph.len_utf8(),\n   634\t                CanonicalStep::Space => offset += ' '.len_utf8(),\n   635\t                CanonicalStep::End(extent) => extent.end = offset,\n   636\t                CanonicalStep::Form(form) => match form {\n   637\t                    Self::Bare { extent, text } => {\n   638\t                        extent.start = offset;\n   639\t                        offset += text.len();\n   640\t                        extent.end = offset;\n   641\t                    }\n   642\t                    Self::Opaque {\n   643\t                        extent,\n   644\t                        boundary,\n   645\t                        content,\n   646\t                    } => {\n   647\t                        extent.start = offset;\n   648\t                        // Opaque nodes are leaves, so the shared writer is\n   649\t                        // bounded by their content and cannot traverse a tree.\n   650\t                        let opaque = Self::Opaque {\n   651\t                            extent: *extent,\n   652\t                            boundary: *boundary,\n   653\t                            content: content.clone(),\n   654\t                        };\n   655\t                        offset += opaque.textualize().len();\n   656\t                        extent.end = offset;\n   657\t                    }\n   658\t                    Self::Enclosed {\n   659\t                        extent,\n   660\t                        enclosure,\n   661\t                        children,\n   662\t                    } => {\n   663\t                        extent.start = offset;\n   664\t                        offset += enclosure.opener().len_utf8();\n   665\t                        steps.push(CanonicalStep::End(extent));\n   666\t                        steps.push(CanonicalStep::Glyph(enclosure.closer()));\n   667\t                        if !children.is_empty() {\n   668\t                            if *enclosure != Enclosure::Angled {\n   669\t                                steps.push(CanonicalStep::Space);\n   670\t                            }\n   671\t                            for (index, child) in children.iter_mut().enumerate().rev() {\n   672\t                                steps.push(CanonicalStep::Form(child));\n   673\t                                if index > 0 {\n   674\t                                    steps.push(CanonicalStep::Space);\n   675\t                                }\n   676\t                            }\n   677\t                            if *enclosure != Enclosure::Angled {\n   678\t                                steps.push(CanonicalStep::Space);\n   679\t                            }\n   680\t                        }\n   681\t                    }\n   682\t                    Self::Headed {\n   683\t                        extent,\n   684\t                        head,\n   685\t                        constraints,\n   686\t                        separator,\n   687\t                        body,\n   688\t                    } => {\n   689\t                        extent.start = offset;\n   690\t                        steps.push(CanonicalStep::End(extent));\n   691\t                        steps.push(CanonicalStep::Form(body));\n   692\t                        steps.push(CanonicalStep::Glyph(separator.glyph()));\n   693\t                        if let Some(constraints) = constraints {\n   694\t                            steps.push(CanonicalStep::Form(constraints));\n   695\t                        }\n   696\t                        steps.push(CanonicalStep::Text(&head.0));\n   697\t                    }\n   698\t                },\n   699\t            }\n   700\t        }\n   701\t    }\n   702\t}\n   703\timpl Canonicalizable for Protos {\n   704\t    fn canonicalize(&mut self) {\n   705\t        self.canonicalize_tree();\n   706\t    }\n   707\t}\n   708\timpl fmt::Display for Error {\n   709\t    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {\n   710\t        write!(\n   711\t            formatter,\n   712\t            \"structural error at {}..{}: {:?}\",\n   713\t            self.extent.start, self.extent.end, self.problem\n   714\t        )\n   715\t    }\n   716\t}\n   717\timpl std::error::Error for Error {}\n     1\tuse protos::{\n     2\t    Boundary, BoundedProtosizable, Canonicalizable, Enclosure, Extent, Protos, Protosizable,\n     3\t    ReaderBudget, Separator, Symbol, Textualizable,\n     4\t};\n     5\tuse std::process::Command;\n     6\t\n     7\tfn form_extent(form: &Protos) -> Extent {\n     8\t    match form {\n     9\t        Protos::Headed { extent, .. }\n    10\t        | Protos::Enclosed { extent, .. }\n    11\t        | Protos::Opaque { extent, .. }\n    12\t        | Protos::Bare { extent, .. } => *extent,\n    13\t    }\n    14\t}\n    15\t#[test]\n    16\tfn structural_forms_keep_their_own_extents() {\n    17\t    let form = \"Reviewer.{ 2024 17 }\".protosize().expect(\"structure\");\n    18\t    assert_eq!(form.textualize(), \"Reviewer.{ 2024 17 }\");\n    19\t    let Protos::Headed { body, .. } = &form else {\n    20\t        panic!(\"headed\")\n    21\t    };\n    22\t    let Protos::Enclosed {\n    23\t        enclosure,\n    24\t        children,\n    25\t        ..\n    26\t    } = body.as_ref()\n    27\t    else {\n    28\t        panic!(\"enclosed\")\n    29\t    };\n    30\t    assert_eq!(*enclosure, Enclosure::Braced);\n    31\t    assert_eq!(children.len(), 2);\n    32\t}\n    33\t\n    34\t#[test]\n    35\tfn invalid_separator_chains_remain_one_bare_run() {\n    36\t    for text in [\n    37\t        \"a.\",\n    38\t        \".a\",\n    39\t        \"a..b\",\n    40\t        \"a.b.\",\n    41\t        \"..\",\n    42\t        \".codex/agents/worker.toml\",\n    43\t        \".猫/龍.\",\n    44\t    ] {\n    45\t        let form = text.protosize().expect(\"bare run\");\n    46\t        assert!(\n    47\t            matches!(&form, Protos::Bare { text: value, .. } if value == text),\n    48\t            \"{text}: {form:?}\"\n    49\t        );\n    50\t        assert_eq!(form.textualize(), text);\n    51\t    }\n    52\t}\n    53\t\n    54\t#[test]\n    55\tfn complete_separator_chains_remain_headed_with_exact_extents() {\n    56\t    for text in [\n    57\t        \"lower.case\",\n    58\t        \"Upper.Case\",\n    59\t        \"a:b:c\",\n    60\t        \"a!b!c\",\n    61\t        \"https://example.org/a\",\n    62\t        \"猫.龍\",\n    63\t        \"Observed.Locks.[]\",\n    64\t        \"Reviewer.{ 2024 17 }\",\n    65\t        \"Some.(x)\",\n    66\t    ] {\n    67\t        let form = text.protosize().expect(\"headed structure\");\n    68\t        assert!(matches!(&form, Protos::Headed { .. }), \"{text}: {form:?}\");\n    69\t        assert_eq!(\n    70\t            form_extent(&form),\n    71\t            Extent {\n    72\t                start: 0,\n    73\t                end: text.len()\n    74\t            }\n    75\t        );\n    76\t        assert_eq!(form.textualize(), text);\n    77\t    }\n    78\t}\n    79\t\n    80\t#[test]\n    81\tfn opaque_guillemets_escape_their_closer() {\n    82\t    let form = \"«she said \\\\»no\\\\» and left»\".protosize().expect(\"string\");\n    83\t    assert_eq!(form.textualize(), \"«she said \\\\»no\\\\» and left»\");\n    84\t    assert!(matches!(\n    85\t        form,\n    86\t        Protos::Opaque {\n    87\t            boundary: Boundary::Guillemets,\n    88\t            ..\n    89\t        }\n    90\t    ));\n    91\t}\n    92\t\n    93\t#[test]\n    94\tfn a_guillemet_escape_does_not_consume_an_ordinary_backslash() {\n    95\t    let form = \"«path\\\\segment»\".protosize().expect(\"string\");\n    96\t    assert_eq!(form.textualize(), \"«path\\\\segment»\");\n    97\t}\n    98\t\n    99\t#[test]\n   100\tfn parentheses_are_one_balanced_opaque_structure() {\n   101\t    let form = \"(a (b))\".protosize().expect(\"meaning structure\");\n   102\t    assert_eq!(form.textualize(), \"(a (b))\");\n   103\t    assert!(matches!(\n   104\t        form,\n   105\t        Protos::Opaque {\n   106\t            boundary: Boundary::Parentheses,\n   107\t            ..\n   108\t        }\n   109\t    ));\n   110\t}\n   111\t\n   112\t#[test]\n   113\tfn parentheses_escape_their_structural_glyphs() {\n   114\t    for text in [\"(x\\\\))\", \"(\\\\()\"] {\n   115\t        let form = text.protosize().expect(\"escaped meaning\");\n   116\t        assert_eq!(form.textualize(), text);\n   117\t    }\n   118\t}\n   119\t\n   120\t#[test]\n   121\tfn a_meaning_keeps_an_ordinary_backslash() {\n   122\t    let form = \"(path\\\\segment)\".protosize().expect(\"meaning\");\n   123\t    assert_eq!(form.textualize(), \"(path\\\\segment)\");\n   124\t    assert!(matches!(\n   125\t        &form,\n   126\t        Protos::Opaque { content, .. } if content == \"path\\\\segment\"\n   127\t    ));\n   128\t}\n   129\t\n   130\t#[test]\n   131\tfn reader_budget_bounds_recursive_descent() {\n   132\t    let mut budget = ReaderBudget { remaining: 2 };\n   133\t    assert!(\"{ { Ada } }\".protosize_with(&mut budget).is_err());\n   134\t}\n   135\t\n   136\t#[test]\n   137\tfn bounded_depth_probe_child() {\n   138\t    if std::env::var_os(\"PROTOS_DEPTH_PROBE\").is_none() {\n   139\t        return;\n   140\t    }\n   141\t    let text = format!(\"{}Ada{}\", \"{\".repeat(100_001), \"}\".repeat(100_001));\n   142\t    let mut budget = ReaderBudget { remaining: 100_002 };\n   143\t    assert!(text.protosize_with(&mut budget).is_err());\n   144\t}\n   145\t\n   146\t#[test]\n   147\tfn depth_is_bounded_independently_of_node_budget() {\n   148\t    let text = format!(\"[ {}]\", \"Ada \".repeat(10_000));\n   149\t    let mut budget = ReaderBudget { remaining: 10_001 };\n   150\t    let form = text.protosize_with(&mut budget).expect(\"wide structure\");\n   151\t    assert!(matches!(&form, Protos::Enclosed { children, .. } if children.len() == 10_000));\n   152\t}\n   153\t\n   154\t#[test]\n   155\tfn deeply_constructed_forms_print_without_recursion() {\n   156\t    let mut form = Protos::Bare {\n   157\t        extent: protos::Extent { start: 0, end: 1 },\n   158\t        text: String::from(\"Ada\"),\n   159\t    };\n   160\t    for _ in 0..100_001 {\n   161\t        form = Protos::Headed {\n   162\t            extent: protos::Extent { start: 0, end: 1 },\n   163\t            head: protos::Symbol(String::from(\"A\")),\n   164\t            constraints: None,\n   165\t            separator: protos::Separator::Period,\n   166\t            body: Box::new(form),\n   167\t        };\n   168\t    }\n   169\t    let text = form.textualize();\n   170\t    assert_eq!(text.len(), 200_005);\n   171\t    assert!(text.ends_with(\"Ada\"));\n   172\t    drop(form);\n   173\t}\n   174\t\n   175\t#[test]\n   176\tfn deeply_constructed_forms_drop_without_recursion() {\n   177\t    let mut form = Protos::Bare {\n   178\t        extent: protos::Extent { start: 0, end: 1 },\n   179\t        text: String::from(\"Ada\"),\n   180\t    };\n   181\t    for _ in 0..100_000 {\n   182\t        form = Protos::Headed {\n   183\t            extent: protos::Extent { start: 0, end: 1 },\n   184\t            head: protos::Symbol(String::from(\"A\")),\n   185\t            constraints: None,\n   186\t            separator: protos::Separator::Period,\n   187\t            body: Box::new(form),\n   188\t        };\n   189\t    }\n   190\t    drop(form);\n   191\t}\n   192\t\n   193\t#[test]\n   194\tfn canonicalization_assigns_utf8_extents_without_reading() {\n   195\t    let mut form = Protos::Headed {\n   196\t        extent: Extent { start: 99, end: 99 },\n   197\t        head: Symbol(\"H\".into()),\n   198\t        constraints: Some(Box::new(Protos::Enclosed {\n   199\t            extent: Extent { start: 99, end: 99 },\n   200\t            enclosure: Enclosure::Angled,\n   201\t            children: vec![\n   202\t                Protos::Bare {\n   203\t                    extent: Extent { start: 99, end: 99 },\n   204\t                    text: \"A\".into(),\n   205\t                },\n   206\t                Protos::Bare {\n   207\t                    extent: Extent { start: 99, end: 99 },\n   208\t                    text: \"B\".into(),\n   209\t                },\n   210\t            ],\n   211\t        })),\n   212\t        separator: Separator::Period,\n   213\t        body: Box::new(Protos::Enclosed {\n   214\t            extent: Extent { start: 99, end: 99 },\n   215\t            enclosure: Enclosure::Braced,\n   216\t            children: vec![\n   217\t                Protos::Opaque {\n   218\t                    extent: Extent { start: 99, end: 99 },\n   219\t                    boundary: Boundary::Guillemets,\n   220\t                    content: \"é»\".into(),\n   221\t                },\n   222\t                Protos::Opaque {\n   223\t                    extent: Extent { start: 99, end: 99 },\n   224\t                    boundary: Boundary::Parentheses,\n   225\t                    content: \"x)\".into(),\n   226\t                },\n   227\t                Protos::Enclosed {\n   228\t                    extent: Extent { start: 99, end: 99 },\n   229\t                    enclosure: Enclosure::Bracketed,\n   230\t                    children: vec![],\n   231\t                },\n   232\t            ],\n   233\t        }),\n   234\t    };\n   235\t    form.canonicalize();\n   236\t    let text = form.textualize();\n   237\t    assert_eq!(text, \"H<A B>.{ «é\\\\»» (x\\\\)) [] }\");\n   238\t    let Protos::Headed {\n   239\t        extent,\n   240\t        constraints: Some(constraints),\n   241\t        body,\n   242\t        ..\n   243\t    } = &form\n   244\t    else {\n   245\t        panic!(\"headed form\")\n   246\t    };\n   247\t    assert_eq!(&text[extent.start..extent.end], text);\n   248\t    let constraints_extent = form_extent(constraints);\n   249\t    assert_eq!(\n   250\t        &text[constraints_extent.start..constraints_extent.end],\n   251\t        \"<A B>\"\n   252\t    );\n   253\t    let Protos::Enclosed {\n   254\t        extent, children, ..\n   255\t    } = body.as_ref()\n   256\t    else {\n   257\t        panic!(\"braced body\")\n   258\t    };\n   259\t    assert_eq!(&text[extent.start..extent.end], \"{ «é\\\\»» (x\\\\)) [] }\");\n   260\t    for (child, expected) in children.iter().zip([\"«é\\\\»»\", \"(x\\\\))\", \"[]\"]) {\n   261\t        let child_extent = form_extent(child);\n   262\t        assert_eq!(&text[child_extent.start..child_extent.end], expected);\n   263\t    }\n   264\t}\n   265\t\n   266\t#[test]\n   267\tfn canonicalization_is_iterative_for_wide_and_deep_structures() {\n   268\t    let mut wide = Protos::Enclosed {\n   269\t        extent: Extent { start: 0, end: 0 },\n   270\t        enclosure: Enclosure::Bracketed,\n   271\t        children: (0..5_000)\n   272\t            .map(|_| Protos::Bare {\n   273\t                extent: Extent { start: 0, end: 0 },\n   274\t                text: \"é\".into(),\n   275\t            })\n   276\t            .collect(),\n   277\t    };\n   278\t    wide.canonicalize();\n   279\t    let wide_text = wide.textualize();\n   280\t    assert_eq!(form_extent(&wide).end, wide_text.len());\n   281\t\n   282\t    let mut deep = Protos::Bare {\n   283\t        extent: Extent { start: 0, end: 0 },\n   284\t        text: \"x\".into(),\n   285\t    };\n   286\t    for _ in 0..100_000 {\n   287\t        deep = Protos::Headed {\n   288\t            extent: Extent { start: 0, end: 0 },\n   289\t            head: Symbol(\"V\".into()),\n   290\t            constraints: None,\n   291\t            separator: Separator::Period,\n   292\t            body: Box::new(deep),\n   293\t        };\n   294\t    }\n   295\t    deep.canonicalize();\n   296\t    assert_eq!(\n   297\t        form_extent(&deep),\n   298\t        Extent {\n   299\t            start: 0,\n   300\t            end: 200_001\n   301\t        }\n   302\t    );\n   303\t    drop(deep);\n   304\t}\n   305\t\n   306\t#[test]\n   307\tfn depth_probe_is_bounded_by_memory_and_time() {\n   308\t    let executable = std::env::current_exe().expect(\"test executable\");\n   309\t    let output = Command::new(\"sh\")\n   310\t        .arg(\"-c\")\n   311\t        .arg(\"ulimit -v 262144; exec timeout 30 \\\"$0\\\" \\\"$@\\\"\")\n   312\t        .arg(executable)\n   313\t        .arg(\"--exact\")\n   314\t        .arg(\"bounded_depth_probe_child\")\n   315\t        .arg(\"--nocapture\")\n   316\t        .env(\"PROTOS_DEPTH_PROBE\", \"1\")\n   317\t        .output()\n   318\t        .expect(\"bounded child process\");\n   319\t    assert!(\n   320\t        output.status.success(),\n   321\t        \"deep reader probe failed: {}\\n{}\",\n   322\t        output.status,\n   323\t        String::from_utf8_lossy(&output.stderr)\n   324\t    );\n   325\t}\n   326\t\n   327\t#[test]\n   328\tfn angle_brackets_remain_structural() {\n   329\t    let form = \"<Thing Other>\".protosize().expect(\"structural angle\");\n   330\t    assert_eq!(form.textualize(), \"<Thing Other>\");\n   331\t    assert!(matches!(\n   332\t        form,\n   333\t        Protos::Enclosed {\n   334\t            enclosure: Enclosure::Angled,\n   335\t            ..\n   336\t        }\n   337\t    ));\n   338\t}\n   339\t\n   340\t#[test]\n   341\tfn qualified_names_are_one_structural_form() {\n   342\t    let text = \"Processable<[Clonable Sendable] Serializable>.[ Vector<String> ]\";\n   343\t    let form = text.protosize().expect(\"qualified headed form\");\n   344\t    assert_eq!(\n   345\t        form.textualize(),\n   346\t        \"Processable<[ Clonable Sendable ] Serializable>.[ Vector <String> ]\"\n   347\t    );\n   348\t    let Protos::Headed {\n   349\t        head,\n   350\t        constraints: Some(constraints),\n   351\t        body,\n   352\t        ..\n   353\t    } = &form\n   354\t    else {\n   355\t        panic!(\"qualified heading\")\n   356\t    };\n   357\t    assert_eq!(head.0, \"Processable\");\n   358\t    assert!(matches!(\n   359\t        constraints.as_ref(),\n   360\t        Protos::Enclosed { enclosure: Enclosure::Angled, children, .. }\n   361\t        if children.len() == 2\n   362\t    ));\n   363\t    assert!(matches!(\n   364\t        body.as_ref(),\n   365\t        Protos::Enclosed { children, .. }\n   366\t        if matches!(children.as_slice(), [Protos::Bare { text, .. }, Protos::Enclosed { enclosure: Enclosure::Angled, .. }] if text == \"Vector\")\n   367\t    ));\n   368\t}\n     1\t# protos\n     2\t\n     3\tThe universal structural substrate. Protos is only about structure: it owns the\n     4\tone character reader and the one character writer every dialect shares, and it\n     5\tknows nothing of struct, vector, integer or string. What a structure means is\n     6\tsaid by the dialect.\n     7\t\n     8\t## Layers\n     9\t\n    10\tText, Protoform, Concept, Corporate. Text arrives as a `Potential` value and\n    11\tdescends; a corporate value ascends. A capability is named by the layer it goes\n    12\tto.\n    13\t\n    14\t| capability | kind | goes to | borne by |\n    15\t|---|---|---|---|\n    16\t| `protosize` | `Protosizable` | Protoform | `str`, `String` (the delineation; may fault); a dialect's concept (cannot) |\n    17\t| `conceive` | `Conceivable<C>` | Concept | `Situated<Protoform>`, `Delineation` (in the dialect) |\n    18\t| `incorporate` | `Incorporable<T>` | Corporate | the dialect's concept |\n    19\t| `actualize` | `Actualizable<T>` | Corporate | `Potential<T, C>`: the whole descent |\n    20\t| `textualize` | `Textualizable` | Text | `Protoform`, `Delineation`; the dialect's concept |\n    21\t| `situate` | `Situating` | Text | `Protoform`: text and situation in one pass |\n    22\t\n    23\t## Structure\n    24\t\n    25\t`Protos` is every unit of the text: `Headed` (a head, separator, and body),\n    26\t`Enclosed` (structures between `{ }`, `[ ]` or `< >`), `Opaque` (content between\n    27\t`« »` or `( )`), and `Bare` (a head alone). Every `Protos` node carries its\n    28\town `Extent`.\n    29\t\n    30\tA `Headed` form has a `Symbol` head and an optional extent-bearing angled\n    31\t`Enclosed` form in `constraints`. This holds the anatomy of\n    32\t`Processable<[Clonable Sendable] Serializable>.[ ... ]`, with no type or kind\n    33\tmeaning. `Vector<String>` without a following heading separator remains the\n    34\tadjacent structural forms `Bare(\"Vector\")` and angled `Enclosed` for its\n    35\tconceptual reader to relate.\n    36\t\n    37\t## Situation\n    38\t\n    39\tExtents are not intrinsic to structures. A `Situation` is a tree parallel to the\n    40\tstructure: the structure's `Extent` and the situations of its children, in path\n    41\torder. `Situated<T>` pairs a value with its situation; a `Delineation` is the\n    42\ttext's top-level structures, each situated. The reader finds the situation on\n    43\tthe way in; the writer computes it on the way out, from the offsets it writes\n    44\tat. Memory is one situation node per structure: linear in the text.\n    45\t\n    46\tThe path convention, stated on `Pathed`: a headed structure's head is child 0\n    47\tand its body child 1; an enclosure's children are in order; a qualified head's\n    48\tconstraints are the head's children. `Locating::locate` looks a situation up by\n    49\tpath.\n    50\t\n    51\t## Reading\n    52\t\n    53\tWhitespace separates; `;` opens a comment to the end of the line. A bare run is\n    54\ta maximal run of plain and separator (`.` `!` `:`) glyphs; a symbol is a\n    55\tnon-empty run with no separator.\n    56\t\n    57\t- A run is a chain (right-associative `Headed`) only when every segment between\n    58\t  its separators is a symbol: `a:b:c`, `Some.42`. Any other run is one bare\n    59\t  word: `a.`, `.a`, `a..b`, `2026-09-03`.\n    60\t- A run ending in exactly one separator, immediately followed by an opener,\n    61\t  opens that structure as the chain's body: `Reviewer.{ 2024 17 }`,\n    62\t  `Observed.Locks.[]`, `Some.(x)`.\n    63\t- A run of symbols immediately followed by `<` qualifies its last symbol:\n    64\t  `Vector<Text>`, `A<B>.{ 1 }`, `A<B>.C`.\n    65\t- Every other adjacency yields siblings: `a..{ 1 }`, `a<b>c`, `a.{ 1 }.b`.\n    66\t- Curly quotes are opaque to the first `”`; parentheses are read by balance,\n    67\t  with `\\(` `\\)` `\\\\` unescaped.\n    68\t\n    69\tFaults are structural only and carry their extent. The reader has a fixed\n    70\tstructural-depth boundary independent of its public node budget; the writer\n    71\tuses an explicit stack and accepts arbitrarily deep constructed trees.\n    72\t\n    73\t## Writing\n    74\t\n    75\tCanonical text: `{ a b }` and `[ a b ]` spaced, `{}` `[]` empty; `<a b>` tight;\n    76\t`“x”` never spaced; `Head.body`; siblings one space apart; one line. Inside\n    77\tparentheses only an unbalanced parenthesis and a backslash are escaped, so a\n    78\tbalanced inner pair is written verbatim. Writing cannot fault: `Text` is a\n    79\tstring that cannot carry `”`, refused at construction with a `Refusal` naming\n    80\tthe glyph and its offset.\n    81\t\n    82\t## Anatomy\n    83\t\n    84\t| module | what | kind |\n    85\t|---|---|---|\n    86\t| `anatomy` | the types of every layer | |\n    87\t| `kinds` | the kinds | |\n    88\t| `glyph` | each delimiter's glyphs; classification by walking the variants | `Glyphing`, `Delimiting`, `Serial`, `Classifying` |\n    89\t| `text` | `Text` and its refusal | |\n    90\t| `run` | a bare run split into its pieces | |\n    91\t| `delineation` | the reader: frames, runs, heads, enclosures | `Protosizable` |\n    92\t| `opaque` | the opaque regions: quotes, parentheses by balance | |\n    93\t| `textualization` | the writer, with the situation | `Situating`, `Textualizable` |\n    94\t| `situation` | lookup by path; iterative drop | `Locating` |\n    95\t| `actualization` | `Potential` and the descent | `Actualizable` |\n    96\t| `dropping` | iterative drop of the protoform tree | |\n    97\t\n    98\tNo free functions, no inherent impls, no zero-sized bearers, no variant rosters:\n    99\t`nix flake check` carries the guards, with build, test, fmt, clippy and doc.\n     1\t[package]\n     2\tname = \"protos\"\n     3\tversion = \"0.29.1\"\n     4\tedition = \"2024\"\n     5\trust-version = \"1.85\"\n     6\tlicense = \"MIT OR Apache-2.0\"\n     7\trepository = \"https://github.com/LiGoldragon/protos\"\n     8\tdescription = \"Universal structural substrate for the Protos family.\"\n     9\tpublish = false\n    10\tautotests = false\n    11\t\n    12\t[lib]\n    13\tname = \"protos\"\n    14\tpath = \"src/lib.rs\"\n    15\t\n    16\t[dev-dependencies]\n    17\tproptest = \"1.6\"\n    18\t\n    19\t[lints.rust]\n    20\tunsafe_code = \"forbid\"\n    21\tunused = { level = \"warn\", priority = -1 }\n    22\tdead_code = \"warn\"\n    23\t\n    24\t[[test]]\n    25\tname = \"protos\"\n    26\tpath = \"tests/protos.rs\"\n     1\t{\n     2\t  description = \"protos — universal structural substrate\";\n     3\t\n     4\t  inputs = {\n     5\t    nixpkgs.url = \"github:NixOS/nixpkgs/nixpkgs-unstable\";\n     6\t    flake-utils.url = \"github:numtide/flake-utils\";\n     7\t    rust-build = {\n     8\t      url = \"github:LiGoldragon/rust-build\";\n     9\t      inputs.nixpkgs.follows = \"nixpkgs\";\n    10\t    };\n    11\t    ethos-zero = {\n    12\t      url = \"github:LiGoldragon/ethos-zero/daf007296a19ad2f9c8a1e67e102b2e3f09db327\";\n    13\t    };\n    14\t  };\n    15\t\n    16\t  outputs = { self, nixpkgs, flake-utils, rust-build, ethos-zero }:\n    17\t    flake-utils.lib.eachSystem [ \"x86_64-linux\" ] (system:\n    18\t      let\n    19\t        pkgs = import nixpkgs { inherit system; };\n    20\t        rust = rust-build.lib.${system}.fromPkgs pkgs;\n    21\t        inherit (rust) craneLib toolchain;\n    22\t        src = rust.cleanSource { root = ./.; };\n    23\t        common = { inherit src; strictDeps = true; cargoArtifacts = null; doInstallCargoArtifacts = false; };\n    24\t      in {\n    25\t        packages.default = craneLib.buildPackage common;\n    26\t        checks = {\n    27\t          build = craneLib.cargoBuild common;\n    28\t          test = craneLib.cargoTest common;\n    29\t          no-production-free-functions = pkgs.runCommand \"protos-no-production-free-functions\" { } ''\n    30\t            if grep -R -n -E '^(pub(\\([^)]*\\))? )?fn ' ${src}/src; then\n    31\t              echo \"production Rust must not use module-level free functions\" >&2\n    32\t              exit 1\n    33\t            fi\n    34\t            touch $out\n    35\t          '';\n    36\t          no-production-inherent-methods = pkgs.runCommand \"protos-no-production-inherent-methods\" { } ''\n    37\t            if grep -R -n -E '^[[:space:]]*impl[[:space:]]+[[:alpha:]_][[:alnum:]_:<>]*[[:space:]]*\\{' ${src}/src; then\n    38\t              echo \"production Rust must home behavior in traits\" >&2\n    39\t              exit 1\n    40\t            fi\n    41\t            touch $out\n    42\t          '';\n    43\t          no-zst-behavior = pkgs.runCommand \"protos-no-zst-behavior\" { } ''\n    44\t            if grep -R -n -E '^[[:space:]]*(pub[[:space:]]+)?struct[[:space:]]+[[:alpha:]_][[:alnum:]_]*[[:space:]]*;' ${src}/src; then\n    45\t              echo \"behavioral Rust nouns must carry data\" >&2\n    46\t              exit 1\n    47\t            fi\n    48\t            touch $out\n    49\t          '';\n    50\t          no-forbidden-vocabulary = pkgs.runCommand \"protos-no-forbidden-vocabulary\" { } ''\n    51\t            if grep -R -n -i -E 'encode|decode|codec|transcode' ${src}/src; then\n    52\t              echo \"Protos names must use the ruled form vocabulary\" >&2\n    53\t              exit 1\n    54\t            fi\n    55\t            touch $out\n    56\t          '';\n    57\t          generated-contract = pkgs.runCommand \"protos-generated-contract\" {\n    58\t            generator = ethos-zero.packages.${system}.default;\n    59\t            declaration = ./protos.ethos;\n    60\t            committed = ./generated-contract/protos.rs;\n    61\t          } (builtins.readFile ./checks/generated-contract.sh);\n    62\t          doc = craneLib.cargoDoc (common // { RUSTDOCFLAGS = \"-D warnings\"; });\n    63\t          fmt = craneLib.cargoFmt { inherit src; doInstallCargoArtifacts = false; };\n    64\t          clippy = craneLib.cargoClippy (common // { cargoClippyExtraArgs = \"--all-targets -- -D warnings\"; });\n    65\t        };\n    66\t        devShells.default = pkgs.mkShell { packages = [ pkgs.jujutsu toolchain ]; };\n    67\t      });\n    68\t}\n     1\t#![allow(dead_code, non_camel_case_types, non_snake_case)]\n     2\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n     3\tpub struct Extent {\n     4\t    pub first_integer: i64,\n     5\t    pub second_integer: i64,\n     6\t}\n     7\tpub type Symbol = String;\n     8\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n     9\tpub enum Separator {\n    10\t    Period,\n    11\t    Exclamation,\n    12\t    Colon,\n    13\t}\n    14\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    15\tpub enum Enclosure {\n    16\t    Braced,\n    17\t    Bracketed,\n    18\t    Angled,\n    19\t}\n    20\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    21\tpub enum Boundary {\n    22\t    Guillemets,\n    23\t    Parentheses,\n    24\t}\n    25\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    26\tpub struct Headed_Data {\n    27\t    pub extent: Extent,\n    28\t    pub symbol: Symbol,\n    29\t    pub protos_option: Option<std::boxed::Box<Protos>>,\n    30\t    pub separator: Separator,\n    31\t    pub protos: std::boxed::Box<Protos>,\n    32\t}\n    33\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    34\tpub struct Enclosed_Data {\n    35\t    pub extent: Extent,\n    36\t    pub enclosure: Enclosure,\n    37\t    pub protos_vector: std::vec::Vec<Protos>,\n    38\t}\n    39\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    40\tpub struct Opaque_Data {\n    41\t    pub extent: Extent,\n    42\t    pub boundary: Boundary,\n    43\t    pub string: String,\n    44\t}\n    45\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    46\tpub struct Bare_Data {\n    47\t    pub extent: Extent,\n    48\t    pub string: String,\n    49\t}\n    50\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    51\tpub enum Protos {\n    52\t    Headed(Headed_Data),\n    53\t    Enclosed(Enclosed_Data),\n    54\t    Opaque(Opaque_Data),\n    55\t    Bare(Bare_Data),\n    56\t}\n    57\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    58\tpub struct Error {\n    59\t    pub extent: Extent,\n    60\t    pub problem: Problem,\n    61\t}\n    62\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    63\tpub enum Problem {\n    64\t    Empty,\n    65\t    Multiple,\n    66\t    Unclosed(String),\n    67\t    Unexpected(String),\n    68\t    MissingHead,\n    69\t    MissingBody,\n    70\t    Budget,\n    71\t    Depth,\n    72\t}\n    73\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    74\tpub struct ReaderBudget {\n    75\t    pub integer: i64,\n    76\t}\n    77\tpub trait Textualizable {\n    78\t    fn textualize(&self) -> String;\n    79\t}\n    80\tpub trait Canonicalizable {}\n     1\t#![allow(dead_code)]\n     2\tpub trait Serial: Sized + std::marker::Copy {\n     3\t    fn first() -> Self;\n     4\t    fn after(&self) -> Option<Self>;\n     5\t}\n     6\tpub trait Classifying {\n     7\t    fn classify(&self) -> crate::Glyph;\n     8\t}\n     9\tpub trait Textualizable {\n    10\t    fn textualize(&self) -> std::string::String;\n    11\t}\n    12\tpub trait Situating {\n    13\t    fn situate(&self) -> crate::Situated<std::string::String>;\n    14\t}\n    15\tpub trait Protosizable {\n    16\t    type Fault;\n    17\t    fn protosize(&self) -> Result<crate::Delineation, Self::Fault>;\n    18\t}\n    19\tpub trait Conceivable<A: Sized> {\n    20\t    type Fault;\n    21\t    fn conceive(&self) -> Result<crate::Situated<A>, Self::Fault>;\n    22\t}\n    23\tpub trait Actualizable<A: Sized> {\n    24\t    type Fault;\n    25\t    type Budget;\n    26\t    fn actualize(&self, input: Self::Budget) -> Result<A, Self::Fault>;\n    27\t}\n     1\t; The Protos structural substrate's representable public data anatomy. Borrowed\n     2\t; reader helpers and tuple wrapper implementation details are not reflected as\n     3\t; separate Ethos shapes.\n     4\tLibrary\n     5\t[]\n     6\t[ Extent.{ Integer Integer }\n     7\t  Symbol.String\n     8\t  Separator.[ Period Exclamation Colon ]\n     9\t  Enclosure.[ Braced Bracketed Angled ]\n    10\t  Boundary.[ Guillemets Parentheses ]\n    11\t  Protos.[ Headed.{ Extent Symbol Option<Protos> Separator Protos }\n    12\t           Enclosed.{ Extent Enclosure Vector<Protos> }\n    13\t           Opaque.{ Extent Boundary String }\n    14\t           Bare.{ Extent String } ]\n    15\t  Error.{ Extent Problem }\n    16\t  Problem.[ Empty Multiple Unclosed.String Unexpected.String MissingHead MissingBody Budget Depth ]\n    17\t  ReaderBudget.{ Integer } ]\n    18\t[ Textualizable.[ textualize.[ String ] ]\n    19\t  Canonicalizable.[] ]\n    20\t[]\n    21\t; Rust char payloads are represented as one-character String positions because\n    22\t; Character is not an Ethos intrinsic.\n     1\t; The representable public structural conversion kinds. Reader helpers and\n     2\t; unit-yield operational capabilities remain Rust implementation surface until\n     3\t; Ethos can state them without inventing a yield type.\n     4\tLibrary\n     5\t[ crate:[ Protos Error ReaderBudget ] ]\n     6\t[]\n     7\t[ BoundedProtosizable.[ protosize_with!{ [ ReaderBudget ] [ Result<Protos Error> ] } ]\n     8\t  Protosizable.{ [] [ Output ] [] [ protosize.[ Output ] ] }\n     9\t  Textualizable.[ textualize.[ String ] ]\n    10\t  Canonicalizable.[] ]\n    11\t[]\n     1\tset -eu\n     2\t\n     3\ttemporary=\"$(mktemp -d)\"\n     4\tcleanup() {\n     5\t  rm -rf \"$temporary\"\n     6\t}\n     7\ttrap cleanup EXIT\n     8\t\n     9\tname=\"$(basename \"$declaration\" .ethos)\"\n    10\t\"$generator/bin/ethos-zero\" \"Generate.{ «$declaration» «$temporary» }\"\n    11\tcmp \"$temporary/$name.rs\" \"$committed\"\n    12\ttouch \"$out\"\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"agent_message","text":"The first concrete test-boundary issue is visible: Protos disables automatic tests and registers only `tests/protos.rs`; four substantial test files are present but never built. I’m treating those files as non-evidence and checking whether their apparent coverage masks released API/behavior gaps. Next I’m tracing Datom’s composition/ascent path and derive expansion against arbitrary Rust forms and generic containers."}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/run/current-system/sw/bin/zsh -lc 'wc -l src/*.rs crates/datom-codec-derive/src/lib.rs tests/core.rs generated-contract/*.rs; nl -ba src/lib.rs; nl -ba src/core.rs; nl -ba src/composition.rs; nl -ba src/projection.rs; nl -ba src/dropping.rs; nl -ba crates/datom-codec-derive/src/lib.rs; nl -ba crates/datom-codec-derive/Cargo.toml; nl -ba tests/core.rs; nl -ba Cargo.toml; nl -ba flake.nix; nl -ba datom-codec.ethos; nl -ba datom-codec-kinds.ethos; nl -ba generated-contract/datom-codec.rs; nl -ba generated-contract/datom-codec-kinds.rs; nl -ba checks/generated-contract.sh'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/run/current-system/sw/bin/zsh -lc 'wc -l src/*.rs crates/datom-codec-derive/src/lib.rs tests/core.rs generated-contract/*.rs; nl -ba src/lib.rs; nl -ba src/core.rs; nl -ba src/composition.rs; nl -ba src/projection.rs; nl -ba src/dropping.rs; nl -ba crates/datom-codec-derive/src/lib.rs; nl -ba crates/datom-codec-derive/Cargo.toml; nl -ba tests/core.rs; nl -ba Cargo.toml; nl -ba flake.nix; nl -ba datom-codec.ethos; nl -ba datom-codec-kinds.ethos; nl -ba generated-contract/datom-codec.rs; nl -ba generated-contract/datom-codec-kinds.rs; nl -ba checks/generated-contract.sh'","aggregated_output":"  914 src/composition.rs\n  464 src/core.rs\n   32 src/dropping.rs\n   26 src/lib.rs\n  202 src/projection.rs\n  196 crates/datom-codec-derive/src/lib.rs\n  971 tests/core.rs\n   40 generated-contract/datom-codec-kinds.rs\n   38 generated-contract/datom-codec.rs\n 2883 total\n     1\t//! Datomic: positional typed data over Protos.\n     2\t//!\n     3\t//! The datom dialect carries data, strictly typed. Schema-driven and positional:\n     4\t//! the reader walks the expected type, writing is the exact reverse projection,\n     5\t//! and all naming lives in the type. A [`Datom`] is the concept between the\n     6\t//! protoform and the corporate value; a corporate type bears [`Datomizable`] and\n     7\t//! [`Compositional`], and is reached through [`Potential`] on the way in and\n     8\t//! `textualize` on the way out.\n     9\t//! Every fault names its layer, its path and its extent in the text.\n    10\t\n    11\tmod composition;\n    12\tmod core;\n    13\tmod dropping;\n    14\tmod projection;\n    15\t\n    16\tpub use composition::{DatomForming, Meaning, Scalar, Variantizing};\n    17\tpub use core::{\n    18\t    Actualizing, Budget, Budgeting, Composable, CompositionDepthing, Compositional, Datom,\n    19\t    DatomPositioning, Datomizable, Error, ErrorKind, ErrorLayer, ErrorRaising, Form, Naming,\n    20\t    Pathing, Positioning, Positions, Potential, PotentialExtenting, ProtosExtenting,\n    21\t};\n    22\tpub use derive::{Compositional, Datomizable};\n    23\tpub use protos::Symbol;\n    24\tpub type Integer = i64;\n    25\tpub type Path = Vec<Integer>;\n    26\tpub type Opaque = String;\n     1\tuse std::marker::PhantomData;\n     2\t\n     3\tuse crate::composition::Variantizing;\n     4\t\n     5\tuse crate::{Integer, Opaque, Path};\n     6\tuse protos::Symbol;\n     7\t\n     8\t#[derive(Clone, Debug, PartialEq, Eq)]\n     9\tpub struct Datom {\n    10\t    pub path: Path,\n    11\t    pub form: Form,\n    12\t}\n    13\t\n    14\t#[derive(Clone, Debug, PartialEq, Eq)]\n    15\tpub enum Form {\n    16\t    Struct(Vec<Datom>),\n    17\t    Vector(Vec<Datom>),\n    18\t    Variant(Symbol, Box<Datom>),\n    19\t    Bare(String),\n    20\t    String(String),\n    21\t    Meaning(Opaque),\n    22\t}\n    23\t\n    24\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n    25\tpub struct Budget {\n    26\t    pub remaining: Integer,\n    27\t    pub reader: protos::ReaderBudget,\n    28\t    pub depth: Integer,\n    29\t    pub maximum_depth: Integer,\n    30\t}\n    31\t\n    32\tpub trait Budgeting {\n    33\t    fn spend(&mut self, path: &Path) -> Result<(), Error>;\n    34\t}\n    35\tpub trait CompositionDepthing {\n    36\t    fn enter_composition(&mut self, path: &Path) -> Result<(), Error>;\n    37\t    fn leave_composition(&mut self);\n    38\t}\n    39\timpl Budgeting for Budget {\n    40\t    fn spend(&mut self, path: &Path) -> Result<(), Error> {\n    41\t        if self.remaining <= 0 {\n    42\t            return Err(Error {\n    43\t                layer: ErrorLayer::Composition,\n    44\t                path: path.clone(),\n    45\t                kind: ErrorKind::Budget,\n    46\t            });\n    47\t        }\n    48\t        self.remaining -= 1;\n    49\t        Ok(())\n    50\t    }\n    51\t}\n    52\t\n    53\timpl CompositionDepthing for Budget {\n    54\t    fn enter_composition(&mut self, path: &Path) -> Result<(), Error> {\n    55\t        if self.depth >= self.maximum_depth {\n    56\t            return Err(Error::composition(path.clone(), ErrorKind::Budget));\n    57\t        }\n    58\t        self.depth += 1;\n    59\t        Ok(())\n    60\t    }\n    61\t    fn leave_composition(&mut self) {\n    62\t        self.depth -= 1;\n    63\t    }\n    64\t}\n    65\t\n    66\t#[derive(Clone, Debug, PartialEq, Eq)]\n    67\tpub enum ErrorLayer {\n    68\t    Protos,\n    69\t    Datom,\n    70\t    Composition,\n    71\t}\n    72\t#[derive(Clone, Debug, PartialEq, Eq)]\n    73\tpub struct Error {\n    74\t    pub layer: ErrorLayer,\n    75\t    pub path: Path,\n    76\t    pub kind: ErrorKind,\n    77\t}\n    78\tpub trait ErrorRaising {\n    79\t    fn composition(path: Path, kind: ErrorKind) -> Self;\n    80\t}\n    81\timpl ErrorRaising for Error {\n    82\t    fn composition(path: Path, kind: ErrorKind) -> Self {\n    83\t        Self {\n    84\t            layer: ErrorLayer::Composition,\n    85\t            path,\n    86\t            kind,\n    87\t        }\n    88\t    }\n    89\t}\n    90\t#[derive(Clone, Debug, PartialEq, Eq)]\n    91\tpub enum ErrorKind {\n    92\t    Budget,\n    93\t    Structural(protos::Error),\n    94\t    Form { expected: String, found: String },\n    95\t    Arity { expected: Integer, found: Integer },\n    96\t    Value { expected: String, value: String },\n    97\t    Variant { expected: String, found: String },\n    98\t}\n    99\tpub trait ProtosExtenting {\n   100\t    fn extent(&self) -> protos::Extent;\n   101\t    fn at(&self, path: &[Integer]) -> Option<&protos::Protos>;\n   102\t}\n   103\timpl ProtosExtenting for protos::Protos {\n   104\t    fn extent(&self) -> protos::Extent {\n   105\t        match self {\n   106\t            Self::Headed { extent, .. }\n   107\t            | Self::Enclosed { extent, .. }\n   108\t            | Self::Opaque { extent, .. }\n   109\t            | Self::Bare { extent, .. } => *extent,\n   110\t        }\n   111\t    }\n   112\t    fn at(&self, path: &[Integer]) -> Option<&protos::Protos> {\n   113\t        let Some((&index, tail)) = path.split_first() else {\n   114\t            return Some(self);\n   115\t        };\n   116\t        match self {\n   117\t            Self::Enclosed { children, .. } => children\n   118\t                .get(usize::try_from(index).ok()?)\n   119\t                .and_then(|child| child.at(tail)),\n   120\t            Self::Headed { body, .. } if index == 1 => body.at(tail),\n   121\t            _ => None,\n   122\t        }\n   123\t    }\n   124\t}\n   125\t\n   126\tpub trait Composable {\n   127\t    fn compose<T: Compositional>(&self, budget: &mut Budget) -> Result<T, Error>;\n   128\t}\n   129\tpub trait Compositional: Sized {\n   130\t    const ARITY: Integer;\n   131\t    fn from_positions(positions: Positions<'_>, budget: &mut Budget) -> Result<Self, Error>;\n   132\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   133\t        budget.spend(&datom.path)?;\n   134\t        Self::from_positions(datom.positions(\"Struct\")?, budget)\n   135\t    }\n   136\t}\n   137\tpub trait Datomizable {\n   138\t    type Output;\n   139\t    fn datomize(&self, at: Path) -> Self::Output;\n   140\t}\n   141\tpub trait Pathing {\n   142\t    fn child(&self, index: Integer) -> Path;\n   143\t}\n   144\timpl Pathing for Path {\n   145\t    fn child(&self, index: Integer) -> Path {\n   146\t        let mut child = self.clone();\n   147\t        child.push(index);\n   148\t        child\n   149\t    }\n   150\t}\n   151\t\n   152\tpub struct Positions<'a> {\n   153\t    path: &'a Path,\n   154\t    children: &'a [Datom],\n   155\t    next: usize,\n   156\t}\n   157\tpub trait Positioning {\n   158\t    fn position<T: Compositional>(&mut self, budget: &mut Budget) -> Result<T, Error>;\n   159\t    fn finish(self) -> Result<(), Error>;\n   160\t}\n   161\timpl Positioning for Positions<'_> {\n   162\t    fn position<T: Compositional>(&mut self, budget: &mut Budget) -> Result<T, Error> {\n   163\t        let child = self.children.get(self.next).ok_or_else(|| Error {\n   164\t            layer: ErrorLayer::Composition,\n   165\t            path: self.path.clone(),\n   166\t            kind: ErrorKind::Arity {\n   167\t                expected: self.next as Integer + 1,\n   168\t                found: self.next as Integer,\n   169\t            },\n   170\t        })?;\n   171\t        self.next += 1;\n   172\t        child.compose(budget)\n   173\t    }\n   174\t    fn finish(self) -> Result<(), Error> {\n   175\t        if self.next == self.children.len() {\n   176\t            Ok(())\n   177\t        } else {\n   178\t            Err(Error {\n   179\t                layer: ErrorLayer::Composition,\n   180\t                path: self.path.clone(),\n   181\t                kind: ErrorKind::Arity {\n   182\t                    expected: self.next as Integer,\n   183\t                    found: self.children.len() as Integer,\n   184\t                },\n   185\t            })\n   186\t        }\n   187\t    }\n   188\t}\n   189\t\n   190\tpub trait Naming {\n   191\t    fn form_name(&self) -> &'static str;\n   192\t}\n   193\timpl Naming for Form {\n   194\t    fn form_name(&self) -> &'static str {\n   195\t        match self {\n   196\t            Form::Struct(_) => \"Struct\",\n   197\t            Form::Vector(_) => \"Vector\",\n   198\t            Form::Variant(_, _) => \"Variant\",\n   199\t            Form::Bare(_) => \"Bare\",\n   200\t            Form::String(_) => \"String\",\n   201\t            Form::Meaning(_) => \"Meaning\",\n   202\t        }\n   203\t    }\n   204\t}\n   205\tpub trait DatomPositioning {\n   206\t    fn positions(&self, expected: &'static str) -> Result<Positions<'_>, Error>;\n   207\t    fn variant_positions(&self) -> Result<Positions<'_>, Error>;\n   208\t}\n   209\timpl DatomPositioning for Datom {\n   210\t    fn positions(&self, expected: &'static str) -> Result<Positions<'_>, Error> {\n   211\t        let children = match &self.form {\n   212\t            Form::Struct(children) => children,\n   213\t            found => {\n   214\t                return Err(Error {\n   215\t                    layer: ErrorLayer::Composition,\n   216\t                    path: self.path.clone(),\n   217\t                    kind: ErrorKind::Form {\n   218\t                        expected: expected.to_owned(),\n   219\t                        found: found.form_name().to_owned(),\n   220\t                    },\n   221\t                });\n   222\t            }\n   223\t        };\n   224\t        Ok(Positions {\n   225\t            path: &self.path,\n   226\t            children,\n   227\t            next: 0,\n   228\t        })\n   229\t    }\n   230\t    fn variant_positions(&self) -> Result<Positions<'_>, Error> {\n   231\t        self.positions(\"Struct\")\n   232\t    }\n   233\t}\n   234\timpl Composable for Datom {\n   235\t    fn compose<T: Compositional>(&self, budget: &mut Budget) -> Result<T, Error> {\n   236\t        budget.enter_composition(&self.path)?;\n   237\t        let result = T::compose(self, budget);\n   238\t        budget.leave_composition();\n   239\t        result\n   240\t    }\n   241\t}\n   242\t\n   243\timpl Datomizable for ErrorLayer {\n   244\t    type Output = Datom;\n   245\t    fn datomize(&self, at: Path) -> Datom {\n   246\t        let name = match self {\n   247\t            Self::Protos => \"Protos\",\n   248\t            Self::Datom => \"Datom\",\n   249\t            Self::Composition => \"Composition\",\n   250\t        };\n   251\t        Datom {\n   252\t            path: at,\n   253\t            form: Form::Bare(name.to_owned()),\n   254\t        }\n   255\t    }\n   256\t}\n   257\timpl Compositional for ErrorLayer {\n   258\t    const ARITY: Integer = 0;\n   259\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   260\t        unreachable!()\n   261\t    }\n   262\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   263\t        budget.spend(&datom.path)?;\n   264\t        match &datom.form {\n   265\t            Form::Bare(name) => match name.as_str() {\n   266\t                \"Protos\" => Ok(Self::Protos),\n   267\t                \"Datom\" => Ok(Self::Datom),\n   268\t                \"Composition\" => Ok(Self::Composition),\n   269\t                found => Err(Error::composition(\n   270\t                    datom.path.clone(),\n   271\t                    ErrorKind::Variant {\n   272\t                        expected: \"ErrorLayer\".into(),\n   273\t                        found: found.to_owned(),\n   274\t                    },\n   275\t                )),\n   276\t            },\n   277\t            found => Err(Error::composition(\n   278\t                datom.path.clone(),\n   279\t                ErrorKind::Form {\n   280\t                    expected: \"Bare\".into(),\n   281\t                    found: found.form_name().to_owned(),\n   282\t                },\n   283\t            )),\n   284\t        }\n   285\t    }\n   286\t}\n   287\timpl Datomizable for ErrorKind {\n   288\t    type Output = Datom;\n   289\t    fn datomize(&self, at: Path) -> Datom {\n   290\t        match self {\n   291\t            Self::Budget => Datom {\n   292\t                path: at,\n   293\t                form: Form::Bare(\"Budget\".into()),\n   294\t            },\n   295\t            Self::Structural(error) => error.datomize(at.child(1)).named_variant(at, \"Structural\"),\n   296\t            Self::Form { expected, found } => Datom {\n   297\t                path: at.clone(),\n   298\t                form: Form::Struct(vec![\n   299\t                    expected.datomize(at.child(1).child(0)),\n   300\t                    found.datomize(at.child(1).child(1)),\n   301\t                ]),\n   302\t            }\n   303\t            .named_variant(at, \"Form\"),\n   304\t            Self::Arity { expected, found } => Datom {\n   305\t                path: at.clone(),\n   306\t                form: Form::Struct(vec![\n   307\t                    expected.datomize(at.child(1).child(0)),\n   308\t                    found.datomize(at.child(1).child(1)),\n   309\t                ]),\n   310\t            }\n   311\t            .named_variant(at, \"Arity\"),\n   312\t            Self::Value { expected, value } => Datom {\n   313\t                path: at.clone(),\n   314\t                form: Form::Struct(vec![\n   315\t                    expected.datomize(at.child(1).child(0)),\n   316\t                    value.datomize(at.child(1).child(1)),\n   317\t                ]),\n   318\t            }\n   319\t            .named_variant(at, \"Value\"),\n   320\t            Self::Variant { expected, found } => Datom {\n   321\t                path: at.clone(),\n   322\t                form: Form::Struct(vec![\n   323\t                    expected.datomize(at.child(1).child(0)),\n   324\t                    found.datomize(at.child(1).child(1)),\n   325\t                ]),\n   326\t            }\n   327\t            .named_variant(at, \"Variant\"),\n   328\t        }\n   329\t    }\n   330\t}\n   331\timpl Compositional for ErrorKind {\n   332\t    const ARITY: Integer = 1;\n   333\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   334\t        unreachable!()\n   335\t    }\n   336\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   337\t        if matches!(&datom.form, Form::Bare(name) if name == \"Budget\") {\n   338\t            budget.spend(&datom.path)?;\n   339\t            return Ok(Self::Budget);\n   340\t        }\n   341\t        let (head, body) = datom.variant(budget, \"ErrorKind\")?;\n   342\t        let mut positions = body.positions(\"Struct\")?;\n   343\t        let value = match head {\n   344\t            \"Structural\" => Self::Structural(positions.position(budget)?),\n   345\t            \"Form\" => Self::Form {\n   346\t                expected: positions.position(budget)?,\n   347\t                found: positions.position(budget)?,\n   348\t            },\n   349\t            \"Arity\" => Self::Arity {\n   350\t                expected: positions.position(budget)?,\n   351\t                found: positions.position(budget)?,\n   352\t            },\n   353\t            \"Value\" => Self::Value {\n   354\t                expected: positions.position(budget)?,\n   355\t                value: positions.position(budget)?,\n   356\t            },\n   357\t            \"Variant\" => Self::Variant {\n   358\t                expected: positions.position(budget)?,\n   359\t                found: positions.position(budget)?,\n   360\t            },\n   361\t            found => {\n   362\t                return Err(Error::composition(\n   363\t                    datom.path.clone(),\n   364\t                    ErrorKind::Variant {\n   365\t                        expected: \"ErrorKind\".into(),\n   366\t                        found: found.to_owned(),\n   367\t                    },\n   368\t                ));\n   369\t            }\n   370\t        };\n   371\t        positions.finish()?;\n   372\t        Ok(value)\n   373\t    }\n   374\t}\n   375\timpl Datomizable for Error {\n   376\t    type Output = Datom;\n   377\t    fn datomize(&self, at: Path) -> Datom {\n   378\t        Datom {\n   379\t            path: at.clone(),\n   380\t            form: Form::Struct(vec![\n   381\t                self.layer.datomize(at.child(1).child(0)),\n   382\t                self.path.datomize(at.child(1).child(1)),\n   383\t                self.kind.datomize(at.child(1).child(2)),\n   384\t            ]),\n   385\t        }\n   386\t        .named_variant(at, \"Error\")\n   387\t    }\n   388\t}\n   389\timpl Compositional for Error {\n   390\t    const ARITY: Integer = 3;\n   391\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   392\t        unreachable!()\n   393\t    }\n   394\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   395\t        let (head, body) = datom.variant(budget, \"Error\")?;\n   396\t        if head != \"Error\" {\n   397\t            return Err(Error::composition(\n   398\t                datom.path.clone(),\n   399\t                ErrorKind::Variant {\n   400\t                    expected: \"Error\".into(),\n   401\t                    found: head.to_owned(),\n   402\t                },\n   403\t            ));\n   404\t        }\n   405\t        let mut positions = body.positions(\"Struct\")?;\n   406\t        let layer = positions.position(budget)?;\n   407\t        let path = positions.position(budget)?;\n   408\t        let kind = positions.position(budget)?;\n   409\t        positions.finish()?;\n   410\t        Ok(Self { layer, path, kind })\n   411\t    }\n   412\t}\n   413\t\n   414\t/// Text that may actualize into `T` after structural reading and datomic composition.\n   415\tpub struct Potential<T> {\n   416\t    text: String,\n   417\t    reader: Option<protos::Protos>,\n   418\t    marker: PhantomData<fn() -> T>,\n   419\t}\n   420\timpl<T> From<&str> for Potential<T> {\n   421\t    fn from(text: &str) -> Self {\n   422\t        Self {\n   423\t            text: text.to_owned(),\n   424\t            reader: None,\n   425\t            marker: PhantomData,\n   426\t        }\n   427\t    }\n   428\t}\n   429\timpl<T> From<String> for Potential<T> {\n   430\t    fn from(text: String) -> Self {\n   431\t        Self {\n   432\t            text,\n   433\t            reader: None,\n   434\t            marker: PhantomData,\n   435\t        }\n   436\t    }\n   437\t}\n   438\tpub trait Actualizing<T> {\n   439\t    fn actualize(&mut self, budget: &mut Budget) -> Result<T, Error>;\n   440\t}\n   441\tpub trait PotentialExtenting {\n   442\t    fn reader_extent(&self, path: &Path) -> Option<protos::Extent>;\n   443\t}\n   444\timpl<T> PotentialExtenting for Potential<T> {\n   445\t    fn reader_extent(&self, path: &Path) -> Option<protos::Extent> {\n   446\t        self.reader.as_ref()?.at(path).map(ProtosExtenting::extent)\n   447\t    }\n   448\t}\n   449\timpl<T: Compositional> Actualizing<T> for Potential<T> {\n   450\t    fn actualize(&mut self, budget: &mut Budget) -> Result<T, Error> {\n   451\t        use protos::BoundedProtosizable;\n   452\t        let protos = self\n   453\t            .text\n   454\t            .protosize_with(&mut budget.reader)\n   455\t            .map_err(|error| Error {\n   456\t                layer: ErrorLayer::Protos,\n   457\t                path: Path::new(),\n   458\t                kind: ErrorKind::Structural(error),\n   459\t            })?;\n   460\t        self.reader = Some(protos.clone());\n   461\t        let datom = protos.datomize(Path::new())?;\n   462\t        datom.compose(budget)\n   463\t    }\n   464\t}\n     1\tuse std::str::FromStr;\n     2\t\n     3\tuse crate::*;\n     4\t\n     5\tpub trait DatomForming {\n     6\t    fn datom_form(&self, path: Path) -> Result<Datom, Error>;\n     7\t}\n     8\t\n     9\tconst MAXIMUM_FORMING_DEPTH: Integer = 4_096;\n    10\t\n    11\tenum Forming<'a> {\n    12\t    Visit(&'a protos::Protos, Path, Integer),\n    13\t    Enclosed(Path, bool, usize),\n    14\t    Headed(Path, protos::Symbol),\n    15\t}\n    16\tstruct Former<'a> {\n    17\t    work: Vec<Forming<'a>>,\n    18\t    values: Vec<Datom>,\n    19\t}\n    20\ttrait FormingDatoms<'a> {\n    21\t    fn form(root: &'a protos::Protos, path: Path) -> Result<Datom, Error>;\n    22\t}\n    23\timpl<'a> FormingDatoms<'a> for Former<'a> {\n    24\t    fn form(root: &'a protos::Protos, path: Path) -> Result<Datom, Error> {\n    25\t        let mut former = Self {\n    26\t            work: vec![Forming::Visit(root, path, 0)],\n    27\t            values: Vec::new(),\n    28\t        };\n    29\t        while let Some(work) = former.work.pop() {\n    30\t            match work {\n    31\t                Forming::Visit(protos, path, depth) => {\n    32\t                    if depth >= MAXIMUM_FORMING_DEPTH {\n    33\t                        return Err(Error {\n    34\t                            layer: ErrorLayer::Datom,\n    35\t                            path,\n    36\t                            kind: ErrorKind::Budget,\n    37\t                        });\n    38\t                    }\n    39\t                    match protos {\n    40\t                        protos::Protos::Bare { text, .. } => former.values.push(Datom {\n    41\t                            path,\n    42\t                            form: Form::Bare(text.clone()),\n    43\t                        }),\n    44\t                        protos::Protos::Opaque {\n    45\t                            boundary: protos::Boundary::Guillemets,\n    46\t                            content,\n    47\t                            ..\n    48\t                        } => former.values.push(Datom {\n    49\t                            path,\n    50\t                            form: Form::String(content.clone()),\n    51\t                        }),\n    52\t                        protos::Protos::Opaque {\n    53\t                            boundary: protos::Boundary::Parentheses,\n    54\t                            content,\n    55\t                            ..\n    56\t                        } => former.values.push(Datom {\n    57\t                            path,\n    58\t                            form: Form::Meaning(content.clone()),\n    59\t                        }),\n    60\t                        protos::Protos::Enclosed {\n    61\t                            enclosure: protos::Enclosure::Braced,\n    62\t                            children,\n    63\t                            ..\n    64\t                        }\n    65\t                        | protos::Protos::Enclosed {\n    66\t                            enclosure: protos::Enclosure::Bracketed,\n    67\t                            children,\n    68\t                            ..\n    69\t                        } => {\n    70\t                            let structure = matches!(\n    71\t                                protos,\n    72\t                                protos::Protos::Enclosed {\n    73\t                                    enclosure: protos::Enclosure::Braced,\n    74\t                                    ..\n    75\t                                }\n    76\t                            );\n    77\t                            former.work.push(Forming::Enclosed(\n    78\t                                path.clone(),\n    79\t                                structure,\n    80\t                                children.len(),\n    81\t                            ));\n    82\t                            for (index, child) in children.iter().enumerate().rev() {\n    83\t                                former.work.push(Forming::Visit(\n    84\t                                    child,\n    85\t                                    path.child(index as Integer),\n    86\t                                    depth + 1,\n    87\t                                ));\n    88\t                            }\n    89\t                        }\n    90\t                        protos::Protos::Enclosed {\n    91\t                            enclosure: protos::Enclosure::Angled,\n    92\t                            ..\n    93\t                        } => {\n    94\t                            return Err(Error {\n    95\t                                layer: ErrorLayer::Datom,\n    96\t                                path,\n    97\t                                kind: ErrorKind::Form {\n    98\t                                    expected: \"Datom enclosure\".into(),\n    99\t                                    found: \"Angled\".into(),\n   100\t                                },\n   101\t                            });\n   102\t                        }\n   103\t                        protos::Protos::Headed {\n   104\t                            constraints: Some(_),\n   105\t                            ..\n   106\t                        } => {\n   107\t                            return Err(Error {\n   108\t                                layer: ErrorLayer::Datom,\n   109\t                                path,\n   110\t                                kind: ErrorKind::Form {\n   111\t                                    expected: \"unqualified Variant\".into(),\n   112\t                                    found: \"qualified head\".into(),\n   113\t                                },\n   114\t                            });\n   115\t                        }\n   116\t                        protos::Protos::Headed {\n   117\t                            head,\n   118\t                            constraints: None,\n   119\t                            separator: protos::Separator::Period,\n   120\t                            body,\n   121\t                            ..\n   122\t                        } => {\n   123\t                            former\n   124\t                                .work\n   125\t                                .push(Forming::Headed(path.clone(), head.clone()));\n   126\t                            former\n   127\t                                .work\n   128\t                                .push(Forming::Visit(body, path.child(1), depth + 1));\n   129\t                        }\n   130\t                        protos::Protos::Headed { .. } => former.values.push(Datom {\n   131\t                            path,\n   132\t                            form: Form::Bare(protos::Textualizable::textualize(protos)),\n   133\t                        }),\n   134\t                    }\n   135\t                }\n   136\t                Forming::Enclosed(path, structure, count) => {\n   137\t                    let children = former.values.split_off(former.values.len() - count);\n   138\t                    former.values.push(Datom {\n   139\t                        path,\n   140\t                        form: if structure {\n   141\t                            Form::Struct(children)\n   142\t                        } else {\n   143\t                            Form::Vector(children)\n   144\t                        },\n   145\t                    });\n   146\t                }\n   147\t                Forming::Headed(path, head) => {\n   148\t                    let body = former.values.pop().expect(\"formed headed body\");\n   149\t                    let form = match &body.form {\n   150\t                        Form::Bare(text)\n   151\t                            if head.0.parse::<i64>().is_ok()\n   152\t                                && text.chars().all(|character| character.is_ascii_digit()) =>\n   153\t                        {\n   154\t                            Form::Bare(format!(\"{}.{}\", head.0, text))\n   155\t                        }\n   156\t                        _ => Form::Variant(head, Box::new(body)),\n   157\t                    };\n   158\t                    former.values.push(Datom { path, form });\n   159\t                }\n   160\t            }\n   161\t        }\n   162\t        Ok(former.values.pop().expect(\"formed root\"))\n   163\t    }\n   164\t}\n   165\timpl DatomForming for protos::Protos {\n   166\t    fn datom_form(&self, path: Path) -> Result<Datom, Error> {\n   167\t        Former::form(self, path)\n   168\t    }\n   169\t}\n   170\t\n   171\timpl Datomizable for protos::Protos {\n   172\t    type Output = Result<Datom, Error>;\n   173\t    fn datomize(&self, at: Path) -> Self::Output {\n   174\t        self.datom_form(at)\n   175\t    }\n   176\t}\n   177\t\n   178\timpl Datomizable for String {\n   179\t    type Output = Datom;\n   180\t    fn datomize(&self, at: Path) -> Datom {\n   181\t        let form = if self.is_empty()\n   182\t            || self.chars().any(|character| {\n   183\t                character.is_whitespace()\n   184\t                    || matches!(\n   185\t                        character,\n   186\t                        '{' | '}' | '[' | ']' | '<' | '>' | '«' | '»' | '(' | ')' | ';'\n   187\t                    )\n   188\t            }) {\n   189\t            Form::String(self.clone())\n   190\t        } else {\n   191\t            Form::Bare(self.clone())\n   192\t        };\n   193\t        Datom { path: at, form }\n   194\t    }\n   195\t}\n   196\timpl Compositional for String {\n   197\t    const ARITY: Integer = 0;\n   198\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   199\t        unreachable!(\"strings compose from a scalar form\")\n   200\t    }\n   201\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   202\t        datom.compose_bare_string(budget)\n   203\t    }\n   204\t}\n   205\t\n   206\ttrait BareStringComposing {\n   207\t    fn compose_bare_string(&self, budget: &mut Budget) -> Result<String, Error>;\n   208\t}\n   209\t\n   210\timpl BareStringComposing for Datom {\n   211\t    fn compose_bare_string(&self, budget: &mut Budget) -> Result<String, Error> {\n   212\t        let mut current = self;\n   213\t        let mut depth = budget.depth;\n   214\t        let mut value = String::new();\n   215\t        loop {\n   216\t            budget.spend(&current.path)?;\n   217\t            let text = match &current.form {\n   218\t                Form::Bare(text) | Form::String(text) | Form::Meaning(text) if value.is_empty() => {\n   219\t                    return Ok(text.clone());\n   220\t                }\n   221\t                Form::Bare(text) => text,\n   222\t                Form::Variant(head, body) => {\n   223\t                    if depth >= budget.maximum_depth {\n   224\t                        return Err(Error::composition(body.path.clone(), ErrorKind::Budget));\n   225\t                    }\n   226\t                    depth += 1;\n   227\t                    if head.0.is_empty()\n   228\t                        || head.0.chars().any(|character| {\n   229\t                            character.is_whitespace()\n   230\t                                || matches!(\n   231\t                                    character,\n   232\t                                    '{' | '}' | '[' | ']' | '<' | '>' | '«' | '»' | '(' | ')' | ';'\n   233\t                                )\n   234\t                        })\n   235\t                    {\n   236\t                        return Err(Error::composition(\n   237\t                            current.path.clone(),\n   238\t                            ErrorKind::Form {\n   239\t                                expected: \"String\".into(),\n   240\t                                found: \"Variant\".into(),\n   241\t                            },\n   242\t                        ));\n   243\t                    }\n   244\t                    value.push_str(&head.0);\n   245\t                    value.push('.');\n   246\t                    current = body;\n   247\t                    continue;\n   248\t                }\n   249\t                found => {\n   250\t                    return Err(Error::composition(\n   251\t                        current.path.clone(),\n   252\t                        ErrorKind::Form {\n   253\t                            expected: \"String\".into(),\n   254\t                            found: found.form_name().to_owned(),\n   255\t                        },\n   256\t                    ));\n   257\t                }\n   258\t            };\n   259\t            if text.is_empty()\n   260\t                || text.chars().any(|character| {\n   261\t                    character.is_whitespace()\n   262\t                        || matches!(\n   263\t                            character,\n   264\t                            '{' | '}' | '[' | ']' | '<' | '>' | '«' | '»' | '(' | ')' | ';'\n   265\t                        )\n   266\t                })\n   267\t            {\n   268\t                return Err(Error::composition(\n   269\t                    current.path.clone(),\n   270\t                    ErrorKind::Form {\n   271\t                        expected: \"bare String\".into(),\n   272\t                        found: current.form.form_name().to_owned(),\n   273\t                    },\n   274\t                ));\n   275\t            }\n   276\t            value.push_str(text);\n   277\t            return Ok(value);\n   278\t        }\n   279\t    }\n   280\t}\n   281\timpl Datomizable for i64 {\n   282\t    type Output = Datom;\n   283\t    fn datomize(&self, at: Path) -> Datom {\n   284\t        Datom {\n   285\t            path: at,\n   286\t            form: Form::Bare(self.to_string()),\n   287\t        }\n   288\t    }\n   289\t}\n   290\timpl Compositional for i64 {\n   291\t    const ARITY: Integer = 0;\n   292\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   293\t        unreachable!(\"integers compose from a bare form\")\n   294\t    }\n   295\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   296\t        Self::scalar(datom, budget)\n   297\t    }\n   298\t}\n   299\timpl Datomizable for f64 {\n   300\t    type Output = Datom;\n   301\t    fn datomize(&self, at: Path) -> Datom {\n   302\t        assert!(self.is_finite(), \"Datom decimals are finite\");\n   303\t        let mut text = self.to_string();\n   304\t        if !text.contains('.') {\n   305\t            text.push_str(\".0\");\n   306\t        }\n   307\t        Datom {\n   308\t            path: at,\n   309\t            form: Form::Bare(text),\n   310\t        }\n   311\t    }\n   312\t}\n   313\timpl Compositional for f64 {\n   314\t    const ARITY: Integer = 0;\n   315\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   316\t        unreachable!(\"decimals compose from a bare form\")\n   317\t    }\n   318\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   319\t        Self::scalar(datom, budget)\n   320\t    }\n   321\t}\n   322\timpl Datomizable for bool {\n   323\t    type Output = Datom;\n   324\t    fn datomize(&self, at: Path) -> Datom {\n   325\t        Datom {\n   326\t            path: at,\n   327\t            form: Form::Bare(if *self { \"True\".into() } else { \"False\".into() }),\n   328\t        }\n   329\t    }\n   330\t}\n   331\timpl Compositional for bool {\n   332\t    const ARITY: Integer = 0;\n   333\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   334\t        unreachable!(\"booleans compose from a bare form\")\n   335\t    }\n   336\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   337\t        Self::scalar(datom, budget)\n   338\t    }\n   339\t}\n   340\t\n   341\timpl<T: Datomizable<Output = Datom>> Datomizable for Vec<T> {\n   342\t    type Output = Datom;\n   343\t    fn datomize(&self, at: Path) -> Datom {\n   344\t        Datom {\n   345\t            path: at.clone(),\n   346\t            form: Form::Vector(\n   347\t                self.iter()\n   348\t                    .enumerate()\n   349\t                    .map(|(index, value)| value.datomize(at.child(index as Integer)))\n   350\t                    .collect(),\n   351\t            ),\n   352\t        }\n   353\t    }\n   354\t}\n   355\timpl<T: Compositional> Compositional for Vec<T> {\n   356\t    const ARITY: Integer = -1;\n   357\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   358\t        unreachable!(\"vectors compose from a vector form\")\n   359\t    }\n   360\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   361\t        budget.spend(&datom.path)?;\n   362\t        let children = match &datom.form {\n   363\t            Form::Vector(children) => children,\n   364\t            found => {\n   365\t                return Err(Error {\n   366\t                    layer: ErrorLayer::Composition,\n   367\t                    path: datom.path.clone(),\n   368\t                    kind: ErrorKind::Form {\n   369\t                        expected: \"Vector\".into(),\n   370\t                        found: found.form_name().to_owned(),\n   371\t                    },\n   372\t                });\n   373\t            }\n   374\t        };\n   375\t        children.iter().map(|child| child.compose(budget)).collect()\n   376\t    }\n   377\t}\n   378\t\n   379\t#[derive(Clone, Debug, PartialEq, Eq)]\n   380\tpub struct Meaning(pub Opaque);\n   381\timpl Datomizable for Meaning {\n   382\t    type Output = Datom;\n   383\t    fn datomize(&self, at: Path) -> Datom {\n   384\t        Datom {\n   385\t            path: at,\n   386\t            form: Form::Meaning(self.0.clone()),\n   387\t        }\n   388\t    }\n   389\t}\n   390\timpl Compositional for Meaning {\n   391\t    const ARITY: Integer = 0;\n   392\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   393\t        unreachable!(\"meaning composes from a meaning form\")\n   394\t    }\n   395\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   396\t        budget.spend(&datom.path)?;\n   397\t        match &datom.form {\n   398\t            Form::Meaning(value) => Ok(Self(value.clone())),\n   399\t            found => Err(Error {\n   400\t                layer: ErrorLayer::Composition,\n   401\t                path: datom.path.clone(),\n   402\t                kind: ErrorKind::Form {\n   403\t                    expected: \"Meaning\".into(),\n   404\t                    found: found.form_name().to_owned(),\n   405\t                },\n   406\t            }),\n   407\t        }\n   408\t    }\n   409\t}\n   410\t\n   411\timpl<T: Datomizable<Output = Datom>> Datomizable for Box<T> {\n   412\t    type Output = Datom;\n   413\t    fn datomize(&self, at: Path) -> Datom {\n   414\t        self.as_ref().datomize(at)\n   415\t    }\n   416\t}\n   417\timpl<T: Compositional> Compositional for Box<T> {\n   418\t    const ARITY: Integer = T::ARITY;\n   419\t    fn from_positions(positions: Positions<'_>, budget: &mut Budget) -> Result<Self, Error> {\n   420\t        Ok(Box::new(T::from_positions(positions, budget)?))\n   421\t    }\n   422\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   423\t        Ok(Box::new(datom.compose(budget)?))\n   424\t    }\n   425\t}\n   426\t\n   427\tpub trait Variantizing {\n   428\t    fn named_variant(self, at: Path, name: &str) -> Datom;\n   429\t    fn variant(&self, budget: &mut Budget, expected: &'static str)\n   430\t    -> Result<(&str, &Datom), Error>;\n   431\t}\n   432\timpl Variantizing for Datom {\n   433\t    fn named_variant(self, at: Path, name: &str) -> Datom {\n   434\t        Datom {\n   435\t            path: at,\n   436\t            form: Form::Variant(Symbol(name.to_owned()), Box::new(self)),\n   437\t        }\n   438\t    }\n   439\t    fn variant(\n   440\t        &self,\n   441\t        budget: &mut Budget,\n   442\t        expected: &'static str,\n   443\t    ) -> Result<(&str, &Datom), Error> {\n   444\t        budget.spend(&self.path)?;\n   445\t        match &self.form {\n   446\t            Form::Variant(head, body) => Ok((&head.0, body)),\n   447\t            found => Err(Error {\n   448\t                layer: ErrorLayer::Composition,\n   449\t                path: self.path.clone(),\n   450\t                kind: ErrorKind::Form {\n   451\t                    expected: expected.to_owned(),\n   452\t                    found: found.form_name().to_owned(),\n   453\t                },\n   454\t            }),\n   455\t        }\n   456\t    }\n   457\t}\n   458\timpl<T: Datomizable<Output = Datom>> Datomizable for Option<T> {\n   459\t    type Output = Datom;\n   460\t    fn datomize(&self, at: Path) -> Datom {\n   461\t        match self {\n   462\t            Some(value) => value\n   463\t                .datomize(at.child(1))\n   464\t                .named_variant(at.clone(), \"Some\"),\n   465\t            None => Datom {\n   466\t                path: at,\n   467\t                form: Form::Bare(\"None\".to_owned()),\n   468\t            },\n   469\t        }\n   470\t    }\n   471\t}\n   472\timpl<T: Compositional> Compositional for Option<T> {\n   473\t    const ARITY: Integer = 1;\n   474\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   475\t        unreachable!(\"options compose from a variant form\")\n   476\t    }\n   477\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   478\t        if matches!(&datom.form, Form::Bare(head) if head == \"None\") {\n   479\t            budget.spend(&datom.path)?;\n   480\t            return Ok(None);\n   481\t        }\n   482\t        let (head, body) = datom.variant(budget, \"Variant\")?;\n   483\t        match head {\n   484\t            \"Some\" => Ok(Some(body.compose(budget)?)),\n   485\t            \"None\" if matches!(body.form, Form::Bare(ref value) if value.is_empty()) => Ok(None),\n   486\t            found => Err(Error {\n   487\t                layer: ErrorLayer::Composition,\n   488\t                path: datom.path.clone(),\n   489\t                kind: ErrorKind::Variant {\n   490\t                    expected: \"Option\".into(),\n   491\t                    found: found.to_owned(),\n   492\t                },\n   493\t            }),\n   494\t        }\n   495\t    }\n   496\t}\n   497\timpl<T: Datomizable<Output = Datom>, E: Datomizable<Output = Datom>> Datomizable for Result<T, E> {\n   498\t    type Output = Datom;\n   499\t    fn datomize(&self, at: Path) -> Datom {\n   500\t        match self {\n   501\t            Ok(value) => value.datomize(at.child(1)).named_variant(at.clone(), \"Ok\"),\n   502\t            Err(value) => value.datomize(at.child(1)).named_variant(at.clone(), \"Err\"),\n   503\t        }\n   504\t    }\n   505\t}\n   506\timpl<T: Compositional, E: Compositional> Compositional for Result<T, E> {\n   507\t    const ARITY: Integer = 1;\n   508\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   509\t        unreachable!(\"results compose from a variant form\")\n   510\t    }\n   511\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   512\t        let (head, body) = datom.variant(budget, \"Variant\")?;\n   513\t        match head {\n   514\t            \"Ok\" => Ok(Ok(body.compose(budget)?)),\n   515\t            \"Err\" => Ok(Err(body.compose(budget)?)),\n   516\t            found => Err(Error {\n   517\t                layer: ErrorLayer::Composition,\n   518\t                path: datom.path.clone(),\n   519\t                kind: ErrorKind::Variant {\n   520\t                    expected: \"Result\".into(),\n   521\t                    found: found.to_owned(),\n   522\t                },\n   523\t            }),\n   524\t        }\n   525\t    }\n   526\t}\n   527\t\n   528\timpl Datomizable for protos::Extent {\n   529\t    type Output = Datom;\n   530\t    fn datomize(&self, at: Path) -> Datom {\n   531\t        Datom {\n   532\t            path: at.clone(),\n   533\t            form: Form::Struct(vec![\n   534\t                (self.start as i64).datomize(at.child(0)),\n   535\t                (self.end as i64).datomize(at.child(1)),\n   536\t            ]),\n   537\t        }\n   538\t        .named_variant(at, \"Extent\")\n   539\t    }\n   540\t}\n   541\timpl Compositional for protos::Extent {\n   542\t    const ARITY: Integer = 2;\n   543\t    fn from_positions(mut positions: Positions<'_>, budget: &mut Budget) -> Result<Self, Error> {\n   544\t        let start: i64 = positions.position(budget)?;\n   545\t        let end: i64 = positions.position(budget)?;\n   546\t        positions.finish()?;\n   547\t        Ok(Self {\n   548\t            start: start.try_into().map_err(|_| Error {\n   549\t                layer: ErrorLayer::Composition,\n   550\t                path: Path::new(),\n   551\t                kind: ErrorKind::Value {\n   552\t                    expected: \"non-negative extent\".into(),\n   553\t                    value: start.to_string(),\n   554\t                },\n   555\t            })?,\n   556\t            end: end.try_into().map_err(|_| Error {\n   557\t                layer: ErrorLayer::Composition,\n   558\t                path: Path::new(),\n   559\t                kind: ErrorKind::Value {\n   560\t                    expected: \"non-negative extent\".into(),\n   561\t                    value: end.to_string(),\n   562\t                },\n   563\t            })?,\n   564\t        })\n   565\t    }\n   566\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   567\t        let (head, body) = datom.variant(budget, \"Extent\")?;\n   568\t        if head != \"Extent\" {\n   569\t            return Err(Error {\n   570\t                layer: ErrorLayer::Composition,\n   571\t                path: datom.path.clone(),\n   572\t                kind: ErrorKind::Variant {\n   573\t                    expected: \"Extent\".into(),\n   574\t                    found: head.to_owned(),\n   575\t                },\n   576\t            });\n   577\t        }\n   578\t        Self::from_positions(body.positions(\"Struct\")?, budget)\n   579\t    }\n   580\t}\n   581\t\n   582\timpl Datomizable for protos::Separator {\n   583\t    type Output = Datom;\n   584\t    fn datomize(&self, at: Path) -> Datom {\n   585\t        let name = match self {\n   586\t            Self::Period => \"Period\",\n   587\t            Self::Exclamation => \"Exclamation\",\n   588\t            Self::Colon => \"Colon\",\n   589\t        };\n   590\t        Datom {\n   591\t            path: at,\n   592\t            form: Form::Bare(name.to_owned()),\n   593\t        }\n   594\t    }\n   595\t}\n   596\timpl Compositional for protos::Separator {\n   597\t    const ARITY: Integer = 0;\n   598\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   599\t        unreachable!()\n   600\t    }\n   601\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   602\t        budget.spend(&datom.path)?;\n   603\t        match &datom.form {\n   604\t            Form::Bare(name) if name == \"Period\" => Ok(Self::Period),\n   605\t            Form::Bare(name) if name == \"Exclamation\" => Ok(Self::Exclamation),\n   606\t            Form::Bare(name) if name == \"Colon\" => Ok(Self::Colon),\n   607\t            Form::Bare(name) => Err(Error {\n   608\t                layer: ErrorLayer::Composition,\n   609\t                path: datom.path.clone(),\n   610\t                kind: ErrorKind::Variant {\n   611\t                    expected: \"Separator\".into(),\n   612\t                    found: name.clone(),\n   613\t                },\n   614\t            }),\n   615\t            found => Err(Error {\n   616\t                layer: ErrorLayer::Composition,\n   617\t                path: datom.path.clone(),\n   618\t                kind: ErrorKind::Form {\n   619\t                    expected: \"Separator\".into(),\n   620\t                    found: found.form_name().to_owned(),\n   621\t                },\n   622\t            }),\n   623\t        }\n   624\t    }\n   625\t}\n   626\t\n   627\timpl Datomizable for protos::Symbol {\n   628\t    type Output = Datom;\n   629\t    fn datomize(&self, at: Path) -> Datom {\n   630\t        self.0.datomize(at)\n   631\t    }\n   632\t}\n   633\timpl Compositional for protos::Symbol {\n   634\t    const ARITY: Integer = 1;\n   635\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   636\t        unreachable!()\n   637\t    }\n   638\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   639\t        Ok(Self(String::compose(datom, budget)?))\n   640\t    }\n   641\t}\n   642\t\n   643\timpl Datomizable for protos::ReaderBudget {\n   644\t    type Output = Datom;\n   645\t    fn datomize(&self, at: Path) -> Datom {\n   646\t        (self.remaining as Integer).datomize(at)\n   647\t    }\n   648\t}\n   649\timpl Compositional for protos::ReaderBudget {\n   650\t    const ARITY: Integer = 1;\n   651\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   652\t        unreachable!()\n   653\t    }\n   654\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   655\t        let remaining: Integer = datom.compose(budget)?;\n   656\t        Ok(Self {\n   657\t            remaining: remaining.try_into().map_err(|_| Error {\n   658\t                layer: ErrorLayer::Composition,\n   659\t                path: datom.path.clone(),\n   660\t                kind: ErrorKind::Value {\n   661\t                    expected: \"non-negative reader budget\".into(),\n   662\t                    value: remaining.to_string(),\n   663\t                },\n   664\t            })?,\n   665\t        })\n   666\t    }\n   667\t}\n   668\t\n   669\timpl Datomizable for protos::Problem {\n   670\t    type Output = Datom;\n   671\t    fn datomize(&self, at: Path) -> Datom {\n   672\t        match self {\n   673\t            Self::Empty\n   674\t            | Self::Multiple\n   675\t            | Self::MissingHead\n   676\t            | Self::MissingBody\n   677\t            | Self::Budget\n   678\t            | Self::Depth => {\n   679\t                let name = match self {\n   680\t                    Self::Empty => \"Empty\",\n   681\t                    Self::Multiple => \"Multiple\",\n   682\t                    Self::MissingHead => \"MissingHead\",\n   683\t                    Self::MissingBody => \"MissingBody\",\n   684\t                    Self::Budget => \"Budget\",\n   685\t                    Self::Depth => \"Depth\",\n   686\t                    _ => unreachable!(),\n   687\t                };\n   688\t                Datom {\n   689\t                    path: at,\n   690\t                    form: Form::Bare(name.to_owned()),\n   691\t                }\n   692\t            }\n   693\t            Self::Unclosed(character) => character\n   694\t                .to_string()\n   695\t                .datomize(at.child(1))\n   696\t                .named_variant(at, \"Unclosed\"),\n   697\t            Self::Unexpected(character) => character\n   698\t                .to_string()\n   699\t                .datomize(at.child(1))\n   700\t                .named_variant(at, \"Unexpected\"),\n   701\t        }\n   702\t    }\n   703\t}\n   704\timpl Compositional for protos::Problem {\n   705\t    const ARITY: Integer = 1;\n   706\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   707\t        unreachable!()\n   708\t    }\n   709\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   710\t        if let Form::Bare(name) = &datom.form {\n   711\t            budget.spend(&datom.path)?;\n   712\t            return match name.as_str() {\n   713\t                \"Empty\" => Ok(Self::Empty),\n   714\t                \"Multiple\" => Ok(Self::Multiple),\n   715\t                \"MissingHead\" => Ok(Self::MissingHead),\n   716\t                \"MissingBody\" => Ok(Self::MissingBody),\n   717\t                \"Budget\" => Ok(Self::Budget),\n   718\t                \"Depth\" => Ok(Self::Depth),\n   719\t                _ => Err(Error {\n   720\t                    layer: ErrorLayer::Composition,\n   721\t                    path: datom.path.clone(),\n   722\t                    kind: ErrorKind::Variant {\n   723\t                        expected: \"Problem\".into(),\n   724\t                        found: name.clone(),\n   725\t                    },\n   726\t                }),\n   727\t            };\n   728\t        }\n   729\t        let (head, body) = datom.variant(budget, \"Problem\")?;\n   730\t        let character: String = body.compose(budget)?;\n   731\t        let mut characters = character.chars();\n   732\t        let Some(character) = characters.next().filter(|_| characters.next().is_none()) else {\n   733\t            return Err(Error {\n   734\t                layer: ErrorLayer::Composition,\n   735\t                path: body.path.clone(),\n   736\t                kind: ErrorKind::Value {\n   737\t                    expected: \"one character\".into(),\n   738\t                    value: character,\n   739\t                },\n   740\t            });\n   741\t        };\n   742\t        match head {\n   743\t            \"Unclosed\" => Ok(Self::Unclosed(character)),\n   744\t            \"Unexpected\" => Ok(Self::Unexpected(character)),\n   745\t            found => Err(Error {\n   746\t                layer: ErrorLayer::Composition,\n   747\t                path: datom.path.clone(),\n   748\t                kind: ErrorKind::Variant {\n   749\t                    expected: \"Problem\".into(),\n   750\t                    found: found.to_owned(),\n   751\t                },\n   752\t            }),\n   753\t        }\n   754\t    }\n   755\t}\n   756\t\n   757\timpl Datomizable for protos::Error {\n   758\t    type Output = Datom;\n   759\t    fn datomize(&self, at: Path) -> Datom {\n   760\t        Datom {\n   761\t            path: at.clone(),\n   762\t            form: Form::Struct(vec![\n   763\t                self.extent.datomize(at.child(1).child(0)),\n   764\t                self.problem.datomize(at.child(1).child(1)),\n   765\t            ]),\n   766\t        }\n   767\t        .named_variant(at, \"ProtosError\")\n   768\t    }\n   769\t}\n   770\timpl Compositional for protos::Error {\n   771\t    const ARITY: Integer = 2;\n   772\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   773\t        unreachable!()\n   774\t    }\n   775\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   776\t        let (head, body) = datom.variant(budget, \"ProtosError\")?;\n   777\t        if head != \"ProtosError\" {\n   778\t            return Err(Error {\n   779\t                layer: ErrorLayer::Composition,\n   780\t                path: datom.path.clone(),\n   781\t                kind: ErrorKind::Variant {\n   782\t                    expected: \"ProtosError\".into(),\n   783\t                    found: head.to_owned(),\n   784\t                },\n   785\t            });\n   786\t        }\n   787\t        let mut positions = body.positions(\"Struct\")?;\n   788\t        let extent = positions.position(budget)?;\n   789\t        let problem = positions.position(budget)?;\n   790\t        positions.finish()?;\n   791\t        Ok(Self { extent, problem })\n   792\t    }\n   793\t}\n   794\t\n   795\tpub trait Scalar: Sized {\n   796\t    fn scalar(datom: &Datom, budget: &mut Budget) -> Result<Self, Error>;\n   797\t}\n   798\timpl Scalar for String {\n   799\t    fn scalar(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   800\t        budget.spend(&datom.path)?;\n   801\t        match &datom.form {\n   802\t            Form::Bare(value) | Form::String(value) | Form::Meaning(value) => Ok(value.clone()),\n   803\t            found => Err(Error {\n   804\t                layer: ErrorLayer::Composition,\n   805\t                path: datom.path.clone(),\n   806\t                kind: ErrorKind::Form {\n   807\t                    expected: \"String\".into(),\n   808\t                    found: found.form_name().to_owned(),\n   809\t                },\n   810\t            }),\n   811\t        }\n   812\t    }\n   813\t}\n   814\timpl Scalar for i64 {\n   815\t    fn scalar(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   816\t        budget.spend(&datom.path)?;\n   817\t        let value = match &datom.form {\n   818\t            Form::Bare(value) => value,\n   819\t            found => {\n   820\t                return Err(Error {\n   821\t                    layer: ErrorLayer::Composition,\n   822\t                    path: datom.path.clone(),\n   823\t                    kind: ErrorKind::Form {\n   824\t                        expected: \"Bare\".into(),\n   825\t                        found: found.form_name().to_owned(),\n   826\t                    },\n   827\t                });\n   828\t            }\n   829\t        };\n   830\t        if value.starts_with(\"-0\") || (value.len() > 1 && value.starts_with('0')) {\n   831\t            return Err(Error {\n   832\t                layer: ErrorLayer::Composition,\n   833\t                path: datom.path.clone(),\n   834\t                kind: ErrorKind::Value {\n   835\t                    expected: \"Integer\".into(),\n   836\t                    value: value.clone(),\n   837\t                },\n   838\t            });\n   839\t        }\n   840\t        i64::from_str(value).map_err(|_| Error {\n   841\t            layer: ErrorLayer::Composition,\n   842\t            path: datom.path.clone(),\n   843\t            kind: ErrorKind::Value {\n   844\t                expected: \"Integer\".into(),\n   845\t                value: value.clone(),\n   846\t            },\n   847\t        })\n   848\t    }\n   849\t}\n   850\timpl Scalar for bool {\n   851\t    fn scalar(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   852\t        budget.spend(&datom.path)?;\n   853\t        match &datom.form {\n   854\t            Form::Bare(value) if value == \"True\" => Ok(true),\n   855\t            Form::Bare(value) if value == \"False\" => Ok(false),\n   856\t            Form::Bare(value) => Err(Error {\n   857\t                layer: ErrorLayer::Composition,\n   858\t                path: datom.path.clone(),\n   859\t                kind: ErrorKind::Value {\n   860\t                    expected: \"Boolean\".into(),\n   861\t                    value: value.clone(),\n   862\t                },\n   863\t            }),\n   864\t            found => Err(Error {\n   865\t                layer: ErrorLayer::Composition,\n   866\t                path: datom.path.clone(),\n   867\t                kind: ErrorKind::Form {\n   868\t                    expected: \"Bare\".into(),\n   869\t                    found: found.form_name().to_owned(),\n   870\t                },\n   871\t            }),\n   872\t        }\n   873\t    }\n   874\t}\n   875\timpl Scalar for f64 {\n   876\t    fn scalar(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   877\t        budget.spend(&datom.path)?;\n   878\t        let value = match &datom.form {\n   879\t            Form::Bare(value) if value.contains('.') => value,\n   880\t            Form::Bare(value) => {\n   881\t                return Err(Error {\n   882\t                    layer: ErrorLayer::Composition,\n   883\t                    path: datom.path.clone(),\n   884\t                    kind: ErrorKind::Value {\n   885\t                        expected: \"Decimal\".into(),\n   886\t                        value: value.clone(),\n   887\t                    },\n   888\t                });\n   889\t            }\n   890\t            found => {\n   891\t                return Err(Error {\n   892\t                    layer: ErrorLayer::Composition,\n   893\t                    path: datom.path.clone(),\n   894\t                    kind: ErrorKind::Form {\n   895\t                        expected: \"Bare\".into(),\n   896\t                        found: found.form_name().to_owned(),\n   897\t                    },\n   898\t                });\n   899\t            }\n   900\t        };\n   901\t        value\n   902\t            .parse::<f64>()\n   903\t            .ok()\n   904\t            .filter(|value| value.is_finite())\n   905\t            .ok_or_else(|| Error {\n   906\t                layer: ErrorLayer::Composition,\n   907\t                path: datom.path.clone(),\n   908\t                kind: ErrorKind::Value {\n   909\t                    expected: \"Decimal\".into(),\n   910\t                    value: value.clone(),\n   911\t                },\n   912\t            })\n   913\t    }\n   914\t}\n     1\tuse std::collections::HashMap;\n     2\t\n     3\tuse crate::{Datom, Form};\n     4\t\n     5\tpub(crate) trait Projecting {\n     6\t    fn project(&self) -> protos::Protos;\n     7\t}\n     8\t\n     9\tenum Measure<'a> {\n    10\t    Visit(&'a Datom),\n    11\t    Finish(&'a Datom),\n    12\t}\n    13\tenum Build<'a> {\n    14\t    Visit(&'a Datom, usize),\n    15\t    Enclosed(protos::Enclosure, usize, usize, usize),\n    16\t    Headed(protos::Symbol, usize, usize),\n    17\t}\n    18\t\n    19\ttrait Measuring<'a> {\n    20\t    fn measure(root: &'a Datom) -> HashMap<usize, usize>;\n    21\t}\n    22\tstruct Meter<'a> {\n    23\t    work: Vec<Measure<'a>>,\n    24\t    lengths: HashMap<usize, usize>,\n    25\t}\n    26\timpl<'a> Measuring<'a> for Meter<'a> {\n    27\t    fn measure(root: &'a Datom) -> HashMap<usize, usize> {\n    28\t        let mut meter = Self {\n    29\t            work: vec![Measure::Visit(root)],\n    30\t            lengths: HashMap::new(),\n    31\t        };\n    32\t        while let Some(job) = meter.work.pop() {\n    33\t            match job {\n    34\t                Measure::Visit(datom) => match &datom.form {\n    35\t                    Form::Bare(text) => {\n    36\t                        meter.lengths.insert(datom as *const _ as usize, text.len());\n    37\t                    }\n    38\t                    Form::String(content) => {\n    39\t                        meter.lengths.insert(\n    40\t                            datom as *const _ as usize,\n    41\t                            protos::Boundary::Guillemets.opaque_length(content),\n    42\t                        );\n    43\t                    }\n    44\t                    Form::Meaning(content) => {\n    45\t                        meter.lengths.insert(\n    46\t                            datom as *const _ as usize,\n    47\t                            protos::Boundary::Parentheses.opaque_length(content),\n    48\t                        );\n    49\t                    }\n    50\t                    Form::Variant(_, body) => {\n    51\t                        meter.work.push(Measure::Finish(datom));\n    52\t                        meter.work.push(Measure::Visit(body));\n    53\t                    }\n    54\t                    Form::Struct(children) | Form::Vector(children) => {\n    55\t                        meter.work.push(Measure::Finish(datom));\n    56\t                        meter.work.extend(children.iter().map(Measure::Visit));\n    57\t                    }\n    58\t                },\n    59\t                Measure::Finish(datom) => {\n    60\t                    let length = match &datom.form {\n    61\t                        Form::Variant(head, body) => {\n    62\t                            head.0.len() + 1 + meter.lengths[&(body.as_ref() as *const _ as usize)]\n    63\t                        }\n    64\t                        Form::Struct(children) | Form::Vector(children) => {\n    65\t                            if children.is_empty() {\n    66\t                                2\n    67\t                            } else {\n    68\t                                children\n    69\t                                    .iter()\n    70\t                                    .map(|child| meter.lengths[&(child as *const _ as usize)])\n    71\t                                    .sum::<usize>()\n    72\t                                    + children.len()\n    73\t                                    + 3\n    74\t                            }\n    75\t                        }\n    76\t                        _ => unreachable!(),\n    77\t                    };\n    78\t                    meter.lengths.insert(datom as *const _ as usize, length);\n    79\t                }\n    80\t            }\n    81\t        }\n    82\t        meter.lengths\n    83\t    }\n    84\t}\n    85\t\n    86\ttrait Building<'a> {\n    87\t    fn build(root: &'a Datom, lengths: &HashMap<usize, usize>) -> protos::Protos;\n    88\t}\n    89\tstruct Builder<'a> {\n    90\t    work: Vec<Build<'a>>,\n    91\t    values: Vec<protos::Protos>,\n    92\t}\n    93\timpl<'a> Building<'a> for Builder<'a> {\n    94\t    fn build(root: &'a Datom, lengths: &HashMap<usize, usize>) -> protos::Protos {\n    95\t        let mut builder = Self {\n    96\t            work: vec![Build::Visit(root, 0)],\n    97\t            values: Vec::new(),\n    98\t        };\n    99\t        while let Some(job) = builder.work.pop() {\n   100\t            match job {\n   101\t                Build::Visit(datom, start) => match &datom.form {\n   102\t                    Form::Bare(text) => builder.values.push(protos::Protos::Bare {\n   103\t                        extent: protos::Extent {\n   104\t                            start,\n   105\t                            end: start + text.len(),\n   106\t                        },\n   107\t                        text: text.clone(),\n   108\t                    }),\n   109\t                    Form::String(content) => builder\n   110\t                        .values\n   111\t                        .push(protos::Boundary::Guillemets.project_opaque(content, start)),\n   112\t                    Form::Meaning(content) => builder\n   113\t                        .values\n   114\t                        .push(protos::Boundary::Parentheses.project_opaque(content, start)),\n   115\t                    Form::Variant(head, body) => {\n   116\t                        let end = start + lengths[&(datom as *const _ as usize)];\n   117\t                        builder.work.push(Build::Headed(head.clone(), start, end));\n   118\t                        builder\n   119\t                            .work\n   120\t                            .push(Build::Visit(body, start + head.0.len() + 1));\n   121\t                    }\n   122\t                    Form::Struct(children) | Form::Vector(children) => {\n   123\t                        let enclosure = if matches!(&datom.form, Form::Struct(_)) {\n   124\t                            protos::Enclosure::Braced\n   125\t                        } else {\n   126\t                            protos::Enclosure::Bracketed\n   127\t                        };\n   128\t                        let end = start + lengths[&(datom as *const _ as usize)];\n   129\t                        builder\n   130\t                            .work\n   131\t                            .push(Build::Enclosed(enclosure, start, end, children.len()));\n   132\t                        let mut offset = start + 2;\n   133\t                        let mut starts = Vec::with_capacity(children.len());\n   134\t                        for child in children {\n   135\t                            starts.push(offset);\n   136\t                            offset += lengths[&(child as *const _ as usize)] + 1;\n   137\t                        }\n   138\t                        for (child, child_start) in children.iter().zip(starts).rev() {\n   139\t                            builder.work.push(Build::Visit(child, child_start));\n   140\t                        }\n   141\t                    }\n   142\t                },\n   143\t                Build::Enclosed(enclosure, start, end, count) => {\n   144\t                    let children = builder.values.split_off(builder.values.len() - count);\n   145\t                    builder.values.push(protos::Protos::Enclosed {\n   146\t                        extent: protos::Extent { start, end },\n   147\t                        enclosure,\n   148\t                        children,\n   149\t                    });\n   150\t                }\n   151\t                Build::Headed(head, start, end) => {\n   152\t                    let body = Box::new(builder.values.pop().expect(\"projected headed body\"));\n   153\t                    builder.values.push(protos::Protos::Headed {\n   154\t                        extent: protos::Extent { start, end },\n   155\t                        head,\n   156\t                        constraints: None,\n   157\t                        separator: protos::Separator::Period,\n   158\t                        body,\n   159\t                    });\n   160\t                }\n   161\t            }\n   162\t        }\n   163\t        builder.values.pop().expect(\"projected root\")\n   164\t    }\n   165\t}\n   166\t\n   167\ttrait OpaqueProjecting {\n   168\t    fn project_opaque(self, content: &str, start: usize) -> protos::Protos;\n   169\t    fn opaque_length(self, content: &str) -> usize;\n   170\t}\n   171\timpl OpaqueProjecting for protos::Boundary {\n   172\t    fn project_opaque(self, content: &str, start: usize) -> protos::Protos {\n   173\t        let end = start + self.opaque_length(content);\n   174\t        protos::Protos::Opaque {\n   175\t            extent: protos::Extent { start, end },\n   176\t            boundary: self,\n   177\t            content: content.to_owned(),\n   178\t        }\n   179\t    }\n   180\t    fn opaque_length(self, content: &str) -> usize {\n   181\t        use protos::Textualizable;\n   182\t        protos::Protos::Opaque {\n   183\t            extent: protos::Extent { start: 0, end: 0 },\n   184\t            boundary: self,\n   185\t            content: content.to_owned(),\n   186\t        }\n   187\t        .textualize()\n   188\t        .len()\n   189\t    }\n   190\t}\n   191\timpl Projecting for Datom {\n   192\t    fn project(&self) -> protos::Protos {\n   193\t        let lengths = Meter::measure(self);\n   194\t        Builder::build(self, &lengths)\n   195\t    }\n   196\t}\n   197\timpl protos::Protosizable for Datom {\n   198\t    type Output = protos::Protos;\n   199\t    fn protosize(&self) -> Self::Output {\n   200\t        self.project()\n   201\t    }\n   202\t}\n     1\tuse std::mem;\n     2\t\n     3\tuse crate::{Datom, Form};\n     4\t\n     5\ttrait TreeDropping {\n     6\t    fn empty_tree(&mut self) -> Form;\n     7\t}\n     8\timpl TreeDropping for Datom {\n     9\t    fn empty_tree(&mut self) -> Form {\n    10\t        mem::replace(&mut self.form, Form::Bare(String::new()))\n    11\t    }\n    12\t}\n    13\t\n    14\timpl Drop for Datom {\n    15\t    fn drop(&mut self) {\n    16\t        let mut forms = vec![self.empty_tree()];\n    17\t        while let Some(form) = forms.pop() {\n    18\t            match form {\n    19\t                Form::Variant(_, body) => {\n    20\t                    let mut body = *body;\n    21\t                    forms.push(body.empty_tree());\n    22\t                }\n    23\t                Form::Struct(children) | Form::Vector(children) => {\n    24\t                    for mut child in children {\n    25\t                        forms.push(child.empty_tree());\n    26\t                    }\n    27\t                }\n    28\t                Form::Bare(_) | Form::String(_) | Form::Meaning(_) => {}\n    29\t            }\n    30\t        }\n    31\t    }\n    32\t}\n     1\tuse proc_macro::TokenStream;\n     2\tuse quote::quote;\n     3\tuse syn::{Data, DeriveInput, Fields, parse_macro_input};\n     4\t\n     5\tfn fields<'a>(input: &'a DeriveInput, capability: &str) -> Result<&'a Fields, TokenStream> {\n     6\t    match &input.data {\n     7\t        Data::Struct(data) => Ok(&data.fields),\n     8\t        _ => Err(\n     9\t            syn::Error::new_spanned(&input.ident, format!(\"{capability} supports structs\"))\n    10\t                .into_compile_error()\n    11\t                .into(),\n    12\t        ),\n    13\t    }\n    14\t}\n    15\t\n    16\t#[proc_macro_derive(Compositional)]\n    17\tpub fn compositional(input: TokenStream) -> TokenStream {\n    18\t    let input = parse_macro_input!(input as DeriveInput);\n    19\t    let name = &input.ident;\n    20\t    if let Data::Enum(data) = &input.data {\n    21\t        let mut bounded_generics = input.generics.clone();\n    22\t        for parameter in &input.generics.params {\n    23\t            if let syn::GenericParam::Type(parameter) = parameter {\n    24\t                let ident = &parameter.ident;\n    25\t                bounded_generics\n    26\t                    .make_where_clause()\n    27\t                    .predicates\n    28\t                    .push(syn::parse_quote!(#ident: ::datom_codec::Compositional));\n    29\t            }\n    30\t        }\n    31\t        let (impl_generics, ty_generics, where_clause) = bounded_generics.split_for_impl();\n    32\t        let unit_arms = data.variants.iter().filter_map(|variant| {\n    33\t            if !matches!(variant.fields, Fields::Unit) {\n    34\t                return None;\n    35\t            }\n    36\t            let spelling = variant.ident.to_string();\n    37\t            let name = &variant.ident;\n    38\t            Some(quote!(#spelling => Ok(Self::#name)))\n    39\t        });\n    40\t        let arms = data.variants.iter().map(|variant| {\n    41\t            let variant_name = &variant.ident;\n    42\t            let spelling = variant_name.to_string();\n    43\t            let fields = &variant.fields;\n    44\t            let reads = fields.iter().enumerate().map(|(index, field)| { let ty = &field.ty; let binding = syn::Ident::new(&format!(\"field_{index}\"), proc_macro2::Span::call_site()); quote!(let #binding: #ty = positions.position(budget)?;) });\n    45\t            let bindings: Vec<_> = (0..fields.len()).map(|index| syn::Ident::new(&format!(\"field_{index}\"), proc_macro2::Span::call_site())).collect();\n    46\t            let build = match fields { Fields::Named(named) => { let names = named.named.iter().map(|field| field.ident.as_ref().unwrap()); quote!(Self::#variant_name { #(#names: #bindings),* }) }, Fields::Unnamed(_) => quote!(Self::#variant_name(#(#bindings),*)), Fields::Unit => quote!(Self::#variant_name) };\n    47\t            let count = fields.len();\n    48\t            if count == 0 {\n    49\t                quote!(#spelling => Err(<::datom_codec::Error as ::datom_codec::ErrorRaising>::composition(datom.path.clone(), ::datom_codec::ErrorKind::Form { expected: \"bare variant\".to_owned(), found: \"Variant\".to_owned() })))\n    50\t            } else if count == 1 {\n    51\t                let binding = &bindings[0];\n    52\t                quote!(#spelling => { let #binding = body.compose(budget)?; Ok(#build) })\n    53\t            } else {\n    54\tquote!(#spelling => { let mut positions = ::datom_codec::DatomPositioning::variant_positions(body)?; #(#reads)* positions.finish()?; Ok(#build) })\n    55\t            }\n    56\t        });\n    57\t        return quote! {\n    58\t            impl #impl_generics ::datom_codec::Compositional for #name #ty_generics #where_clause {\n    59\t                const ARITY: ::datom_codec::Integer = 1;\n    60\t                fn from_positions(_: ::datom_codec::Positions<'_>, _: &mut ::datom_codec::Budget) -> Result<Self, ::datom_codec::Error> { unreachable!(\"enums compose from a variant form\") }\n    61\t                fn compose(datom: &::datom_codec::Datom, budget: &mut ::datom_codec::Budget) -> Result<Self, ::datom_codec::Error> {\n    62\t                    use ::datom_codec::{Composable, Positioning, Variantizing};\n    63\t                    match &datom.form {\n    64\t                        ::datom_codec::Form::Bare(head) => match head.as_str() { #(#unit_arms,)* other => Err(<::datom_codec::Error as ::datom_codec::ErrorRaising>::composition(datom.path.clone(), ::datom_codec::ErrorKind::Variant { expected: stringify!(#name).to_owned(), found: other.to_owned() })) },\n    65\t                        _ => { let (head, body) = datom.variant(budget, \"Variant\")?; match head { #(#arms,)* other => Err(<::datom_codec::Error as ::datom_codec::ErrorRaising>::composition(datom.path.clone(), ::datom_codec::ErrorKind::Variant { expected: stringify!(#name).to_owned(), found: other.to_owned() })) } }\n    66\t                    }\n    67\t                }\n    68\t            }\n    69\t        }.into();\n    70\t    }\n    71\t    let fields = match fields(&input, \"Compositional\") {\n    72\t        Ok(fields) => fields,\n    73\t        Err(error) => return error,\n    74\t    };\n    75\t    let mut bounded_generics = input.generics.clone();\n    76\t    for parameter in &input.generics.params {\n    77\t        if let syn::GenericParam::Type(parameter) = parameter {\n    78\t            let ident = &parameter.ident;\n    79\t            bounded_generics\n    80\t                .make_where_clause()\n    81\t                .predicates\n    82\t                .push(syn::parse_quote!(#ident: ::datom_codec::Compositional));\n    83\t        }\n    84\t    }\n    85\t    let (impl_generics, ty_generics, where_clause) = bounded_generics.split_for_impl();\n    86\t    let reads = fields.iter().enumerate().map(|(index, field)| {\n    87\t        let ty = &field.ty;\n    88\t        let binding = syn::Ident::new(&format!(\"field_{index}\"), proc_macro2::Span::call_site());\n    89\t        quote!(let #binding: #ty = positions.position(budget)?;)\n    90\t    });\n    91\t    let bindings: Vec<_> = (0..fields.len())\n    92\t        .map(|index| syn::Ident::new(&format!(\"field_{index}\"), proc_macro2::Span::call_site()))\n    93\t        .collect();\n    94\t    let build = match fields {\n    95\t        Fields::Named(named) => {\n    96\t            let names = named\n    97\t                .named\n    98\t                .iter()\n    99\t                .map(|field| field.ident.as_ref().unwrap());\n   100\t            quote!(Self { #(#names: #bindings),* })\n   101\t        }\n   102\t        Fields::Unnamed(_) => quote!(Self(#(#bindings),*)),\n   103\t        Fields::Unit => quote!(Self),\n   104\t    };\n   105\t    let arity = fields.len();\n   106\t    quote! {\n   107\t        impl #impl_generics ::datom_codec::Compositional for #name #ty_generics #where_clause {\n   108\t            const ARITY: ::datom_codec::Integer = #arity as ::datom_codec::Integer;\n   109\t            fn from_positions(mut positions: ::datom_codec::Positions<'_>, budget: &mut ::datom_codec::Budget) -> Result<Self, ::datom_codec::Error> {\n   110\t                use ::datom_codec::Positioning; #(#reads)* positions.finish()?; Ok(#build)\n   111\t            }\n   112\t        }\n   113\t    }.into()\n   114\t}\n   115\t\n   116\t#[proc_macro_derive(Datomizable)]\n   117\tpub fn datomizable(input: TokenStream) -> TokenStream {\n   118\t    let input = parse_macro_input!(input as DeriveInput);\n   119\t    let name = &input.ident;\n   120\t    if let Data::Enum(data) = &input.data {\n   121\t        let mut bounded_generics = input.generics.clone();\n   122\t        for parameter in &input.generics.params {\n   123\t            if let syn::GenericParam::Type(parameter) = parameter {\n   124\t                let ident = &parameter.ident;\n   125\t                bounded_generics.make_where_clause().predicates.push(\n   126\t                    syn::parse_quote!(#ident: ::datom_codec::Datomizable<Output = ::datom_codec::Datom>),\n   127\t                );\n   128\t            }\n   129\t        }\n   130\t        let (impl_generics, ty_generics, where_clause) = bounded_generics.split_for_impl();\n   131\t        let arms = data.variants.iter().map(|variant| {\n   132\t            let variant_name = &variant.ident;\n   133\t            let spelling = variant_name.to_string();\n   134\t            let bindings: Vec<_> = (0..variant.fields.len()).map(|index| syn::Ident::new(&format!(\"field_{index}\"), proc_macro2::Span::call_site())).collect();\n   135\t            let pattern = match &variant.fields { Fields::Named(named) => { let names = named.named.iter().map(|field| field.ident.as_ref().unwrap()); quote!(Self::#variant_name { #(#names: #bindings),* }) }, Fields::Unnamed(_) => quote!(Self::#variant_name(#(#bindings),*)), Fields::Unit => quote!(Self::#variant_name) };\n   136\t            let child_values: Vec<_> = bindings.iter().enumerate().map(|(index, binding)| quote!((#binding).datomize(at.child(1).child(#index as ::datom_codec::Integer)))).collect();\n   137\t            let body = match variant.fields.len() {\n   138\t                0 => quote!(::datom_codec::Datom { path: at.child(1), form: ::datom_codec::Form::Bare(String::new()) }),\n   139\t                1 => { let binding = &bindings[0]; quote!((#binding).datomize(at.child(1))) },\n   140\t                _ => quote!(::datom_codec::Datom { path: at.child(1), form: ::datom_codec::Form::Struct(vec![#(#child_values),*]) }),\n   141\t            };\n   142\t            if variant.fields.is_empty() {\n   143\t                quote!(#pattern => ::datom_codec::Datom { path: at.clone(), form: ::datom_codec::Form::Bare(#spelling.to_owned()) })\n   144\t            } else {\n   145\t                quote!(#pattern => ::datom_codec::Datom { path: at.clone(), form: ::datom_codec::Form::Variant(::datom_codec::Symbol(#spelling.to_owned()), Box::new(#body)) })\n   146\t            }\n   147\t        });\n   148\t        return quote! {\n   149\t            impl #impl_generics ::datom_codec::Datomizable for #name #ty_generics #where_clause {\n   150\t                type Output = ::datom_codec::Datom;\n   151\t                fn datomize(&self, at: ::datom_codec::Path) -> ::datom_codec::Datom {\n   152\t                    use ::datom_codec::{Datomizable, Pathing};\n   153\t                    match self { #(#arms),* }\n   154\t                }\n   155\t            }\n   156\t        }\n   157\t        .into();\n   158\t    }\n   159\t    let fields = match fields(&input, \"Datomizable\") {\n   160\t        Ok(fields) => fields,\n   161\t        Err(error) => return error,\n   162\t    };\n   163\t    let mut bounded_generics = input.generics.clone();\n   164\t    for parameter in &input.generics.params {\n   165\t        if let syn::GenericParam::Type(parameter) = parameter {\n   166\t            let ident = &parameter.ident;\n   167\t            bounded_generics.make_where_clause().predicates.push(\n   168\t                syn::parse_quote!(#ident: ::datom_codec::Datomizable<Output = ::datom_codec::Datom>),\n   169\t            );\n   170\t        }\n   171\t    }\n   172\t    let (impl_generics, ty_generics, where_clause) = bounded_generics.split_for_impl();\n   173\t    let values: Vec<_> = fields\n   174\t        .iter()\n   175\t        .enumerate()\n   176\t        .map(|(index, field)| {\n   177\t            let value = match &field.ident {\n   178\t                Some(name) => quote!(&self.#name),\n   179\t                None => {\n   180\t                    let index = syn::Index::from(index);\n   181\t                    quote!(&self.#index)\n   182\t                }\n   183\t            };\n   184\t            quote!((#value).datomize(at.child(#index as ::datom_codec::Integer)))\n   185\t        })\n   186\t        .collect();\n   187\t    quote! {\n   188\t        impl #impl_generics ::datom_codec::Datomizable for #name #ty_generics #where_clause {\n   189\t            type Output = ::datom_codec::Datom;\n   190\t            fn datomize(&self, at: ::datom_codec::Path) -> ::datom_codec::Datom {\n   191\t                use ::datom_codec::{Datomizable, Pathing};\n   192\t                ::datom_codec::Datom { path: at.clone(), form: ::datom_codec::Form::Struct(vec![#(#values),*]) }\n   193\t            }\n   194\t        }\n   195\t    }.into()\n   196\t}\n     1\t[package]\n     2\tname = \"datom-codec-derive\"\n     3\tversion = \"0.25.6\"\n     4\tedition = \"2024\"\n     5\tpublish = false\n     6\t\n     7\t[lib]\n     8\tproc-macro = true\n     9\t\n    10\t[dependencies]\n    11\tproc-macro2 = \"1\"\n    12\tquote = \"1\"\n    13\tsyn = { version = \"2\", features = [\"full\"] }\n     1\tuse datom_codec::{\n     2\t    Actualizing, Budget, Composable, Compositional, Datom, Datomizable, Error, ErrorKind,\n     3\t    ErrorLayer, ErrorRaising, Form, Meaning, Path, Potential, PotentialExtenting, ProtosExtenting,\n     4\t    Scalar,\n     5\t};\n     6\tuse protos::{Protosizable, ReaderBudget, Textualizable};\n     7\t\n     8\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n     9\tstruct Score {\n    10\t    name: String,\n    11\t    value: i64,\n    12\t    enabled: bool,\n    13\t}\n    14\t\n    15\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n    16\tenum Reply {\n    17\t    Accepted(i64, String),\n    18\t    Pending,\n    19\t}\n    20\t\n    21\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n    22\tenum Message {\n    23\t    Reply(Reply),\n    24\t}\n    25\t\n    26\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n    27\tstruct PunctuatedStrings {\n    28\t    model: String,\n    29\t    url: String,\n    30\t    qualified_name: String,\n    31\t}\n    32\t\n    33\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n    34\tenum Pair {\n    35\t    Values(i64, i64),\n    36\t}\n    37\t\n    38\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n    39\tstruct Wrapper<T> {\n    40\t    value: T,\n    41\t}\n    42\t\n    43\t#[test]\n    44\tfn derived_struct_composes_its_typed_positions() {\n    45\t    let datom = Datom {\n    46\t        path: Path::new(),\n    47\t        form: Form::Struct(vec![\n    48\t            Datom {\n    49\t                path: vec![0],\n    50\t                form: Form::Bare(\"Ada\".into()),\n    51\t            },\n    52\t            Datom {\n    53\t                path: vec![1],\n    54\t                form: Form::Bare(\"42\".into()),\n    55\t            },\n    56\t            Datom {\n    57\t                path: vec![2],\n    58\t                form: Form::Bare(\"True\".into()),\n    59\t            },\n    60\t        ]),\n    61\t    };\n    62\t    let value: Score = datom\n    63\t        .compose(&mut Budget {\n    64\t            remaining: 10,\n    65\t            reader: ReaderBudget { remaining: 128 },\n    66\t            depth: 0,\n    67\t            maximum_depth: 4_096,\n    68\t        })\n    69\t        .unwrap();\n    70\t    assert_eq!(\n    71\t        value,\n    72\t        Score {\n    73\t            name: \"Ada\".into(),\n    74\t            value: 42,\n    75\t            enabled: true\n    76\t        }\n    77\t    );\n    78\t    assert_eq!(value.datomize(vec![]), datom);\n    79\t}\n    80\t\n    81\t#[test]\n    82\tfn protos_symbol_and_reader_budget_are_datom_intrinsics() {\n    83\t    let mut budget = Budget {\n    84\t        remaining: 20,\n    85\t        reader: ReaderBudget { remaining: 128 },\n    86\t        depth: 0,\n    87\t        maximum_depth: 128,\n    88\t    };\n    89\t    let symbol = protos::Symbol(\"Reviewer\".into());\n    90\t    let datom = symbol.datomize(vec![]);\n    91\t    let rebuilt: protos::Symbol = datom.compose(&mut budget.clone()).unwrap();\n    92\t    assert_eq!(rebuilt, symbol);\n    93\t\n    94\t    let reader = ReaderBudget { remaining: 4_096 };\n    95\t    let datom = reader.datomize(vec![]);\n    96\t    let rebuilt: ReaderBudget = datom.compose(&mut budget).unwrap();\n    97\t    assert_eq!(rebuilt, reader);\n    98\t}\n    99\t\n   100\t#[test]\n   101\tfn scalar_refusal_keeps_the_datom_path() {\n   102\t    let datom = Datom {\n   103\t        path: vec![2],\n   104\t        form: Form::Bare(\"01\".into()),\n   105\t    };\n   106\t    let error = i64::scalar(\n   107\t        &datom,\n   108\t        &mut Budget {\n   109\t            remaining: 1,\n   110\t            reader: ReaderBudget { remaining: 128 },\n   111\t            depth: 0,\n   112\t            maximum_depth: 4_096,\n   113\t        },\n   114\t    )\n   115\t    .unwrap_err();\n   116\t    assert_eq!(error.path, vec![2]);\n   117\t}\n   118\t\n   119\t#[test]\n   120\tfn derived_variants_use_their_rust_names_as_heads() {\n   121\t    let value = Reply::Accepted(42, \"today\".into());\n   122\t    let datom = value.datomize(vec![]);\n   123\t    assert!(matches!(&datom.form, Form::Variant(head, _) if head.0 == \"Accepted\"));\n   124\t    assert_eq!(\n   125\t        datom\n   126\t            .compose::<Reply>(&mut Budget {\n   127\t                remaining: 10,\n   128\t                reader: ReaderBudget { remaining: 10 },\n   129\t                depth: 0,\n   130\t                maximum_depth: 4_096\n   131\t            })\n   132\t            .unwrap(),\n   133\t        value\n   134\t    );\n   135\t    let pending = Reply::Pending.datomize(vec![]);\n   136\t    assert_eq!(\n   137\t        pending\n   138\t            .compose::<Reply>(&mut Budget {\n   139\t                remaining: 10,\n   140\t                reader: ReaderBudget { remaining: 10 },\n   141\t                depth: 0,\n   142\t                maximum_depth: 4_096\n   143\t            })\n   144\t            .unwrap(),\n   145\t        Reply::Pending\n   146\t    );\n   147\t    assert_eq!(pending.protosize().textualize(), \"Pending\");\n   148\t    assert_eq!(\n   149\t        Potential::<Reply>::from(\"Pending\")\n   150\t            .actualize(&mut Budget {\n   151\t                remaining: 1,\n   152\t                reader: ReaderBudget { remaining: 128 },\n   153\t                depth: 0,\n   154\t                maximum_depth: 4_096\n   155\t            })\n   156\t            .unwrap(),\n   157\t        Reply::Pending\n   158\t    );\n   159\t}\n   160\t\n   161\t#[test]\n   162\tfn scalar_writers_preserve_their_textual_kind() {\n   163\t    assert_eq!(3.0_f64.datomize(vec![]).protosize().textualize(), \"3.0\");\n   164\t    assert_eq!((-0.0_f64).datomize(vec![]).protosize().textualize(), \"-0.0\");\n   165\t    assert_eq!(\n   166\t        \"a{b\".to_owned().datomize(vec![]).protosize().textualize(),\n   167\t        \"«a{b»\"\n   168\t    );\n   169\t    assert!(\n   170\t        i64::scalar(\n   171\t            &Datom {\n   172\t                path: vec![],\n   173\t                form: Form::Bare(\"-01\".into())\n   174\t            },\n   175\t            &mut Budget {\n   176\t                remaining: 1,\n   177\t                reader: ReaderBudget { remaining: 1 },\n   178\t                depth: 0,\n   179\t                maximum_depth: 4_096\n   180\t            }\n   181\t        )\n   182\t        .is_err()\n   183\t    );\n   184\t}\n   185\t\n   186\t#[test]\n   187\tfn qualified_heads_refuse_at_the_variant_path() {\n   188\t    let mut potential = Potential::<Reply>::from(\"Accepted<String>.42\");\n   189\t    let error = potential\n   190\t        .actualize(&mut Budget {\n   191\t            remaining: 10,\n   192\t            reader: ReaderBudget { remaining: 128 },\n   193\t            depth: 0,\n   194\t            maximum_depth: 4_096,\n   195\t        })\n   196\t        .unwrap_err();\n   197\t    assert_eq!(error.path, Vec::<i64>::new());\n   198\t    assert!(matches!(\n   199\t        error.kind,\n   200\t        ErrorKind::Form { ref expected, ref found }\n   201\t            if expected == \"unqualified Variant\" && found == \"qualified head\"\n   202\t    ));\n   203\t    assert_eq!(\n   204\t        potential.reader_extent(&error.path),\n   205\t        Some(protos::Extent { start: 0, end: 19 })\n   206\t    );\n   207\t}\n   208\t\n   209\t#[test]\n   210\tfn protos_conversion_preserves_datoms_and_canonical_text() {\n   211\t    let datom = Score {\n   212\t        name: \"Ada\".into(),\n   213\t        value: 42,\n   214\t        enabled: true,\n   215\t    }\n   216\t    .datomize(vec![]);\n   217\t    let text = datom.protosize().textualize();\n   218\t    assert_eq!(text, \"{ Ada 42 True }\");\n   219\t    assert_eq!(datom.protosize(), text.protosize().unwrap());\n   220\t    let rebuilt = text.protosize().unwrap().datomize(vec![]);\n   221\t    assert_eq!(rebuilt.unwrap(), datom);\n   222\t}\n   223\t\n   224\t#[test]\n   225\tfn potential_actualizes_text_through_protos_and_datom() {\n   226\t    let value: Score = Potential::from(\"{ Ada 42 True }\")\n   227\t        .actualize(&mut Budget {\n   228\t            remaining: 10,\n   229\t            reader: ReaderBudget { remaining: 10 },\n   230\t            depth: 0,\n   231\t            maximum_depth: 4_096,\n   232\t        })\n   233\t        .unwrap();\n   234\t    assert_eq!(\n   235\t        value,\n   236\t        Score {\n   237\t            name: \"Ada\".into(),\n   238\t            value: 42,\n   239\t            enabled: true\n   240\t        }\n   241\t    );\n   242\t}\n   243\t\n   244\t#[test]\n   245\tfn scalar_positions_keep_bare_payloads_and_some_bodies_flat() {\n   246\t    let three_point_fourteen: f64 = \"3.14\".parse().unwrap();\n   247\t    let timestamp: String = Potential::from(\"2026-09-03T17:46:20\")\n   248\t        .actualize(&mut Budget {\n   249\t            remaining: 1,\n   250\t            reader: ReaderBudget { remaining: 128 },\n   251\t            depth: 0,\n   252\t            maximum_depth: 4_096,\n   253\t        })\n   254\t        .unwrap();\n   255\t    assert_eq!(timestamp, \"2026-09-03T17:46:20\");\n   256\t    let name: String = Potential::from(\"Ada:one\")\n   257\t        .actualize(&mut Budget {\n   258\t            remaining: 1,\n   259\t            reader: ReaderBudget { remaining: 128 },\n   260\t            depth: 0,\n   261\t            maximum_depth: 4_096,\n   262\t        })\n   263\t        .unwrap();\n   264\t    assert_eq!(name, \"Ada:one\");\n   265\t\n   266\t    let string: Option<String> = Potential::from(\"Some.42\")\n   267\t        .actualize(&mut Budget {\n   268\t            remaining: 2,\n   269\t            reader: ReaderBudget { remaining: 128 },\n   270\t            depth: 0,\n   271\t            maximum_depth: 4_096,\n   272\t        })\n   273\t        .unwrap();\n   274\t    assert_eq!(string, Some(\"42\".into()));\n   275\t    let integer: Option<i64> = Potential::from(\"Some.42\")\n   276\t        .actualize(&mut Budget {\n   277\t            remaining: 2,\n   278\t            reader: ReaderBudget { remaining: 128 },\n   279\t            depth: 0,\n   280\t            maximum_depth: 4_096,\n   281\t        })\n   282\t        .unwrap();\n   283\t    assert_eq!(integer, Some(42));\n   284\t    let decimal: f64 = Potential::from(\"3.14\")\n   285\t        .actualize(&mut Budget {\n   286\t            remaining: 1,\n   287\t            reader: ReaderBudget { remaining: 128 },\n   288\t            depth: 0,\n   289\t            maximum_depth: 4_096,\n   290\t        })\n   291\t        .unwrap();\n   292\t    assert_eq!(decimal, three_point_fourteen);\n   293\t    let optional_decimal: Option<f64> = Potential::from(\"Some.3.14\")\n   294\t        .actualize(&mut Budget {\n   295\t            remaining: 2,\n   296\t            reader: ReaderBudget { remaining: 128 },\n   297\t            depth: 0,\n   298\t            maximum_depth: 4_096,\n   299\t        })\n   300\t        .unwrap();\n   301\t    assert_eq!(optional_decimal, Some(three_point_fourteen));\n   302\t\n   303\t    assert_eq!(\n   304\t        Some(\"Ada:one\".to_owned())\n   305\t            .datomize(vec![])\n   306\t            .protosize()\n   307\t            .textualize(),\n   308\t        \"Some.Ada:one\"\n   309\t    );\n   310\t    assert_eq!(\n   311\t        Some(three_point_fourteen)\n   312\t            .datomize(vec![])\n   313\t            .protosize()\n   314\t            .textualize(),\n   315\t        \"Some.3.14\"\n   316\t    );\n   317\t}\n   318\t\n   319\t#[test]\n   320\tfn typed_string_positions_resolve_bare_syntax_characters() {\n   321\t    let text = \"{ gpt-5.6-luna https://example.org/a Upper.Case }\";\n   322\t    let expected = PunctuatedStrings {\n   323\t        model: \"gpt-5.6-luna\".into(),\n   324\t        url: \"https://example.org/a\".into(),\n   325\t        qualified_name: \"Upper.Case\".into(),\n   326\t    };\n   327\t    let value: PunctuatedStrings = Potential::from(text)\n   328\t        .actualize(&mut Budget {\n   329\t            remaining: 16,\n   330\t            reader: ReaderBudget { remaining: 128 },\n   331\t            depth: 0,\n   332\t            maximum_depth: 16,\n   333\t        })\n   334\t        .unwrap();\n   335\t    assert_eq!(value, expected);\n   336\t    assert_eq!(value.datomize(vec![]).protosize().textualize(), text);\n   337\t}\n   338\t\n   339\t#[test]\n   340\tfn string_rule_round_trips_bare_punctuation_and_delimited_content() {\n   341\t    for (value, canonical) in [\n   342\t        (\".a\", \".a\"),\n   343\t        (\"a.\", \"a.\"),\n   344\t        (\"a..b\", \"a..b\"),\n   345\t        (\".codex/agents/worker.toml\", \".codex/agents/worker.toml\"),\n   346\t        (\"lower.case\", \"lower.case\"),\n   347\t        (\"Upper.Case\", \"Upper.Case\"),\n   348\t        (\"a:b:c\", \"a:b:c\"),\n   349\t        (\"a!b!c\", \"a!b!c\"),\n   350\t        (\"https://example.org/a\", \"https://example.org/a\"),\n   351\t        (\"猫.龍\", \"猫.龍\"),\n   352\t        (\"path\\\\segment\", \"path\\\\segment\"),\n   353\t        (\"\", \"«»\"),\n   354\t        (\"two words\", \"«two words»\"),\n   355\t        (\";comment\", \"«;comment»\"),\n   356\t        (\"a;b\", \"«a;b»\"),\n   357\t        (\"{x}\", \"«{x}»\"),\n   358\t        (\"(x)\", \"«(x)»\"),\n   359\t        (\"«x»\", \"««x\\\\»»\"),\n   360\t    ] {\n   361\t        let text = value.to_owned().datomize(vec![]).protosize().textualize();\n   362\t        assert_eq!(text, canonical, \"canonical String for {value:?}\");\n   363\t        let rebuilt: String = Potential::from(text)\n   364\t            .actualize(&mut Budget {\n   365\t                remaining: 64,\n   366\t                reader: ReaderBudget { remaining: 256 },\n   367\t                depth: 0,\n   368\t                maximum_depth: 64,\n   369\t            })\n   370\t            .unwrap();\n   371\t        assert_eq!(rebuilt, value, \"String round trip for {canonical:?}\");\n   372\t    }\n   373\t}\n   374\t\n   375\t#[test]\n   376\tfn typed_enums_keep_bare_carried_and_daisy_variants() {\n   377\t    for (text, expected) in [\n   378\t        (\n   379\t            \"Reply.Accepted.{ 42 today }\",\n   380\t            Message::Reply(Reply::Accepted(42, \"today\".into())),\n   381\t        ),\n   382\t        (\"Reply.Pending\", Message::Reply(Reply::Pending)),\n   383\t    ] {\n   384\t        let value: Message = Potential::from(text)\n   385\t            .actualize(&mut Budget {\n   386\t                remaining: 16,\n   387\t                reader: ReaderBudget { remaining: 128 },\n   388\t                depth: 0,\n   389\t                maximum_depth: 16,\n   390\t            })\n   391\t            .unwrap();\n   392\t        assert_eq!(value, expected);\n   393\t        assert_eq!(value.datomize(vec![]).protosize().textualize(), text);\n   394\t    }\n   395\t}\n   396\t\n   397\t#[test]\n   398\tfn delimited_variant_shapes_do_not_compose_as_strings() {\n   399\t    let error = Potential::<String>::from(\"Head.{ x }\")\n   400\t        .actualize(&mut Budget {\n   401\t            remaining: 8,\n   402\t            reader: ReaderBudget { remaining: 128 },\n   403\t            depth: 0,\n   404\t            maximum_depth: 8,\n   405\t        })\n   406\t        .unwrap_err();\n   407\t    assert!(matches!(\n   408\t        error.kind,\n   409\t        ErrorKind::Form { ref expected, .. } if expected == \"String\"\n   410\t    ));\n   411\t}\n   412\t\n   413\t#[test]\n   414\tfn dotted_string_composition_obeys_depth_and_work_budgets() {\n   415\t    let dotted = Datom {\n   416\t        path: vec![],\n   417\t        form: Form::Variant(\n   418\t            protos::Symbol(\"One\".into()),\n   419\t            Box::new(Datom {\n   420\t                path: vec![1],\n   421\t                form: Form::Variant(\n   422\t                    protos::Symbol(\"Two\".into()),\n   423\t                    Box::new(Datom {\n   424\t                        path: vec![1, 1],\n   425\t                        form: Form::Variant(\n   426\t                            protos::Symbol(\"Three\".into()),\n   427\t                            Box::new(Datom {\n   428\t                                path: vec![1, 1, 1],\n   429\t                                form: Form::Bare(\"Four\".into()),\n   430\t                            }),\n   431\t                        ),\n   432\t                    }),\n   433\t                ),\n   434\t            }),\n   435\t        ),\n   436\t    };\n   437\t    let mut depth_budget = Budget {\n   438\t        remaining: 16,\n   439\t        reader: ReaderBudget { remaining: 16 },\n   440\t        depth: 0,\n   441\t        maximum_depth: 3,\n   442\t    };\n   443\t    let error = dotted.compose::<String>(&mut depth_budget).unwrap_err();\n   444\t    assert_eq!(error.kind, ErrorKind::Budget);\n   445\t    assert_eq!(depth_budget.depth, 0);\n   446\t\n   447\t    let mut work_budget = Budget {\n   448\t        remaining: 2,\n   449\t        reader: ReaderBudget { remaining: 16 },\n   450\t        depth: 0,\n   451\t        maximum_depth: 16,\n   452\t    };\n   453\t    let error = dotted.compose::<String>(&mut work_budget).unwrap_err();\n   454\t    assert_eq!(error.kind, ErrorKind::Budget);\n   455\t    assert_eq!(work_budget.depth, 0);\n   456\t}\n   457\t\n   458\t#[test]\n   459\tfn generic_containers_and_meaning_round_trip_their_forms() {\n   460\t    let value = Wrapper {\n   461\t        value: Some(Box::new(Meaning(\"nested (meaning)\".into()))),\n   462\t    };\n   463\t    let datom = value.datomize(vec![]);\n   464\t    assert_eq!(\n   465\t        datom.protosize().textualize(),\n   466\t        \"{ Some.(nested (meaning)) }\"\n   467\t    );\n   468\t    let rebuilt: Wrapper<Option<Box<Meaning>>> = datom\n   469\t        .compose(&mut Budget {\n   470\t            remaining: 10,\n   471\t            reader: ReaderBudget { remaining: 10 },\n   472\t            depth: 0,\n   473\t            maximum_depth: 4_096,\n   474\t        })\n   475\t        .unwrap();\n   476\t    assert_eq!(rebuilt, value);\n   477\t    let result: Result<i64, String> = Err(\"nope\".into());\n   478\t    let datom = result.datomize(vec![]);\n   479\t    assert_eq!(\n   480\t        datom\n   481\t            .compose::<Result<i64, String>>(&mut Budget {\n   482\t                remaining: 10,\n   483\t                reader: ReaderBudget { remaining: 10 },\n   484\t                depth: 0,\n   485\t                maximum_depth: 4_096\n   486\t            })\n   487\t            .unwrap(),\n   488\t        result\n   489\t    );\n   490\t}\n   491\t\n   492\t#[test]\n   493\tfn potential_reports_structural_and_budget_errors_at_their_context() {\n   494\t    let structural = Potential::<Score>::from(\"{ Ada\")\n   495\t        .actualize(&mut Budget {\n   496\t            remaining: 10,\n   497\t            reader: ReaderBudget { remaining: 128 },\n   498\t            depth: 0,\n   499\t            maximum_depth: 4_096,\n   500\t        })\n   501\t        .unwrap_err();\n   502\t    assert_eq!(structural.path, Vec::<i64>::new());\n   503\t    assert!(matches!(structural.kind, ErrorKind::Structural(_)));\n   504\t    let exhausted = Potential::<Score>::from(\"{ Ada 42 True }\")\n   505\t        .actualize(&mut Budget {\n   506\t            remaining: 0,\n   507\t            reader: ReaderBudget { remaining: 128 },\n   508\t            depth: 0,\n   509\t            maximum_depth: 4_096,\n   510\t        })\n   511\t        .unwrap_err();\n   512\t    assert_eq!(exhausted.path, Vec::<i64>::new());\n   513\t    assert_eq!(exhausted.kind, ErrorKind::Budget);\n   514\t}\n   515\t\n   516\t#[test]\n   517\tfn potential_refuses_before_composition_when_reader_budget_is_exhausted() {\n   518\t    let error = Potential::<String>::from(\"Ada\")\n   519\t        .actualize(&mut Budget {\n   520\t            remaining: 1,\n   521\t            reader: ReaderBudget { remaining: 0 },\n   522\t            depth: 0,\n   523\t            maximum_depth: 4_096,\n   524\t        })\n   525\t        .unwrap_err();\n   526\t    assert_eq!(error.path, Vec::<i64>::new());\n   527\t    assert!(matches!(error.kind, ErrorKind::Structural(_)));\n   528\t}\n   529\t\n   530\t#[test]\n   531\tfn unit_options_and_unit_enums_round_trip_as_bare_text() {\n   532\t    let value: Option<i64> = None;\n   533\t    assert_eq!(value.datomize(vec![]).protosize().textualize(), \"None\");\n   534\t    assert_eq!(\n   535\t        Potential::<Option<i64>>::from(\"None\")\n   536\t            .actualize(&mut Budget {\n   537\t                remaining: 1,\n   538\t                reader: ReaderBudget { remaining: 128 },\n   539\t                depth: 0,\n   540\t                maximum_depth: 4_096\n   541\t            })\n   542\t            .unwrap(),\n   543\t        None\n   544\t    );\n   545\t    assert_eq!(\n   546\t        Potential::<Reply>::from(\"Pending\")\n   547\t            .actualize(&mut Budget {\n   548\t                remaining: 1,\n   549\t                reader: ReaderBudget { remaining: 128 },\n   550\t                depth: 0,\n   551\t                maximum_depth: 4_096\n   552\t            })\n   553\t            .unwrap(),\n   554\t        Reply::Pending\n   555\t    );\n   556\t}\n   557\t\n   558\t#[test]\n   559\tfn datom_refuses_non_datom_structural_forms() {\n   560\t    let angled = Potential::<Vec<i64>>::from(\"< 1 2 >\")\n   561\t        .actualize(&mut Budget {\n   562\t            remaining: 10,\n   563\t            reader: ReaderBudget { remaining: 128 },\n   564\t            depth: 0,\n   565\t            maximum_depth: 4_096,\n   566\t        })\n   567\t        .unwrap_err();\n   568\t    assert!(matches!(\n   569\t        angled.kind,\n   570\t        ErrorKind::Form { ref expected, ref found }\n   571\t            if expected == \"Datom enclosure\" && found == \"Angled\"\n   572\t    ));\n   573\t\n   574\t    let positions = Potential::<Pair>::from(\"Values.[ 1 2 ]\")\n   575\t        .actualize(&mut Budget {\n   576\t            remaining: 10,\n   577\t            reader: ReaderBudget { remaining: 128 },\n   578\t            depth: 0,\n   579\t            maximum_depth: 4_096,\n   580\t        })\n   581\t        .unwrap_err();\n   582\t    assert!(matches!(\n   583\t        positions.kind,\n   584\t        ErrorKind::Form { ref expected, ref found }\n   585\t            if expected == \"Struct\" && found == \"Vector\"\n   586\t    ));\n   587\t}\n   588\t\n   589\t#[test]\n   590\tfn strings_quote_delimiters_keep_bare_separators_and_accept_temporary_meaning_text() {\n   591\t    for value in [\"a{b\", \"a;b\", \"a(b\"] {\n   592\t        let text = value.to_owned().datomize(vec![]).protosize().textualize();\n   593\t        assert!(text.starts_with('«'), \"{value}: {text}\");\n   594\t        assert_eq!(\n   595\t            Potential::<String>::from(text)\n   596\t                .actualize(&mut Budget {\n   597\t                    remaining: 1,\n   598\t                    reader: ReaderBudget { remaining: 128 },\n   599\t                    depth: 0,\n   600\t                    maximum_depth: 4_096\n   601\t                })\n   602\t                .unwrap(),\n   603\t            value\n   604\t        );\n   605\t    }\n   606\t    for value in [\"a.b\", \"a!b\", \"a:b\"] {\n   607\t        let text = value.to_owned().datomize(vec![]).protosize().textualize();\n   608\t        assert_eq!(text, value);\n   609\t        assert_eq!(\n   610\t            Potential::<String>::from(text)\n   611\t                .actualize(&mut Budget {\n   612\t                    remaining: 8,\n   613\t                    reader: ReaderBudget { remaining: 128 },\n   614\t                    depth: 0,\n   615\t                    maximum_depth: 8,\n   616\t                })\n   617\t                .unwrap(),\n   618\t            value\n   619\t        );\n   620\t    }\n   621\t    assert_eq!(\n   622\t        Potential::<String>::from(\"(temporary meaning)\")\n   623\t            .actualize(&mut Budget {\n   624\t                remaining: 1,\n   625\t                reader: ReaderBudget { remaining: 128 },\n   626\t                depth: 0,\n   627\t                maximum_depth: 4_096\n   628\t            })\n   629\t            .unwrap(),\n   630\t        \"temporary meaning\"\n   631\t    );\n   632\t}\n   633\t\n   634\t#[test]\n   635\tfn retained_reader_finds_nested_composition_fault_extents() {\n   636\t    let mut vector = Potential::<Vec<i64>>::from(\"[ 1 x ]\");\n   637\t    let error = vector\n   638\t        .actualize(&mut Budget {\n   639\t            remaining: 10,\n   640\t            reader: ReaderBudget { remaining: 128 },\n   641\t            depth: 0,\n   642\t            maximum_depth: 4_096,\n   643\t        })\n   644\t        .unwrap_err();\n   645\t    assert_eq!(error.path, vec![1]);\n   646\t    assert_eq!(\n   647\t        vector.reader_extent(&error.path),\n   648\t        Some(protos::Extent { start: 4, end: 5 })\n   649\t    );\n   650\t\n   651\t    let mut variant = Potential::<Pair>::from(\"Values.{ 1 x }\");\n   652\t    let error = variant\n   653\t        .actualize(&mut Budget {\n   654\t            remaining: 10,\n   655\t            reader: ReaderBudget { remaining: 128 },\n   656\t            depth: 0,\n   657\t            maximum_depth: 4_096,\n   658\t        })\n   659\t        .unwrap_err();\n   660\t    assert_eq!(error.path, vec![1, 1]);\n   661\t    assert_eq!(\n   662\t        variant.reader_extent(&error.path),\n   663\t        Some(protos::Extent { start: 11, end: 12 })\n   664\t    );\n   665\t}\n   666\t\n   667\t#[test]\n   668\tfn typed_protos_errors_round_trip_without_a_reader_tree() {\n   669\t    let error = protos::Error {\n   670\t        extent: protos::Extent { start: 3, end: 4 },\n   671\t        problem: protos::Problem::Unexpected('@'),\n   672\t    };\n   673\t    let datom = error.datomize(vec![]);\n   674\t    let text = datom.protosize().textualize();\n   675\t    let rebuilt: protos::Error = Potential::from(text)\n   676\t        .actualize(&mut Budget {\n   677\t            remaining: 20,\n   678\t            reader: ReaderBudget { remaining: 128 },\n   679\t            depth: 0,\n   680\t            maximum_depth: 4_096,\n   681\t        })\n   682\t        .unwrap();\n   683\t    assert_eq!(rebuilt, error);\n   684\t}\n   685\t\n   686\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n   687\tenum GenericReply<T> {\n   688\t    Pending,\n   689\t    One(T),\n   690\t    Pair(T, i64),\n   691\t    Named { value: T, label: String },\n   692\t}\n   693\t\n   694\t#[test]\n   695\tfn generic_enum_derives_bound_every_payload_shape() {\n   696\t    let budget = || Budget {\n   697\t        remaining: 50,\n   698\t        reader: ReaderBudget { remaining: 128 },\n   699\t        depth: 0,\n   700\t        maximum_depth: 4_096,\n   701\t    };\n   702\t    for value in [\n   703\t        GenericReply::Pending,\n   704\t        GenericReply::One(7_i64),\n   705\t        GenericReply::Pair(7_i64, 8),\n   706\t        GenericReply::Named {\n   707\t            value: 7_i64,\n   708\t            label: \"Ada\".into(),\n   709\t        },\n   710\t    ] {\n   711\t        let datom = value.datomize(vec![]);\n   712\t        let rebuilt: GenericReply<i64> = datom.compose(&mut budget()).unwrap();\n   713\t        assert_eq!(rebuilt, value);\n   714\t    }\n   715\t}\n   716\t\n   717\t#[test]\n   718\tfn datom_errors_round_trip_with_their_raising_layer() {\n   719\t    let error = Error {\n   720\t        layer: ErrorLayer::Datom,\n   721\t        path: vec![1, 0],\n   722\t        kind: ErrorKind::Form {\n   723\t            expected: \"Datom enclosure\".into(),\n   724\t            found: \"Angled\".into(),\n   725\t        },\n   726\t    };\n   727\t    let text = error.datomize(vec![]).protosize().textualize();\n   728\t    let rebuilt: Error = Potential::from(text)\n   729\t        .actualize(&mut Budget {\n   730\t            remaining: 30,\n   731\t            reader: ReaderBudget { remaining: 128 },\n   732\t            depth: 0,\n   733\t            maximum_depth: 4_096,\n   734\t        })\n   735\t        .unwrap();\n   736\t    assert_eq!(rebuilt, error);\n   737\t}\n   738\t\n   739\t#[test]\n   740\tfn manually_built_hundred_thousand_deep_datom_projects_and_drops_iteratively() {\n   741\t    let mut datom = Datom {\n   742\t        path: vec![],\n   743\t        form: Form::Bare(\"x\".into()),\n   744\t    };\n   745\t    for _ in 0..100_000 {\n   746\t        datom = Datom {\n   747\t            path: vec![],\n   748\t            form: Form::Variant(protos::Symbol(\"V\".into()), Box::new(datom)),\n   749\t        };\n   750\t    }\n   751\t    let protos = datom.protosize();\n   752\t    assert_eq!(protos.textualize().len(), 200_001);\n   753\t    drop(protos);\n   754\t    drop(datom);\n   755\t}\n   756\t\n   757\t#[test]\n   758\tfn composition_depth_is_bounded_independently_from_node_budget() {\n   759\t    let mut datom = Datom {\n   760\t        path: vec![],\n   761\t        form: Form::Bare(\"Pending\".into()),\n   762\t    };\n   763\t    for _ in 0..128 {\n   764\t        datom = Datom {\n   765\t            path: vec![],\n   766\t            form: Form::Variant(protos::Symbol(\"Next\".into()), Box::new(datom)),\n   767\t        };\n   768\t    }\n   769\t    let error = datom\n   770\t        .compose::<Recursive>(&mut Budget {\n   771\t            remaining: 1_000_000,\n   772\t            reader: ReaderBudget {\n   773\t                remaining: 1_000_000,\n   774\t            },\n   775\t            depth: 0,\n   776\t            maximum_depth: 32,\n   777\t        })\n   778\t        .unwrap_err();\n   779\t    assert_eq!(error.kind, ErrorKind::Budget);\n   780\t}\n   781\t\n   782\t#[derive(Debug, PartialEq)]\n   783\tstruct Recursive(usize);\n   784\timpl Compositional for Recursive {\n   785\t    const ARITY: i64 = 0;\n   786\t    fn from_positions(_: datom_codec::Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   787\t        unreachable!()\n   788\t    }\n   789\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   790\t        use datom_codec::{Composable, Variantizing};\n   791\t        if matches!(&datom.form, Form::Bare(name) if name == \"Pending\") {\n   792\t            return Ok(Self(0));\n   793\t        }\n   794\t        let (head, body) = datom.variant(budget, \"Recursive\")?;\n   795\t        if head != \"Next\" {\n   796\t            return Err(datom_codec::Error::composition(\n   797\t                datom.path.clone(),\n   798\t                ErrorKind::Variant {\n   799\t                    expected: \"Recursive\".into(),\n   800\t                    found: head.into(),\n   801\t                },\n   802\t            ));\n   803\t        }\n   804\t        Ok(Self(body.compose::<Recursive>(budget)?.0 + 1))\n   805\t    }\n   806\t}\n   807\t\n   808\t#[test]\n   809\tfn wide_projection_keeps_canonical_extents() {\n   810\t    let datom = Datom {\n   811\t        path: vec![],\n   812\t        form: Form::Struct(\n   813\t            (0..10_000)\n   814\t                .map(|index| Datom {\n   815\t                    path: vec![index],\n   816\t                    form: Form::Bare(\"x\".into()),\n   817\t                })\n   818\t                .collect(),\n   819\t        ),\n   820\t    };\n   821\t    let protos = datom.protosize();\n   822\t    assert_eq!(protos.textualize().len(), 20_003);\n   823\t    assert_eq!(\n   824\t        protos.extent(),\n   825\t        protos::Extent {\n   826\t            start: 0,\n   827\t            end: 20_003\n   828\t        }\n   829\t    );\n   830\t}\n   831\t\n   832\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n   833\tenum RecursiveNode<T> {\n   834\t    Leaf(T),\n   835\t    Next(Box<RecursiveNode<T>>),\n   836\t}\n   837\t\n   838\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n   839\tstruct Chain {\n   840\t    string: String,\n   841\t    chain_option: Option<Box<Chain>>,\n   842\t}\n   843\t\n   844\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n   845\tstruct GenericChain<T> {\n   846\t    value: T,\n   847\t    next: Option<Box<GenericChain<T>>>,\n   848\t}\n   849\t\n   850\t#[test]\n   851\tfn recursive_struct_derives_without_a_self_bound_cycle() {\n   852\t    let value = Chain {\n   853\t        string: \"root\".into(),\n   854\t        chain_option: Some(Box::new(Chain {\n   855\t            string: \"tail\".into(),\n   856\t            chain_option: None,\n   857\t        })),\n   858\t    };\n   859\t    let datom = value.datomize(vec![]);\n   860\t    let rebuilt: Chain = datom\n   861\t        .compose(&mut Budget {\n   862\t            remaining: 100,\n   863\t            reader: ReaderBudget { remaining: 128 },\n   864\t            depth: 0,\n   865\t            maximum_depth: 128,\n   866\t        })\n   867\t        .unwrap();\n   868\t    assert_eq!(rebuilt, value);\n   869\t\n   870\t    let generic = GenericChain {\n   871\t        value: 7_i64,\n   872\t        next: Some(Box::new(GenericChain {\n   873\t            value: 8,\n   874\t            next: None,\n   875\t        })),\n   876\t    };\n   877\t    let datom = generic.datomize(vec![]);\n   878\t    let rebuilt: GenericChain<i64> = datom\n   879\t        .compose(&mut Budget {\n   880\t            remaining: 100,\n   881\t            reader: ReaderBudget { remaining: 128 },\n   882\t            depth: 0,\n   883\t            maximum_depth: 128,\n   884\t        })\n   885\t        .unwrap();\n   886\t    assert_eq!(rebuilt, generic);\n   887\t}\n   888\t\n   889\t#[test]\n   890\tfn recursive_generic_enum_derives_without_a_self_bound_cycle() {\n   891\t    let value = RecursiveNode::Next(Box::new(RecursiveNode::Leaf(7_i64)));\n   892\t    let datom = value.datomize(vec![]);\n   893\t    let rebuilt: RecursiveNode<i64> = datom\n   894\t        .compose(&mut Budget {\n   895\t            remaining: 100,\n   896\t            reader: ReaderBudget { remaining: 128 },\n   897\t            depth: 0,\n   898\t            maximum_depth: 128,\n   899\t        })\n   900\t        .unwrap();\n   901\t    assert_eq!(rebuilt, value);\n   902\t}\n   903\t\n   904\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n   905\tstruct NodeData<T>(T);\n   906\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n   907\tenum Node<T> {\n   908\t    Data(NodeData<T>),\n   909\t    Next(Box<Node<T>>),\n   910\t}\n   911\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n   912\tenum MutualA<T> {\n   913\t    End,\n   914\t    Next(Box<MutualB<T>>),\n   915\t}\n   916\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n   917\tenum MutualB<T> {\n   918\t    Next(Box<MutualA<T>>),\n   919\t    Data(T),\n   920\t}\n   921\t\n   922\t#[test]\n   923\tfn exact_self_detection_bounds_similarly_named_wrappers_without_cycles() {\n   924\t    let value = Node::Data(NodeData(7_i64));\n   925\t    let datom = value.datomize(vec![]);\n   926\t    let rebuilt: Node<i64> = datom\n   927\t        .compose(&mut Budget {\n   928\t            remaining: 100,\n   929\t            reader: ReaderBudget { remaining: 128 },\n   930\t            depth: 0,\n   931\t            maximum_depth: 128,\n   932\t        })\n   933\t        .unwrap();\n   934\t    assert_eq!(rebuilt, value);\n   935\t    let mutual = MutualA::Next(Box::new(MutualB::Data(8_i64)));\n   936\t    let datom = mutual.datomize(vec![]);\n   937\t    let rebuilt: MutualA<i64> = datom\n   938\t        .compose(&mut Budget {\n   939\t            remaining: 100,\n   940\t            reader: ReaderBudget { remaining: 128 },\n   941\t            depth: 0,\n   942\t            maximum_depth: 128,\n   943\t        })\n   944\t        .unwrap();\n   945\t    assert_eq!(rebuilt, mutual);\n   946\t}\n   947\t\n   948\t#[test]\n   949\tfn manually_built_hundred_thousand_deep_protos_refuses_or_forms_without_recursion() {\n   950\t    let mut protos = protos::Protos::Bare {\n   951\t        extent: protos::Extent { start: 0, end: 1 },\n   952\t        text: \"x\".into(),\n   953\t    };\n   954\t    for index in 0..100_000 {\n   955\t        protos = protos::Protos::Headed {\n   956\t            extent: protos::Extent {\n   957\t                start: 0,\n   958\t                end: index + 3,\n   959\t            },\n   960\t            head: protos::Symbol(\"V\".into()),\n   961\t            constraints: None,\n   962\t            separator: protos::Separator::Period,\n   963\t            body: Box::new(protos),\n   964\t        };\n   965\t    }\n   966\t    let error = protos\n   967\t        .datomize(vec![])\n   968\t        .expect_err(\"manual headed tree reaches the typed depth refusal\");\n   969\t    assert_eq!(error.kind, ErrorKind::Budget);\n   970\t    drop(protos);\n   971\t}\n     1\t[package]\n     2\tname        = \"datom-codec\"\n     3\tversion     = \"0.25.6\"\n     4\tedition     = \"2024\"\n     5\trust-version = \"1.85\"\n     6\tlicense     = \"MIT OR Apache-2.0\"\n     7\trepository  = \"https://github.com/LiGoldragon/datom-codec\"\n     8\tdescription = \"Datomic: positional typed data over Protos.\"\n     9\tpublish     = false\n    10\t\n    11\t[workspace]\n    12\tmembers = [\"crates/datom-codec-derive\"]\n    13\t\n    14\t[dependencies]\n    15\tprotos = { git = \"https://github.com/LiGoldragon/protos\", rev = \"b543678cfc8609529cea7174eb4af8a64daa54ad\" }\n    16\tderive = { package = \"datom-codec-derive\", path = \"crates/datom-codec-derive\" }\n    17\t\n    18\t[dev-dependencies]\n    19\tproptest = \"1.6\"\n    20\t\n    21\t[lib]\n    22\tname = \"datom_codec\"\n    23\tpath = \"src/lib.rs\"\n    24\t\n    25\t[lints.rust]\n    26\tunsafe_code = \"forbid\"\n    27\tunused      = { level = \"warn\", priority = -1 }\n    28\tdead_code   = \"warn\"\n     1\t{\n     2\t  description = \"datom-codec — positional typed data over Protos\";\n     3\t\n     4\t  inputs = {\n     5\t    nixpkgs.url = \"github:NixOS/nixpkgs/nixpkgs-unstable\";\n     6\t    flake-utils.url = \"github:numtide/flake-utils\";\n     7\t    rust-build = {\n     8\t      url = \"github:LiGoldragon/rust-build\";\n     9\t      inputs.nixpkgs.follows = \"nixpkgs\";\n    10\t    };\n    11\t    ethos-zero = {\n    12\t      url = \"github:LiGoldragon/ethos-zero/daf007296a19ad2f9c8a1e67e102b2e3f09db327\";\n    13\t    };\n    14\t  };\n    15\t\n    16\t  outputs = { self, nixpkgs, flake-utils, rust-build, ethos-zero }:\n    17\t    flake-utils.lib.eachDefaultSystem (system:\n    18\t      let\n    19\t        pkgs = import nixpkgs { inherit system; };\n    20\t        rust = rust-build.lib.${system}.fromPkgs pkgs;\n    21\t        inherit (rust) craneLib toolchain;\n    22\t        src = rust.cleanSource {\n    23\t          root = ./.;\n    24\t        };\n    25\t        commonArguments = { inherit src; strictDeps = true; };\n    26\t        cargoArtifacts = craneLib.buildDepsOnly commonArguments;\n    27\t      in\n    28\t      {\n    29\t        packages.default = craneLib.buildPackage (commonArguments // { inherit cargoArtifacts; });\n    30\t        checks = {\n    31\t          build = craneLib.cargoBuild (commonArguments // { inherit cargoArtifacts; });\n    32\t          test = craneLib.cargoTest (commonArguments // { inherit cargoArtifacts; });\n    33\t          no-production-free-functions = pkgs.runCommand \"datom-codec-no-production-free-functions\" { } ''\n    34\t            if grep -R -n -E '^(pub(\\([^)]*\\))? )?fn ' ${src}/src; then\n    35\t              echo \"production Rust must not use module-level free functions\" >&2\n    36\t              exit 1\n    37\t            fi\n    38\t            touch $out\n    39\t          '';\n    40\t          no-production-inherent-methods = pkgs.runCommand \"datom-codec-no-production-inherent-methods\" { } ''\n    41\t            if grep -R -n -E '^[[:space:]]*impl[[:space:]]+[[:alpha:]_][[:alnum:]_:<>]*[[:space:]]*\\{' ${src}/src; then\n    42\t              echo \"production Rust must home behavior in traits\" >&2\n    43\t              exit 1\n    44\t            fi\n    45\t            touch $out\n    46\t          '';\n    47\t          no-zst-behavior = pkgs.runCommand \"datom-codec-no-zst-behavior\" { } ''\n    48\t            if grep -R -n -E '^[[:space:]]*(pub[[:space:]]+)?struct[[:space:]]+[[:alpha:]_][[:alnum:]_]*[[:space:]]*;' ${src}/src; then\n    49\t              echo \"behavioral Rust nouns must carry data\" >&2\n    50\t              exit 1\n    51\t            fi\n    52\t            touch $out\n    53\t          '';\n    54\t          no-forbidden-vocabulary = pkgs.runCommand \"datom-codec-no-forbidden-vocabulary\" { } ''\n    55\t            if grep -R -n -i -E 'encode|decode|codec|transcode' ${src}/src; then\n    56\t              echo \"Datomic names must use the ruled form vocabulary\" >&2\n    57\t              exit 1\n    58\t            fi\n    59\t            touch $out\n    60\t          '';\n    61\t          generated-contract = pkgs.runCommand \"datom-codec-generated-contract\" {\n    62\t            generator = ethos-zero.packages.${system}.default;\n    63\t            declaration = ./datom-codec.ethos;\n    64\t            committed = ./generated-contract/datom-codec.rs;\n    65\t          } (builtins.readFile ./checks/generated-contract.sh);\n    66\t          doc = craneLib.cargoDoc (commonArguments // {\n    67\t            inherit cargoArtifacts;\n    68\t            RUSTDOCFLAGS = \"-D warnings\";\n    69\t          });\n    70\t          fmt = craneLib.cargoFmt { inherit src; };\n    71\t          clippy = craneLib.cargoClippy (commonArguments // {\n    72\t            inherit cargoArtifacts;\n    73\t            cargoClippyExtraArgs = \"--all-targets -- -D warnings\";\n    74\t          });\n    75\t        };\n    76\t        devShells.default = pkgs.mkShell {\n    77\t          name = \"datom-codec\";\n    78\t          packages = [ pkgs.jujutsu toolchain ];\n    79\t        };\n    80\t      });\n    81\t}\n     1\t; Datom's public conceptual data anatomy. This declaration covers the\n     2\t; serializable conceptual surface, not every operational or borrowed Rust\n     3\t; helper. Meaning is represented as its one opaque String position; Rust's\n     4\t; tuple wrapper is not a distinct Ethos declaration form. Error is omitted:\n     5\t; its unit Datom layer collides with the defined Datom type under Ethos's\n     6\t; named-type-variant rule, so a declaration would falsely give that unit data.\n     7\tLibrary\n     8\t[ protos:[ Extent Protos ReaderBudget Separator Symbol ] ]\n     9\t[ Path.Vector<Integer>\n    10\t  Opaque.String\n    11\t  Meaning.String\n    12\t  FormVariant.{ Symbol Datom }\n    13\t  Datom.{ Path Form }\n    14\t  Form.[ Struct.Vector<Datom>\n    15\t         Vector.Vector<Datom>\n    16\t         Variant.FormVariant\n    17\t         Bare.String\n    18\t         String.String\n    19\t         Meaning.Opaque ]\n    20\t  Budget.{ Integer ReaderBudget Integer Integer }\n    21\t  ]\n    22\t[ Datomizable.{ [] [ Output ] [] [ datomize.{ [ Path ] [ Output ] } ] }\n    23\t  Compositional.{ [] [ ARITY ] [] [] }\n    24\t  Composable.[] ]\n    25\t[]\n     1\t; Datom's representable public conversion kinds. Borrowed reader handles and\n     2\t; operational helper kinds remain Rust implementation surface until Ethos has\n     3\t; declarations for their references and unit-yield capabilities.\n     4\tLibrary\n     5\t[ crate:[ Datom Budget Error Form Path Positions Potential ] ]\n     6\t[]\n     7\t[ DatomForming.[ datom_form.{ [ Path ] [ Result<Datom Error> ] } ]\n     8\t  Datomizable.{ [] [ Output ] [] [ datomize.{ [ Path ] [ Output ] } ] }\n     9\t  Compositional.{ [] [ ARITY ] [] [ from_positions:{ [ Positions Budget ] [ Result<Self Error> ] } ] }\n    10\t  Composable.[ compose.{ [ Budget ] [ Result<Self Error> ] } ]\n    11\t  Actualizing.[ actualize!{ [ Budget ] [ Result<Self Error> ] } ] ]\n    12\t[]\n     1\t#![allow(dead_code, non_camel_case_types, non_snake_case)]\n     2\tpub type Path = std::vec::Vec<i64>;\n     3\tpub type Opaque = String;\n     4\tpub type Meaning = String;\n     5\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n     6\tpub struct FormVariant {\n     7\t    pub symbol: protos::Symbol,\n     8\t    pub datom: std::boxed::Box<Datom>,\n     9\t}\n    10\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    11\tpub struct Datom {\n    12\t    pub path: Path,\n    13\t    pub form: std::boxed::Box<Form>,\n    14\t}\n    15\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    16\tpub enum Form {\n    17\t    Struct(std::vec::Vec<Datom>),\n    18\t    Vector(std::vec::Vec<Datom>),\n    19\t    Variant(std::boxed::Box<FormVariant>),\n    20\t    Bare(String),\n    21\t    String(String),\n    22\t    Meaning(Opaque),\n    23\t}\n    24\t#[derive(datom_codec::Datomizable, datom_codec::Compositional)]\n    25\tpub struct Budget {\n    26\t    pub first_integer: i64,\n    27\t    pub reader_budget: protos::ReaderBudget,\n    28\t    pub second_integer: i64,\n    29\t    pub third_integer: i64,\n    30\t}\n    31\tpub trait Datomizable {\n    32\t    type Output;\n    33\t    fn datomize(&self, input: Path) -> Self::Output;\n    34\t}\n    35\tpub trait Compositional {\n    36\t    type ARITY;\n    37\t}\n    38\tpub trait Composable {}\n     1\t#![allow(dead_code)]\n     2\tpub trait Datomic: Sized + protos::Conceivable<\n     3\t        crate::Datom,\n     4\t    > + protos::Textualizable<crate::Datom> {\n     5\t    fn incorporate(input: crate::Site) -> Result<Self, crate::Fault>;\n     6\t}\n     7\tpub trait Worded: Sized {\n     8\t    const EXPECTED: crate::Expected;\n     9\t    fn to_word(&self) -> std::string::String;\n    10\t    fn incorporate_word(input: crate::Site) -> Result<Self, crate::Fault>;\n    11\t    fn conceive_word(&self) -> crate::Datom;\n    12\t}\n    13\tpub trait Sited {\n    14\t    fn positions(\n    15\t        &self,\n    16\t        input: protos::Integer,\n    17\t    ) -> Result<crate::Positions, crate::Fault>;\n    18\t    fn elements(&self) -> Result<crate::Positions, crate::Fault>;\n    19\t    fn variant(&self) -> Result<crate::Variant, crate::Fault>;\n    20\t    fn text(&self) -> Result<protos::Text, crate::Fault>;\n    21\t    fn found(&self) -> crate::Found;\n    22\t    fn refuse(&self, input: crate::Problem) -> crate::Fault;\n    23\t}\n    24\tpub trait Positional<A: Datomic> {\n    25\t    fn position(&mut self) -> Result<A, crate::Fault>;\n    26\t}\n    27\tpub trait Counted {\n    28\t    fn remaining(&self) -> protos::Integer;\n    29\t}\n    30\tpub trait Carrying<A: Datomic> {\n    31\t    fn body(&self) -> Result<A, crate::Fault>;\n    32\t}\n    33\tpub trait Headed: Sized {\n    34\t    fn positions(\n    35\t        &self,\n    36\t        input: protos::Integer,\n    37\t    ) -> Result<crate::Positions, crate::Fault>;\n    38\t    fn nothing(&self) -> Result<Self, crate::Fault>;\n    39\t    fn reject(&self, input: crate::Problem) -> crate::Fault;\n    40\t}\n     1\tset -eu\n     2\t\n     3\ttemporary=\"$(mktemp -d)\"\n     4\tcleanup() {\n     5\t  rm -rf \"$temporary\"\n     6\t}\n     7\ttrap cleanup EXIT\n     8\t\n     9\tname=\"$(basename \"$declaration\" .ethos)\"\n    10\t\"$generator/bin/ethos-zero\" \"Generate.{ «$declaration» «$temporary» }\"\n    11\tcmp \"$temporary/$name.rs\" \"$committed\"\n    12\ttouch \"$out\"\n","exit_code":0,"status":"completed"}}
