       }\n   829\t        };\n   830\t        if value.starts_with(\"-0\") || (value.len() > 1 && value.starts_with('0')) {\n   831\t            return Err(Error {\n   832\t                layer: ErrorLayer::Composition,\n   833\t                path: datom.path.clone(),\n   834\t                kind: ErrorKind::Value {\n   835\t                    expected: \"Integer\".into(),\n   836\t                    value: value.clone(),\n   837\t                },\n   838\t            });\n   839\t        }\n   840\t        i64::from_str(value).map_err(|_| Error {\n   841\t            layer: ErrorLayer::Composition,\n   842\t            path: datom.path.clone(),\n   843\t            kind: ErrorKind::Value {\n   844\t                expected: \"Integer\".into(),\n   845\t                value: value.clone(),\n   846\t            },\n   847\t        })\n   848\t    }\n   849\t}\n   850\timpl Scalar for bool {\n   851\t    fn scalar(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   852\t        budget.spend(&datom.path)?;\n   853\t        match &datom.form {\n   854\t            Form::Bare(value) if value == \"True\" => Ok(true),\n   855\t            Form::Bare(value) if value == \"False\" => Ok(false),\n   856\t            Form::Bare(value) => Err(Error {\n   857\t                layer: ErrorLayer::Composition,\n   858\t                path: datom.path.clone(),\n   859\t                kind: ErrorKind::Value {\n   860\t                    expected: \"Boolean\".into(),\n   861\t                    value: value.clone(),\n   862\t                },\n   863\t            }),\n   864\t            found => Err(Error {\n   865\t                layer: ErrorLayer::Composition,\n   866\t                path: datom.path.clone(),\n   867\t                kind: ErrorKind::Form {\n   868\t                    expected: \"Bare\".into(),\n   869\t                    found: found.form_name().to_owned(),\n   870\t                },\n   871\t            }),\n   872\t        }\n   873\t    }\n   874\t}\n   875\timpl Scalar for f64 {\n   876\t    fn scalar(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   877\t        budget.spend(&datom.path)?;\n   878\t        let value = match &datom.form {\n   879\t            Form::Bare(value) if value.contains('.') => value,\n   880\t            Form::Bare(value) => {\n   881\t                return Err(Error {\n   882\t                    layer: ErrorLayer::Composition,\n   883\t                    path: datom.path.clone(),\n   884\t                    kind: ErrorKind::Value {\n   885\t                        expected: \"Decimal\".into(),\n   886\t                        value: value.clone(),\n   887\t                    },\n   888\t                });\n   889\t            }\n   890\t            found => {\n   891\t                return Err(Error {\n   892\t                    layer: ErrorLayer::Composition,\n   893\t                    path: datom.path.clone(),\n   894\t                    kind: ErrorKind::Form {\n   895\t                        expected: \"Bare\".into(),\n   896\t                        found: found.form_name().to_owned(),\n   897\t                    },\n   898\t                });\n   899\t            }\n   900\t        };\n   901\t        value\n   902\t            .parse::<f64>()\n   903\t            .ok()\n   904\t            .filter(|value| value.is_finite())\n   905\t            .ok_or_else(|| Error {\n   906\t                layer: ErrorLayer::Composition,\n   907\t                path: datom.path.clone(),\n   908\t                kind: ErrorKind::Value {\n   909\t                    expected: \"Decimal\".into(),\n   910\t                    value: value.clone(),\n   911\t                },\n   912\t            })\n   913\t    }\n   914\t}\n   130\t                maximum_depth: 4_096\n   131\t            })\n   132\t            .unwrap(),\n   133\t        value\n   134\t    );\n   135\t    let pending = Reply::Pending.datomize(vec![]);\n   136\t    assert_eq!(\n   137\t        pending\n   138\t            .compose::<Reply>(&mut Budget {\n   139\t                remaining: 10,\n   140\t                reader: ReaderBudget { remaining: 10 },\n   141\t                depth: 0,\n   142\t                maximum_depth: 4_096\n   143\t            })\n   144\t            .unwrap(),\n   145\t        Reply::Pending\n   146\t    );\n   147\t    assert_eq!(pending.protosize().textualize(), \"Pending\");\n   148\t    assert_eq!(\n   149\t        Potential::<Reply>::from(\"Pending\")\n   150\t            .actualize(&mut Budget {\n   151\t                remaining: 1,\n   152\t                reader: ReaderBudget { remaining: 128 },\n   153\t                depth: 0,\n   154\t                maximum_depth: 4_096\n   155\t            })\n   156\t            .unwrap(),\n   157\t        Reply::Pending\n   158\t    );\n   159\t}\n   160\t\n   161\t#[test]\n   162\tfn scalar_writers_preserve_their_textual_kind() {\n   163\t    assert_eq!(3.0_f64.datomize(vec![]).protosize().textualize(), \"3.0\");\n   164\t    assert_eq!((-0.0_f64).datomize(vec![]).protosize().textualize(), \"-0.0\");\n   165\t    assert_eq!(\n   166\t        \"a{b\".to_owned().datomize(vec![]).protosize().textualize(),\n   167\t        \"«a{b»\"\n   168\t    );\n   169\t    assert!(\n   170\t        i64::scalar(\n   171\t            &Datom {\n   172\t                path: vec![],\n   173\t                form: Form::Bare(\"-01\".into())\n   174\t            },\n   175\t            &mut Budget {\n   176\t                remaining: 1,\n   177\t                reader: ReaderBudget { remaining: 1 },\n   178\t                depth: 0,\n   179\t                maximum_depth: 4_096\n   180\t            }\n   181\t        )\n   182\t        .is_err()\n   183\t    );\n   184\t}\n   185\t\n   186\t#[test]\n   187\tfn qualified_heads_refuse_at_the_variant_path() {\n   188\t    let mut potential = Potential::<Reply>::from(\"Accepted<String>.42\");\n   590\tfn strings_quote_delimiters_keep_bare_separators_and_accept_temporary_meaning_text() {\n   591\t    for value in [\"a{b\", \"a;b\", \"a(b\"] {\n   592\t        let text = value.to_owned().datomize(vec![]).protosize().textualize();\n   593\t        assert!(text.starts_with('«'), \"{value}: {text}\");\n   594\t        assert_eq!(\n   595\t            Potential::<String>::from(text)\n   596\t                .actualize(&mut Budget {\n   597\t                    remaining: 1,\n   598\t                    reader: ReaderBudget { remaining: 128 },\n   599\t                    depth: 0,\n   600\t                    maximum_depth: 4_096\n   601\t                })\n   602\t                .unwrap(),\n   603\t            value\n   604\t        );\n   605\t    }\n   606\t    for value in [\"a.b\", \"a!b\", \"a:b\"] {\n   607\t        let text = value.to_owned().datomize(vec![]).protosize().textualize();\n   608\t        assert_eq!(text, value);\n   609\t        assert_eq!(\n   610\t            Potential::<String>::from(text)\n   611\t                .actualize(&mut Budget {\n   612\t                    remaining: 8,\n   613\t                    reader: ReaderBudget { remaining: 128 },\n   614\t                    depth: 0,\n   615\t                    maximum_depth: 8,\n   616\t                })\n   617\t                .unwrap(),\n   618\t            value\n   619\t        );\n   620\t    }\n   621\t    assert_eq!(\n   622\t        Potential::<String>::from(\"(temporary meaning)\")\n   623\t            .actualize(&mut Budget {\n   624\t                remaining: 1,\n   625\t                reader: ReaderBudget { remaining: 128 },\n   626\t                depth: 0,\n   627\t                maximum_depth: 4_096\n   628\t            })\n   629\t            .unwrap(),\n   630\t        \"temporary meaning\"\n   631\t    );\n   632\t}\n   633\t\n   634\t#[test]\n   635\tfn retained_reader_finds_nested_composition_fault_extents() {\n   636\t    let mut vector = Potential::<Vec<i64>>::from(\"[ 1 x ]\");\n   637\t    let error = vector\n   638\t        .actualize(&mut Budget {\n   639\t            remaining: 10,\n   640\t            reader: ReaderBudget { remaining: 128 },\n   641\t            depth: 0,\n   642\t            maximum_depth: 4_096,\n   643\t        })\n   644\t        .unwrap_err();\n   645\t    assert_eq!(error.path, vec![1]);\n   646\t    assert_eq!(\n   647\t        vector.reader_extent(&error.path),\n   648\t        Some(protos::Extent { start: 4, end: 5 })\n   649\t    );\n   650\t\n   651\t    let mut variant = Potential::<Pair>::from(\"Values.{ 1 x }\");\n   652\t    let error = variant\n   653\t        .actualize(&mut Budget {\n   654\t            remaining: 10,\n   655\t            reader: ReaderBudget { remaining: 128 },\n   656\t            depth: 0,\n   657\t            maximum_depth: 4_096,\n   658\t        })\n   659\t        .unwrap_err();\n   660\t    assert_eq!(error.path, vec![1, 1]);\n   661\t    assert_eq!(\n   662\t        variant.reader_extent(&error.path),\n   663\t        Some(protos::Extent { start: 11, end: 12 })\n   664\t    );\n   665\t}\n   666\t\n   667\t#[test]\n   668\tfn typed_protos_errors_round_trip_without_a_reader_tree() {\n   669\t    let error = protos::Error {\n   670\t        extent: protos::Extent { start: 3, end: 4 },\n   414\t/// Text that may actualize into `T` after structural reading and datomic composition.\n   415\tpub struct Potential<T> {\n   416\t    text: String,\n   417\t    reader: Option<protos::Protos>,\n   418\t    marker: PhantomData<fn() -> T>,\n   419\t}\n   420\timpl<T> From<&str> for Potential<T> {\n   421\t    fn from(text: &str) -> Self {\n   422\t        Self {\n   423\t            text: text.to_owned(),\n   424\t            reader: None,\n   425\t            marker: PhantomData,\n   426\t        }\n   427\t    }\n   428\t}\n   429\timpl<T> From<String> for Potential<T> {\n   430\t    fn from(text: String) -> Self {\n   431\t        Self {\n   432\t            text,\n   433\t            reader: None,\n   434\t            marker: PhantomData,\n   435\t        }\n   436\t    }\n   437\t}\n   438\tpub trait Actualizing<T> {\n   439\t    fn actualize(&mut self, budget: &mut Budget) -> Result<T, Error>;\n   440\t}\n   441\tpub trait PotentialExtenting {\n   442\t    fn reader_extent(&self, path: &Path) -> Option<protos::Extent>;\n   443\t}\n   444\timpl<T> PotentialExtenting for Potential<T> {\n   445\t    fn reader_extent(&self, path: &Path) -> Option<protos::Extent> {\n   446\t        self.reader.as_ref()?.at(path).map(ProtosExtenting::extent)\n   447\t    }\n   448\t}\n   449\timpl<T: Compositional> Actualizing<T> for Potential<T> {\n   450\t    fn actualize(&mut self, budget: &mut Budget) -> Result<T, Error> {\n   451\t        use protos::BoundedProtosizable;\n   452\t        let protos = self\n   453\t            .text\n   454\t            .protosize_with(&mut budget.reader)\n   455\t            .map_err(|error| Error {\n   456\t                layer: ErrorLayer::Protos,\n   457\t                path: Path::new(),\n   458\t                kind: ErrorKind::Structural(error),\n   459\t            })?;\n   460\t        self.reader = Some(protos.clone());\n   461\t        let datom = protos.datomize(Path::new())?;\n   462\t        datom.compose(budget)\n   463\t    }\n   464\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/run/current-system/sw/bin/zsh -lc \"nl -ba src/canonicalization.rs; nl -ba src/actualization.rs; nl -ba src/protosization.rs | sed -n '1,380p'; nl -ba src/conception.rs | sed -n '1,220p'; nl -ba src/conception.rs | sed -n '220,620p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/run/current-system/sw/bin/zsh -lc \"nl -ba src/canonicalization.rs; nl -ba src/actualization.rs; nl -ba src/protosization.rs | sed -n '1,380p'; nl -ba src/conception.rs | sed -n '1,220p'; nl -ba src/conception.rs | sed -n '220,620p'\"","aggregated_output":"     1\t//! Canonicalization: sweet Text to canonical Text (the mechanical conversion).\n     2\t//!\n     3\t//! An ethos file is written in the sweet form: the root's head, then the\n     4\t//! sections as siblings. The reader sees only the braced form. The\n     5\t//! conversion is mechanical and structural: the sweet text is\n     6\t//! delineated, and when its first structure is a bare head, `.{` is\n     7\t//! inserted right after it and a closing brace appended on its own\n     8\t//! line. A text already in the braced form is left as it is.\n     9\t\n    10\tuse protos::{Extent, Protos, Protosizable};\n    11\t\n    12\tuse crate::{Canonical, Canonicalizable, Resituating};\n    13\t\n    14\timpl Canonicalizable for String {\n    15\t    fn canonicalize(&self) -> Result<Canonical, protos::Error> {\n    16\t        let mut head_start = 0;\n    17\t        let mut offset = 0;\n    18\t        for line in self.split_inclusive('\\n') {\n    19\t            let trimmed = line.trim_start();\n    20\t            if !trimmed.is_empty() && !trimmed.starts_with(';') {\n    21\t                head_start = offset + (line.len() - trimmed.len());\n    22\t                break;\n    23\t            }\n    24\t            offset += line.len();\n    25\t        }\n    26\t        let head_end = head_start\n    27\t            + self[head_start..]\n    28\t                .find(char::is_whitespace)\n    29\t                .unwrap_or(self.len() - head_start);\n    30\t        if self[head_start..head_end]\n    31\t            .chars()\n    32\t            .all(|glyph| glyph.is_ascii_alphabetic())\n    33\t            && !self[head_end..].trim_start().starts_with(\".{\")\n    34\t        {\n    35\t            let mut text = String::with_capacity(self.len() + 4);\n    36\t            text.push_str(&self[..head_end]);\n    37\t            text.push_str(\".{\");\n    38\t            text.push_str(&self[head_end..]);\n    39\t            text.push_str(\"\\n}\");\n    40\t            return Ok(Canonical {\n    41\t                text,\n    42\t                seam: Extent {\n    43\t                    start: head_end,\n    44\t                    end: head_end + 2,\n    45\t                },\n    46\t            });\n    47\t        }\n    48\t        let protos = <str as Protosizable>::protosize(self)?;\n    49\t        if let Protos::Bare { extent, .. } = protos {\n    50\t            let end = extent.end;\n    51\t            let mut text = String::with_capacity(self.len() + 4);\n    52\t            text.push_str(&self[..end]);\n    53\t            text.push_str(\".{\");\n    54\t            text.push_str(&self[end..]);\n    55\t            text.push_str(\"\\n}\");\n    56\t            return Ok(Canonical {\n    57\t                text,\n    58\t                seam: Extent {\n    59\t                    start: end,\n    60\t                    end: end + 2,\n    61\t                },\n    62\t            });\n    63\t        }\n    64\t        Ok(Canonical {\n    65\t            text: self.clone(),\n    66\t            seam: Extent { start: 0, end: 0 },\n    67\t        })\n    68\t    }\n    69\t}\n    70\t\n    71\t/// The kind whose capability maps one position across the seam.\n    72\ttrait Shifting {\n    73\t    fn shift(&self, position: usize) -> usize;\n    74\t}\n    75\t\n    76\timpl Shifting for Canonical {\n    77\t    fn shift(&self, position: usize) -> usize {\n    78\t        let Extent { start, end } = self.seam;\n    79\t        let inserted = end - start;\n    80\t        let source_end = self.text.len() - 2 * inserted;\n    81\t        if position <= start {\n    82\t            position\n    83\t        } else if position < end {\n    84\t            start\n    85\t        } else {\n    86\t            (position - inserted).min(source_end)\n    87\t        }\n    88\t    }\n    89\t}\n    90\t\n    91\timpl Resituating for Canonical {\n    92\t    fn resituate(&self, extent: Extent) -> Extent {\n    93\t        Extent {\n    94\t            start: self.shift(extent.start),\n    95\t            end: self.shift(extent.end),\n    96\t        }\n    97\t    }\n    98\t}\n     1\t//! Actualization: textual Ethos to its one conceptual File.\n     2\t\n     3\tuse protos::Protosizable;\n     4\t\n     5\tuse crate::{\n     6\t    Actualizing, Canonicalizable, Error, Ethosizable, File, Potential, Resituating,\n     7\t    Structural_Error,\n     8\t};\n     9\t\n    10\timpl Actualizing<File> for Potential<File> {\n    11\t    type Error = Error;\n    12\t\n    13\t    fn actualize(&self) -> Result<File, Self::Error> {\n    14\t        let canonical = self.0.canonicalize().map_err(|error| {\n    15\t            Error::Structural(Structural_Error {\n    16\t                extent: error.extent,\n    17\t                problem: error.problem,\n    18\t            })\n    19\t        })?;\n    20\t        let protos = canonical.text.protosize().map_err(|error| {\n    21\t            Error::Structural(Structural_Error {\n    22\t                extent: canonical.resituate(error.extent),\n    23\t                problem: error.problem,\n    24\t            })\n    25\t        })?;\n    26\t        protos.ethosize()\n    27\t    }\n    28\t}\n     1\t//! Protosization: the infallible structural ascent of a checked Ethos file.\n     2\t\n     3\tuse protos::{Canonicalizable, Enclosure, Extent, Protos, Protosizable, Separator, Symbol};\n     4\t\n     5\tuse crate::{\n     6\t    AssociatedConstant, AssociatedType, Association, Capability, Constraint, File, Identity,\n     7\t    Import, Imported, KindBody, KindDeclaration, Library, Receiver, Reference, Sema, Signal,\n     8\t    Signature, TypeDeclaration, Variant,\n     9\t};\n    10\t\n    11\tpub(crate) trait Protosizing {\n    12\t    fn protos(&self) -> Protos;\n    13\t}\n    14\t\n    15\ttrait Structuring {\n    16\t    fn bare(&self) -> Protos;\n    17\t    fn enclosed(&self, enclosure: Enclosure, children: Vec<Protos>) -> Protos;\n    18\t    fn headed(&self, constraints: Option<Protos>, separator: Separator, body: Protos) -> Protos;\n    19\t}\n    20\t\n    21\timpl Structuring for str {\n    22\t    fn bare(&self) -> Protos {\n    23\t        Protos::Bare {\n    24\t            extent: Extent { start: 0, end: 0 },\n    25\t            text: self.to_owned(),\n    26\t        }\n    27\t    }\n    28\t    fn enclosed(&self, enclosure: Enclosure, children: Vec<Protos>) -> Protos {\n    29\t        Protos::Enclosed {\n    30\t            extent: Extent { start: 0, end: 0 },\n    31\t            enclosure,\n    32\t            children,\n    33\t        }\n    34\t    }\n    35\t    fn headed(&self, constraints: Option<Protos>, separator: Separator, body: Protos) -> Protos {\n    36\t        Protos::Headed {\n    37\t            extent: Extent { start: 0, end: 0 },\n    38\t            head: Symbol(self.to_owned()),\n    39\t            constraints: constraints.map(Box::new),\n    40\t            separator,\n    41\t            body: Box::new(body),\n    42\t        }\n    43\t    }\n    44\t}\n    45\t\n    46\ttrait ListProtosizing {\n    47\t    fn protos_list(&self) -> Vec<Protos>;\n    48\t}\n    49\timpl<T: Protosizing> ListProtosizing for [T] {\n    50\t    fn protos_list(&self) -> Vec<Protos> {\n    51\t        self.iter().map(Protosizing::protos).collect()\n    52\t    }\n    53\t}\n    54\t\n    55\ttrait ReferencesProtosizing {\n    56\t    fn reference_nodes(&self) -> Vec<Protos>;\n    57\t}\n    58\timpl ReferencesProtosizing for [Reference] {\n    59\t    fn reference_nodes(&self) -> Vec<Protos> {\n    60\t        let mut nodes = Vec::new();\n    61\t        for reference in self {\n    62\t            if reference.arguments.is_empty() {\n    63\t                nodes.push(reference.protos());\n    64\t            } else {\n    65\t                let base = match &reference.source {\n    66\t                    Some(source) => source.as_ref().headed(\n    67\t                        None,\n    68\t                        Separator::Colon,\n    69\t                        reference.name.as_ref().bare(),\n    70\t                    ),\n    71\t                    None => reference.name.as_ref().bare(),\n    72\t                };\n    73\t                nodes.push(base);\n    74\t                nodes.push(\"\".enclosed(Enclosure::Angled, reference.arguments.reference_nodes()));\n    75\t            }\n    76\t        }\n    77\t        nodes\n    78\t    }\n    79\t}\n    80\t\n    81\ttrait DeclarationsProtosizing {\n    82\t    fn declaration_nodes(&self) -> Vec<Protos>;\n    83\t}\n    84\t\n    85\t/// Associated types use the substrate's adjacent bare-plus-angle sequence:\n    86\t/// `Item<Serializable>`.  They are declarations only conceptually; emitting\n    87\t/// a headed `Item<...>.` invents a separator and cannot be read back.\n    88\ttrait AssociatedTypesProtosizing {\n    89\t    fn associated_type_nodes(&self) -> Vec<Protos>;\n    90\t}\n    91\timpl AssociatedTypesProtosizing for [AssociatedType] {\n    92\t    fn associated_type_nodes(&self) -> Vec<Protos> {\n    93\t        let mut nodes = Vec::new();\n    94\t        for associated in self {\n    95\t            nodes.push(associated.name.as_ref().bare());\n    96\t            if !associated.bounds.is_empty() {\n    97\t                nodes.push(\"\".enclosed(Enclosure::Angled, associated.bounds.protos_list()));\n    98\t            }\n    99\t        }\n   100\t        nodes\n   101\t    }\n   102\t}\n   103\timpl DeclarationsProtosizing for [TypeDeclaration] {\n   104\t    fn declaration_nodes(&self) -> Vec<Protos> {\n   105\t        let mut nodes = Vec::new();\n   106\t        for declaration in self {\n   107\t            match declaration {\n   108\t                TypeDeclaration::Alias(identity, reference) if !reference.arguments.is_empty() => {\n   109\t                    let body = match &reference.source {\n   110\t                        Some(source) => source.as_ref().headed(\n   111\t                            None,\n   112\t                            Separator::Colon,\n   113\t                            reference.name.as_ref().bare(),\n   114\t                        ),\n   115\t                        None => reference.name.as_ref().bare(),\n   116\t                    };\n   117\t                    nodes.push(identity.heading(Separator::Period, body));\n   118\t                    nodes.push(\n   119\t                        \"\".enclosed(Enclosure::Angled, reference.arguments.reference_nodes()),\n   120\t                    );\n   121\t                }\n   122\t                _ => nodes.push(declaration.protos()),\n   123\t            }\n   124\t        }\n   125\t        nodes\n   126\t    }\n   127\t}\n   128\t\n   129\timpl Protosizing for Reference {\n   130\t    fn protos(&self) -> Protos {\n   131\t        let base = self.name.as_ref().bare();\n   132\t        let applied = if self.arguments.is_empty() {\n   133\t            base\n   134\t        } else {\n   135\t            let arguments = \"\".enclosed(Enclosure::Angled, self.arguments.protos_list());\n   136\t            \"\".enclosed(Enclosure::Braced, vec![base, arguments])\n   137\t        };\n   138\t        match &self.source {\n   139\t            Some(source) => source.as_ref().headed(None, Separator::Colon, applied),\n   140\t            None => applied,\n   141\t        }\n   142\t    }\n   143\t}\n   144\t\n   145\timpl Protosizing for Constraint {\n   146\t    fn protos(&self) -> Protos {\n   147\t        match self {\n   148\t            Self::One(reference) => reference.protos(),\n   149\t            Self::Many(references) => \"\".enclosed(Enclosure::Bracketed, references.protos_list()),\n   150\t        }\n   151\t    }\n   152\t}\n   153\t\n   154\timpl Protosizing for Identity {\n   155\t    fn protos(&self) -> Protos {\n   156\t        let constraints = (!self.constraints.is_empty())\n   157\t            .then(|| \"\".enclosed(Enclosure::Angled, self.constraints.protos_list()));\n   158\t        self.name\n   159\t            .as_ref()\n   160\t            .headed(constraints, Separator::Period, \"\".bare())\n   161\t    }\n   162\t}\n   163\t\n   164\ttrait Heading {\n   165\t    fn heading(&self, separator: Separator, body: Protos) -> Protos;\n   166\t}\n   167\timpl Heading for Identity {\n   168\t    fn heading(&self, separator: Separator, body: Protos) -> Protos {\n   169\t        let constraints = (!self.constraints.is_empty())\n   170\t            .then(|| \"\".enclosed(Enclosure::Angled, self.constraints.protos_list()));\n   171\t        self.name.as_ref().headed(constraints, separator, body)\n   172\t    }\n   173\t}\n   174\t\n   175\timpl Protosizing for Imported {\n   176\t    fn protos(&self) -> Protos {\n   177\t        if self.name == self.emitted {\n   178\t            self.name.as_ref().bare()\n   179\t        } else {\n   180\t            self.name\n   181\t                .as_ref()\n   182\t                .headed(None, Separator::Period, self.emitted.as_ref().bare())\n   183\t        }\n   184\t    }\n   185\t}\n   186\timpl Protosizing for Import {\n   187\t    fn protos(&self) -> Protos {\n   188\t        match self {\n   189\t            Self::One(source, imported) => {\n   190\t                source\n   191\t                    .as_ref()\n   192\t                    .headed(None, Separator::Colon, imported.protos())\n   193\t            }\n   194\t            Self::Many(source, imported) => source.as_ref().headed(\n   195\t                None,\n   196\t                Separator::Colon,\n   197\t                \"\".enclosed(Enclosure::Bracketed, imported.protos_list()),\n   198\t            ),\n   199\t        }\n   200\t    }\n   201\t}\n   202\timpl Protosizing for TypeDeclaration {\n   203\t    fn protos(&self) -> Protos {\n   204\t        match self {\n   205\t            Self::Struct(identity, positions) => identity.heading(\n   206\t                Separator::Period,\n   207\t                \"\".enclosed(Enclosure::Braced, positions.reference_nodes()),\n   208\t            ),\n   209\t            Self::Enum(identity, variants) => identity.heading(\n   210\t                Separator::Period,\n   211\t                \"\".enclosed(Enclosure::Bracketed, variants.protos_list()),\n   212\t            ),\n   213\t            Self::Alias(identity, reference) => {\n   214\t                identity.heading(Separator::Period, reference.protos())\n   215\t            }\n   216\t        }\n   217\t    }\n   218\t}\n   219\timpl Protosizing for Variant {\n   220\t    fn protos(&self) -> Protos {\n   221\t        match self {\n   222\t            Self::Bare(name) => name.as_ref().bare(),\n   223\t            Self::Typed(name, reference) => {\n   224\t                name.as_ref()\n   225\t                    .headed(None, Separator::Period, reference.protos())\n   226\t            }\n   227\t            Self::Struct(name, positions) => name.as_ref().headed(\n   228\t                None,\n   229\t                Separator::Period,\n   230\t                \"\".enclosed(Enclosure::Braced, positions.reference_nodes()),\n   231\t            ),\n   232\t            Self::Enum(name, variants) => name.as_ref().headed(\n   233\t                None,\n   234\t                Separator::Period,\n   235\t                \"\".enclosed(Enclosure::Bracketed, variants.protos_list()),\n   236\t            ),\n   237\t        }\n   238\t    }\n   239\t}\n   240\timpl Protosizing for AssociatedConstant {\n   241\t    fn protos(&self) -> Protos {\n   242\t        self.name\n   243\t            .as_ref()\n   244\t            .headed(None, Separator::Period, self.ty.protos())\n   245\t    }\n   246\t}\n   247\timpl Protosizing for Capability {\n   248\t    fn protos(&self) -> Protos {\n   249\t        let separator = match self.receiver {\n   250\t            Receiver::Shared => Separator::Period,\n   251\t            Receiver::Mutable => Separator::Exclamation,\n   252\t            Receiver::Static => Separator::Colon,\n   253\t        };\n   254\t        let body = match &self.signature {\n   255\t            Signature::Yielding(yielding) => \"\".enclosed(\n   256\t                Enclosure::Bracketed,\n   257\t                std::slice::from_ref(yielding).reference_nodes(),\n   258\t            ),\n   259\t            Signature::Taking(inputs, yielding) => \"\".enclosed(\n   260\t                Enclosure::Braced,\n   261\t                vec![\n   262\t                    \"\".enclosed(Enclosure::Bracketed, inputs.reference_nodes()),\n   263\t                    \"\".enclosed(\n   264\t                        Enclosure::Bracketed,\n   265\t                        std::slice::from_ref(yielding).reference_nodes(),\n   266\t                    ),\n   267\t                ],\n   268\t            ),\n   269\t        };\n   270\t        self.name.as_ref().headed(None, separator, body)\n   271\t    }\n   272\t}\n   273\timpl Protosizing for KindDeclaration {\n   274\t    fn protos(&self) -> Protos {\n   275\t        let body = match &self.body {\n   276\t            KindBody::Simple(capabilities) => {\n   277\t                \"\".enclosed(Enclosure::Bracketed, capabilities.protos_list())\n   278\t            }\n   279\t            KindBody::Complex {\n   280\t                superkinds,\n   281\t                types,\n   282\t                constants,\n   283\t                capabilities,\n   284\t            } => \"\".enclosed(\n   285\t                Enclosure::Braced,\n   286\t                vec![\n   287\t                    \"\".enclosed(Enclosure::Bracketed, superkinds.protos_list()),\n   288\t                    \"\".enclosed(Enclosure::Bracketed, types.associated_type_nodes()),\n   289\t                    \"\".enclosed(Enclosure::Bracketed, constants.protos_list()),\n   290\t                    \"\".enclosed(Enclosure::Bracketed, capabilities.protos_list()),\n   291\t                ],\n   292\t            ),\n   293\t        };\n   294\t        self.identity.heading(Separator::Period, body)\n   295\t    }\n   296\t}\n   297\timpl Protosizing for Association {\n   298\t    fn protos(&self) -> Protos {\n   299\t        self.identity.heading(\n   300\t            Separator::Period,\n   301\t            \"\".enclosed(Enclosure::Bracketed, self.kinds.protos_list()),\n   302\t        )\n   303\t    }\n   304\t}\n   305\timpl Protosizing for Library {\n   306\t    fn protos(&self) -> Protos {\n   307\t        \"\".enclosed(\n   308\t            Enclosure::Braced,\n   309\t            vec![\n   310\t                \"\".enclosed(Enclosure::Bracketed, self.imports.protos_list()),\n   311\t                \"\".enclosed(Enclosure::Bracketed, self.types.declaration_nodes()),\n   312\t                \"\".enclosed(Enclosure::Bracketed, self.kinds.protos_list()),\n   313\t                \"\".enclosed(Enclosure::Bracketed, self.associations.protos_list()),\n   314\t            ],\n   315\t        )\n   316\t    }\n   317\t}\n   318\timpl Protosizing for Signal {\n   319\t    fn protos(&self) -> Protos {\n   320\t        \"\".enclosed(\n   321\t            Enclosure::Braced,\n   322\t            vec![\n   323\t                \"\".enclosed(Enclosure::Bracketed, self.imports.protos_list()),\n   324\t                \"\".enclosed(Enclosure::Bracketed, self.requests.protos_list()),\n   325\t                \"\".enclosed(Enclosure::Bracketed, self.responses.protos_list()),\n   326\t                \"\".enclosed(Enclosure::Bracketed, self.types.declaration_nodes()),\n   327\t            ],\n   328\t        )\n   329\t    }\n   330\t}\n   331\timpl Protosizing for Sema {\n   332\t    fn protos(&self) -> Protos {\n   333\t        \"\".enclosed(\n   334\t            Enclosure::Braced,\n   335\t            vec![\n   336\t                \"\".enclosed(Enclosure::Bracketed, self.imports.protos_list()),\n   337\t                \"\".enclosed(Enclosure::Bracketed, self.types.declaration_nodes()),\n   338\t            ],\n   339\t        )\n   340\t    }\n   341\t}\n   342\timpl Protosizing for File {\n   343\t    fn protos(&self) -> Protos {\n   344\t        let raw = match self {\n   345\t            Self::Library(library) => \"Library\".headed(None, Separator::Period, library.protos()),\n   346\t            Self::Signal(signal) => \"Signal\".headed(None, Separator::Period, signal.protos()),\n   347\t            Self::Sema(sema) => \"Sema\".headed(None, Separator::Period, sema.protos()),\n   348\t        };\n   349\t        // Shared Protos canonicalization assigns exact UTF-8 byte spans\n   350\t        // without routing a valid conceptual ascent through a finite reader.\n   351\t        let mut canonical = raw;\n   352\t        canonical.canonicalize();\n   353\t        canonical\n   354\t    }\n   355\t}\n   356\t\n   357\timpl Protosizable for File {\n   358\t    type Output = Protos;\n   359\t\n   360\t    fn protosize(&self) -> Self::Output {\n   361\t        self.protos()\n   362\t    }\n   363\t}\n     1\t//! Conception: structural Protos to Ethos concepts.\n     2\t\n     3\tuse datom_codec::Integer;\n     4\tuse protos::{Enclosure, Protos, Separator, Symbol};\n     5\t\n     6\tuse crate::{\n     7\t    ArityProblem, AssociatedConstant, AssociatedType, Association, Capability, ConceptualFaulting,\n     8\t    Constraint, Error, Ethosizable, File, Form, Identifiable, Identity, Import, Imported, KindBody,\n     9\t    KindDeclaration, Library, Name, Placing, Problem, Receiver, Reference, Root, Sema, Signal,\n    10\t    Signature, Source, TypeDeclaration, Variant,\n    11\t};\n    12\t\n    13\tpub(crate) trait Conceiving<C> {\n    14\t    fn conceive(&self) -> Result<C, Error>;\n    15\t}\n    16\timpl Ethosizable<File> for Protos {\n    17\t    type Error = Error;\n    18\t    fn ethosize(&self) -> Result<File, Self::Error> {\n    19\t        self.conceive()\n    20\t    }\n    21\t}\n    22\ttrait Children {\n    23\t    fn children(&self, enclosure: Enclosure) -> Option<&[Protos]>;\n    24\t}\n    25\timpl Children for Protos {\n    26\t    fn children(&self, enclosure: Enclosure) -> Option<&[Protos]> {\n    27\t        match self {\n    28\t            Protos::Enclosed {\n    29\t                enclosure: found,\n    30\t                children,\n    31\t                ..\n    32\t            } if *found == enclosure => Some(children),\n    33\t            _ => None,\n    34\t        }\n    35\t    }\n    36\t}\n    37\ttrait Naming {\n    38\t    fn name(&self) -> Result<Name, Error>;\n    39\t}\n    40\timpl Naming for Symbol {\n    41\t    fn name(&self) -> Result<Name, Error> {\n    42\t        Name::try_from(self.0.as_str())\n    43\t            .map_err(|text| Error::conceptual(vec![], Problem::Name(text)))\n    44\t    }\n    45\t}\n    46\timpl Naming for str {\n    47\t    fn name(&self) -> Result<Name, Error> {\n    48\t        Name::try_from(self).map_err(|text| Error::conceptual(vec![], Problem::Name(text)))\n    49\t    }\n    50\t}\n    51\ttrait Reading {\n    52\t    fn list<C>(children: &[Protos]) -> Result<Vec<C>, Error>\n    53\t    where\n    54\t        Protos: Conceiving<C>;\n    55\t}\n    56\timpl Reading for Protos {\n    57\t    fn list<C>(children: &[Protos]) -> Result<Vec<C>, Error>\n    58\t    where\n    59\t        Protos: Conceiving<C>,\n    60\t    {\n    61\t        let mut values = Vec::new();\n    62\t        for (index, child) in children.iter().enumerate() {\n    63\t            values.push(<Protos as Conceiving<C>>::conceive(child).place(index as Integer)?);\n    64\t        }\n    65\t        Ok(values)\n    66\t    }\n    67\t}\n    68\t\n    69\timpl Conceiving<File> for Protos {\n    70\t    fn conceive(&self) -> Result<File, Error> {\n    71\t        let Protos::Headed {\n    72\t            head,\n    73\t            constraints,\n    74\t            separator,\n    75\t            body,\n    76\t            ..\n    77\t        } = self\n    78\t        else {\n    79\t            return Err(Error::conceptual(vec![], Problem::Root));\n    80\t        };\n    81\t        if constraints.is_some() || *separator != Separator::Period {\n    82\t            return Err(Error::conceptual(vec![], Problem::Root));\n    83\t        };\n    84\t        match Root::identify(&head.0) {\n    85\t            Some(Root::Library) => Ok(File::Library(body.conceive()?)),\n    86\t            Some(Root::Signal) => Ok(File::Signal(body.conceive()?)),\n    87\t            Some(Root::Sema) => Ok(File::Sema(body.conceive()?)),\n    88\t            _ => Err(Error::conceptual(vec![], Problem::Root)),\n    89\t        }\n    90\t    }\n    91\t}\n    92\ttrait Sections {\n    93\t    fn sections(&self, count: usize) -> Result<&[Protos], Error>;\n    94\t}\n    95\timpl Sections for Protos {\n    96\t    fn sections(&self, count: usize) -> Result<&[Protos], Error> {\n    97\t        let Some(parts) = self.children(Enclosure::Braced) else {\n    98\t            return Err(Error::conceptual(vec![], Problem::Expected(Form::File)));\n    99\t        };\n   100\t        if parts.len() != count {\n   101\t            return Err(Error::conceptual(\n   102\t                vec![],\n   103\t                Problem::arity(count as Integer, parts.len() as Integer),\n   104\t            ));\n   105\t        };\n   106\t        Ok(parts)\n   107\t    }\n   108\t}\n   109\ttrait Brackets {\n   110\t    fn bracket<C>(&self) -> Result<Vec<C>, Error>\n   111\t    where\n   112\t        Protos: Conceiving<C>;\n   113\t}\n   114\timpl Brackets for Protos {\n   115\t    fn bracket<C>(&self) -> Result<Vec<C>, Error>\n   116\t    where\n   117\t        Protos: Conceiving<C>,\n   118\t    {\n   119\t        let Some(children) = self.children(Enclosure::Bracketed) else {\n   120\t            return Err(Error::conceptual(vec![], Problem::Expected(Form::Section)));\n   121\t        };\n   122\t        Protos::list(children)\n   123\t    }\n   124\t}\n   125\ttrait References {\n   126\t    fn references(&self) -> Result<Vec<Reference>, Error>;\n   127\t}\n   128\timpl References for [Protos] {\n   129\t    fn references(&self) -> Result<Vec<Reference>, Error> {\n   130\t        let mut values = Vec::new();\n   131\t        let mut index = 0;\n   132\t        while index < self.len() {\n   133\t            if let Protos::Bare { text, .. } = &self[index]\n   134\t                && let Some(Protos::Enclosed {\n   135\t                    enclosure: Enclosure::Angled,\n   136\t                    children,\n   137\t                    ..\n   138\t                }) = self.get(index + 1)\n   139\t            {\n   140\t                values.push(Reference {\n   141\t                    source: None,\n   142\t                    name: text.as_str().name().place(index as Integer)?,\n   143\t                    arguments: children.references().place((index + 1) as Integer)?,\n   144\t                });\n   145\t                index += 2;\n   146\t                continue;\n   147\t            }\n   148\t            values.push(self[index].conceive().place(index as Integer)?);\n   149\t            index += 1;\n   150\t        }\n   151\t        Ok(values)\n   152\t    }\n   153\t}\n   154\ttrait Declarations {\n   155\t    fn declarations(&self) -> Result<Vec<TypeDeclaration>, Error>;\n   156\t}\n   157\timpl Declarations for [Protos] {\n   158\t    fn declarations(&self) -> Result<Vec<TypeDeclaration>, Error> {\n   159\t        let mut values = Vec::new();\n   160\t        let mut index = 0;\n   161\t        while index < self.len() {\n   162\t            let mut declaration: TypeDeclaration =\n   163\t                self[index].conceive().place(index as Integer)?;\n   164\t            if let (\n   165\t                TypeDeclaration::Alias(_, reference),\n   166\t                Some(Protos::Enclosed {\n   167\t                    enclosure: Enclosure::Angled,\n   168\t                    children,\n   169\t                    ..\n   170\t                }),\n   171\t            ) = (&mut declaration, self.get(index + 1))\n   172\t            {\n   173\t                reference.arguments = children.references().place((index + 1) as Integer)?;\n   174\t                index += 1;\n   175\t            }\n   176\t            values.push(declaration);\n   177\t            index += 1;\n   178\t        }\n   179\t        Ok(values)\n   180\t    }\n   181\t}\n   182\ttrait Variants {\n   183\t    fn variants(&self) -> Result<Vec<Variant>, Error>;\n   184\t}\n   185\timpl Variants for [Protos] {\n   186\t    fn variants(&self) -> Result<Vec<Variant>, Error> {\n   187\t        let mut values = Vec::new();\n   188\t        let mut index = 0;\n   189\t        while index < self.len() {\n   190\t            let mut variant: Variant = self[index].conceive().place(index as Integer)?;\n   191\t            if let (\n   192\t                Variant::Typed(_, reference),\n   193\t                Some(Protos::Enclosed {\n   194\t                    enclosure: Enclosure::Angled,\n   195\t                    children,\n   196\t                    ..\n   197\t                }),\n   198\t            ) = (&mut variant, self.get(index + 1))\n   199\t            {\n   200\t                reference.arguments = children.references().place((index + 1) as Integer)?;\n   201\t                index += 1;\n   202\t            }\n   203\t            values.push(variant);\n   204\t            index += 1;\n   205\t        }\n   206\t        Ok(values)\n   207\t    }\n   208\t}\n   209\ttrait AssociatedTypes {\n   210\t    fn associated_types(&self) -> Result<Vec<AssociatedType>, Error>;\n   211\t}\n   212\timpl AssociatedTypes for [Protos] {\n   213\t    fn associated_types(&self) -> Result<Vec<AssociatedType>, Error> {\n   214\t        let mut values = Vec::new();\n   215\t        let mut index = 0;\n   216\t        while index < self.len() {\n   217\t            let Protos::Bare { text, .. } = &self[index] else {\n   218\t                return Err(Error::conceptual(\n   219\t                    vec![index as Integer],\n   220\t                    Problem::Expected(Form::Kind),\n   220\t                    Problem::Expected(Form::Kind),\n   221\t                ));\n   222\t            };\n   223\t            let bounds = match self.get(index + 1) {\n   224\t                Some(Protos::Enclosed {\n   225\t                    enclosure: Enclosure::Angled,\n   226\t                    children,\n   227\t                    ..\n   228\t                }) => {\n   229\t                    index += 1;\n   230\t                    Protos::list(children).place((index + 1) as Integer)?\n   231\t                }\n   232\t                _ => vec![],\n   233\t            };\n   234\t            values.push(AssociatedType {\n   235\t                name: text.as_str().name().place(index as Integer)?,\n   236\t                bounds,\n   237\t            });\n   238\t            index += 1;\n   239\t        }\n   240\t        Ok(values)\n   241\t    }\n   242\t}\n   243\timpl Conceiving<Library> for Protos {\n   244\t    fn conceive(&self) -> Result<Library, Error> {\n   245\t        let s = self.sections(4)?;\n   246\t        let Some(declarations) = s[1].children(Enclosure::Bracketed) else {\n   247\t            return Err(Error::conceptual(vec![1], Problem::Expected(Form::Section)));\n   248\t        };\n   249\t        Ok(Library {\n   250\t            imports: s[0].bracket().place(0)?,\n   251\t            types: declarations.declarations().place(1)?,\n   252\t            kinds: s[2].bracket().place(2)?,\n   253\t            associations: s[3].bracket().place(3)?,\n   254\t        })\n   255\t    }\n   256\t}\n   257\timpl Conceiving<Signal> for Protos {\n   258\t    fn conceive(&self) -> Result<Signal, Error> {\n   259\t        let s = self.sections(4)?;\n   260\t        let Some(requests) = s[1].children(Enclosure::Bracketed) else {\n   261\t            return Err(Error::conceptual(vec![1], Problem::Expected(Form::Section)));\n   262\t        };\n   263\t        let Some(responses) = s[2].children(Enclosure::Bracketed) else {\n   264\t            return Err(Error::conceptual(vec![2], Problem::Expected(Form::Section)));\n   265\t        };\n   266\t        let Some(declarations) = s[3].children(Enclosure::Bracketed) else {\n   267\t            return Err(Error::conceptual(vec![3], Problem::Expected(Form::Section)));\n   268\t        };\n   269\t        Ok(Signal {\n   270\t            imports: s[0].bracket().place(0)?,\n   271\t            requests: requests.variants().place(1)?,\n   272\t            responses: responses.variants().place(2)?,\n   273\t            types: declarations.declarations().place(3)?,\n   274\t        })\n   275\t    }\n   276\t}\n   277\timpl Conceiving<Sema> for Protos {\n   278\t    fn conceive(&self) -> Result<Sema, Error> {\n   279\t        let s = self.sections(2)?;\n   280\t        let Some(types) = s[1].children(Enclosure::Bracketed) else {\n   281\t            return Err(Error::conceptual(vec![1], Problem::Expected(Form::Section)));\n   282\t        };\n   283\t        Ok(Sema {\n   284\t            imports: s[0].bracket().place(0)?,\n   285\t            types: types.declarations().place(1)?,\n   286\t        })\n   287\t    }\n   288\t}\n   289\timpl Conceiving<Imported> for Protos {\n   290\t    fn conceive(&self) -> Result<Imported, Error> {\n   291\t        let name = match self {\n   292\t            Protos::Bare { text, .. } => text.as_str().name()?,\n   293\t            Protos::Headed {\n   294\t                head,\n   295\t                separator: Separator::Period,\n   296\t                body,\n   297\t                ..\n   298\t            } => {\n   299\t                let Protos::Bare { text, .. } = body.as_ref() else {\n   300\t                    return Err(Error::conceptual(vec![1], Problem::Expected(Form::Import)));\n   301\t                };\n   302\t                return Ok(Imported {\n   303\t                    name: head.name()?,\n   304\t                    emitted: text.as_str().name()?,\n   305\t                });\n   306\t            }\n   307\t            _ => return Err(Error::conceptual(vec![], Problem::Expected(Form::Import))),\n   308\t        };\n   309\t        Ok(Imported {\n   310\t            name: name.clone(),\n   311\t            emitted: name,\n   312\t        })\n   313\t    }\n   314\t}\n   315\timpl Conceiving<Import> for Protos {\n   316\t    fn conceive(&self) -> Result<Import, Error> {\n   317\t        let Protos::Headed {\n   318\t            head,\n   319\t            separator: Separator::Colon,\n   320\t            body,\n   321\t            ..\n   322\t        } = self\n   323\t        else {\n   324\t            return Err(Error::conceptual(vec![], Problem::Expected(Form::Import)));\n   325\t        };\n   326\t        let source = Source::try_from(head.0.as_str())\n   327\t            .map_err(|text| Error::conceptual(vec![], Problem::Name(text)))?;\n   328\t        if let Some(children) = body.children(Enclosure::Bracketed) {\n   329\t            Ok(Import::Many(source, Protos::list(children)?))\n   330\t        } else {\n   331\t            Ok(Import::One(source, body.conceive()?))\n   332\t        }\n   333\t    }\n   334\t}\n   335\timpl Conceiving<Reference> for Protos {\n   336\t    fn conceive(&self) -> Result<Reference, Error> {\n   337\t        match self {\n   338\t            Protos::Bare { text, .. } => Ok(Reference {\n   339\t                source: None,\n   340\t                name: text.as_str().name()?,\n   341\t                arguments: vec![],\n   342\t            }),\n   343\t            Protos::Headed {\n   344\t                head,\n   345\t                separator: Separator::Colon,\n   346\t                body,\n   347\t                ..\n   348\t            } => {\n   349\t                let mut r: Reference = body.conceive()?;\n   350\t                r.source = Some(\n   351\t                    Source::try_from(head.0.as_str())\n   352\t                        .map_err(|text| Error::conceptual(vec![], Problem::Name(text)))?,\n   353\t                );\n   354\t                Ok(r)\n   355\t            }\n   356\t            _ => Err(Error::conceptual(\n   357\t                vec![],\n   358\t                Problem::Expected(Form::Reference),\n   359\t            )),\n   360\t        }\n   361\t    }\n   362\t}\n   363\timpl Conceiving<TypeDeclaration> for Protos {\n   364\t    fn conceive(&self) -> Result<TypeDeclaration, Error> {\n   365\t        let Protos::Headed {\n   366\t            head,\n   367\t            constraints,\n   368\t            separator: Separator::Period,\n   369\t            body,\n   370\t            ..\n   371\t        } = self\n   372\t        else {\n   373\t            return Err(Error::conceptual(\n   374\t                vec![],\n   375\t                Problem::Expected(Form::Declaration),\n   376\t            ));\n   377\t        };\n   378\t        if constraints.is_some() {\n   379\t            return Err(Error::conceptual(\n   380\t                vec![],\n   381\t                Problem::Expected(Form::Declaration),\n   382\t            ));\n   383\t        }\n   384\t        let identity = Identity {\n   385\t            name: head.name()?,\n   386\t            constraints: vec![],\n   387\t        };\n   388\t        if let Some(p) = body.children(Enclosure::Braced) {\n   389\t            Ok(TypeDeclaration::Struct(identity, p.references()?))\n   390\t        } else if let Some(v) = body.children(Enclosure::Bracketed) {\n   391\t            Ok(TypeDeclaration::Enum(identity, v.variants()?))\n   392\t        } else {\n   393\t            Ok(TypeDeclaration::Alias(identity, body.conceive()?))\n   394\t        }\n   395\t    }\n   396\t}\n   397\timpl Conceiving<Variant> for Protos {\n   398\t    fn conceive(&self) -> Result<Variant, Error> {\n   399\t        match self {\n   400\t            Protos::Bare { text, .. } => Ok(Variant::Bare(text.as_str().name()?)),\n   401\t            Protos::Headed {\n   402\t                head,\n   403\t                separator: Separator::Period,\n   404\t                body,\n   405\t                ..\n   406\t            } => {\n   407\t                let n = head.name()?;\n   408\t                if let Some(p) = body.children(Enclosure::Braced) {\n   409\t                    Ok(Variant::Struct(n, p.references()?))\n   410\t                } else if let Some(v) = body.children(Enclosure::Bracketed) {\n   411\t                    Ok(Variant::Enum(n, v.variants()?))\n   412\t                } else {\n   413\t                    Ok(Variant::Typed(n, body.conceive()?))\n   414\t                }\n   415\t            }\n   416\t            _ => Err(Error::conceptual(vec![], Problem::Expected(Form::Variant))),\n   417\t        }\n   418\t    }\n   419\t}\n   420\t\n   421\timpl Conceiving<Constraint> for Protos {\n   422\t    fn conceive(&self) -> Result<Constraint, Error> {\n   423\t        if let Some(c) = self.children(Enclosure::Bracketed) {\n   424\t            Ok(Constraint::Many(Protos::list(c)?))\n   425\t        } else {\n   426\t            Ok(Constraint::One(self.conceive()?))\n   427\t        }\n   428\t    }\n   429\t}\n   430\timpl Conceiving<Receiver> for Separator {\n   431\t    fn conceive(&self) -> Result<Receiver, Error> {\n   432\t        Ok(match self {\n   433\t            Separator::Period => Receiver::Shared,\n   434\t            Separator::Exclamation => Receiver::Mutable,\n   435\t            Separator::Colon => Receiver::Static,\n   436\t        })\n   437\t    }\n   438\t}\n   439\timpl Conceiving<AssociatedType> for Protos {\n   440\t    fn conceive(&self) -> Result<AssociatedType, Error> {\n   441\t        match self {\n   442\t            Protos::Bare { text, .. } => Ok(AssociatedType {\n   443\t                name: text.as_str().name()?,\n   444\t                bounds: vec![],\n   445\t            }),\n   446\t            Protos::Headed {\n   447\t                head, constraints, ..\n   448\t            } => Ok(AssociatedType {\n   449\t                name: head.name()?,\n   450\t                bounds: match constraints.as_deref() {\n   451\t                    Some(Protos::Enclosed { children, .. }) => Protos::list(children)?,\n   452\t                    _ => vec![],\n   453\t                },\n   454\t            }),\n   455\t            _ => Err(Error::conceptual(vec![], Problem::Expected(Form::Kind))),\n   456\t        }\n   457\t    }\n   458\t}\n   459\timpl Conceiving<AssociatedConstant> for Protos {\n   460\t    fn conceive(&self) -> Result<AssociatedConstant, Error> {\n   461\t        let Protos::Headed {\n   462\t            head,\n   463\t            separator: Separator::Period,\n   464\t            body,\n   465\t            ..\n   466\t        } = self\n   467\t        else {\n   468\t            return Err(Error::conceptual(vec![], Problem::Expected(Form::Constant)));\n   469\t        };\n   470\t        Ok(AssociatedConstant {\n   471\t            name: head.name().place(0)?,\n   472\t            ty: body.conceive().place(1)?,\n   473\t        })\n   474\t    }\n   475\t}\n   476\timpl Conceiving<Capability> for Protos {\n   477\t    fn conceive(&self) -> Result<Capability, Error> {\n   478\t        let Protos::Headed {\n   479\t            head,\n   480\t            separator,\n   481\t            body,\n   482\t            ..\n   483\t        } = self\n   484\t        else {\n   485\t            return Err(Error::conceptual(\n   486\t                vec![],\n   487\t                Problem::Expected(Form::Capability),\n   488\t            ));\n   489\t        };\n   490\t        let name = head.name().place(0)?;\n   491\t        let receiver = separator.conceive()?;\n   492\t        if let Some(y) = body.children(Enclosure::Bracketed) {\n   493\t            let yields = y.references().place(1)?;\n   494\t            if yields.len() != 1 {\n   495\t                return Err(Error::conceptual(vec![1], Problem::Yield));\n   496\t            };\n   497\t            return Ok(Capability {\n   498\t                name,\n   499\t                receiver,\n   500\t                signature: Signature::Yielding(yields.into_iter().next().expect(\"one yield\")),\n   501\t            });\n   502\t        };\n   503\t        let sections = body.sections(2)?;\n   504\t        let Some(input_nodes) = sections[0].children(Enclosure::Bracketed) else {\n   505\t            return Err(Error::conceptual(\n   506\t                vec![0],\n   507\t                Problem::Expected(Form::Capability),\n   508\t            ));\n   509\t        };\n   510\t        let inputs = input_nodes.references().place(0).place(1)?;\n   511\t        let Some(y) = sections[1].children(Enclosure::Bracketed) else {\n   512\t            return Err(Error::conceptual(\n   513\t                vec![1],\n   514\t                Problem::Expected(Form::Capability),\n   515\t            ));\n   516\t        };\n   517\t        let yields = y.references().place(1).place(1)?;\n   518\t        if yields.len() != 1 {\n   519\t            return Err(Error::conceptual(vec![1, 1], Problem::Yield));\n   520\t        };\n   521\t        Ok(Capability {\n   522\t            name,\n   523\t            receiver,\n   524\t            signature: Signature::Taking(inputs, yields.into_iter().next().expect(\"one yield\")),\n   525\t        })\n   526\t    }\n   527\t}\n   528\timpl Conceiving<KindDeclaration> for Protos {\n   529\t    fn conceive(&self) -> Result<KindDeclaration, Error> {\n   530\t        let Protos::Headed {\n   531\t            head,\n   532\t            constraints,\n   533\t            separator: Separator::Period,\n   534\t            body,\n   535\t            ..\n   536\t        } = self\n   537\t        else {\n   538\t            return Err(Error::conceptual(vec![], Problem::Expected(Form::Kind)));\n   539\t        };\n   540\t        let identity = Identity {\n   541\t            name: head.name()?,\n   542\t            constraints: match constraints.as_deref() {\n   543\t                Some(Protos::Enclosed { children, .. }) => Protos::list(children)?,\n   544\t                _ => vec![],\n   545\t            },\n   546\t        };\n   547\t        if let Some(c) = body.children(Enclosure::Bracketed) {\n   548\t            return Ok(KindDeclaration {\n   549\t                identity,\n   550\t                body: KindBody::Simple(Protos::list(c).place(1)?),\n   551\t            });\n   552\t        };\n   553\t        let s = body.sections(4)?;\n   554\t        let Some(types) = s[1].children(Enclosure::Bracketed) else {\n   555\t            return Err(Error::conceptual(vec![1], Problem::Expected(Form::Kind)));\n   556\t        };\n   557\t        Ok(KindDeclaration {\n   558\t            identity,\n   559\t            body: KindBody::Complex {\n   560\t                superkinds: s[0].bracket().place(0).place(1)?,\n   561\t                types: types.associated_types().place(1).place(1)?,\n   562\t                constants: s[2].bracket().place(2).place(1)?,\n   563\t                capabilities: s[3].bracket().place(3).place(1)?,\n   564\t            },\n   565\t        })\n   566\t    }\n   567\t}\n   568\timpl Conceiving<Association> for Protos {\n   569\t    fn conceive(&self) -> Result<Association, Error> {\n   570\t        let Protos::Headed {\n   571\t            head,\n   572\t            separator: Separator::Period,\n   573\t            body,\n   574\t            ..\n   575\t        } = self\n   576\t        else {\n   577\t            return Err(Error::conceptual(\n   578\t                vec![],\n   579\t                Problem::Expected(Form::Association),\n   580\t            ));\n   581\t        };\n   582\t        Ok(Association {\n   583\t            identity: Identity {\n   584\t                name: head.name().place(0)?,\n   585\t                constraints: vec![],\n   586\t            },\n   587\t            kinds: body.bracket().place(1)?,\n   588\t        })\n   589\t    }\n   590\t}\n","exit_code":0,"status":"completed"}}
