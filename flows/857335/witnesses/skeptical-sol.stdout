{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/run/current-system/sw/bin/zsh -lc \"nl -ba crates/datom-codec-derive/src/lib.rs | sed -n '1,210p'; nl -ba src/composition.rs | sed -n '450,540p'; nl -ba tests/core.rs | sed -n '1,220p'; nl -ba tests/core.rs | sed -n '220,430p'; nl -ba tests/core.rs | sed -n '430,690p'\"","aggregated_output":"     1\tuse proc_macro::TokenStream;\n     2\tuse quote::quote;\n     3\tuse syn::{Data, DeriveInput, Fields, parse_macro_input};\n     4\t\n     5\tfn fields<'a>(input: &'a DeriveInput, capability: &str) -> Result<&'a Fields, TokenStream> {\n     6\t    match &input.data {\n     7\t        Data::Struct(data) => Ok(&data.fields),\n     8\t        _ => Err(\n     9\t            syn::Error::new_spanned(&input.ident, format!(\"{capability} supports structs\"))\n    10\t                .into_compile_error()\n    11\t                .into(),\n    12\t        ),\n    13\t    }\n    14\t}\n    15\t\n    16\t#[proc_macro_derive(Compositional)]\n    17\tpub fn compositional(input: TokenStream) -> TokenStream {\n    18\t    let input = parse_macro_input!(input as DeriveInput);\n    19\t    let name = &input.ident;\n    20\t    if let Data::Enum(data) = &input.data {\n    21\t        let mut bounded_generics = input.generics.clone();\n    22\t        for parameter in &input.generics.params {\n    23\t            if let syn::GenericParam::Type(parameter) = parameter {\n    24\t                let ident = &parameter.ident;\n    25\t                bounded_generics\n    26\t                    .make_where_clause()\n    27\t                    .predicates\n    28\t                    .push(syn::parse_quote!(#ident: ::datom_codec::Compositional));\n    29\t            }\n    30\t        }\n    31\t        let (impl_generics, ty_generics, where_clause) = bounded_generics.split_for_impl();\n    32\t        let unit_arms = data.variants.iter().filter_map(|variant| {\n    33\t            if !matches!(variant.fields, Fields::Unit) {\n    34\t                return None;\n    35\t            }\n    36\t            let spelling = variant.ident.to_string();\n    37\t            let name = &variant.ident;\n    38\t            Some(quote!(#spelling => Ok(Self::#name)))\n    39\t        });\n    40\t        let arms = data.variants.iter().map(|variant| {\n    41\t            let variant_name = &variant.ident;\n    42\t            let spelling = variant_name.to_string();\n    43\t            let fields = &variant.fields;\n    44\t            let reads = fields.iter().enumerate().map(|(index, field)| { let ty = &field.ty; let binding = syn::Ident::new(&format!(\"field_{index}\"), proc_macro2::Span::call_site()); quote!(let #binding: #ty = positions.position(budget)?;) });\n    45\t            let bindings: Vec<_> = (0..fields.len()).map(|index| syn::Ident::new(&format!(\"field_{index}\"), proc_macro2::Span::call_site())).collect();\n    46\t            let build = match fields { Fields::Named(named) => { let names = named.named.iter().map(|field| field.ident.as_ref().unwrap()); quote!(Self::#variant_name { #(#names: #bindings),* }) }, Fields::Unnamed(_) => quote!(Self::#variant_name(#(#bindings),*)), Fields::Unit => quote!(Self::#variant_name) };\n    47\t            let count = fields.len();\n    48\t            if count == 0 {\n    49\t                quote!(#spelling => Err(<::datom_codec::Error as ::datom_codec::ErrorRaising>::composition(datom.path.clone(), ::datom_codec::ErrorKind::Form { expected: \"bare variant\".to_owned(), found: \"Variant\".to_owned() })))\n    50\t            } else if count == 1 {\n    51\t                let binding = &bindings[0];\n    52\t                quote!(#spelling => { let #binding = body.compose(budget)?; Ok(#build) })\n    53\t            } else {\n    54\tquote!(#spelling => { let mut positions = ::datom_codec::DatomPositioning::variant_positions(body)?; #(#reads)* positions.finish()?; Ok(#build) })\n    55\t            }\n    56\t        });\n    57\t        return quote! {\n    58\t            impl #impl_generics ::datom_codec::Compositional for #name #ty_generics #where_clause {\n    59\t                const ARITY: ::datom_codec::Integer = 1;\n    60\t                fn from_positions(_: ::datom_codec::Positions<'_>, _: &mut ::datom_codec::Budget) -> Result<Self, ::datom_codec::Error> { unreachable!(\"enums compose from a variant form\") }\n    61\t                fn compose(datom: &::datom_codec::Datom, budget: &mut ::datom_codec::Budget) -> Result<Self, ::datom_codec::Error> {\n    62\t                    use ::datom_codec::{Composable, Positioning, Variantizing};\n    63\t                    match &datom.form {\n    64\t                        ::datom_codec::Form::Bare(head) => match head.as_str() { #(#unit_arms,)* other => Err(<::datom_codec::Error as ::datom_codec::ErrorRaising>::composition(datom.path.clone(), ::datom_codec::ErrorKind::Variant { expected: stringify!(#name).to_owned(), found: other.to_owned() })) },\n    65\t                        _ => { let (head, body) = datom.variant(budget, \"Variant\")?; match head { #(#arms,)* other => Err(<::datom_codec::Error as ::datom_codec::ErrorRaising>::composition(datom.path.clone(), ::datom_codec::ErrorKind::Variant { expected: stringify!(#name).to_owned(), found: other.to_owned() })) } }\n    66\t                    }\n    67\t                }\n    68\t            }\n    69\t        }.into();\n    70\t    }\n    71\t    let fields = match fields(&input, \"Compositional\") {\n    72\t        Ok(fields) => fields,\n    73\t        Err(error) => return error,\n    74\t    };\n    75\t    let mut bounded_generics = input.generics.clone();\n    76\t    for parameter in &input.generics.params {\n    77\t        if let syn::GenericParam::Type(parameter) = parameter {\n    78\t            let ident = &parameter.ident;\n    79\t            bounded_generics\n    80\t                .make_where_clause()\n    81\t                .predicates\n    82\t                .push(syn::parse_quote!(#ident: ::datom_codec::Compositional));\n    83\t        }\n    84\t    }\n    85\t    let (impl_generics, ty_generics, where_clause) = bounded_generics.split_for_impl();\n    86\t    let reads = fields.iter().enumerate().map(|(index, field)| {\n    87\t        let ty = &field.ty;\n    88\t        let binding = syn::Ident::new(&format!(\"field_{index}\"), proc_macro2::Span::call_site());\n    89\t        quote!(let #binding: #ty = positions.position(budget)?;)\n    90\t    });\n    91\t    let bindings: Vec<_> = (0..fields.len())\n    92\t        .map(|index| syn::Ident::new(&format!(\"field_{index}\"), proc_macro2::Span::call_site()))\n    93\t        .collect();\n    94\t    let build = match fields {\n    95\t        Fields::Named(named) => {\n    96\t            let names = named\n    97\t                .named\n    98\t                .iter()\n    99\t                .map(|field| field.ident.as_ref().unwrap());\n   100\t            quote!(Self { #(#names: #bindings),* })\n   101\t        }\n   102\t        Fields::Unnamed(_) => quote!(Self(#(#bindings),*)),\n   103\t        Fields::Unit => quote!(Self),\n   104\t    };\n   105\t    let arity = fields.len();\n   106\t    quote! {\n   107\t        impl #impl_generics ::datom_codec::Compositional for #name #ty_generics #where_clause {\n   108\t            const ARITY: ::datom_codec::Integer = #arity as ::datom_codec::Integer;\n   109\t            fn from_positions(mut positions: ::datom_codec::Positions<'_>, budget: &mut ::datom_codec::Budget) -> Result<Self, ::datom_codec::Error> {\n   110\t                use ::datom_codec::Positioning; #(#reads)* positions.finish()?; Ok(#build)\n   111\t            }\n   112\t        }\n   113\t    }.into()\n   114\t}\n   115\t\n   116\t#[proc_macro_derive(Datomizable)]\n   117\tpub fn datomizable(input: TokenStream) -> TokenStream {\n   118\t    let input = parse_macro_input!(input as DeriveInput);\n   119\t    let name = &input.ident;\n   120\t    if let Data::Enum(data) = &input.data {\n   121\t        let mut bounded_generics = input.generics.clone();\n   122\t        for parameter in &input.generics.params {\n   123\t            if let syn::GenericParam::Type(parameter) = parameter {\n   124\t                let ident = &parameter.ident;\n   125\t                bounded_generics.make_where_clause().predicates.push(\n   126\t                    syn::parse_quote!(#ident: ::datom_codec::Datomizable<Output = ::datom_codec::Datom>),\n   127\t                );\n   128\t            }\n   129\t        }\n   130\t        let (impl_generics, ty_generics, where_clause) = bounded_generics.split_for_impl();\n   131\t        let arms = data.variants.iter().map(|variant| {\n   132\t            let variant_name = &variant.ident;\n   133\t            let spelling = variant_name.to_string();\n   134\t            let bindings: Vec<_> = (0..variant.fields.len()).map(|index| syn::Ident::new(&format!(\"field_{index}\"), proc_macro2::Span::call_site())).collect();\n   135\t            let pattern = match &variant.fields { Fields::Named(named) => { let names = named.named.iter().map(|field| field.ident.as_ref().unwrap()); quote!(Self::#variant_name { #(#names: #bindings),* }) }, Fields::Unnamed(_) => quote!(Self::#variant_name(#(#bindings),*)), Fields::Unit => quote!(Self::#variant_name) };\n   136\t            let child_values: Vec<_> = bindings.iter().enumerate().map(|(index, binding)| quote!((#binding).datomize(at.child(1).child(#index as ::datom_codec::Integer)))).collect();\n   137\t            let body = match variant.fields.len() {\n   138\t                0 => quote!(::datom_codec::Datom { path: at.child(1), form: ::datom_codec::Form::Bare(String::new()) }),\n   139\t                1 => { let binding = &bindings[0]; quote!((#binding).datomize(at.child(1))) },\n   140\t                _ => quote!(::datom_codec::Datom { path: at.child(1), form: ::datom_codec::Form::Struct(vec![#(#child_values),*]) }),\n   141\t            };\n   142\t            if variant.fields.is_empty() {\n   143\t                quote!(#pattern => ::datom_codec::Datom { path: at.clone(), form: ::datom_codec::Form::Bare(#spelling.to_owned()) })\n   144\t            } else {\n   145\t                quote!(#pattern => ::datom_codec::Datom { path: at.clone(), form: ::datom_codec::Form::Variant(::datom_codec::Symbol(#spelling.to_owned()), Box::new(#body)) })\n   146\t            }\n   147\t        });\n   148\t        return quote! {\n   149\t            impl #impl_generics ::datom_codec::Datomizable for #name #ty_generics #where_clause {\n   150\t                type Output = ::datom_codec::Datom;\n   151\t                fn datomize(&self, at: ::datom_codec::Path) -> ::datom_codec::Datom {\n   152\t                    use ::datom_codec::{Datomizable, Pathing};\n   153\t                    match self { #(#arms),* }\n   154\t                }\n   155\t            }\n   156\t        }\n   157\t        .into();\n   158\t    }\n   159\t    let fields = match fields(&input, \"Datomizable\") {\n   160\t        Ok(fields) => fields,\n   161\t        Err(error) => return error,\n   162\t    };\n   163\t    let mut bounded_generics = input.generics.clone();\n   164\t    for parameter in &input.generics.params {\n   165\t        if let syn::GenericParam::Type(parameter) = parameter {\n   166\t            let ident = &parameter.ident;\n   167\t            bounded_generics.make_where_clause().predicates.push(\n   168\t                syn::parse_quote!(#ident: ::datom_codec::Datomizable<Output = ::datom_codec::Datom>),\n   169\t            );\n   170\t        }\n   171\t    }\n   172\t    let (impl_generics, ty_generics, where_clause) = bounded_generics.split_for_impl();\n   173\t    let values: Vec<_> = fields\n   174\t        .iter()\n   175\t        .enumerate()\n   176\t        .map(|(index, field)| {\n   177\t            let value = match &field.ident {\n   178\t                Some(name) => quote!(&self.#name),\n   179\t                None => {\n   180\t                    let index = syn::Index::from(index);\n   181\t                    quote!(&self.#index)\n   182\t                }\n   183\t            };\n   184\t            quote!((#value).datomize(at.child(#index as ::datom_codec::Integer)))\n   185\t        })\n   186\t        .collect();\n   187\t    quote! {\n   188\t        impl #impl_generics ::datom_codec::Datomizable for #name #ty_generics #where_clause {\n   189\t            type Output = ::datom_codec::Datom;\n   190\t            fn datomize(&self, at: ::datom_codec::Path) -> ::datom_codec::Datom {\n   191\t                use ::datom_codec::{Datomizable, Pathing};\n   192\t                ::datom_codec::Datom { path: at.clone(), form: ::datom_codec::Form::Struct(vec![#(#values),*]) }\n   193\t            }\n   194\t        }\n   195\t    }.into()\n   196\t}\n   450\t                kind: ErrorKind::Form {\n   451\t                    expected: expected.to_owned(),\n   452\t                    found: found.form_name().to_owned(),\n   453\t                },\n   454\t            }),\n   455\t        }\n   456\t    }\n   457\t}\n   458\timpl<T: Datomizable<Output = Datom>> Datomizable for Option<T> {\n   459\t    type Output = Datom;\n   460\t    fn datomize(&self, at: Path) -> Datom {\n   461\t        match self {\n   462\t            Some(value) => value\n   463\t                .datomize(at.child(1))\n   464\t                .named_variant(at.clone(), \"Some\"),\n   465\t            None => Datom {\n   466\t                path: at,\n   467\t                form: Form::Bare(\"None\".to_owned()),\n   468\t            },\n   469\t        }\n   470\t    }\n   471\t}\n   472\timpl<T: Compositional> Compositional for Option<T> {\n   473\t    const ARITY: Integer = 1;\n   474\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   475\t        unreachable!(\"options compose from a variant form\")\n   476\t    }\n   477\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   478\t        if matches!(&datom.form, Form::Bare(head) if head == \"None\") {\n   479\t            budget.spend(&datom.path)?;\n   480\t            return Ok(None);\n   481\t        }\n   482\t        let (head, body) = datom.variant(budget, \"Variant\")?;\n   483\t        match head {\n   484\t            \"Some\" => Ok(Some(body.compose(budget)?)),\n   485\t            \"None\" if matches!(body.form, Form::Bare(ref value) if value.is_empty()) => Ok(None),\n   486\t            found => Err(Error {\n   487\t                layer: ErrorLayer::Composition,\n   488\t                path: datom.path.clone(),\n   489\t                kind: ErrorKind::Variant {\n   490\t                    expected: \"Option\".into(),\n   491\t                    found: found.to_owned(),\n   492\t                },\n   493\t            }),\n   494\t        }\n   495\t    }\n   496\t}\n   497\timpl<T: Datomizable<Output = Datom>, E: Datomizable<Output = Datom>> Datomizable for Result<T, E> {\n   498\t    type Output = Datom;\n   499\t    fn datomize(&self, at: Path) -> Datom {\n   500\t        match self {\n   501\t            Ok(value) => value.datomize(at.child(1)).named_variant(at.clone(), \"Ok\"),\n   502\t            Err(value) => value.datomize(at.child(1)).named_variant(at.clone(), \"Err\"),\n   503\t        }\n   504\t    }\n   505\t}\n   506\timpl<T: Compositional, E: Compositional> Compositional for Result<T, E> {\n   507\t    const ARITY: Integer = 1;\n   508\t    fn from_positions(_: Positions<'_>, _: &mut Budget) -> Result<Self, Error> {\n   509\t        unreachable!(\"results compose from a variant form\")\n   510\t    }\n   511\t    fn compose(datom: &Datom, budget: &mut Budget) -> Result<Self, Error> {\n   512\t        let (head, body) = datom.variant(budget, \"Variant\")?;\n   513\t        match head {\n   514\t            \"Ok\" => Ok(Ok(body.compose(budget)?)),\n   515\t            \"Err\" => Ok(Err(body.compose(budget)?)),\n   516\t            found => Err(Error {\n   517\t                layer: ErrorLayer::Composition,\n   518\t                path: datom.path.clone(),\n   519\t                kind: ErrorKind::Variant {\n   520\t                    expected: \"Result\".into(),\n   521\t                    found: found.to_owned(),\n   522\t                },\n   523\t            }),\n   524\t        }\n   525\t    }\n   526\t}\n   527\t\n   528\timpl Datomizable for protos::Extent {\n   529\t    type Output = Datom;\n   530\t    fn datomize(&self, at: Path) -> Datom {\n   531\t        Datom {\n   532\t            path: at.clone(),\n   533\t            form: Form::Struct(vec![\n   534\t                (self.start as i64).datomize(at.child(0)),\n   535\t                (self.end as i64).datomize(at.child(1)),\n   536\t            ]),\n   537\t        }\n   538\t        .named_variant(at, \"Extent\")\n   539\t    }\n   540\t}\n     1\tuse datom_codec::{\n     2\t    Actualizing, Budget, Composable, Compositional, Datom, Datomizable, Error, ErrorKind,\n     3\t    ErrorLayer, ErrorRaising, Form, Meaning, Path, Potential, PotentialExtenting, ProtosExtenting,\n     4\t    Scalar,\n     5\t};\n     6\tuse protos::{Protosizable, ReaderBudget, Textualizable};\n     7\t\n     8\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n     9\tstruct Score {\n    10\t    name: String,\n    11\t    value: i64,\n    12\t    enabled: bool,\n    13\t}\n    14\t\n    15\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n    16\tenum Reply {\n    17\t    Accepted(i64, String),\n    18\t    Pending,\n    19\t}\n    20\t\n    21\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n    22\tenum Message {\n    23\t    Reply(Reply),\n    24\t}\n    25\t\n    26\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n    27\tstruct PunctuatedStrings {\n    28\t    model: String,\n    29\t    url: String,\n    30\t    qualified_name: String,\n    31\t}\n    32\t\n    33\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n    34\tenum Pair {\n    35\t    Values(i64, i64),\n    36\t}\n    37\t\n    38\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n    39\tstruct Wrapper<T> {\n    40\t    value: T,\n    41\t}\n    42\t\n    43\t#[test]\n    44\tfn derived_struct_composes_its_typed_positions() {\n    45\t    let datom = Datom {\n    46\t        path: Path::new(),\n    47\t        form: Form::Struct(vec![\n    48\t            Datom {\n    49\t                path: vec![0],\n    50\t                form: Form::Bare(\"Ada\".into()),\n    51\t            },\n    52\t            Datom {\n    53\t                path: vec![1],\n    54\t                form: Form::Bare(\"42\".into()),\n    55\t            },\n    56\t            Datom {\n    57\t                path: vec![2],\n    58\t                form: Form::Bare(\"True\".into()),\n    59\t            },\n    60\t        ]),\n    61\t    };\n    62\t    let value: Score = datom\n    63\t        .compose(&mut Budget {\n    64\t            remaining: 10,\n    65\t            reader: ReaderBudget { remaining: 128 },\n    66\t            depth: 0,\n    67\t            maximum_depth: 4_096,\n    68\t        })\n    69\t        .unwrap();\n    70\t    assert_eq!(\n    71\t        value,\n    72\t        Score {\n    73\t            name: \"Ada\".into(),\n    74\t            value: 42,\n    75\t            enabled: true\n    76\t        }\n    77\t    );\n    78\t    assert_eq!(value.datomize(vec![]), datom);\n    79\t}\n    80\t\n    81\t#[test]\n    82\tfn protos_symbol_and_reader_budget_are_datom_intrinsics() {\n    83\t    let mut budget = Budget {\n    84\t        remaining: 20,\n    85\t        reader: ReaderBudget { remaining: 128 },\n    86\t        depth: 0,\n    87\t        maximum_depth: 128,\n    88\t    };\n    89\t    let symbol = protos::Symbol(\"Reviewer\".into());\n    90\t    let datom = symbol.datomize(vec![]);\n    91\t    let rebuilt: protos::Symbol = datom.compose(&mut budget.clone()).unwrap();\n    92\t    assert_eq!(rebuilt, symbol);\n    93\t\n    94\t    let reader = ReaderBudget { remaining: 4_096 };\n    95\t    let datom = reader.datomize(vec![]);\n    96\t    let rebuilt: ReaderBudget = datom.compose(&mut budget).unwrap();\n    97\t    assert_eq!(rebuilt, reader);\n    98\t}\n    99\t\n   100\t#[test]\n   101\tfn scalar_refusal_keeps_the_datom_path() {\n   102\t    let datom = Datom {\n   103\t        path: vec![2],\n   104\t        form: Form::Bare(\"01\".into()),\n   105\t    };\n   106\t    let error = i64::scalar(\n   107\t        &datom,\n   108\t        &mut Budget {\n   109\t            remaining: 1,\n   110\t            reader: ReaderBudget { remaining: 128 },\n   111\t            depth: 0,\n   112\t            maximum_depth: 4_096,\n   113\t        },\n   114\t    )\n   115\t    .unwrap_err();\n   116\t    assert_eq!(error.path, vec![2]);\n   117\t}\n   118\t\n   119\t#[test]\n   120\tfn derived_variants_use_their_rust_names_as_heads() {\n   121\t    let value = Reply::Accepted(42, \"today\".into());\n   122\t    let datom = value.datomize(vec![]);\n   123\t    assert!(matches!(&datom.form, Form::Variant(head, _) if head.0 == \"Accepted\"));\n   124\t    assert_eq!(\n   125\t        datom\n   126\t            .compose::<Reply>(&mut Budget {\n   127\t                remaining: 10,\n   128\t                reader: ReaderBudget { remaining: 10 },\n   129\t                depth: 0,\n   130\t                maximum_depth: 4_096\n   131\t            })\n   132\t            .unwrap(),\n   133\t        value\n   134\t    );\n   135\t    let pending = Reply::Pending.datomize(vec![]);\n   136\t    assert_eq!(\n   137\t        pending\n   138\t            .compose::<Reply>(&mut Budget {\n   139\t                remaining: 10,\n   140\t                reader: ReaderBudget { remaining: 10 },\n   141\t                depth: 0,\n   142\t                maximum_depth: 4_096\n   143\t            })\n   144\t            .unwrap(),\n   145\t        Reply::Pending\n   146\t    );\n   147\t    assert_eq!(pending.protosize().textualize(), \"Pending\");\n   148\t    assert_eq!(\n   149\t        Potential::<Reply>::from(\"Pending\")\n   150\t            .actualize(&mut Budget {\n   151\t                remaining: 1,\n   152\t                reader: ReaderBudget { remaining: 128 },\n   153\t                depth: 0,\n   154\t                maximum_depth: 4_096\n   155\t            })\n   156\t            .unwrap(),\n   157\t        Reply::Pending\n   158\t    );\n   159\t}\n   160\t\n   161\t#[test]\n   162\tfn scalar_writers_preserve_their_textual_kind() {\n   163\t    assert_eq!(3.0_f64.datomize(vec![]).protosize().textualize(), \"3.0\");\n   164\t    assert_eq!((-0.0_f64).datomize(vec![]).protosize().textualize(), \"-0.0\");\n   165\t    assert_eq!(\n   166\t        \"a{b\".to_owned().datomize(vec![]).protosize().textualize(),\n   167\t        \"«a{b»\"\n   168\t    );\n   169\t    assert!(\n   170\t        i64::scalar(\n   171\t            &Datom {\n   172\t                path: vec![],\n   173\t                form: Form::Bare(\"-01\".into())\n   174\t            },\n   175\t            &mut Budget {\n   176\t                remaining: 1,\n   177\t                reader: ReaderBudget { remaining: 1 },\n   178\t                depth: 0,\n   179\t                maximum_depth: 4_096\n   180\t            }\n   181\t        )\n   182\t        .is_err()\n   183\t    );\n   184\t}\n   185\t\n   186\t#[test]\n   187\tfn qualified_heads_refuse_at_the_variant_path() {\n   188\t    let mut potential = Potential::<Reply>::from(\"Accepted<String>.42\");\n   189\t    let error = potential\n   190\t        .actualize(&mut Budget {\n   191\t            remaining: 10,\n   192\t            reader: ReaderBudget { remaining: 128 },\n   193\t            depth: 0,\n   194\t            maximum_depth: 4_096,\n   195\t        })\n   196\t        .unwrap_err();\n   197\t    assert_eq!(error.path, Vec::<i64>::new());\n   198\t    assert!(matches!(\n   199\t        error.kind,\n   200\t        ErrorKind::Form { ref expected, ref found }\n   201\t            if expected == \"unqualified Variant\" && found == \"qualified head\"\n   202\t    ));\n   203\t    assert_eq!(\n   204\t        potential.reader_extent(&error.path),\n   205\t        Some(protos::Extent { start: 0, end: 19 })\n   206\t    );\n   207\t}\n   208\t\n   209\t#[test]\n   210\tfn protos_conversion_preserves_datoms_and_canonical_text() {\n   211\t    let datom = Score {\n   212\t        name: \"Ada\".into(),\n   213\t        value: 42,\n   214\t        enabled: true,\n   215\t    }\n   216\t    .datomize(vec![]);\n   217\t    let text = datom.protosize().textualize();\n   218\t    assert_eq!(text, \"{ Ada 42 True }\");\n   219\t    assert_eq!(datom.protosize(), text.protosize().unwrap());\n   220\t    let rebuilt = text.protosize().unwrap().datomize(vec![]);\n   220\t    let rebuilt = text.protosize().unwrap().datomize(vec![]);\n   221\t    assert_eq!(rebuilt.unwrap(), datom);\n   222\t}\n   223\t\n   224\t#[test]\n   225\tfn potential_actualizes_text_through_protos_and_datom() {\n   226\t    let value: Score = Potential::from(\"{ Ada 42 True }\")\n   227\t        .actualize(&mut Budget {\n   228\t            remaining: 10,\n   229\t            reader: ReaderBudget { remaining: 10 },\n   230\t            depth: 0,\n   231\t            maximum_depth: 4_096,\n   232\t        })\n   233\t        .unwrap();\n   234\t    assert_eq!(\n   235\t        value,\n   236\t        Score {\n   237\t            name: \"Ada\".into(),\n   238\t            value: 42,\n   239\t            enabled: true\n   240\t        }\n   241\t    );\n   242\t}\n   243\t\n   244\t#[test]\n   245\tfn scalar_positions_keep_bare_payloads_and_some_bodies_flat() {\n   246\t    let three_point_fourteen: f64 = \"3.14\".parse().unwrap();\n   247\t    let timestamp: String = Potential::from(\"2026-09-03T17:46:20\")\n   248\t        .actualize(&mut Budget {\n   249\t            remaining: 1,\n   250\t            reader: ReaderBudget { remaining: 128 },\n   251\t            depth: 0,\n   252\t            maximum_depth: 4_096,\n   253\t        })\n   254\t        .unwrap();\n   255\t    assert_eq!(timestamp, \"2026-09-03T17:46:20\");\n   256\t    let name: String = Potential::from(\"Ada:one\")\n   257\t        .actualize(&mut Budget {\n   258\t            remaining: 1,\n   259\t            reader: ReaderBudget { remaining: 128 },\n   260\t            depth: 0,\n   261\t            maximum_depth: 4_096,\n   262\t        })\n   263\t        .unwrap();\n   264\t    assert_eq!(name, \"Ada:one\");\n   265\t\n   266\t    let string: Option<String> = Potential::from(\"Some.42\")\n   267\t        .actualize(&mut Budget {\n   268\t            remaining: 2,\n   269\t            reader: ReaderBudget { remaining: 128 },\n   270\t            depth: 0,\n   271\t            maximum_depth: 4_096,\n   272\t        })\n   273\t        .unwrap();\n   274\t    assert_eq!(string, Some(\"42\".into()));\n   275\t    let integer: Option<i64> = Potential::from(\"Some.42\")\n   276\t        .actualize(&mut Budget {\n   277\t            remaining: 2,\n   278\t            reader: ReaderBudget { remaining: 128 },\n   279\t            depth: 0,\n   280\t            maximum_depth: 4_096,\n   281\t        })\n   282\t        .unwrap();\n   283\t    assert_eq!(integer, Some(42));\n   284\t    let decimal: f64 = Potential::from(\"3.14\")\n   285\t        .actualize(&mut Budget {\n   286\t            remaining: 1,\n   287\t            reader: ReaderBudget { remaining: 128 },\n   288\t            depth: 0,\n   289\t            maximum_depth: 4_096,\n   290\t        })\n   291\t        .unwrap();\n   292\t    assert_eq!(decimal, three_point_fourteen);\n   293\t    let optional_decimal: Option<f64> = Potential::from(\"Some.3.14\")\n   294\t        .actualize(&mut Budget {\n   295\t            remaining: 2,\n   296\t            reader: ReaderBudget { remaining: 128 },\n   297\t            depth: 0,\n   298\t            maximum_depth: 4_096,\n   299\t        })\n   300\t        .unwrap();\n   301\t    assert_eq!(optional_decimal, Some(three_point_fourteen));\n   302\t\n   303\t    assert_eq!(\n   304\t        Some(\"Ada:one\".to_owned())\n   305\t            .datomize(vec![])\n   306\t            .protosize()\n   307\t            .textualize(),\n   308\t        \"Some.Ada:one\"\n   309\t    );\n   310\t    assert_eq!(\n   311\t        Some(three_point_fourteen)\n   312\t            .datomize(vec![])\n   313\t            .protosize()\n   314\t            .textualize(),\n   315\t        \"Some.3.14\"\n   316\t    );\n   317\t}\n   318\t\n   319\t#[test]\n   320\tfn typed_string_positions_resolve_bare_syntax_characters() {\n   321\t    let text = \"{ gpt-5.6-luna https://example.org/a Upper.Case }\";\n   322\t    let expected = PunctuatedStrings {\n   323\t        model: \"gpt-5.6-luna\".into(),\n   324\t        url: \"https://example.org/a\".into(),\n   325\t        qualified_name: \"Upper.Case\".into(),\n   326\t    };\n   327\t    let value: PunctuatedStrings = Potential::from(text)\n   328\t        .actualize(&mut Budget {\n   329\t            remaining: 16,\n   330\t            reader: ReaderBudget { remaining: 128 },\n   331\t            depth: 0,\n   332\t            maximum_depth: 16,\n   333\t        })\n   334\t        .unwrap();\n   335\t    assert_eq!(value, expected);\n   336\t    assert_eq!(value.datomize(vec![]).protosize().textualize(), text);\n   337\t}\n   338\t\n   339\t#[test]\n   340\tfn string_rule_round_trips_bare_punctuation_and_delimited_content() {\n   341\t    for (value, canonical) in [\n   342\t        (\".a\", \".a\"),\n   343\t        (\"a.\", \"a.\"),\n   344\t        (\"a..b\", \"a..b\"),\n   345\t        (\".codex/agents/worker.toml\", \".codex/agents/worker.toml\"),\n   346\t        (\"lower.case\", \"lower.case\"),\n   347\t        (\"Upper.Case\", \"Upper.Case\"),\n   348\t        (\"a:b:c\", \"a:b:c\"),\n   349\t        (\"a!b!c\", \"a!b!c\"),\n   350\t        (\"https://example.org/a\", \"https://example.org/a\"),\n   351\t        (\"猫.龍\", \"猫.龍\"),\n   352\t        (\"path\\\\segment\", \"path\\\\segment\"),\n   353\t        (\"\", \"«»\"),\n   354\t        (\"two words\", \"«two words»\"),\n   355\t        (\";comment\", \"«;comment»\"),\n   356\t        (\"a;b\", \"«a;b»\"),\n   357\t        (\"{x}\", \"«{x}»\"),\n   358\t        (\"(x)\", \"«(x)»\"),\n   359\t        (\"«x»\", \"««x\\\\»»\"),\n   360\t    ] {\n   361\t        let text = value.to_owned().datomize(vec![]).protosize().textualize();\n   362\t        assert_eq!(text, canonical, \"canonical String for {value:?}\");\n   363\t        let rebuilt: String = Potential::from(text)\n   364\t            .actualize(&mut Budget {\n   365\t                remaining: 64,\n   366\t                reader: ReaderBudget { remaining: 256 },\n   367\t                depth: 0,\n   368\t                maximum_depth: 64,\n   369\t            })\n   370\t            .unwrap();\n   371\t        assert_eq!(rebuilt, value, \"String round trip for {canonical:?}\");\n   372\t    }\n   373\t}\n   374\t\n   375\t#[test]\n   376\tfn typed_enums_keep_bare_carried_and_daisy_variants() {\n   377\t    for (text, expected) in [\n   378\t        (\n   379\t            \"Reply.Accepted.{ 42 today }\",\n   380\t            Message::Reply(Reply::Accepted(42, \"today\".into())),\n   381\t        ),\n   382\t        (\"Reply.Pending\", Message::Reply(Reply::Pending)),\n   383\t    ] {\n   384\t        let value: Message = Potential::from(text)\n   385\t            .actualize(&mut Budget {\n   386\t                remaining: 16,\n   387\t                reader: ReaderBudget { remaining: 128 },\n   388\t                depth: 0,\n   389\t                maximum_depth: 16,\n   390\t            })\n   391\t            .unwrap();\n   392\t        assert_eq!(value, expected);\n   393\t        assert_eq!(value.datomize(vec![]).protosize().textualize(), text);\n   394\t    }\n   395\t}\n   396\t\n   397\t#[test]\n   398\tfn delimited_variant_shapes_do_not_compose_as_strings() {\n   399\t    let error = Potential::<String>::from(\"Head.{ x }\")\n   400\t        .actualize(&mut Budget {\n   401\t            remaining: 8,\n   402\t            reader: ReaderBudget { remaining: 128 },\n   403\t            depth: 0,\n   404\t            maximum_depth: 8,\n   405\t        })\n   406\t        .unwrap_err();\n   407\t    assert!(matches!(\n   408\t        error.kind,\n   409\t        ErrorKind::Form { ref expected, .. } if expected == \"String\"\n   410\t    ));\n   411\t}\n   412\t\n   413\t#[test]\n   414\tfn dotted_string_composition_obeys_depth_and_work_budgets() {\n   415\t    let dotted = Datom {\n   416\t        path: vec![],\n   417\t        form: Form::Variant(\n   418\t            protos::Symbol(\"One\".into()),\n   419\t            Box::new(Datom {\n   420\t                path: vec![1],\n   421\t                form: Form::Variant(\n   422\t                    protos::Symbol(\"Two\".into()),\n   423\t                    Box::new(Datom {\n   424\t                        path: vec![1, 1],\n   425\t                        form: Form::Variant(\n   426\t                            protos::Symbol(\"Three\".into()),\n   427\t                            Box::new(Datom {\n   428\t                                path: vec![1, 1, 1],\n   429\t                                form: Form::Bare(\"Four\".into()),\n   430\t                            }),\n   430\t                            }),\n   431\t                        ),\n   432\t                    }),\n   433\t                ),\n   434\t            }),\n   435\t        ),\n   436\t    };\n   437\t    let mut depth_budget = Budget {\n   438\t        remaining: 16,\n   439\t        reader: ReaderBudget { remaining: 16 },\n   440\t        depth: 0,\n   441\t        maximum_depth: 3,\n   442\t    };\n   443\t    let error = dotted.compose::<String>(&mut depth_budget).unwrap_err();\n   444\t    assert_eq!(error.kind, ErrorKind::Budget);\n   445\t    assert_eq!(depth_budget.depth, 0);\n   446\t\n   447\t    let mut work_budget = Budget {\n   448\t        remaining: 2,\n   449\t        reader: ReaderBudget { remaining: 16 },\n   450\t        depth: 0,\n   451\t        maximum_depth: 16,\n   452\t    };\n   453\t    let error = dotted.compose::<String>(&mut work_budget).unwrap_err();\n   454\t    assert_eq!(error.kind, ErrorKind::Budget);\n   455\t    assert_eq!(work_budget.depth, 0);\n   456\t}\n   457\t\n   458\t#[test]\n   459\tfn generic_containers_and_meaning_round_trip_their_forms() {\n   460\t    let value = Wrapper {\n   461\t        value: Some(Box::new(Meaning(\"nested (meaning)\".into()))),\n   462\t    };\n   463\t    let datom = value.datomize(vec![]);\n   464\t    assert_eq!(\n   465\t        datom.protosize().textualize(),\n   466\t        \"{ Some.(nested (meaning)) }\"\n   467\t    );\n   468\t    let rebuilt: Wrapper<Option<Box<Meaning>>> = datom\n   469\t        .compose(&mut Budget {\n   470\t            remaining: 10,\n   471\t            reader: ReaderBudget { remaining: 10 },\n   472\t            depth: 0,\n   473\t            maximum_depth: 4_096,\n   474\t        })\n   475\t        .unwrap();\n   476\t    assert_eq!(rebuilt, value);\n   477\t    let result: Result<i64, String> = Err(\"nope\".into());\n   478\t    let datom = result.datomize(vec![]);\n   479\t    assert_eq!(\n   480\t        datom\n   481\t            .compose::<Result<i64, String>>(&mut Budget {\n   482\t                remaining: 10,\n   483\t                reader: ReaderBudget { remaining: 10 },\n   484\t                depth: 0,\n   485\t                maximum_depth: 4_096\n   486\t            })\n   487\t            .unwrap(),\n   488\t        result\n   489\t    );\n   490\t}\n   491\t\n   492\t#[test]\n   493\tfn potential_reports_structural_and_budget_errors_at_their_context() {\n   494\t    let structural = Potential::<Score>::from(\"{ Ada\")\n   495\t        .actualize(&mut Budget {\n   496\t            remaining: 10,\n   497\t            reader: ReaderBudget { remaining: 128 },\n   498\t            depth: 0,\n   499\t            maximum_depth: 4_096,\n   500\t        })\n   501\t        .unwrap_err();\n   502\t    assert_eq!(structural.path, Vec::<i64>::new());\n   503\t    assert!(matches!(structural.kind, ErrorKind::Structural(_)));\n   504\t    let exhausted = Potential::<Score>::from(\"{ Ada 42 True }\")\n   505\t        .actualize(&mut Budget {\n   506\t            remaining: 0,\n   507\t            reader: ReaderBudget { remaining: 128 },\n   508\t            depth: 0,\n   509\t            maximum_depth: 4_096,\n   510\t        })\n   511\t        .unwrap_err();\n   512\t    assert_eq!(exhausted.path, Vec::<i64>::new());\n   513\t    assert_eq!(exhausted.kind, ErrorKind::Budget);\n   514\t}\n   515\t\n   516\t#[test]\n   517\tfn potential_refuses_before_composition_when_reader_budget_is_exhausted() {\n   518\t    let error = Potential::<String>::from(\"Ada\")\n   519\t        .actualize(&mut Budget {\n   520\t            remaining: 1,\n   521\t            reader: ReaderBudget { remaining: 0 },\n   522\t            depth: 0,\n   523\t            maximum_depth: 4_096,\n   524\t        })\n   525\t        .unwrap_err();\n   526\t    assert_eq!(error.path, Vec::<i64>::new());\n   527\t    assert!(matches!(error.kind, ErrorKind::Structural(_)));\n   528\t}\n   529\t\n   530\t#[test]\n   531\tfn unit_options_and_unit_enums_round_trip_as_bare_text() {\n   532\t    let value: Option<i64> = None;\n   533\t    assert_eq!(value.datomize(vec![]).protosize().textualize(), \"None\");\n   534\t    assert_eq!(\n   535\t        Potential::<Option<i64>>::from(\"None\")\n   536\t            .actualize(&mut Budget {\n   537\t                remaining: 1,\n   538\t                reader: ReaderBudget { remaining: 128 },\n   539\t                depth: 0,\n   540\t                maximum_depth: 4_096\n   541\t            })\n   542\t            .unwrap(),\n   543\t        None\n   544\t    );\n   545\t    assert_eq!(\n   546\t        Potential::<Reply>::from(\"Pending\")\n   547\t            .actualize(&mut Budget {\n   548\t                remaining: 1,\n   549\t                reader: ReaderBudget { remaining: 128 },\n   550\t                depth: 0,\n   551\t                maximum_depth: 4_096\n   552\t            })\n   553\t            .unwrap(),\n   554\t        Reply::Pending\n   555\t    );\n   556\t}\n   557\t\n   558\t#[test]\n   559\tfn datom_refuses_non_datom_structural_forms() {\n   560\t    let angled = Potential::<Vec<i64>>::from(\"< 1 2 >\")\n   561\t        .actualize(&mut Budget {\n   562\t            remaining: 10,\n   563\t            reader: ReaderBudget { remaining: 128 },\n   564\t            depth: 0,\n   565\t            maximum_depth: 4_096,\n   566\t        })\n   567\t        .unwrap_err();\n   568\t    assert!(matches!(\n   569\t        angled.kind,\n   570\t        ErrorKind::Form { ref expected, ref found }\n   571\t            if expected == \"Datom enclosure\" && found == \"Angled\"\n   572\t    ));\n   573\t\n   574\t    let positions = Potential::<Pair>::from(\"Values.[ 1 2 ]\")\n   575\t        .actualize(&mut Budget {\n   576\t            remaining: 10,\n   577\t            reader: ReaderBudget { remaining: 128 },\n   578\t            depth: 0,\n   579\t            maximum_depth: 4_096,\n   580\t        })\n   581\t        .unwrap_err();\n   582\t    assert!(matches!(\n   583\t        positions.kind,\n   584\t        ErrorKind::Form { ref expected, ref found }\n   585\t            if expected == \"Struct\" && found == \"Vector\"\n   586\t    ));\n   587\t}\n   588\t\n   589\t#[test]\n   590\tfn strings_quote_delimiters_keep_bare_separators_and_accept_temporary_meaning_text() {\n   591\t    for value in [\"a{b\", \"a;b\", \"a(b\"] {\n   592\t        let text = value.to_owned().datomize(vec![]).protosize().textualize();\n   593\t        assert!(text.starts_with('«'), \"{value}: {text}\");\n   594\t        assert_eq!(\n   595\t            Potential::<String>::from(text)\n   596\t                .actualize(&mut Budget {\n   597\t                    remaining: 1,\n   598\t                    reader: ReaderBudget { remaining: 128 },\n   599\t                    depth: 0,\n   600\t                    maximum_depth: 4_096\n   601\t                })\n   602\t                .unwrap(),\n   603\t            value\n   604\t        );\n   605\t    }\n   606\t    for value in [\"a.b\", \"a!b\", \"a:b\"] {\n   607\t        let text = value.to_owned().datomize(vec![]).protosize().textualize();\n   608\t        assert_eq!(text, value);\n   609\t        assert_eq!(\n   610\t            Potential::<String>::from(text)\n   611\t                .actualize(&mut Budget {\n   612\t                    remaining: 8,\n   613\t                    reader: ReaderBudget { remaining: 128 },\n   614\t                    depth: 0,\n   615\t                    maximum_depth: 8,\n   616\t                })\n   617\t                .unwrap(),\n   618\t            value\n   619\t        );\n   620\t    }\n   621\t    assert_eq!(\n   622\t        Potential::<String>::from(\"(temporary meaning)\")\n   623\t            .actualize(&mut Budget {\n   624\t                remaining: 1,\n   625\t                reader: ReaderBudget { remaining: 128 },\n   626\t                depth: 0,\n   627\t                maximum_depth: 4_096\n   628\t            })\n   629\t            .unwrap(),\n   630\t        \"temporary meaning\"\n   631\t    );\n   632\t}\n   633\t\n   634\t#[test]\n   635\tfn retained_reader_finds_nested_composition_fault_extents() {\n   636\t    let mut vector = Potential::<Vec<i64>>::from(\"[ 1 x ]\");\n   637\t    let error = vector\n   638\t        .actualize(&mut Budget {\n   639\t            remaining: 10,\n   640\t            reader: ReaderBudget { remaining: 128 },\n   641\t            depth: 0,\n   642\t            maximum_depth: 4_096,\n   643\t        })\n   644\t        .unwrap_err();\n   645\t    assert_eq!(error.path, vec![1]);\n   646\t    assert_eq!(\n   647\t        vector.reader_extent(&error.path),\n   648\t        Some(protos::Extent { start: 4, end: 5 })\n   649\t    );\n   650\t\n   651\t    let mut variant = Potential::<Pair>::from(\"Values.{ 1 x }\");\n   652\t    let error = variant\n   653\t        .actualize(&mut Budget {\n   654\t            remaining: 10,\n   655\t            reader: ReaderBudget { remaining: 128 },\n   656\t            depth: 0,\n   657\t            maximum_depth: 4_096,\n   658\t        })\n   659\t        .unwrap_err();\n   660\t    assert_eq!(error.path, vec![1, 1]);\n   661\t    assert_eq!(\n   662\t        variant.reader_extent(&error.path),\n   663\t        Some(protos::Extent { start: 11, end: 12 })\n   664\t    );\n   665\t}\n   666\t\n   667\t#[test]\n   668\tfn typed_protos_errors_round_trip_without_a_reader_tree() {\n   669\t    let error = protos::Error {\n   670\t        extent: protos::Extent { start: 3, end: 4 },\n   671\t        problem: protos::Problem::Unexpected('@'),\n   672\t    };\n   673\t    let datom = error.datomize(vec![]);\n   674\t    let text = datom.protosize().textualize();\n   675\t    let rebuilt: protos::Error = Potential::from(text)\n   676\t        .actualize(&mut Budget {\n   677\t            remaining: 20,\n   678\t            reader: ReaderBudget { remaining: 128 },\n   679\t            depth: 0,\n   680\t            maximum_depth: 4_096,\n   681\t        })\n   682\t        .unwrap();\n   683\t    assert_eq!(rebuilt, error);\n   684\t}\n   685\t\n   686\t#[derive(Debug, PartialEq, Compositional, Datomizable)]\n   687\tenum GenericReply<T> {\n   688\t    Pending,\n   689\t    One(T),\n   690\t    Pair(T, i64),\n","exit_code":0,"status":"completed"}}
