+            children: Children(vec![]),
+        }]),
+    };
+    let bytes = rkyv::to_bytes::<rkyv::rancor::Error>(&node).expect("archive node");
+    let restored = rkyv::from_bytes::<Node, rkyv::rancor::Error>(&bytes).expect("restore node");
+    assert_eq!(restored, node);
+}
