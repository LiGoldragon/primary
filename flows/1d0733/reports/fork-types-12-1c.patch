                         Problem::Cycle(identity.name.0.clone()),
                     ));
                 }
-                Ok(())
+                aliased.wraps(&inner)
+            }
+        }
+    }
+}
+
+/// The kind whose capability refuses a new type over a Vector or an Option,
+/// `WrapsContainer`: the container is written inline where it is used.
+trait Wrapping {
+    fn wraps(&self, scope: &Scope) -> Result<(), Error>;
+}
+
+impl Wrapping for Reference {
+    fn wraps(&self, scope: &Scope) -> Result<(), Error> {
+        if self.source.is_some() {
+            return Ok(());
+        }
+        match scope.resolve(&self.name) {
+            Resolution::Intrinsic(Intrinsic::Vector | Intrinsic::Option) => {
+                Err(Error::conceptual(vec![], Problem::WrapsContainer))
             }
+            _ => Ok(()),
         }
     }
 }
