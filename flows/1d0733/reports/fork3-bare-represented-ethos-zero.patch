+impl Bindings for [Protos] {
+    fn bindings(&self) -> Result<Vec<Binding>, Error> {
+        let mut values = Vec::new();
+        for (node, arguments, index) in self.constrained() {
+            let Protos::Headed {
+                head,
+                constraints: None,
+                separator: Separator::Period,
+                body,
+                ..
+            } = node
+            else {
+                return Err(Error::conceptual(
+                    vec![index as Integer],
+                    Problem::Expected(Form::Association),
+                ));
+            };
+            let mut ty: Reference = body.conceive().place(1).place(index as Integer)?;
+            if let Some(children) = arguments {
+                ty.arguments = children.references().place((index + 1) as Integer)?;
+            }
+            values.push(Binding {
+                name: head.name().place(0).place(index as Integer)?,
+                ty,
+            });
+        }
+        Ok(values)
+    }
