+/// An associated trait must name a trait: a name the file declares as a type, or
+/// an intrinsic type, is refused as no trait. Each binding names an
+/// associated type once, one the trait declares where the file declares the
+/// trait, and binds it to a type.
+impl Checkable for AssociatedTrait {
+    fn check(&self, scope: &Scope) -> Result<(), Error> {
+        let typed = match scope.resolve(&self.bound.name) {
+            Resolution::Type(_) => self.bound.source.is_none(),
+            Resolution::Intrinsic(intrinsic) => {
+                self.bound.source.is_none() && intrinsic.role() == Role::Type
+            }
+            _ => false,
+        };
+        // The name is the head of an associated trait with bindings, the element itself without.
+        let head = if self.bindings.is_empty() {
+            vec![]
+        } else {
+            vec![0]
+        };
+        if typed {
+            return Err(Error::conceptual(
+                head,
+                Problem::Expected(crate::Form::Trait),
+            ));
+        }
+        if self.bindings.is_empty() {
+            return self.bound.refer(scope, Role::Trait);
+        }
+        self.bound.refer(scope, Role::Trait).place(0)?;
+        let declared = scope.file.trait_declaration(&self.bound.name);
+        let mut at = 0;
+        for (index, binding) in self.bindings.iter().enumerate() {
+            if self.bindings[..index]
+                .iter()
+                .any(|earlier| earlier.name == binding.name)
+            {
+                return Err(Error::conceptual(
+                    vec![1, at, 0],
+                    Problem::Duplicate(binding.name.0.clone()),
+                ));
+            }
+            if let Some(declaration) = declared {
+                let associated = match &declaration.body {
+                    TraitBody::Complex { types, .. } => types.as_slice(),
+                    TraitBody::Simple(_) => &[],
+                };
+                if !associated.iter().any(|ty| ty.name == binding.name) {
+                    return Err(Error::conceptual(
+                        vec![1, at, 0],
+                        Problem::Undeclared(binding.name.0.clone()),
+                    ));
+                }
+            }
+            binding
+                .ty
+                .refer(scope, Role::Type)
+                .lifted(1)
+                .beside(at)
+                .place(1)?;
