+//! Types with a special representation, declared in ethos.
+//!
+//! An association binds the associated type of the trait a type bears:
+//! `Ticket.[ Represented.{ Representation.Vector<Digit> } ]`. The generator
+//! derives datom-codec's `Represented` for the type in place of
+//! `Datomizable` and `Composing`, and asserts at compile time that the
+//! type's representation is the one bound. The two conversions are
+//! hand-written in the sibling module `representation` below; a hand-written
+//! impl naming another representation fails to compile.
+
+// The fixture imports `datom:[ Represented ]`; here `datom` is datom-codec.
+extern crate datom_codec as datom;
+
+use datom_codec::{
+    Actualizing as DatomActualizing, Budget, Composing, Datomizable, Error as DatomError, Path,
+    Potential as DatomPotential, Represented,
+};
+use ethos_zero::{Actualizing, Error, File, Form, Generating, Potential, Printable, Problem};
+use protos::{Protosizable, ReaderBudget, Textualizable};
+
+#[path = "generated/represented-types.rs"]
+mod represented_types;
+
+use represented_types::{Digest, Digit, Ticket};
+
+/// The conversions of each represented type, hand-written beside the
+/// generated module.
+mod representation {
+    use super::represented_types::{Digest, Digit, Ticket};
+    use datom_codec::{ErrorKind, Represented};
+
+    fn refused(expected: &str, value: String) -> ErrorKind {
+        ErrorKind::Value {
+            expected: expected.to_owned(),
+            value,
+        }
+    }
+
+    /// A ticket is written as its decimal digits, each a Digit from 0 to 9;
+    /// a negative ticket negates its first digit. No digits, a leading zero
+    /// on more than one digit, and a digit out of range are refused.
+    impl Represented for Ticket {
+        type Representation = Vec<Digit>;
+        fn represent(&self) -> Vec<Digit> {
+            let mut digits: Vec<Digit> = self
+                .0
+                .unsigned_abs()
+                .to_string()
+                .bytes()
+                .map(|digit| Digit(i64::from(digit - b'0')))
+                .collect();
+            if self.0 < 0 {
+                digits[0].0 = -digits[0].0;
+            }
+            digits
+        }
+        fn from_representation(digits: Vec<Digit>) -> Result<Self, ErrorKind> {
+            let mut spelled = String::new();
+            for (index, digit) in digits.iter().enumerate() {
+                match digit.0 {
+                    0..=9 => spelled.push(char::from(b'0' + digit.0 as u8)),
+                    -9..=-1 if index == 0 => {
+                        spelled.push('-');
+                        spelled.push(char::from(b'0' + (-digit.0) as u8));
+                    }
+                    _ => return Err(refused("Ticket", format!("{digits:?}"))),
+                }
+            }
+            let unsigned = spelled.trim_start_matches('-');
+            if unsigned.is_empty() || (unsigned.len() > 1 && unsigned.starts_with('0')) {
+                return Err(refused("Ticket", spelled));
+            }
+            spelled
+                .parse()
+                .map(Ticket)
+                .map_err(|_| refused("Ticket", spelled))
+        }
+    }
+
+    /// A digest is written as the sixteen lowercase hex digits of its bits.
+    impl Represented for Digest {
+        type Representation = String;
+        fn represent(&self) -> String {
+            format!("{:016x}", self.0 as u64)
+        }
+        fn from_representation(hex: String) -> Result<Self, ErrorKind> {
+            let lower = hex
+                .bytes()
+                .all(|digit| matches!(digit, b'0'..=b'9' | b'a'..=b'f'));
+            if hex.len() != 16 || !lower {
+                return Err(refused("Digest", hex));
+            }
+            u64::from_str_radix(&hex, 16)
+                .map(|bits| Digest(bits as i64))
+                .map_err(|_| refused("Digest", hex))
+        }
+    }
+}
+
+/// The form as designed, word for word.
+const DESIGNED: &str = "Library
+[ datom:[ Represented ] ]
+[ Ticket.Integer Digit.Integer ]
+[]
+[ Ticket.[ Represented.{ Representation.Vector<Digit> } ] ]";
+
+/// The text of `Ticket(42)`: its Vector of Digits, as this datom-codec
+/// prints a Digit, a new type over an Integer.
+const TICKET_TEXT: &str = "[ 4 2 ]";
+
+/// The text of `Digest(42)`: its String.
+const DIGEST_TEXT: &str = "000000000000002a";
+
+fn budget() -> Budget {
+    Budget {
+        remaining: 4_096,
+        reader: ReaderBudget { remaining: 4_096 },
+        depth: 0,
+        maximum_depth: 4_096,
+    }
+}
+
+fn text_of<T: Datomizable>(value: &T) -> String {
+    value.datomize(Path::new()).protosize().textualize()
+}
+
+fn read<T: Composing>(text: &str) -> Result<T, DatomError> {
+    DatomPotential::<T>::from(text).actualize(&mut budget())
+}
+
+fn file_of(source: &str) -> File {
+    match Potential::<File>::from(source).actualize() {
+        Ok(file) => file,
+        Err(error) => panic!("{source} does not read: {error:?}"),
+    }
+}
+
+fn refusal_of(source: &str) -> (Vec<i64>, Problem) {
+    match file_of(source).generate() {
+        Err(Error::Conceptual(data)) => (data.integer_vector, data.problem),
+        other => panic!("{source} is not refused conceptually: {other:?}"),
+    }
+}
+
+fn generated(source: &str) -> String {
+    match file_of(source).generate() {
+        Ok(rust) => rust,
+        Err(error) => panic!("{source} does not generate: {error:?}"),
+    }
+}
+
+/// The attribute lines of the generated item that declares `item`.
+fn attributes_of<'a>(rust: &'a str, item: &str) -> Vec<&'a str> {
+    let lines: Vec<&str> = rust.lines().collect();
+    let at = lines
+        .iter()
+        .position(|line| line.starts_with(item))
+        .unwrap_or_else(|| panic!("{item} is not generated"));
+    let mut attributes = Vec::new();
+    for line in lines[..at].iter().rev() {
+        if !line.starts_with("#[") {
+            break;
+        }
+        attributes.push(*line);
+    }
+    attributes
+}
+
+#[test]
+fn the_designed_form_is_accepted_and_reprints() {
+    let file = file_of(DESIGNED);
+    let rust = generated(DESIGNED);
+    assert!(rust.contains("pub struct Ticket(pub i64);"), "{rust}");
+    assert!(
+        rust.contains("T: datom::Represented<Representation = std::vec::Vec<Digit>>"),
+        "{rust}"
+    );
+    assert!(
+        rust.contains("let _ = assert_ticket_represented::<Ticket>;"),
+        "{rust}"
+    );
+    let printed = file.print();
+    assert_eq!(file_of(&printed), file, "{printed}");
+}
+
+#[test]
+fn bindings_after_a_name_that_is_no_trait_are_refused_as_no_trait() {
+    // A declared type.
+    let (path, problem) = refusal_of(
+        "Library [] [ Ticket.Integer Digit.Integer ] [] [ Ticket.[ Digit.{ Representation.String } ] ]",
+    );
+    assert_eq!(problem, Problem::Expected(Form::Trait));
+    assert_eq!(path, vec![1, 3, 0, 1, 0, 0]);
+    // A declared type named Represented, with an empty brace.
+    let (path, problem) = refusal_of(
+        "Library [] [ Represented.Integer Ticket.Integer ] [] [ Ticket.[ Represented.{ } ] ]",
+    );
+    assert_eq!(problem, Problem::Expected(Form::Trait));
+    assert_eq!(path, vec![1, 3, 0, 1, 0]);
+    // An intrinsic type.
+    let (path, problem) = refusal_of(
+        "Library [] [ Ticket.Integer ] [] [ Ticket.[ String.{ Representation.String } ] ]",
+    );
+    assert_eq!(problem, Problem::Expected(Form::Trait));
+    assert_eq!(path, vec![1, 3, 0, 1, 0, 0]);
+}
+
+#[test]
+fn a_binding_names_an_associated_type_of_a_declared_trait_once() {
+    let traits = "[ Shown.{ [] [ Shape ] [] [ show.[ Shape ] ] } ]";
+    let accepted =
+        format!("Library [] [ Ticket.Integer ] {traits} [ Ticket.[ Shown.{{ Shape.String }} ] ]");
+    let rust = generated(&accepted);
+    assert!(rust.contains("T: Shown<Shape = String>"), "{rust}");
+    let (path, problem) = refusal_of(&format!(
+        "Library [] [ Ticket.Integer ] {traits} [ Ticket.[ Shown.{{ Form.String }} ] ]"
+    ));
+    assert_eq!(problem, Problem::Undeclared("Form".to_owned()));
+    assert_eq!(path, vec![1, 3, 0, 1, 0, 1, 0, 0]);
+    let (path, problem) = refusal_of(&format!(
+        "Library [] [ Ticket.Integer ] {traits} [ Ticket.[ Shown.{{ Shape.String Shape.Integer }} ] ]"
+    ));
+    assert_eq!(problem, Problem::Duplicate("Shape".to_owned()));
+    assert_eq!(path, vec![1, 3, 0, 1, 0, 1, 1, 0]);
+}
+
+#[test]
+fn a_represented_type_derives_represented_in_place_of_the_datom_derives() {
+    let root = env!("CARGO_MANIFEST_DIR");
+    let rust =
+        std::fs::read_to_string(format!("{root}/tests/generated/represented-types.rs")).unwrap();
+    for item in ["pub struct Ticket(", "pub struct Digest("] {
+        let attributes = attributes_of(&rust, item).join("\n");
+        assert!(
+            attributes.contains("#[cfg_attr(feature = \"datom\", derive(datom::Represented))]"),
+            "{item}: {attributes}"
+        );
+        assert!(!attributes.contains("Datomizable"), "{item}: {attributes}");
+        assert!(!attributes.contains("Composing"), "{item}: {attributes}");
+    }
+    let digit = attributes_of(&rust, "pub struct Digit(").join("\n");
+    assert!(
+        digit.contains("derive(datom_codec::Datomizable, datom_codec::Composing)"),
+        "{digit}"
+    );
+    assert!(!digit.contains("Represented"), "{digit}");
+}
+
+#[test]
+fn the_derive_and_the_assertion_name_the_source_as_written() {
+    for source in ["datom", "datom_codec"] {
+        let rust = generated(&format!(
+            "Library [ {source}:[ Represented ] ] [ Ticket.Integer ] [] \
+             [ Ticket.[ Represented.{{ Representation.String }} ] ]"
+        ));
+        let attributes = attributes_of(&rust, "pub struct Ticket(").join("\n");
+        assert!(
+            attributes.contains(&format!(
+                "#[cfg_attr(feature = \"datom\", derive({source}::Represented))]"
+            )),
+            "{source}: {attributes}"
+        );
+        assert!(
+            rust.contains(&format!(
+                "T: {source}::Represented<Representation = String>"
+            )),
+            "{source}: {rust}"
+        );
+        let other = if source == "datom" {
+            "datom_codec::Represented"
+        } else {
+            "datom::Represented"
+        };
+        assert!(!rust.contains(other), "{source}: {rust}");
+    }
+}
+
+#[test]
+fn a_ticket_is_written_as_its_digits_and_read_back() {
+    assert_eq!(text_of(&Ticket(42)), TICKET_TEXT);
+    assert_eq!(text_of(&Ticket(42)), text_of(&Ticket(42).represent()));
+    assert_eq!(
+        Ticket(42).datomize(Path::new()),
+        vec![Digit(4), Digit(2)].datomize(Path::new())
+    );
+    assert_eq!(read::<Ticket>(TICKET_TEXT).unwrap(), Ticket(42));
+    for ticket in [0, 7, 42, -42, i64::MAX, i64::MIN] {
+        let text = text_of(&Ticket(ticket));
+        assert_eq!(read::<Ticket>(&text).unwrap(), Ticket(ticket), "{text}");
+    }
+    for refused in [
+        vec![],
+        vec![Digit(0), Digit(4)],
+        vec![Digit(12)],
+        vec![Digit(4), Digit(-2)],
+    ] {
+        let text = text_of(&refused);
+        assert!(read::<Ticket>(&text).is_err(), "{text} is read as a ticket");
+    }
+}
+
+#[test]
+fn a_digest_is_written_as_its_hex_string_and_read_back() {
+    assert_eq!(text_of(&Digest(42)), DIGEST_TEXT);
+    assert_eq!(
+        Digest(42).datomize(Path::new()),
+        "000000000000002a".to_owned().datomize(Path::new())
+    );
+    assert_eq!(read::<Digest>(DIGEST_TEXT).unwrap(), Digest(42));
+    for digest in [0, 42, -1, i64::MAX, i64::MIN] {
+        let text = text_of(&Digest(digest));
+        assert_eq!(read::<Digest>(&text).unwrap(), Digest(digest), "{text}");
+    }
+    for refused in [
+        "2a",
+        "000000000000002A",
+        "00000000000000zz",
+        "0000000000000002a",
+    ] {
+        let text = text_of(&refused.to_owned());
+        assert!(read::<Digest>(&text).is_err(), "{text} is read as a digest");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Compile-time: the generated assertion against hand-written impls
+// ---------------------------------------------------------------------------
+
+/// What a crate of a generated module and a hand-written sibling came to.
+struct Compiled {
+    success: bool,
+    stderr: String,
+}
+
+/// Compile a library crate of the module generated from `source` and a
+/// sibling module holding `beside`, against the datom-codec and rkyv this
+/// test was built with, the `datom` feature on.
+fn compile(name: &str, source: &str, beside: &str) -> Compiled {
+    let deps = std::env::current_exe()
+        .unwrap()
+        .parent()
+        .unwrap()
+        .to_path_buf();
+    let dir = std::env::temp_dir().join(format!("ethos-represented-{name}-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(dir.join("generated.rs"), generated(source)).unwrap();
+    std::fs::write(
+        dir.join("lib.rs"),
+        format!(
+            "extern crate datom_codec;\n\
+             extern crate datom_codec as datom;\n\
+             extern crate rkyv;\n\
+             pub struct Opaque;\n\
+             #[path = \"generated.rs\"]\n\
+             pub mod generated;\n\
+             pub mod representation {{\n\
+             use super::generated::*;\n\
+             use datom_codec::{{ErrorKind, Represented}};\n\
+             {beside}\n\
+             }}\n"
+        ),
+    )
+    .unwrap();
+    let rustc = std::env::var("RUSTC").unwrap_or_else(|_| "rustc".to_owned());
+    let output = std::process::Command::new(rustc)
+        .arg("--edition=2024")
+        .arg("--crate-type=lib")
+        .arg("--crate-name=represented_probe")
+        .arg("--cfg")
+        .arg("feature=\"datom\"")
+        .arg("--emit=metadata")
+        .arg("-L")
+        .arg(format!("dependency={}", deps.display()))
+        .arg("--extern")
+        .arg(format!(
+            "datom_codec={}",
+            rlib(&deps, "datom_codec").display()
+        ))
+        .arg("--extern")
+        .arg(format!("rkyv={}", rlib(&deps, "rkyv").display()))
+        .arg("--out-dir")
+        .arg(&dir)
+        .arg(dir.join("lib.rs"))
+        .output()
+        .unwrap();
+    let _ = std::fs::remove_dir_all(&dir);
+    Compiled {
+        success: output.status.success(),
+        stderr: String::from_utf8_lossy(&output.stderr).into_owned(),
+    }
+}
+
+/// The newest rlib of the crate `name` among this test's dependencies: a
+/// check build leaves metadata-only candidates of the same crate beside it.
+fn rlib(deps: &std::path::Path, name: &str) -> std::path::PathBuf {
+    let prefix = format!("lib{name}-");
+    let mut found: Vec<(std::time::SystemTime, std::path::PathBuf)> = Vec::new();
+    for entry in std::fs::read_dir(deps).unwrap() {
+        let path = entry.unwrap().path();
+        let file = path.file_name().unwrap().to_string_lossy().into_owned();
+        if file.starts_with(&prefix) && file.ends_with(".rlib") {
+            found.push((path.metadata().unwrap().modified().unwrap(), path));
+        }
+    }
+    found.sort();
+    match found.pop() {
+        Some((_, path)) => path,
+        None => panic!("no rlib of {name} in {}", deps.display()),
+    }
+}
+
+/// A Ticket impl whose representation is `$representation`, converting
+/// through `$represent` and refusing every representation read.
+fn ticket_impl(representation: &str, represent: &str) -> String {
+    format!(
+        "impl Represented for Ticket {{\n\
+         type Representation = {representation};\n\
+         fn represent(&self) -> {representation} {{ {represent} }}\n\
+         fn from_representation(_: {representation}) -> Result<Self, ErrorKind> {{\n\
+         Err(ErrorKind::Value {{ expected: \"Ticket\".to_owned(), value: String::new() }})\n\
+         }}\n\
+         }}"
+    )
+}
+
+#[test]
+fn a_hand_written_impl_with_another_representation_fails_to_compile() {
+    let right = compile(
+        "right",
+        DESIGNED,
+        &ticket_impl("Vec<Digit>", "vec![Digit(self.0)]"),
+    );
+    assert!(
+        right.success,
+        "the bound representation compiles:\n{}",
+        right.stderr
+    );
+    let wrong = compile(
+        "wrong",
+        DESIGNED,
+        &ticket_impl("String", "self.0.to_string()"),
+    );
+    assert!(!wrong.success, "another representation compiles");
+    assert!(wrong.stderr.contains("E0271"), "{}", wrong.stderr);
+    assert!(
+        wrong.stderr.contains("assert_ticket_represented"),
+        "{}",
+        wrong.stderr
+    );
+}
+
+/// The generated assertion pins the Representation: an impl naming another
+/// Representation fails it with E0271. rustc enforces the trait's bounds at
+/// the impl: an impl whose Representation is outside them fails there with
+/// E0277, even where it is the Representation the assertion pins.
+#[test]
+fn the_assertion_pins_the_representation_and_rustc_enforces_the_bounds_at_the_impl() {
+    // `Opaque` is neither Datomizable nor Composing.
+    let source = "Library
+[ datom:[ Represented ] super:[ Opaque ] ]
+[ Ticket.Integer ]
+[]
+[ Ticket.[ Represented.{ Representation.Opaque } ] ]";
+    let rust = generated(source);
+    assert!(
+        rust.contains("T: datom::Represented<Representation = super::Opaque>"),
+        "{rust}"
+    );
+    // Another Representation fails the pin.
+    let another = compile(
+        "another",
+        source,
+        &ticket_impl("String", "self.0.to_string()"),
+    );
+    assert!(!another.success, "another representation compiles");
+    assert!(another.stderr.contains("E0271"), "{}", another.stderr);
+    assert!(
+        another.stderr.contains("assert_ticket_represented"),
+        "{}",
+        another.stderr
+    );
+    assert!(!another.stderr.contains("E0277"), "{}", another.stderr);
+    // The pinned Representation, outside the bounds, fails at the impl.
+    let outside = compile(
+        "outside",
+        source,
+        &ticket_impl("super::Opaque", "super::Opaque"),
+    );
+    assert!(!outside.success, "an impl outside the bounds compiles");
+    assert!(outside.stderr.contains("E0277"), "{}", outside.stderr);
+    assert!(
+        outside.stderr.contains("Opaque: Composing")
+            && outside.stderr.contains("Opaque: Datomizable"),
+        "{}",
+        outside.stderr
+    );
+    assert!(
+        outside.stderr.contains("Represented::Representation"),
+        "{}",
+        outside.stderr
+    );
+    assert!(!outside.stderr.contains("E0271"), "{}", outside.stderr);
+}
