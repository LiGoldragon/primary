         else {
             return Err(Error::conceptual(vec![], Problem::Expected(Form::Import)));
         };
-        let source = Source::try_from(head.0.as_str())
+        // A chain of colon heads, `std:sync:Mutex`, folds into one source
+        // path, `std::sync`; the last body is the imported name or list.
+        let mut path = head.0.clone();
+        let mut body = body.as_ref();
+        let mut depth = 1;
+        while let Protos::Headed {
+            head,
+            separator: Separator::Colon,
+            body: inner,
+            ..
+        } = body
+        {
+            path.push_str("::");
+            path.push_str(&head.0);
+            body = inner.as_ref();
+            depth += 1;
+        }
+        let source = Source::try_from(path.as_str())
             .map_err(|text| Error::conceptual(vec![0], Problem::Name(text)))?;
         if let Some(children) = body.children(Enclosure::Bracketed) {
-            Ok(Import::Many(source, Protos::list(children).place(1)?))
+            let imported: Result<Vec<Imported>, Error> = Protos::list(children);
+            Ok(Import::Many(
+                source,
+                (0..depth).fold(imported, |result, _| result.place(1))?,
+            ))
         } else {
-            Ok(Import::One(source, body.conceive().place(1)?))
+            let imported: Result<Imported, Error> = body.conceive();
+            Ok(Import::One(
+                source,
+                (0..depth).fold(imported, |result, _| result.place(1))?,
+            ))
         }
     }
 }
