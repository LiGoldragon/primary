+
+#[test]
+fn a_multi_segment_import_reaches_its_path() {
+    let file = read(
+        "Library [ std:sync:Mutex ] [ Flow.String Nexus.{ Mutex<Vector<Flow>> Integer } ] [] []",
+    );
+    assert_eq!(file, read(&file.protosize().textualize()));
+    let rust = match file.generate() {
+        Ok(rust) => rust,
+        Err(_) => panic!("a multi-segment import generates"),
+    };
+    assert!(
+        rust.contains("pub flow_vector_mutex: std::sync::Mutex<std::vec::Vec<Flow>>,"),
+        "{rust}"
+    );
+    syn::parse_file(&rust).expect("generated Rust parses");
+}
