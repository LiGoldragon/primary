+
+#[test]
+fn a_core_source_is_refused() {
+    for (source, path) in [
+        (
+            "Library [ core:[ Name ] ] [ Topic.core:Name Holder.{ Label.core:Name Name } ] [] []",
+            vec![1, 0, 0, 0],
+        ),
+        ("Library [] [ Topic.core:Name ] [] []", vec![1, 1, 0, 1, 0]),
+        (
+            "Library [] [ Holder.{ Label.core:Name } ] [] []",
+            vec![1, 1, 0, 1, 0, 1, 0],
+        ),
+    ] {
+        match Potential::<File>::from(source).actualize() {
+            Err(Error::Conceptual(data)) => {
+                assert_eq!(data.problem, Problem::Source("core".to_owned()), "{source}");
+                assert_eq!(data.integer_vector, path, "{source}");
+            }
+            Err(Error::Structural(_)) => panic!("{source} is a conceptual refusal"),
+            Ok(_) => panic!("{source} must be refused"),
+        }
+    }
+}
+
+#[test]
+fn other_sources_keep_their_emission_beside_the_core_refusal() {
+    let file = read(
+        "Library [] [ Topic.protos:Name Other.custom:Name Holder.{ std:Mutex<String> } ] [] []",
+    );
+    let generated = match file.generate() {
+        Ok(generated) => generated,
+        Err(_) => panic!("non-core sources generate"),
+    };
+    for text in ["protos::Name", "custom::Name", "std::Mutex<String>"] {
+        assert!(generated.contains(text), "{text} missing from {generated}");
+    }
+}
