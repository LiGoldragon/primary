+#[test]
+fn a_name_over_a_container_reads_as_the_container_in_datom() {
+    use datom_codec::{Actualizing, Budget, Datomizable, Potential};
+    use protos::{Protosizable, ReaderBudget, Textualizable};
+
+    let paths = orchestrate::LockPaths(vec![
+        orchestrate::LockPath("a".to_owned()),
+        orchestrate::LockPath("b".to_owned()),
+    ]);
+    let text = paths.clone().datomize(vec![]).protosize().textualize();
+    assert_eq!(text, "[ a b ]");
+    let mut pending = Potential::<orchestrate::LockPaths>::from(text);
+    assert_eq!(
+        pending
+            .actualize(&mut Budget {
+                remaining: 1024,
+                reader: ReaderBudget { remaining: 1024 },
+                depth: 0,
+                maximum_depth: 1024,
+            })
+            .expect("restore container datom"),
+        paths
+    );
+}
