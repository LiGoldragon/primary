+/// The kind whose capability refuses a new type over a type declared in the
+/// file: over a struct or an enum, `WrapsStructure`; over a new type,
+/// `DoubleWrap`.
+trait Wrapping {
+    fn wraps(&self, scope: &Scope) -> Result<(), Error>;
+}
+
+impl Wrapping for Reference {
+    fn wraps(&self, scope: &Scope) -> Result<(), Error> {
+        if self.source.is_some() {
+            return Ok(());
+        }
+        match scope.resolve(&self.name) {
+            Resolution::Type(name) => match scope.file.declaration(&name) {
+                Some(TypeDeclaration::NewType(_, _)) => {
+                    Err(Error::conceptual(vec![], Problem::DoubleWrap))
+                }
+                Some(_) => Err(Error::conceptual(vec![], Problem::WrapsStructure)),
+                None => Ok(()),
+            },
+            _ => Ok(()),
+        }
+    }
+}
