+/// A registry entry: a source an ethos file may name, and the Rust path it
+/// compiles to, which generation writes in its place.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Registered {
+    /// The source as ethos writes it: `flow`.
+    pub name: String,
+    /// The Rust path it compiles to: `signal_flow`.
+    pub emitted: String,
+}
+
+/// The sources an ethos file may name. A source with no entry, or whose
+/// entry's emission is not a Rust path, is refused at its head.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Registry {
+    /// The entries, looked up by source name.
+    pub entries: Vec<Registered>,
+}
+
+/// The trait whose capability yields the Rust path a source compiles to, if registered.
+pub trait Registering {
+    /// The emission of the source's entry, validated as a Rust path.
+    fn emission(&self, source: &Source) -> Option<Source>;
+}
+
+impl Registering for Registry {
+    fn emission(&self, source: &Source) -> Option<Source> {
+        for entry in &self.entries {
+            if entry.name == source.as_ref() {
+                return Source::try_from(entry.emitted.as_str()).ok();
+            }
+        }
+        None
+    }
+}
+
+impl<'a> FromIterator<(&'a str, &'a str)> for Registry {
+    fn from_iter<I: IntoIterator<Item = (&'a str, &'a str)>>(entries: I) -> Self {
+        let mut registry = Registry::default();
+        for (name, emitted) in entries {
+            registry.entries.push(Registered {
+                name: name.to_owned(),
+                emitted: emitted.to_owned(),
+            });
+        }
+        registry
+    }
+}
