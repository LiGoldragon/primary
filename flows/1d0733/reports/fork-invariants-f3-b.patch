+
+#[test]
+fn a_multi_segment_import_is_refused() {
+    let source = "Library [ std::sync:Mutex ] [ Holder.{ Mutex<String> Integer } ] [] []";
+    match Potential::<File>::from(source).actualize() {
+        Err(Error::Conceptual(data)) => {
+            assert_eq!(data.problem, Problem::Expected(Form::Import));
+            assert_eq!(data.integer_vector, vec![1, 0, 0]);
+        }
+        Err(Error::Structural(_)) => panic!("{source} is a conceptual refusal"),
+        Ok(_) => panic!("{source} must be refused"),
+    }
+}
