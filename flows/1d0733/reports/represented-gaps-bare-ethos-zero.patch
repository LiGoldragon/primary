+/// A dependency that publishes ethos declarations: the source it is written
+/// under, and the text of each of its declaration files, embedded by the
+/// build script from the dependency Cargo built against.
+pub(crate) struct Dependency {
+    source: &'static str,
+    declarations: &'static [&'static str],
+}
+
+/// Every dependency that publishes ethos declarations, each declaration read
+/// as a file: the authority on the role of a name it declares.
+pub(crate) struct Dependencies(Vec<(&'static str, File)>);
+
+/// The trait whose capability yields the dependencies, read once.
+pub(crate) trait Knowing {
+    /// The dependencies' declarations, read on first use.
+    fn known() -> &'static Self;
+    /// The role a source's own declarations give a name: a type its types
+    /// section declares, or a trait its traits section declares. A name the
+    /// source imports, or does not declare, has none.
+    fn role(&self, source: &Source, name: &Name) -> Option<Role>;
+}
+
+impl Knowing for Dependencies {
+    fn known() -> &'static Self {
+        static DEPENDENCIES: &[Dependency] = include!(concat!(env!("OUT_DIR"), "/dependencies.rs"));
+        static KNOWN: OnceLock<Dependencies> = OnceLock::new();
+        KNOWN.get_or_init(|| {
+            let mut files = Vec::new();
+            for dependency in DEPENDENCIES {
+                for declaration in dependency.declarations {
+                    // A declaration is read to its concept and no further:
+                    // the roles of its own imports are not learned, and its
+                    // validity is the dependency-ethos check's to witness.
+                    let Ok(canonical) = declaration.to_string().canonicalize() else {
+                        continue;
+                    };
+                    let Ok(protos) = canonical.text.protosize() else {
+                        continue;
+                    };
+                    if let Ok(file) = <Protos as Conceiving<File>>::conceive(&protos) {
+                        files.push((dependency.source, file));
+                    }
+                }
+            }
+            Dependencies(files)
+        })
+    }
+
+    fn role(&self, source: &Source, name: &Name) -> Option<Role> {
+        for (written, file) in &self.0 {
+            if *written != source.as_ref() {
+                continue;
+            }
+            match file.resolve(name) {
+                Resolution::Type(_) => return Some(Role::Type),
+                Resolution::Trait(_) => return Some(Role::Trait),
+                _ => {}
+            }
+        }
+        None
+    }
+}
+
+/// The trait whose capability learns the role of every imported name from
+/// its source's own declarations.
+trait Learning {
+    fn learn(&mut self, dependencies: &Dependencies);
+}
+
+impl Learning for File {
+    fn learn(&mut self, dependencies: &Dependencies) {
+        let imports = match self {
+            File::Library(library) => &mut library.imports,
+            File::Signal(signal) => &mut signal.imports,
+            File::Operation(operation) => &mut operation.imports,
+            File::Memory(memory) => &mut memory.imports,
+        };
+        for import in imports {
+            match import {
+                Import::One(source, imported) => {
+                    imported.role = dependencies.role(source, &imported.emitted);
+                }
+                Import::Many(source, imported) => {
+                    for each in imported {
+                        each.role = dependencies.role(source, &each.emitted);
+                    }
+                }
+            }
+        }
     }
