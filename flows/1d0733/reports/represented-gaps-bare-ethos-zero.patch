+/// The roles conception learned for a file's imports, in order.
+fn learned_roles(source: &str) -> Vec<(String, Option<Role>)> {
+    let File::Library(library) = file_of(source) else {
+        panic!("{source} is no library");
+    };
+    let mut roles = Vec::new();
+    for import in library.imports {
+        let imported = match import {
+            Import::One(_, imported) => vec![imported],
+            Import::Many(_, imported) => imported,
+        };
+        for each in imported {
+            roles.push((each.name.as_ref().to_owned(), each.role));
+        }
+    }
+    roles
+}
+
+#[test]
+fn an_import_learns_its_role_from_the_dependency_declarations() {
+    let roles = learned_roles(
+        "Library [ datom:[ Represented Path Error ] datom_codec:Composing \
+         protos:[ Extent Textualizable ] crate:Represented ] [] [] []",
+    );
+    assert_eq!(
+        roles,
+        vec![
+            ("Represented".to_owned(), Some(Role::Trait)),
+            ("Path".to_owned(), Some(Role::Type)),
+            ("Error".to_owned(), None),
+            ("Composing".to_owned(), Some(Role::Trait)),
+            ("Extent".to_owned(), Some(Role::Type)),
+            ("Textualizable".to_owned(), Some(Role::Trait)),
+            ("Represented".to_owned(), None),
+        ]
+    );
+}
