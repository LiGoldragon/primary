+    assert_eq!(problem, Problem::Expected(Form::Type));
+    assert_eq!(path, vec![1, 1, 0, 1]);
+    let (path, problem) =
+        refusal_of("Library [ datom:[ Represented ] ] [ Tickets.Vector<Represented> ] [] []");
+    assert_eq!(problem, Problem::Expected(Form::Type));
+    // The argument stands in the angled enclosure beside the declaration.
