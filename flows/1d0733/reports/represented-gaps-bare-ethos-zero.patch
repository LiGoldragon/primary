+//! The dependencies' own ethos declarations, embedded so that conception
+//! learns the role of every name a dependency declares: each `.ethos` file at
+//! the root of a direct dependency, found through `cargo metadata`, under the
+//! name the dependency's crate is written by. A consumer also writes
+//! datom-codec as `datom`.
+
+use std::fmt::Write as _;
+
+const ALIASES: &[(&str, &str)] = &[("datom", "datom_codec")];
+
+fn main() {
+    let manifest_directory = std::env::var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR");
+    let cargo = std::env::var("CARGO").expect("CARGO");
+    let target = std::env::var("TARGET").expect("TARGET");
+    let output = std::process::Command::new(cargo)
+        .args(["metadata", "--format-version", "1", "--offline"])
+        .args(["--filter-platform", &target, "--manifest-path"])
+        .arg(format!("{manifest_directory}/Cargo.toml"))
+        .output()
+        .expect("cargo metadata runs");
+    assert!(
+        output.status.success(),
+        "cargo metadata: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let metadata: serde_json::Value =
+        serde_json::from_slice(&output.stdout).expect("cargo metadata is JSON");
+    let root = metadata["resolve"]["root"]
+        .as_str()
+        .expect("a root package");
+    let nodes = metadata["resolve"]["nodes"]
+        .as_array()
+        .expect("resolve nodes");
+    let node = nodes
+        .iter()
+        .find(|node| node["id"] == root)
+        .expect("the root node");
+    let packages = metadata["packages"].as_array().expect("packages");
+    let mut dependencies = Vec::new();
+    for dependency in node["deps"].as_array().expect("root dependencies") {
+        let normal = dependency["dep_kinds"]
+            .as_array()
+            .expect("dependency kinds")
+            .iter()
+            .any(|kind| kind["kind"].is_null());
+        if !normal {
+            continue;
+        }
+        let name = dependency["name"].as_str().expect("dependency name");
+        let package = packages
+            .iter()
+            .find(|package| package["id"] == dependency["pkg"])
+            .expect("the dependency's package");
+        let manifest = std::path::Path::new(
+            package["manifest_path"]
+                .as_str()
+                .expect("the dependency's manifest"),
+        );
+        let directory = manifest.parent().expect("the dependency's directory");
+        let mut declarations = Vec::new();
+        for entry in std::fs::read_dir(directory).expect("the dependency's directory reads") {
+            let path = entry.expect("a directory entry").path();
+            if path.extension().and_then(|extension| extension.to_str()) == Some("ethos") {
+                declarations.push(path);
+            }
+        }
+        if declarations.is_empty() {
+            continue;
+        }
+        declarations.sort();
+        dependencies.push((name.to_owned(), declarations));
+    }
+    dependencies.sort();
+    let mut source = String::from("&[\n");
+    for (name, declarations) in &dependencies {
+        let mut sources = vec![name.clone()];
+        for (alias, aliased) in ALIASES {
+            if aliased == name {
+                sources.push((*alias).to_owned());
+            }
+        }
+        for written in &sources {
+            write!(
+                source,
+                "    Dependency {{ source: {written:?}, declarations: &["
+            )
+            .expect("writes");
+            for path in declarations {
+                println!("cargo::rerun-if-changed={}", path.display());
+                write!(source, " include_str!({:?}),", path.display().to_string()).expect("writes");
+            }
+            source.push_str(" ] },\n");
+        }
+    }
+    source.push_str("]\n");
+    println!("cargo::rerun-if-changed=Cargo.lock");
+    println!("cargo::rerun-if-changed=build.rs");
+    let out = std::env::var("OUT_DIR").expect("OUT_DIR");
+    std::fs::write(format!("{out}/dependencies.rs"), source).expect("dependencies.rs writes");
+}
