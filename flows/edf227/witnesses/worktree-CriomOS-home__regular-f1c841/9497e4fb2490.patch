-        ExecStart = "${messagePackage}/bin/${daemonBinary} ${signalPath}";
-        Restart = "on-failure";
-        RestartSec = "2s";
-      };
-
-      Install.WantedBy = [ "default.target" ];
-    };
-  };
-}
