@@ -106,6 +107,13 @@
 assert hasInfix "Configure.{ %t/flow/flow.sock %t/flow/flow-meta.sock " configure.Service.ExecStart;
 assert hasInfix "[ Psyche ] ${messagePackage}/bin/message-nexus }" configure.Service.ExecStart;
