flow-test: remove private Claude credential on teardown

diff --git a/packages/flow-claude-hook.nix b/packages/flow-claude-hook.nix
index f431bfa9e1..9db78a7477 100644
--- a/packages/flow-claude-hook.nix
+++ b/packages/flow-claude-hook.nix
@@ -109,8 +109,9 @@
     flowNexusPid=
     interactiveHerdrPid=
     interactiveSession=
+    privateCredentials=
     keepFailureRoot=1
-    trap 'if [ -n "$flowNexusPid" ]; then kill "$flowNexusPid" 2>/dev/null || true; wait "$flowNexusPid" 2>/dev/null || true; fi; if [ -n "$interactiveHerdrPid" ]; then kill "$interactiveHerdrPid" 2>/dev/null || true; fi; if [ -n "$interactiveSession" ]; then ${herdrCli} --session "$interactiveSession" server stop 2>/dev/null || true; fi; if [ "$keepFailureRoot" = 0 ]; then rm -rf "$root"; else chmod 700 "$root"; echo "flow-claude-hook: retained private failure root $root" >&2; fi' EXIT
+    trap 'if [ -n "$flowNexusPid" ]; then kill "$flowNexusPid" 2>/dev/null || true; wait "$flowNexusPid" 2>/dev/null || true; fi; if [ -n "$interactiveHerdrPid" ]; then kill "$interactiveHerdrPid" 2>/dev/null || true; fi; if [ -n "$interactiveSession" ]; then ${herdrCli} --session "$interactiveSession" server stop 2>/dev/null || true; fi; case "$privateCredentials" in "$root/home/.claude/.credentials.json") rm -f -- "$privateCredentials" ;; *) echo "flow-claude-hook: refused unexpected credential teardown path" >&2 ;; esac; if [ "$keepFailureRoot" = 0 ]; then rm -rf "$root"; else chmod 700 "$root"; echo "flow-claude-hook: retained private failure root $root" >&2; fi' EXIT
 
