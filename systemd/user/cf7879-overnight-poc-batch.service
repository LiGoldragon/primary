[Unit]
Description=One fixed cf7879 overnight fixture batch

[Service]
Type=oneshot
Environment=PATH=%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin
Environment=CODEX_APP_SERVER_SOCKET=/home/li/.codex/app-server-control/app-server-control.sock
ExecStart=/home/li/wt/github.com/LiGoldragon/primary/cf7879-overnight-batch/tools/overnight-poc-batch.sh
RuntimeMaxSec=8h
TimeoutStartSec=8h
KillMode=control-group
Restart=no
RemainAfterExit=yes
NoNewPrivileges=yes
