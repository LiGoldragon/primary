[Unit]
Description=Bounded core checkup (read-only except one configured owned-unit restart per failure episode)

[Service]
Type=oneshot
Environment=PATH=%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin
ExecStart=/usr/bin/env node %h/primary/tools/core-checkup.mjs /etc/core-checkup/roster.json %h/.config/core-checkup/policy.json %h/.local/state/core-checkup/events.ndjson %h/.local/state/core-checkup/state.json
TimeoutStartSec=180
KillMode=control-group
MemoryMax=256M
NoNewPrivileges=yes
