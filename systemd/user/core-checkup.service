[Unit]
Description=Bounded core checkup (read-only except one configured owned-unit restart per failure episode)

[Service]
Type=oneshot
Environment=PATH=%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin
ExecStart=/usr/bin/env node %h/primary/tools/core-checkup.mjs %h/.config/core-checkup/config.json %h/.local/state/core-checkup/events.ndjson %h/.local/state/core-checkup/state.json
RuntimeMaxSec=120
TimeoutStartSec=120
MemoryMax=256M
NoNewPrivileges=yes
