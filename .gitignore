# Primary workspace local index
/repos

# Private role repositories — local checkouts/symlinks only, never tracked here
/private-repos/

# jj colocated repository metadata
.jj/

# direnv
.direnv/

# nix
result
result-*

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/issues.jsonl

# local environment
.env
.envrc.local

# local Pi continuation state; generated roles and skills are tracked
.pi/*
!.pi/agents/
!.pi/agents/**
!.pi/skills/
!.pi/skills/**

# transient subagent runtime artifacts — transcripts, inputs, outputs, not history
/.pi-subagents/

# editor and language scratch
*.swp
*.swo
__pycache__/
*.pyc

# orchestration lane lock files — runtime coordination state, not history
/orchestrate/*.lock
/orchestrate/*.redb*
/orchestrate/*.signal
/orchestrate/*.sock
/orchestrate/orchestrate-daemon.log

# orchestrate-cli build outputs
/orchestrate-cli/target/
/test
worktrees/aggregator-inventory-health-fixes/
# bd worktree
agent-worktrees/agent-toolchain-refresh-tracker/

# private bootstrap records
/.lojix-bootstrap-primary-*/

# flow-id private runtime claim metadata; lanes and authored flow records remain tracked
/flows/.*.flow-id
/flows/.*.flow-id.lock

# Harness skills: linked by CriomOS-home from the pinned context cohort
/.claude/skills
/.agents/skills
/.codex/skills
/.opencode/skills
/.pi/skills

# a flow directory keeps only its handover, its reports and its proposals;
# evidence, logs, gcroots, books and every other scratch file stay out of history
/flows/*/**
!/flows/*/**/
!/flows/**/handover*.md
!/flows/**/*report*.md
!/flows/*/proposals/**
# nested repositories kept as rollback copies are directories git would list as embedded repos
/flows/374411/0mlh-release/rollback/context-refresh-rehearsal/
/flows/374411/0mlh-release/rollback/stopped-runtime-current-j8/
/flows/896bac/jg4u/release4/rollback/stopped-curriculum-context/
