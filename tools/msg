#!/usr/bin/env bash
set -euo pipefail

# Compatibility entrypoint for the checked Hacky Messenger send.
# Usage: msg <flow> <text...>

if [[ $# -lt 2 ]]; then
  echo "Usage: msg <to> <text...>" >&2
  echo "  FLOW_ID must be set (identifies you as sender)" >&2
  echo "  <flow> is an HM-registered Flow ID" >&2
  exit 2
fi

: "${FLOW_ID:?msg requires FLOW_ID in the environment}"

to="$1"
shift
text="$*"
exec hm-send "$to" "$text"
