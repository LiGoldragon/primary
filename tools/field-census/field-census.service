[Unit]
Description=Read-only Field census and bounded summaries to Field Low and Ultra Low

[Service]
Type=oneshot
WorkingDirectory=/home/li/primary
Environment=FIELD_CENSUS_CONFIG=/home/li/.config/field-census/recipients.json
Environment=FIELD_CENSUS_STATE=/home/li/.local/state/field-census
ExecStart=/home/li/.nix-profile/bin/node /home/li/primary/tools/field-census-cycle.mjs
TimeoutStartSec=30s
MemoryMax=256M
NoNewPrivileges=true
UMask=0077
