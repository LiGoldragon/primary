#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
import { execFileSync } from 'node:child_process';
const workspace=process.env.COMPONENT_EVIDENCE_WORKSPACE ?? path.dirname(path.dirname(new URL(import.meta.url).pathname));
const manifest=process.env.REPO_MANIFEST ?? path.join(workspace,'protocols/repos-manifest.dotos');
const root=process.env.REPO_ROOT ?? '/git/github.com/LiGoldragon';
const inputPath=process.env.COMPONENT_EVIDENCE_INPUTS ?? path.join(workspace,'protocols/component-evidence.inputs.json');
const inputs=fs.existsSync(inputPath)?JSON.parse(fs.readFileSync(inputPath,'utf8')):{};
for (const [name,input] of Object.entries(inputs)) {
  if (!input || typeof input !== 'object' || (input.unit !== undefined && typeof input.unit !== 'string')) throw new Error(`invalid component input: ${name}`);
  if (input.scope !== undefined && !['user','system'].includes(input.scope)) throw new Error(`invalid unit scope: ${name}`);
  for (const field of ['witness','review']) if (input[field] !== undefined && (typeof input[field] !== 'object' || !input[field].ref || !input[field].date || !input[field].scope || !input[field].result)) throw new Error(`invalid ${field} input: ${name}`);
}
const run=(cmd,args,cwd,timeout=3000)=>{try{return execFileSync(cmd,args,{cwd,encoding:'utf8',timeout,stdio:['ignore','pipe','ignore']}).trim()}catch{return null}};
const inventoryRaw=run(process.execPath,[path.join(workspace,'tools/repo-inventory')],workspace);
if (!inventoryRaw) throw new Error('repo inventory failed');
const inventory=JSON.parse(inventoryRaw);
const jj=process.env.COMPONENT_EVIDENCE_JJ??'jj';
const systemctl=process.env.COMPONENT_EVIDENCE_SYSTEMCTL??'systemctl';
const serviceEvidence=(unit,scope='system')=>{if(systemctl==='off')return {unit,scope,status:'unknown'}; const prefix=scope==='user'?['--user']:scope==='system'?[]:null; if(!prefix)return {unit,scope,status:'unknown',reason:'invalid-unit-scope'}; const raw=run(systemctl,[...prefix,'show',unit,'--property=LoadState,ActiveState,SubState,ExecStart','--no-pager'],undefined); if(!raw)return {unit,scope,status:'unknown'}; const fields=Object.fromEntries(raw.split('\n').filter(Boolean).map(line=>{const n=line.indexOf('=');return n<0?[line,'']:[line.slice(0,n),line.slice(n+1)]})); const start=fields.ExecStart??''; const match=start.match(/\{\s*([^\s;]+)/); return {unit,scope,load_state:fields.LoadState??'unknown',active_state:fields.ActiveState??'unknown',sub_state:fields.SubState??'unknown',executable:match?.[1]??null};};
const rows=inventory.rows.map(r=>{const i=inputs[r.name]??{}; const rev=fs.existsSync(r.path)?run(jj,['log','-r','@','-n','1','--no-graph','-T','commit_id'],r.path):null; const unit=i.unit; const config=i.config_path&&fs.existsSync(i.config_path)?{path:i.config_path,sha256:run('sha256sum',[i.config_path])?.split(/\s+/)[0]??null}:i.config_path?{path:i.config_path,sha256:null}:null; return {name:r.name,path:r.path,status:fs.existsSync(r.path)?'present':'missing-locally',source_revision:rev?{value:rev}:null,deployed_executable:unit?serviceEvidence(unit,i.scope):{status:'unknown',reason:'unit-not-configured'},active_configuration:config,bounded_witness:i.witness??'unknown',last_living_review:i.review??'unknown'};});
const unknowns=rows.filter(r=>!r.source_revision||r.deployed_executable.status==='unknown').map(r=>r.name);
process.stdout.write(JSON.stringify({schema:'component-evidence/v1',root,manifest,inventory:{missing:inventory.missing,discovered:inventory.discovered,aliases:inventory.aliases},components:rows,unknowns},null,2)+'\n');
