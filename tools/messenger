#!/usr/bin/env bash
set -euo pipefail

# Persistent central messenger. Input is Send.{ FROM TO TEXT }, Roster, or Status.
[[ $# -ge 1 && -n "$1" ]] || { echo "Usage: tools/messenger <pane-id>" >&2; exit 2; }
readonly PANE_ID="$1"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/messenger"
readonly ROSTER_FILE="$STATE_DIR/roster.json"
readonly LOG_FILE="$STATE_DIR/log"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
mkdir -p "$STATE_DIR"
printf '%s\n' "$PANE_ID" >"$STATE_DIR/pane_id"

log() { printf '%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG_FILE"; }

refresh_roster() {
  local raw
  raw=$(herdr agent list 2>/dev/null) || { log 'roster-refresh-failed'; return 1; }
  python3 -c '
import json, sys
d=json.load(sys.stdin); agents=d.get("result", {}).get("agents", d.get("agents", [])); out={}
for a in agents:
  name=a.get("name")
  if name: out[name]={"pane_id":a.get("pane_id", a.get("id", "")), "status":a.get("agent_status", a.get("status", "unknown")), "kind":a.get("kind", "unknown")}
print(json.dumps(out, separators=(",", ":")))
' <<<"$raw" >"$ROSTER_FILE" || { log 'roster-parse-failed'; return 1; }
}

judge() {
  # Disposition is structural only: terminal ingress has already been typed.
  # It must not rewrite, summarize, or ask another model to reinterpret a quote.
  printf '{"action":"deliver","reason":"typed ingress"}\n'
}

deliver() {
  local from="$1" to="$2" body="$3" decision action reason text
  decision=$(judge "$from" "$to" "$body")
  action=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["action"])' <<<"$decision")
  reason=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["reason"])' <<<"$decision")
  log "decision action=$action from=$from to=$to reason=$reason"
  [[ "$action" == deliver ]] || { echo "${action^}.{ $to «$reason» }"; return; }
  text="$body"
  if [[ "$to" == psyche || "$to" == living ]]; then
    # Notification providers are selected by deployment, not by this relay.
    log "notification-held provider-unconfigured from=$from"
    echo "Held.{ $to «notification provider is not configured» }"
    return
  fi
  refresh_roster || true
  if python3 - "$to" "$ROSTER_FILE" <<'PY'
import json, sys
try: sys.exit(0 if sys.argv[1] in json.load(open(sys.argv[2])) else 1)
except Exception: sys.exit(1)
PY
  then
    herdr agent prompt "$to" "$text" 2>/dev/null && { log "delivered-agent from=$from to=$to"; echo "Delivered.{ $from $to }"; } || { log "agent-delivery-failed to=$to"; echo "Failed.{ $to «agent prompt failed» }"; }
  elif herdr pane get "$to" >/dev/null 2>&1; then
    herdr pane send-text "$to" "$text" 2>/dev/null && herdr pane send-keys "$to" enter 2>/dev/null && { log "delivered-pane from=$from to=$to"; echo "Delivered.{ $from $to }"; } || { log "pane-delivery-failed to=$to"; echo "Failed.{ $to «pane delivery failed» }"; }
  else
    log "target-disappeared from=$from to=$to"; echo "Held.{ $to «target is no longer live» }"
  fi
}

dispatch() {
  local line="$1" from to body event recipients recipient
  case "$line" in
    Roster) refresh_roster && cat "$ROSTER_FILE" ;;
    Status) refresh_roster || true; printf '{"pane_id":"%s","roster":%s}\n' "$PANE_ID" "$(cat "$ROSTER_FILE" 2>/dev/null || echo '{}')" ;;
    MACHINE.*|LIVING.*)
      event=$(cd "$SCRIPT_DIR/messaging-codec" && cargo run --quiet --offline <<<"$line") || { log "parse-failed"; echo 'ParseError.{ «expected terminal MACHINE Relay Datom» }'; return; }
      from=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["claimed_from"])' <<<"$event")
      # Retain the exact structured envelope at the receiving terminal.  The
      # labels are claimed provenance: Herdr's terminal transport has no
      # authenticated sender identity to elevate them beyond attribution.
      body="$line"
      recipients=$(python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["recipients"]))' <<<"$event")
      log "relay-accepted producer=$(python3 -c 'import json,sys;print(json.load(sys.stdin)["producer"])' <<<"$event") claimed_from=$from event=$event"
      while IFS= read -r recipient; do [[ -n "$recipient" ]] && deliver "$from" "$recipient" "$body"; done <<<"$recipients"
      ;;
    *) log "unknown input=${line:0:120}"; echo 'Unknown.{ «use Send.{ from to text }, Roster, or Status» }' ;;
  esac
}

log "messenger-started pane=$PANE_ID pid=$$"
refresh_roster || true
echo "Messenger running in pane $PANE_ID."
while IFS= read -r line; do [[ -n "$line" ]] && { log "received input=${line:0:120}"; dispatch "$line"; }; done
