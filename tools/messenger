#!/usr/bin/env bash
set -euo pipefail

# Central messenger flow — a persistent loop that routes all inter-flow
# messages through one model, maintaining the live roster and judging
# whether each message should be delivered, annotated, or held.
#
# Runs in its own Herder pane. Accepts messages via:
#   herdr agent prompt messenger "Send.{ <from> <to> <text> }"
#
# Delivers via herdr agent prompt to the target. Notifies the living
# via herdr notification show for psyche-addressed messages.

readonly MESSENGER_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/messenger"
readonly ROSTER_FILE="$MESSENGER_STATE/roster.json"
readonly LOG_FILE="$MESSENGER_STATE/log"
mkdir -p "$MESSENGER_STATE"

log() {
  printf '%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG_FILE"
}

refresh_roster() {
  local raw
  raw=$(herdr agent list 2>/dev/null) || { log "roster-refresh-failed"; return 1; }
  echo "$raw" | python3 -c "
import json, sys
data = json.load(sys.stdin)
agents = data.get('result', {}).get('agents', [])
roster = {}
for a in agents:
    name = a.get('name', '')
    if name:
        roster[name] = {
            'pane_id': a.get('pane_id', a.get('id', '')),
            'status': a.get('agent_status', a.get('status', 'unknown')),
            'kind': a.get('kind', 'unknown')
        }
print(json.dumps(roster, indent=2))
" >"$ROSTER_FILE" 2>/dev/null || { log "roster-parse-failed"; return 1; }
  log "roster-refreshed agents=$(python3 -c "import json; print(len(json.load(open('$ROSTER_FILE'))))" 2>/dev/null || echo '?')"
}

resolve_target() {
  local target="$1"
  python3 -c "
import json, sys
roster = json.load(open('$ROSTER_FILE'))
entry = roster.get('$target')
if entry:
    print(entry['pane_id'])
    print(entry['status'])
else:
    print('')
    print('not-found')
" 2>/dev/null
}

deliver() {
  local from="$1" to="$2" text="$3"
  local annotated="[from $from] $text"

  refresh_roster

  if [[ "$to" == "psyche" || "$to" == "living" ]]; then
    herdr notification show "Message from $from" \
      --body "$text" \
      --sound request \
      --position top-right 2>/dev/null
    log "delivered-to-psyche from=$from text=${text:0:80}"
    echo "Delivered.{ $from psyche }"
    return 0
  fi

  local target_info
  target_info=$(resolve_target "$to")
  local pane_id status
  pane_id=$(echo "$target_info" | head -1)
  status=$(echo "$target_info" | tail -1)

  if [[ -z "$pane_id" ]]; then
    log "target-not-found from=$from to=$to"
    echo "NotFound.{ $to «$from tried to reach $to but no agent by that name is registered» }"
    return 0
  fi

  if [[ "$status" == "working" || "$status" == "idle" || "$status" == "blocked" ]]; then
    herdr agent prompt "$pane_id" "$annotated" 2>/dev/null && {
      log "delivered from=$from to=$to pane=$pane_id"
      echo "Delivered.{ $from $to }"
    } || {
      log "delivery-failed from=$from to=$to pane=$pane_id"
      echo "Failed.{ $to «herdr agent prompt failed for pane $pane_id» }"
    }
  else
    log "target-unavailable from=$from to=$to status=$status"
    echo "Unavailable.{ $to $status «$from tried to reach $to but status is $status» }"
  fi
}

roster_cmd() {
  refresh_roster
  cat "$ROSTER_FILE"
}

parse_and_dispatch() {
  local input="$1"

  if [[ "$input" == Roster* ]]; then
    roster_cmd
    return
  fi

  if [[ "$input" == Send.* ]]; then
    local from to text
    from=$(echo "$input" | sed -n 's/^Send\.{ *\([^ ]*\) .*/\1/p')
    to=$(echo "$input" | sed -n 's/^Send\.{ *[^ ]* *\([^ ]*\) .*/\1/p')
    text=$(echo "$input" | sed -n 's/^Send\.{ *[^ ]* *[^ ]* *\(.*\) *}$/\1/p')
    if [[ -n "$from" && -n "$to" && -n "$text" ]]; then
      deliver "$from" "$to" "$text"
    else
      log "parse-failed input=${input:0:120}"
      echo "ParseError.{ «could not extract from/to/text from: ${input:0:80}» }"
    fi
    return
  fi

  log "unknown-command input=${input:0:120}"
  echo "Unknown.{ «unrecognized message shape: ${input:0:80}» }"
}

# Startup — accept pane ID as first argument, or from herdr pane current
log "messenger-started pid=$$"
PANE_ID="${1:-}"
if [[ -z "$PANE_ID" ]]; then
  PANE_ID=$(herdr pane current 2>/dev/null | python3 -c "import json,sys; print(json.load(sys.stdin).get('result',{}).get('pane_id',''))" 2>/dev/null || echo "")
fi
if [[ -n "$PANE_ID" ]]; then
  echo "$PANE_ID" >"$MESSENGER_STATE/pane_id"
  log "pane-id=$PANE_ID"
else
  log "pane-id-unknown"
fi
refresh_roster
echo "Messenger running in pane ${PANE_ID:-unknown}."
echo "Send: tools/msg <to> <text>  (FLOW_ID must be set)"
echo "Roster: herdr pane send-text ${PANE_ID:-PANE} Roster"

# Main loop: read lines from stdin (herdr agent prompt delivers here)
while IFS= read -r line; do
  [[ -n "$line" ]] || continue
  log "received input=${line:0:120}"
  parse_and_dispatch "$line"
done
