#!/usr/bin/env python3
"""Redeem one Codex usage reset, named by its id, and show state before and after.

    codex-redeem-reset <RateLimitResetCredit_...>

Refuses unless the named reset is available and is the one expiring soonest,
and unless one condition holds: (1) Codex is out or nearly out: ordinary
usage not allowed, or a window at least CODEX_RESET_MIN_USED_PERCENT used
(default 95); (2) the reset expires within CODEX_RESET_EXPIRY_WINDOW_MINUTES
(default 90) and the current week is at least 1% used. Prints which allowed it.
Run only under the judgment rule of knowledge:codex-reset.
"""

import os
import sys
import time
import uuid

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import codex_app_server  # noqa: E402

MIN_USED_PERCENT = float(os.environ.get("CODEX_RESET_MIN_USED_PERCENT", "95"))
EXPIRY_WINDOW_MINUTES = float(os.environ.get("CODEX_RESET_EXPIRY_WINDOW_MINUTES", "90"))


def refuse(reason):
    sys.stdout.flush()
    print(f"refused: {reason}", file=sys.stderr)
    sys.exit(2)


def most_used_percent(usage):
    limits = usage.get("rateLimitsByLimitId") or {"codex": usage["rateLimits"]}
    windows = [limit.get(name) for limit in limits.values() for name in ("primary", "secondary")]
    return max((w["usedPercent"] for w in windows if w), default=0)


def week_used_percent(usage):
    limits = usage.get("rateLimitsByLimitId") or {"codex": usage["rateLimits"]}
    weeks = [w for limit in limits.values() for name in ("primary", "secondary")
             for w in [limit.get(name)] if w and w.get("windowDurationMins") == 10080]
    return max((w["usedPercent"] for w in weeks), default=0)


if len(sys.argv) != 2:
    refuse("name exactly one reset id")
credit_id = sys.argv[1]

before = codex_app_server.read_usage()
print("before:\n" + codex_app_server.report(before))

credits = codex_app_server.available_credits(before)
if not credits:
    refuse("no reset is available")
if credit_id not in [c["id"] for c in credits]:
    refuse(f"{credit_id} is not an available reset")
if credits[0]["id"] != credit_id:
    refuse(f"{credit_id} is not the soonest-expiring reset; that is {credits[0]['id']}")
out = before.get("ordinaryUsageAllowed") is False
used = most_used_percent(before)
expires_at = credits[0]["expiresAt"]
minutes_left = (expires_at - time.time()) / 60 if expires_at else None
week_used = week_used_percent(before)
if out or used >= MIN_USED_PERCENT:
    print(f"allowed by: Codex is out or nearly out ({used}% used)")
elif minutes_left is not None and 0 < minutes_left <= EXPIRY_WINDOW_MINUTES and week_used >= 1:
    print(f"allowed by: reset expires in {minutes_left:.0f} min (within "
          f"{EXPIRY_WINDOW_MINUTES:g}) and the week is {week_used}% used")
else:
    refuse(f"neither condition holds: {used}% used < {MIN_USED_PERCENT}% and usage allowed; "
           f"reset expiry window {EXPIRY_WINDOW_MINUTES:g} min not met "
           f"(minutes left: {minutes_left if minutes_left is None else round(minutes_left)}, "
           f"week {week_used}% used, needs >= 1%)")

idempotency_key = str(uuid.uuid4())
print(f"redeeming {credit_id} with idempotency key {idempotency_key}")
result = codex_app_server.call("account/rateLimitResetCredit/consume",
                               {"idempotencyKey": idempotency_key, "creditId": credit_id})
print(f"outcome: {result.get('outcome')}")

after = codex_app_server.read_usage()
print("after:\n" + codex_app_server.report(after))
