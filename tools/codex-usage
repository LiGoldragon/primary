#!/usr/bin/env python3
"""Print Codex usage left, its reset time, and the available usage resets.

Reads account/rateLimits/read from `codex app-server` (CODEX_BIN) with the
~/.codex login. Read-only. `--json` prints the raw reply.
"""

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import codex_app_server  # noqa: E402

usage = codex_app_server.read_usage()
if "--json" in sys.argv[1:]:
    print(json.dumps(usage, indent=1))
else:
    print(codex_app_server.report(usage))
