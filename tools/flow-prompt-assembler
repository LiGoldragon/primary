try {
  if (args.shift() !== 'assemble') throw new Error('usage: flow-prompt-assembler assemble --lane DIRECTORY --output DIRECTORY [--profile primary --primary-root DIRECTORY --topic TOPIC]');
  const lane = args.includes('--lane') ? option('--lane') : option('--predecessor'); const output = option('--output');
