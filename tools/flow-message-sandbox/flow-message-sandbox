#!/usr/bin/env python3
"""Flow + Message semi-sandbox: one entry point.

    flow-message-sandbox run [SCENARIO ...]     up, seats, scenarios, down, verify
    flow-message-sandbox up                      stand up and seat; prints the run id
    flow-message-sandbox scenarios RUN [N ...]   run scenarios against a standing run
    flow-message-sandbox down RUN [--purge]      tear down and verify clean

Scenarios are numbered 1-13 (scenarios.py, scenarios_late.py); `run` takes
them in the order 1-9, 13, 10, 11, 12, since 10 closes a recipient pane. `run` always tears down,
also on failure or interrupt, and writes RUN/results.json and
RUN/results.md under ~/.cache/flow-message-sandbox/.
"""

import json
import pathlib
import sys
import traceback

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from environment import Pins, RunPaths  # noqa: E402
from report import Report  # noqa: E402
from sandbox import Sandbox  # noqa: E402
from scenarios_late import ORDER, SCENARIOS, Scenarios  # noqa: E402
from seats import SeatLauncher  # noqa: E402

SEATS = (('haiku', 'claude'), ('luna-a', 'codex'), ('luna-b', 'codex'),
         ('sender-a', 'codex'), ('sender-b', 'codex'))


def stand_up():
    paths = RunPaths(RunPaths.new_run_id())
    paths.root.mkdir(parents=True)
    (paths.root / 'logs').mkdir()
    pins = Pins.build(paths.root / 'logs')
    sandbox = Sandbox(paths, pins)
    sandbox.save()
    print(f'run {paths.run_id}: {paths.root}', flush=True)
    sandbox.up()
    launcher = SeatLauncher(sandbox)
    for name, harness in SEATS:
        launcher.launch(name, harness)
        print(f'seat {name}: {sandbox.state["seats"][name]["pane"]}', flush=True)
    launcher.bind([name for name, _ in SEATS])
    return sandbox


def run_scenarios(sandbox, numbers):
    runner = Scenarios(sandbox)
    results = sandbox.state.setdefault('results', {})
    for number in numbers or ORDER:
        name = SCENARIOS[number].__name__
        print(f'scenario {number} {name} ...', flush=True)
        try:
            outcome = runner.run(number)
        except Exception as error:  # a harness fault is recorded, not raised
            outcome = {'verdict': 'error', 'error': repr(error),
                       'traceback': traceback.format_exc()}
        results[str(number)] = outcome
        sandbox.save()
        print(f'scenario {number}: {outcome["verdict"]}', flush=True)


def main(arguments):
    command = arguments[0] if arguments else 'run'
    if command == 'up':
        stand_up()
        return 0
    if command == 'scenarios':
        sandbox = Sandbox.resume(arguments[1])
        run_scenarios(sandbox, [int(number) for number in arguments[2:]])
        return 0
    if command == 'down':
        sandbox = Sandbox.resume(arguments[1])
        teardown = sandbox.down(purge='--purge' in arguments)
        if not '--purge' in arguments:
            Report(sandbox).write()
        print(json.dumps(teardown, indent=1))
        return 0 if teardown['clean'] else 1
    if command == 'run':
        sandbox = None
        try:
            sandbox = stand_up()
            run_scenarios(sandbox, [int(number) for number in arguments[1:]])
        finally:
            if sandbox is not None:
                teardown = sandbox.down()
                Report(sandbox).write()
                print(json.dumps(teardown, indent=1))
        return 0
    print(__doc__)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
